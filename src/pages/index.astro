---
import BaseLayout from '../layouts/BaseLayout.astro';
import GamificationWidget from '../components/GamificationWidget.astro';
import { getCollection } from 'astro:content';

let allModules: any[] = [];
try {
  allModules = await getCollection('pembelajaran');
  allModules.sort((a, b) => a.data.order - b.data.order);
} catch (e) {
  allModules = [];
}
const sortedModules = allModules;
---

<BaseLayout 
  title="Beranda Utama" 
  description="Website resmi Agung Gumelar Saputra, S.Tr.T. - Guru Pengampu Rekayasa Perangkat Lunak (RPL) SMKN 1 Rongga, S2 Teknologi Pendidikan, & Software Engineer."
>
  <!-- ========================================== -->
  <!-- HERO SECTION (M3 Elevated Split-Layout) -->
  <!-- ========================================== -->
  <section class="relative pt-12 pb-20 overflow-hidden border-b border-[var(--md-sys-color-outline-variant)] bg-[var(--md-sys-color-surface)]">
    
    <div class="container-main relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Column: Branding, Narrative & CTAs (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Official M3 Assist Role Chips -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="m3-chip-primary text-xs font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
              👨‍🏫 Guru Pengampu RPL SMKN 1 Rongga
            </span>
            <span class="m3-chip-warning text-xs font-semibold">
              🎓 S.Tr.T. (Sarjana Terapan Teknik)
            </span>
            <span class="m3-chip text-xs font-semibold">
              💻 Fullstack Software Engineer
            </span>
          </div>

          <!-- Hero Headline (M3 Display Scale - Clean & Solid) -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground font-display leading-[1.12]">
            Mencetak Talenta Vokasi <span class="text-sky-400">PPLG & Software Engineer</span> Unggulan.
          </h1>

          <!-- Educator Bio -->
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
            Selamat datang di hub edukasi & portal pembelajaran interaktif <strong class="text-foreground font-semibold">Agung Gumelar Saputra, S.Tr.T.</strong> Berbagi modul Rekayasa Perangkat Lunak (RPL), simulasi <strong class="text-foreground font-semibold">Drilling TKA PPLG</strong>, sistem gamifikasi XP, serta etalase karya vokasi berstandar industri.
          </p>

          <!-- Primary M3 Action Buttons -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a 
              href="/pembelajaran" 
              class="m3-btn-filled text-xs sm:text-sm font-bold px-6 py-3 shadow-md"
            >
              📚 Mulai Belajar & Gamifikasi →
            </a>
            <a 
              href="/pembelajaran/tka-pplg" 
              class="m3-btn-tonal text-xs sm:text-sm font-bold px-5 py-3"
            >
              🎯 Simulasi Drilling TKA PPLG
            </a>
          </div>

          <!-- Quick Metrics Bar (M3 Surface Containers) -->
          <div class="grid grid-cols-3 gap-3 pt-6 border-t border-[var(--md-sys-color-outline-variant)]">
            <div class="p-4 rounded-m3-md bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)] space-y-1">
              <div class="text-xl sm:text-2xl font-extrabold text-sky-400 font-mono">16 Modul</div>
              <div class="text-[11px] text-muted-foreground font-medium">Orientasi PPLG</div>
            </div>
            <div class="p-4 rounded-m3-md bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)] space-y-1">
              <div class="text-xl sm:text-2xl font-extrabold text-amber-400 font-mono">600 Soal</div>
              <div class="text-[11px] text-muted-foreground font-medium">Bank CBT TKA (A-E)</div>
            </div>
            <div class="p-4 rounded-m3-md bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)] space-y-1">
              <div class="text-xl sm:text-2xl font-extrabold text-teal-400 font-mono">Real-time</div>
              <div class="text-[11px] text-muted-foreground font-medium">Gamifikasi XP</div>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Console Preview Card (5 Cols) -->
        <div class="lg:col-span-5">
          <div class="m3-card-elevated p-6 rounded-m3-xl space-y-5">
            
            <!-- Window Header Dots -->
            <div class="flex items-center justify-between border-b border-[var(--md-sys-color-outline-variant)] pb-3">
              <div class="flex items-center gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
                <span class="text-xs font-mono text-muted-foreground ml-2">index.ts — Learning Hub Console</span>
              </div>
              <span class="m3-chip-success text-[10px] py-0.5 px-2">
                SYSTEM ONLINE
              </span>
            </div>

            <!-- Code/Console Snippet -->
            <div class="font-mono text-xs space-y-1.5 text-slate-300 leading-relaxed bg-[var(--md-sys-color-surface-container-lowest)] p-4 rounded-m3-md border border-[var(--md-sys-color-outline-variant)]">
              <div class="text-muted-foreground">// Inisialisasi Kurikulum Vokasi RPL</div>
              <div><span class="text-sky-400">const</span> educator = <span class="text-amber-300">&#123;</span></div>
              <div class="pl-4">nama: <span class="text-teal-300">"Agung Gumelar Saputra"</span>,</div>
              <div class="pl-4">gelar: <span class="text-teal-300">"S.Tr.T."</span>,</div>
              <div class="pl-4">peran: <span class="text-teal-300">"Guru Pengampu RPL SMKN 1 Rongga"</span>,</div>
              <div class="pl-4">konsentrasi: <span class="text-sky-300">"Rekayasa Perangkat Lunak"</span>,</div>
              <div class="pl-4">sistem: <span class="text-sky-300">"Serverless SSR & Gamifikasi XP"</span></div>
              <div><span class="text-amber-300">&#125;</span>;</div>
              <div class="pt-1 text-muted-foreground">// Poin Gamifikasi Siswa</div>
              <div><span class="text-purple-400">console</span>.log(<span class="text-teal-300">"Leveling Up Vocational Talent... 🚀"</span>);</div>
            </div>

            <!-- Mini Gamification Preview Box -->
            <div class="p-4 rounded-m3-md bg-[var(--md-sys-color-surface-container-low)] border border-[var(--md-sys-color-outline-variant)] space-y-2.5">
              <div class="flex items-center justify-between text-xs">
                <span class="font-mono text-muted-foreground">Progress Poin Belajar</span>
                <span class="font-mono text-amber-400 font-bold">Lvl 3 • Junior Craftsman</span>
              </div>
              <div class="w-full bg-[var(--md-sys-color-surface-container-lowest)] rounded-m3-full h-2 overflow-hidden border border-[var(--md-sys-color-outline-variant)]">
                <div class="bg-sky-500 h-2 rounded-m3-full w-[75%]"></div>
              </div>
              <div class="flex items-center justify-between text-[11px] text-muted-foreground font-mono">
                <span>350 / 500 XP</span>
                <span class="text-teal-400 font-semibold">+15 XP per modul</span>
              </div>
            </div>

            <!-- Entrance CTA -->
            <div class="pt-1">
              <a href="/login" class="m3-btn-outlined w-full text-center block text-xs font-bold py-2.5">
                🔑 Masuk Portal Siswa / Guru →
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- SECTION 2: 4 PILAR KOMPETENSI KEAHLIAN RPL -->
  <!-- ========================================== -->
  <section class="py-16 bg-[var(--md-sys-color-surface)] border-b border-[var(--md-sys-color-outline-variant)]">
    <div class="container-main space-y-10">
      
      <div class="text-center max-w-2xl mx-auto space-y-2.5">
        <span class="m3-chip text-xs font-mono font-semibold">
          KURIKULUM VOKASI UNGGULAN
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-foreground font-display tracking-tight">
          4 Pilar Kompetensi Rekayasa Perangkat Lunak
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
          Struktur materi komprehensif yang dirancang untuk membekali siswa RPL SMKN 1 Rongga dengan kemampuan teknis berstandar industri.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Pillar 1 -->
        <div class="m3-card p-6 rounded-m3-xl space-y-3.5 group">
          <div class="w-12 h-12 rounded-m3-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
            🧩
          </div>
          <h3 class="text-base font-bold text-foreground font-display group-hover:text-sky-400 transition-colors">
            Algoritma & Logika
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Pola pikir komputasional, penyusunan Flowchart visual, Pseudocode, dan pemecahan masalah algoritmis secara terstruktur.
          </p>
          <div class="pt-2 text-[11px] font-mono text-sky-400 font-semibold">
            Modul 01 - 08 Orientasi
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="m3-card p-6 rounded-m3-xl space-y-3.5 group">
          <div class="w-12 h-12 rounded-m3-lg bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
            🧱
          </div>
          <h3 class="text-base font-bold text-foreground font-display group-hover:text-teal-400 transition-colors">
            PBO & Basis Data
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Paradigma Object-Oriented Programming (Java/C++), Enkapsulasi, Polimorfisme, serta perancangan SQL & Normalisasi 1NF-3NF.
          </p>
          <div class="pt-2 text-[11px] font-mono text-teal-400 font-semibold">
            Drilling TKA P-2 & P-3
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="m3-card p-6 rounded-m3-xl space-y-3.5 group">
          <div class="w-12 h-12 rounded-m3-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
            🌐
          </div>
          <h3 class="text-base font-bold text-foreground font-display group-hover:text-indigo-400 transition-colors">
            Web & REST API
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Pengembangan frontend modern (HTML5, CSS Flex/Grid, JS ES6+) & backend RESTful API berbasis Node.js & Express.
          </p>
          <div class="pt-2 text-[11px] font-mono text-indigo-400 font-semibold">
            Drilling TKA P-5 & P-6
          </div>
        </div>

        <!-- Pillar 4 -->
        <div class="m3-card p-6 rounded-m3-xl space-y-3.5 group">
          <div class="w-12 h-12 rounded-m3-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
            🛡️
          </div>
          <h3 class="text-base font-bold text-foreground font-display group-hover:text-amber-400 transition-colors">
            Security & SDLC
          </h3>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Pengujian keamanan aplikasi (OWASP Top 10), kolaborasi tim via Git & Docker, serta metodologi Agile Scrum.
          </p>
          <div class="pt-2 text-[11px] font-mono text-amber-400 font-semibold">
            Drilling TKA P-8 - P-10
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- SECTION 3: GAMIFICATION ECOSYSTEM PREVIEW -->
  <!-- ========================================== -->
  <section class="py-14 bg-[var(--md-sys-color-surface-container-lowest)] border-b border-[var(--md-sys-color-outline-variant)]">
    <div class="container-main space-y-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[var(--md-sys-color-outline-variant)] pb-4">
        <div>
          <span class="m3-chip-primary text-[10px] font-mono font-bold uppercase">
            SISTEM GAMIFIKASI SISWA
          </span>
          <h2 class="text-xl sm:text-3xl font-extrabold text-foreground font-display mt-1">
            Ekosistem Belajar Berbasis XP & Lencana
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground mt-0.5">
            Raih Experience Points (XP) dan buka lencana pencapaian setiap kali menyelesaikan modul & simulasi TKA.
          </p>
        </div>
        <a href="/pembelajaran" class="m3-btn-outlined text-xs font-semibold px-4 py-2">
          Lihat Katalog Modul Belajar →
        </a>
      </div>

      <GamificationWidget />
    </div>
  </section>

  <!-- ========================================== -->
  <!-- SECTION 4: FEATURED MODULES & TKA SPOTLIGHT -->
  <!-- ========================================== -->
  <section class="py-16 bg-[var(--md-sys-color-surface)] border-b border-[var(--md-sys-color-outline-variant)]">
    <div class="container-main space-y-8">
      
      <!-- Module Grid Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="m3-chip text-[10px] font-mono font-semibold">
            KATALOG MODUL PEMBELAJARAN
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground font-display mt-1.5">
            Materi Orientasi & Drilling Keahlian
          </h2>
        </div>
        <a href="/pembelajaran" class="m3-btn-outlined text-xs font-semibold">
          Jelajahi Semua Modul →
        </a>
      </div>

      <!-- Modules List Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        
        {sortedModules.slice(0, 3).map((mod) => (
          <div class="m3-card p-6 flex flex-col justify-between space-y-4 rounded-m3-xl group">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="m3-chip-primary text-[10px] font-mono">
                  {mod.data.category}
                </span>
                <span class="text-xs text-muted-foreground font-mono">{mod.data.duration}</span>
              </div>
              <h3 class="text-base font-bold text-foreground font-display group-hover:text-sky-400 transition-colors">
                <a href={`/pembelajaran/${mod.id || mod.slug}`}>{mod.data.title}</a>
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">
                {mod.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-[var(--md-sys-color-outline-variant)] flex items-center justify-between text-xs">
              <span class="text-amber-400 font-mono font-bold">✨ +15 XP</span>
              <a href={`/pembelajaran/${mod.id || mod.slug}`} class="m3-btn-filled text-xs font-semibold px-4 py-1.5">
                Buka Modul →
              </a>
            </div>
          </div>
        ))}

        <!-- TKA Drilling Feature Spotlight Card -->
        <div class="m3-card-elevated p-6 bg-[var(--md-sys-color-surface-container)] flex flex-col justify-between space-y-4 rounded-m3-xl border-amber-500/30">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="m3-chip-warning text-[10px] font-mono font-bold uppercase">
                FITUR UNGGULAN KELAS 12
              </span>
              <span class="text-xs text-amber-400 font-mono font-bold">🎯 600 SOAL CBT</span>
            </div>
            <h3 class="text-lg font-bold text-foreground font-display">
              Drilling & Tryout TKA PPLG (10 Pertemuan)
            </h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Simulasi Ujian Tes Keahlian Akademik PPLG berbasis CBT dengan timer 60 menit, pengacakan opsi jawaban (A-E), serta pembahasan langsung khas Guru Pengampu RPL.
            </p>
          </div>

          <div class="pt-3 border-t border-[var(--md-sys-color-outline-variant)]">
            <a href="/pembelajaran/tka-pplg" class="m3-btn-filled w-full text-center block text-xs font-bold py-2.5">
              🎯 Mulai Simulasi Drilling TKA Sekarang →
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- SECTION 5: PROFILE EDUCATOR & ENGINEER -->
  <!-- ========================================== -->
  <section class="py-16 bg-[var(--md-sys-color-surface-container-lowest)] border-b border-[var(--md-sys-color-outline-variant)]">
    <div class="container-main">
      <div class="m3-card-elevated p-8 rounded-m3-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-8 space-y-4">
            <div class="m3-chip-primary text-xs font-mono font-semibold">
              👨‍🏫 GURU PENGAMPU RPL & SOFTWARE ENGINEER
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground font-display tracking-tight">
              Agung Gumelar Saputra, S.Tr.T.
            </h2>

            <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
              Sarjana Terapan Teknik (S.Tr.T.) dan Mahasiswa Magister (S2) Teknologi Pendidikan. Mengabdi sebagai <strong class="text-foreground">Guru Pengampu Rekayasa Perangkat Lunak (RPL) di SMKN 1 Rongga</strong> sekaligus berpraktik aktif sebagai Fullstack Software Engineer. Berkomitmen menghubungkan kurikulum pendidikan vokasi SMK dengan standar industri perangkat lunak modern.
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a href="/cv" class="m3-btn-outlined text-xs font-semibold px-4 py-2">
                📄 Lihat CV & Profil Guru
              </a>
              <a href="/projects" class="m3-btn-outlined text-xs font-semibold px-4 py-2">
                💻 Portfolio Proyek Software
              </a>
              <a href="/contact" class="m3-btn-outlined text-xs font-semibold px-4 py-2">
                ✉️ Hubungi / Diskusi
              </a>
            </div>
          </div>

          <div class="lg:col-span-4 flex justify-center">
            <div class="p-6 rounded-m3-xl bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)] text-center space-y-3 w-full max-w-xs shadow-sm">
              <div class="w-20 h-20 rounded-m3-full bg-sky-500/10 border border-sky-500/30 mx-auto flex items-center justify-center text-4xl shadow-sm">
                👨‍💻
              </div>
              <div>
                <div class="font-bold text-foreground text-sm font-display">SMKN 1 Rongga</div>
                <div class="text-[11px] text-muted-foreground font-mono mt-0.5">Kab. Bandung Barat, Jawa Barat</div>
              </div>
              <div class="m3-chip-primary text-[11px] font-mono font-bold w-full justify-center">
                PPLG • Rekayasa Perangkat Lunak
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- SECTION 6: BOTTOM ACTION CTA BANNER -->
  <!-- ========================================== -->
  <section class="py-14 bg-[var(--md-sys-color-surface)]">
    <div class="container-main">
      <div class="m3-card-elevated p-8 md:p-10 rounded-m3-2xl text-center space-y-6">
        <div class="max-w-2xl mx-auto space-y-3">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground font-display tracking-tight">
            Siap Memulai Petualangan Belajar Koding?
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            Akses modul materi Orientasi PPLG, ikuti simulasi CBT TKA PPLG, dan kumpulkan poin XP untuk meningkatkan level keahlianmu.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a href="/pembelajaran" class="m3-btn-filled text-xs sm:text-sm font-bold px-6 py-3 shadow-md">
            🚀 Masuk Portal Pembelajaran →
          </a>
          <a href="/admin" class="m3-btn-outlined text-xs sm:text-sm font-bold px-6 py-3">
            👑 Panel Guru & Administrasi
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
