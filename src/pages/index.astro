---
import BaseLayout from '../layouts/BaseLayout.astro';
import GamificationWidget from '../components/GamificationWidget.astro';
import { getCollection } from 'astro:content';

const allModules = await getCollection('pembelajaran');
const sortedModules = allModules.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout 
  title="Beranda" 
  description="Website resmi Agung Gumelar Saputra - Guru Rekayasa Perangkat Lunak SMKN 1 Rongga, S2 Teknologi Pendidikan, & Software Engineer."
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 overflow-hidden border-b border-border bg-secondary/30">
    <div class="container-main relative">
      <div class="max-w-3xl space-y-6">
        
        <!-- Role Badges -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-md bg-secondary border border-border text-foreground text-xs font-semibold">
            👨‍🏫 Guru RPL SMKN 1 Rongga
          </span>
          <span class="px-2.5 py-0.5 rounded-md bg-secondary border border-border text-foreground text-xs font-semibold">
            🎓 S2 Teknologi Pendidikan
          </span>
          <span class="px-2.5 py-0.5 rounded-md bg-secondary border border-border text-foreground text-xs font-semibold">
            💻 Software Engineer
          </span>
        </div>

        <!-- Hero Headline -->
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-foreground leading-[1.2]">
          Mencetak Talenta Vokasi IT & PPLG Unggulan
        </h1>

        <!-- Bio Paragraph -->
        <p class="text-base md:text-lg text-muted-foreground leading-relaxed">
          Selamat datang di portal edukasi interaktif <strong class="text-foreground">Agung Gumelar Saputra</strong>. Berbagi modul pembelajaran Rekayasa Perangkat Lunak (RPL), simulasi <strong class="text-foreground">Drilling TKA PPLG</strong>, jurnal teknologi pendidikan, dan etalase karya vokasi.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="/pembelajaran" class="btn btn-primary text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-lg shadow-sm">
            📚 Mulai Belajar & Gamifikasi
          </a>
          <a href="/pembelajaran/tka-pplg" class="btn btn-outline text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-lg border-border hover:bg-secondary">
            🎯 Drilling TKA PPLG
          </a>
        </div>

        <!-- Quick Stats Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 pt-6 border-t border-border">
          <div class="p-3.5 rounded-lg bg-card border border-border">
            <div class="text-xl font-bold text-foreground font-mono">PPLG</div>
            <div class="text-xs text-muted-foreground mt-0.5">Kurikulum Merdeka SMK</div>
          </div>
          <div class="p-3.5 rounded-lg bg-card border border-border">
            <div class="text-xl font-bold text-foreground font-mono">TKA</div>
            <div class="text-xs text-muted-foreground mt-0.5">CBT Simulator Ujian</div>
          </div>
          <div class="p-3.5 rounded-lg bg-card border border-border col-span-2 sm:col-span-1">
            <div class="text-xl font-bold text-foreground font-mono">EdTech</div>
            <div class="text-xs text-muted-foreground mt-0.5">Gamified Learning</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Gamification Widget Preview Section -->
  <section class="py-12 bg-background border-b border-border">
    <div class="container-main space-y-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-foreground">Kemajuan & Gamifikasi Siswa</h2>
          <p class="text-xs sm:text-sm text-muted-foreground">Kumpulkan XP dan raih Lencana Prestasi setiap kali membaca modul & mengerjakan kuis.</p>
        </div>
        <a href="/pembelajaran" class="text-xs font-semibold text-primary hover:underline">Lihat Semua Modul Belajar →</a>
      </div>

      <GamificationWidget />
    </div>
  </section>

  <!-- Featured Modules & Drilling Spotlight -->
  <section class="py-14 bg-secondary/20">
    <div class="container-main space-y-8">
      
      <!-- Module Grid Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="px-2 py-0.5 rounded text-[10px] bg-secondary text-foreground font-mono font-semibold border border-border">MODUL TERPOPULER</span>
          <h2 class="text-2xl font-bold text-foreground mt-1.5">Materi Pembelajaran PPLG</h2>
        </div>
        <a href="/pembelajaran" class="btn btn-outline btn-sm rounded-lg text-xs">Jelajahi Semua Modul →</a>
      </div>

      <!-- Modules List Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {sortedModules.map((mod) => (
          <div class="card p-5 border-border bg-card transition-colors flex flex-col justify-between space-y-3 rounded-xl shadow-sm hover:border-primary/50">
            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="px-2 py-0.5 rounded text-[10px] bg-secondary text-foreground font-mono font-semibold border border-border">
                  {mod.data.category}
                </span>
                <span class="text-xs text-muted-foreground font-mono">{mod.data.duration}</span>
              </div>
              <h3 class="text-base font-bold text-foreground hover:text-primary transition-colors">
                <a href={`/pembelajaran/${mod.id || mod.slug}`}>{mod.data.title}</a>
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">
                {mod.data.description}
              </p>
            </div>

            <div class="pt-3 border-t border-border flex items-center justify-between text-xs">
              <span class="text-amber-600 dark:text-amber-400 font-medium font-mono">✨ +10 XP</span>
              <a href={`/pembelajaran/${mod.id || mod.slug}`} class="btn btn-primary btn-sm text-xs font-semibold px-3 py-1.5 rounded-lg">
                Baca Modul →
              </a>
            </div>
          </div>
        ))}

        <!-- TKA Drilling Feature Spotlight Card -->
        <div class="card p-5 border-border bg-secondary/50 flex flex-col justify-between space-y-3 rounded-xl shadow-sm">
          <div class="space-y-2.5">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] bg-secondary text-foreground font-mono font-semibold border border-border">FITUR UNGGULAN</span>
              <span class="text-xs text-amber-600 dark:text-amber-400 font-mono font-bold">+100 XP</span>
            </div>
            <h3 class="text-base font-bold text-foreground">Drilling & Tryout TKA PPLG</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Persiapkan Ujian Tes Keahlian Akademik PPLG dengan simulasi CBT interaktif berbasis kisi-kisi resmi Kemendikdasmen. Dilengkapi timer & pembahasan soal dari Pak Agung!
            </p>
          </div>

          <div class="pt-3 border-t border-border">
            <a href="/pembelajaran/tka-pplg" class="btn btn-primary w-full text-xs font-semibold py-2.5 rounded-lg">
              🎯 Mulai Simulasi TKA Sekarang
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
