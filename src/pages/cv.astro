---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Curriculum Vitae (CV)" 
  description="Riwayat hidup, pengalaman mengajar di SMKN 1 Rongga, pendidikan S2 Teknologi Pendidikan, dan keahlian teknik Agung Gumelar Saputra."
>
  <section class="py-12 bg-gradient-to-b from-blue-950/20 to-background border-b border-border/40">
    <div class="container-main space-y-4">
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold">
          📄 Curriculum Vitae
        </span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-foreground tracking-tight">
        Agung Gumelar Saputra
      </h1>

      <p class="text-base md:text-lg text-muted-foreground max-w-2xl leading-relaxed">
        Guru Rekayasa Perangkat Lunak (RPL) di **SMKN 1 Rongga**, Mahasiswa S2 Teknologi Pendidikan & Vokasi, serta Software Developer.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container-main max-w-4xl space-y-10">
      
      <!-- Experience Section -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-foreground flex items-center gap-2 border-b border-border/40 pb-3">
          <span>💼 Pengalaman Kerja & Mengajar</span>
        </h2>

        <div class="space-y-6">
          <div class="p-6 rounded-xl bg-card border border-border/60 space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between">
              <h3 class="text-lg font-bold text-foreground">Guru Rekayasa Perangkat Lunak (RPL)</h3>
              <span class="text-xs text-blue-400 font-mono font-semibold">SMKN 1 Rongga</span>
            </div>
            <p class="text-xs text-muted-foreground">Mengampu mata pelajaran Pemrograman Web & Bergerak, Dasar-dasar RPL, Basis Data, dan Bimbingan Ujian TKA RPL.</p>
          </div>

          <div class="p-6 rounded-xl bg-card border border-border/60 space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between">
              <h3 class="text-lg font-bold text-foreground">Software Engineer & EdTech Developer</h3>
              <span class="text-xs text-cyan-400 font-mono font-semibold">Freelance / Project</span>
            </div>
            <p class="text-xs text-muted-foreground">Mengembangkan aplikasi berbasis web modern (Astro, React, Node.js) dan media pembelajaran digital vokasi.</p>
          </div>
        </div>
      </div>

      <!-- Education Section -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-foreground flex items-center gap-2 border-b border-border/40 pb-3">
          <span>🎓 Riwayat Pendidikan</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-6 rounded-xl bg-card border border-border/60 space-y-2">
            <span class="text-xs text-emerald-400 font-mono">S2 Magister (Dalam Proses)</span>
            <h3 class="text-base font-bold text-foreground">Teknologi Pendidikan & Vokasi</h3>
            <p class="text-xs text-muted-foreground">Fokus riset pengembangan media pembelajaran interaktif & EdTech untuk pendidikan vokasi kejuruan IT.</p>
          </div>

          <div class="p-6 rounded-xl bg-card border border-border/60 space-y-2">
            <span class="text-xs text-blue-400 font-mono">S1 Sarjana Pendidikan</span>
            <h3 class="text-base font-bold text-foreground">Pendidikan Komputer / IT</h3>
            <p class="text-xs text-muted-foreground">Penguasaan dasar-dasar ilmu komputer, pedagogi kejuruan, dan rekayasa perangkat lunak.</p>
          </div>
        </div>
      </div>

      <!-- Tech Stack & Skills -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-foreground flex items-center gap-2 border-b border-border/40 pb-3">
          <span>⚙️ Keahlian & Tech Stack</span>
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
          <div class="p-3 rounded-lg bg-card border border-border text-center">Astro v5</div>
          <div class="p-3 rounded-lg bg-card border border-border text-center">TailwindCSS</div>
          <div class="p-3 rounded-lg bg-card border border-border text-center">JavaScript / TS</div>
          <div class="p-3 rounded-lg bg-card border border-border text-center">HTML5 / CSS3</div>
          <div class="p-3 rounded-lg bg-card border border-border text-center">Node.js / Express</div>
          <div class="p-3 rounded-lg bg-card border border-border text-center">MySQL / SQL</div>
          <div class="p-3 rounded-lg bg-card border border-border text-center">Git & GitHub</div>
          <div class="p-3 rounded-lg bg-card border border-border text-center">Vercel SSG</div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
