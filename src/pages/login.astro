---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Masuk Siswa" description="Halaman Login Portal Learning Hub PPLG SMKN 1 Rongga">
  <div class="min-h-[80vh] flex items-center justify-center py-12 px-4 bg-[var(--md-sys-color-surface)]">
    <div class="m3-card-elevated w-full max-w-md p-6 sm:p-8 rounded-m3-2xl space-y-6 shadow-md">
      <div class="text-center space-y-3 flex flex-col items-center">
        <div class="w-14 h-14 rounded-m3-lg overflow-hidden bg-[#090d16] border border-white/15 flex items-center justify-center p-1 shadow-md">
          <img src="/logo-ags.png" alt="Logo AGS" class="w-full h-full object-contain rounded-m3-md" />
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground font-display tracking-tight">Selamat Datang 👋</h1>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1">Masuk untuk mengakses Student Learning Hub & Gamifikasi PPLG</p>
        </div>
      </div>

      <div id="error-alert" class="hidden p-3 rounded-m3-md bg-rose-500/10 border border-rose-500/25 text-rose-400 text-xs text-center font-medium"></div>

      <!-- Google OAuth Button (M3 Outlined Button) -->
      <a href="/api/auth/google" class="m3-btn-outlined w-full flex items-center justify-center gap-2.5 py-2.5 font-bold text-xs sm:text-sm shadow-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
        <span>Masuk dengan Google</span>
      </a>

      <div class="flex items-center my-4">
        <div class="flex-grow border-t border-[var(--md-sys-color-outline-variant)]"></div>
        <span class="px-3 text-[10px] text-muted-foreground uppercase font-mono font-bold">atau email</span>
        <div class="flex-grow border-t border-[var(--md-sys-color-outline-variant)]"></div>
      </div>

      <!-- Email Password Form -->
      <form id="login-form" class="space-y-4 text-xs">
        <div class="space-y-1.5">
          <label class="block font-semibold text-foreground">Email Siswa</label>
          <input type="email" id="email" required class="input rounded-m3-md font-sans" placeholder="siswa@smkn1rongga.sch.id" />
        </div>
        <div class="space-y-1.5">
          <label class="block font-semibold text-foreground">Password</label>
          <input type="password" id="password" required class="input rounded-m3-md font-sans" placeholder="••••••••" />
        </div>
        <button type="submit" class="m3-btn-filled w-full py-3 font-bold text-xs sm:text-sm shadow-md">
          Masuk Portal Siswa ➔
        </button>
      </form>

      <p class="text-center text-xs text-muted-foreground">
        Belum punya akun? <a href="/register" class="text-sky-400 font-bold hover:underline">Daftar Akun Baru</a>
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById('login-form');
    const alert = document.getElementById('error-alert');

    // Check if redirected after account deletion
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('deleted') === '1' && alert) {
      alert.className = 'p-3 rounded-lg bg-amber-500/10 border border-amber-500/25 text-amber-600 dark:text-amber-400 text-xs text-center font-medium block shadow-sm';
      alert.textContent = '✓ Akun Anda telah berhasil dihapus secara permanen.';
      alert.classList.remove('hidden');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      alert?.classList.add('hidden');
      
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          const urlParams = new URLSearchParams(window.location.search);
          const redirectUrl = urlParams.get('redirect');
          if (redirectUrl) {
            window.location.href = redirectUrl;
          } else if (data.user && (data.user.role === 'teacher' || data.user.role === 'admin' || data.user.role === 'superadmin')) {
            window.location.href = '/admin';
          } else {
            window.location.href = '/dashboard';
          }
        } else {
          if (alert) {
            alert.className = 'p-3 rounded-lg bg-destructive/10 border border-destructive/25 text-destructive text-xs text-center font-medium block';
            alert.textContent = data.error || 'Gagal masuk.';
            alert.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (alert) {
          alert.className = 'p-3 rounded-lg bg-destructive/10 border border-destructive/25 text-destructive text-xs text-center font-medium block';
          alert.textContent = 'Koneksi bermasalah.';
          alert.classList.remove('hidden');
        }
      }
    });
  </script>
</BaseLayout>
