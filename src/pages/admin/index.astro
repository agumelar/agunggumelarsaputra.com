                        <div class="text-[10px] text-muted-foreground font-mono flex items-center gap-1.5">
                          <span>{sub.userEmail}</span>
                          {sub.studentClass && (
                            <>
                              <span>•</span>
                              <span class="px-1.5 py-0.2 rounded bg-secondary text-foreground border border-border font-semibold">
                                {sub.studentClass}
                              </span>
                            </>
                          )}
                        </div>
                      </div>
                    </td>

                    <td class="py-3 px-3">
                      <div class="space-y-1">
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-pink-500/10 text-pink-600 dark:text-pink-400 border border-pink-500/20 uppercase">
                          Refleksi
