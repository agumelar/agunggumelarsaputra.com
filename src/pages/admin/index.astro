            </span>
          </div>

          <a 
            href="/api/admin/reflections/export-excel"
            class="px-3 py-1.5 rounded-lg bg-pink-600 hover:bg-pink-500 text-white font-medium text-xs transition-colors flex items-center gap-1.5 shadow-sm"
