                  <th class="py-2.5 px-3">Nilai Skor</th>
                  <th class="py-2.5 px-3">Jawaban Benar</th>
                  <th class="py-2.5 px-3">Waktu Selesai</th>
                </tr>
              </thead>
              <tbody id="report-students-tbody" class="divide-y divide-border/40 font-medium">
                <tr>
                  <td colspan="7" class="text-center py-6 text-muted-foreground">Memuat data...</td>
                </tr>
