      </div>

      <!-- Filter Controls for Reflections -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="relative">
          <input 
            type="text" 
            id="reflection-search-input" 
            placeholder="Cari nama siswa / email / modul refleksi..." 
