              </tr>
            </thead>
            <tbody class="divide-y divide-border font-medium bg-card">
              {reflectionSubmissions.map((sub: any) => {
                const isReviewed = sub.status === 'reviewed' || !!sub.teacherFeedback;
                const dateFormatted = new Date(sub.submittedAt).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                });

                // Parse reflection snippets safely
                let parsedFd: any = {};
                try {
                  let d = sub.formData;
                  while (typeof d === 'string') d = JSON.parse(d);
                  parsedFd = typeof d === 'object' && d !== null ? d : {};
                } catch { parsedFd = {}; }

                const q1Text = parsedFd.q1 || '';
                const q3Text = parsedFd.q3 || '';
                const q4Text = parsedFd.q4 || '';
                const previewSnippet = q4Text || q1Text || q3Text || 'Jurnal refleksi telah diisi.';

