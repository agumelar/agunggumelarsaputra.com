---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { db, ensureDbInitialized } from '../../db';
import { users, userGamification, tkaAttempts, userProgress, enrollmentTokens, userEnrollments } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

import { canAccessAdminPanel, isSuperAdmin, isSuperAdminEmail } from '../../utils/auth';

await ensureDbInitialized();

const user = Astro.locals.user;
if (!user || !canAccessAdminPanel(user.role)) {
  return Astro.redirect('/dashboard?error=unauthorized_admin');
}

const isCurrentSuperAdmin = isSuperAdmin(user.role) || isSuperAdminEmail(user.email);

// Ensure Super Admin email has superadmin role in DB
if (isCurrentSuperAdmin && user.email && isSuperAdminEmail(user.email)) {
  await db.update(users).set({ role: 'superadmin' }).where(eq(users.email, user.email.trim().toLowerCase()));
}

// 1. Fetch All Users + Gamification Info
const allUsers = await db.select({
  id: users.id,
  name: users.name,
  email: users.email,
  role: users.role,
  studentClass: users.studentClass,
  avatarUrl: users.avatarUrl,
  createdAt: users.createdAt,
  xp: userGamification.xp,
  level: userGamification.level,
  streakDays: userGamification.streakDays,
}).from(users)
  .leftJoin(userGamification, eq(users.id, userGamification.userId))
  .orderBy(desc(users.createdAt));

// 2. Fetch All Exam Attempts + User Info
const allExamLogs = await db.select({
  id: tkaAttempts.id,
  userId: tkaAttempts.userId,
  tokenId: tkaAttempts.tokenId,
  userName: users.name,
  userEmail: users.email,
  studentClass: users.studentClass,
  score: tkaAttempts.score,
  totalQuestions: tkaAttempts.totalQuestions,
  correctAnswers: tkaAttempts.correctAnswers,
  xpEarned: tkaAttempts.xpEarned,
  createdAt: tkaAttempts.createdAt,
}).from(tkaAttempts)
  .innerJoin(users, eq(tkaAttempts.userId, users.id))
  .orderBy(desc(tkaAttempts.createdAt));

// 3. Fetch All Lesson Progress + User Info
const allLessonLogs = await db.select({
  id: userProgress.id,
  userId: userProgress.userId,
  tokenId: userProgress.tokenId,
  userName: users.name,
  userEmail: users.email,
  studentClass: users.studentClass,
  lessonSlug: userProgress.lessonSlug,
  completedAt: userProgress.completedAt,
}).from(userProgress)
  .innerJoin(users, eq(userProgress.userId, users.id))
  .orderBy(desc(userProgress.completedAt));

// 4. Fetch All Enrollment Tokens
const allTokens = await db.select({
  id: enrollmentTokens.id,
  token: enrollmentTokens.token,
  title: enrollmentTokens.title,
  description: enrollmentTokens.description,
  targetType: enrollmentTokens.targetType,
  targetSlug: enrollmentTokens.targetSlug,
  targetClass: enrollmentTokens.targetClass,
  isActive: enrollmentTokens.isActive,
  createdAt: enrollmentTokens.createdAt,
  expiresAt: enrollmentTokens.expiresAt,
  creatorName: users.name,
}).from(enrollmentTokens)
  .leftJoin(users, eq(enrollmentTokens.createdBy, users.id))
  .orderBy(desc(enrollmentTokens.createdAt));

// 5. Fetch Enrollment counts
const allEnrollments = await db.select({
  id: userEnrollments.id,
  tokenId: userEnrollments.tokenId,
  userId: userEnrollments.userId,
}).from(userEnrollments);

const enrollmentCountMap: Record<number, number> = {};
for (const e of allEnrollments) {
  enrollmentCountMap[e.tokenId] = (enrollmentCountMap[e.tokenId] || 0) + 1;
}

const examCountMap: Record<number, number> = {};
for (const ex of allExamLogs) {
  if (ex.tokenId) {
    examCountMap[ex.tokenId] = (examCountMap[ex.tokenId] || 0) + 1;
  }
}

// 6. Metrics Calculations
const totalStudents = allUsers.filter(u => u.role === 'student' && !isSuperAdminEmail(u.email)).length;
const totalTeachers = allUsers.filter(u => (u.role === 'teacher' || u.role === 'admin') && !isSuperAdminEmail(u.email)).length;
const totalSuperAdmins = allUsers.filter(u => u.role === 'superadmin' || isSuperAdminEmail(u.email)).length;
const totalExamsTaken = allExamLogs.length;
const avgScoreAll = totalExamsTaken > 0
  ? Math.round(allExamLogs.reduce((acc, curr) => acc + curr.score, 0) / totalExamsTaken)
  : 0;
const passingExams = allExamLogs.filter(e => e.score >= 75).length;
const passRate = totalExamsTaken > 0 ? Math.round((passingExams / totalExamsTaken) * 100) : 0;
---

<DashboardLayout title="Panel Guru & Administrator" activeNav="/admin">
  <div class="space-y-8">
    
    <!-- Admin Hero Banner -->
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-amber-950/40 via-amber-900/20 to-card border border-amber-500/30 flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-xl">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-300 text-xs font-mono font-bold">
          <span>👑 Administrator Management Console</span>
          <span>•</span>
          <span>Guru Pengampu PPLG</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight">
          Panel Manajemen Guru & Monitoring Siswa
        </h1>
        <p class="text-xs sm:text-sm text-muted-foreground max-w-xl">
          Kelola token sesi pembelajaran (Roll Token), pantau partisipasi siswa per-token, kelola perizinan hak akses, dan evaluasi hasil nilai ujian Drilling TKA secara real-time.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a href="#tokens" class="btn btn-sm bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold shadow-lg shadow-cyan-600/20">
          🎟️ Token Sesi ({allTokens.length})
        </a>
        <a href="#students" class="btn btn-sm bg-amber-500 hover:bg-amber-400 text-black font-bold">
          👥 Data Siswa ({allUsers.length})
        </a>
        <a href="#exams" class="btn btn-sm btn-outline border-amber-500/40 text-amber-300 hover:bg-amber-500/10 font-semibold">
          📈 Log Ujian ({totalExamsTaken})
        </a>
      </div>
    </div>

    <!-- 4 KPI Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- Metric 1: Siswa & Guru -->
      <div class="card p-6 rounded-2xl border-border/60 bg-card/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Total Pengguna</span>
          <span class="text-lg">👥</span>
        </div>
        <div class="text-3xl font-extrabold text-foreground font-mono">
          {totalStudents} <span class="text-xs text-muted-foreground font-sans font-normal">Siswa</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] font-mono text-muted-foreground pt-1">
          <span class="text-amber-400 font-bold">{totalTeachers} Guru</span>
          <span>•</span>
          <span class="text-purple-400 font-bold">{totalSuperAdmins} Super Admin</span>
        </div>
      </div>

      <!-- Metric 2: Sesi Token Aktif -->
      <div class="card p-6 rounded-2xl border-border/60 bg-card/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Token Sesi Kelas</span>
          <span class="text-lg">🎟️</span>
        </div>
        <div class="text-3xl font-extrabold text-cyan-400 font-mono">
          {allTokens.filter(t => t.isActive).length} <span class="text-xs text-muted-foreground font-sans font-normal">Aktif</span>
        </div>
        <p class="text-[11px] text-muted-foreground">Total {allTokens.length} sesi terdaftar</p>
      </div>

      <!-- Metric 3: Rata-Rata Nilai -->
      <div class="card p-6 rounded-2xl border-border/60 bg-card/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Rata-Rata Nilai TKA</span>
          <span class="text-lg">📊</span>
        </div>
        <div class="text-3xl font-extrabold text-amber-400 font-mono">
          {avgScoreAll} <span class="text-xs text-muted-foreground font-sans font-normal">/ 100</span>
        </div>
        <p class="text-[11px] text-muted-foreground">Tingkat Kelulusan: <span class="text-emerald-400 font-bold">{passRate}%</span></p>
      </div>

      <!-- Metric 4: Modul Diselesaikan -->
      <div class="card p-6 rounded-2xl border-border/60 bg-card/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Modul Diselesaikan</span>
          <span class="text-lg">📚</span>
        </div>
        <div class="text-3xl font-extrabold text-emerald-400 font-mono">
          {allLessonLogs.length} <span class="text-xs text-muted-foreground font-sans font-normal">Kali</span>
        </div>
        <p class="text-[11px] text-muted-foreground">Aktivitas Belajar Mandiri</p>
      </div>

    </div>

    <!-- Alert Notification -->
    <div id="admin-alert" class="hidden p-4 rounded-xl text-xs font-medium text-center transition-all"></div>

    <!-- ========================================== -->
    <!-- SECTION 0: MANAJEMEN TOKEN SESI (ROLL & REKAP PER-TOKEN) -->
    <!-- ========================================== -->
    <div id="tokens" class="card p-6 sm:p-8 rounded-3xl border-cyan-500/40 bg-card/90 space-y-8 shadow-xl relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Header & Create Token Form -->
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/40 pb-4">
          <div>
            <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
              <span>🎟️ Manajemen Token Sesi Belajar & Ujian (Roll Token)</span>
              <span class="text-[10px] px-2.5 py-0.5 rounded-full font-mono bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">
                PENGUMPULAN DATA PER-TOKEN
              </span>
            </h2>
            <p class="text-xs text-muted-foreground mt-1">
              Buat (Roll) Token baru untuk sesi kelas tertentu. Siswa wajib melakukan <b>Enroll Token</b> agar data pengerjaan ujian dan modul tercatat rapi per-sesi.
            </p>
          </div>

          <button 
            type="button" 
            id="toggle-create-token-btn"
            class="px-4 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs shadow-lg shadow-cyan-600/20 transition-all flex items-center gap-2 flex-shrink-0"
          >
            <span>+ Buat (Roll) Token Baru</span>
          </button>
        </div>

        <!-- Form Pembuatan Token Baru (Collapsible) -->
        <div id="create-token-card" class="hidden p-6 rounded-2xl bg-cyan-950/20 border border-cyan-500/30 space-y-5 animate-fadeIn">
          <div class="flex items-center justify-between border-b border-cyan-500/20 pb-3">
            <h3 class="text-sm font-bold text-cyan-300 flex items-center gap-2">
              <span>🎲 Formulir Penerbitan Token Sesi Baru</span>
            </h3>
            <span class="text-[10px] text-muted-foreground">Oleh: {user.name}</span>
          </div>

          <form id="create-token-form" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              
              <!-- Judul Sesi -->
              <div class="md:col-span-2 space-y-1">
                <label class="block font-medium text-foreground">Judul / Nama Sesi Belajar <span class="text-red-400">*</span></label>
                <input 
                  type="text" 
                  id="token-title" 
                  required 
                  placeholder="Contoh: Tryout TKA PPLG Sesi 1 - 10 RPL 1" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-xs focus:outline-none focus:border-cyan-500"
                />
              </div>

              <!-- Target Kelas -->
              <div class="space-y-1">
                <label class="block font-medium text-foreground">Target Kelas / Rombel</label>
                <select 
                  id="token-target-class" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-xs focus:outline-none focus:border-cyan-500"
                >
                  <option value="Semua Kelas">Semua Kelas (Umum)</option>
                  <optgroup label="Kelas 10 RPL">
                    <option value="10 RPL 1">10 RPL 1</option>
                    <option value="10 RPL 2">10 RPL 2</option>
                    <option value="10 RPL 3">10 RPL 3</option>
                    <option value="10 RPL 4">10 RPL 4</option>
                  </optgroup>
                  <optgroup label="Kelas 11 RPL">
                    <option value="11 RPL 1">11 RPL 1</option>
                    <option value="11 RPL 2">11 RPL 2</option>
                    <option value="11 RPL 3">11 RPL 3</option>
                    <option value="11 RPL 4">11 RPL 4</option>
                  </optgroup>
                  <optgroup label="Kelas 12 RPL">
                    <option value="12 RPL 1">12 RPL 1</option>
                    <option value="12 RPL 2">12 RPL 2</option>
                    <option value="12 RPL 3">12 RPL 3</option>
                    <option value="12 RPL 4">12 RPL 4</option>
                  </optgroup>
                </select>
              </div>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              <!-- Tipe Sesi -->
              <div class="space-y-1">
                <label class="block font-medium text-foreground">Tipe Target Sesi</label>
                <select 
                  id="token-target-type" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-xs focus:outline-none focus:border-cyan-500"
                >
                  <option value="tka">🎯 Drilling TKA Simulator (Ujian CBT)</option>
                  <option value="all">📚 Semua Modul & Tryout (Global)</option>
                  <option value="module">📖 Modul Pembelajaran Tertentu</option>
                </select>
              </div>

              <!-- Kode Token Kustom (Opsional) -->
              <div class="space-y-1">
                <label class="block font-medium text-foreground">
                  Kode Token Kustom (Opsional - Kosongkan jika ingin auto-generate)
                </label>
                <input 
                  type="text" 
                  id="token-custom-code" 
                  placeholder="Contoh: RPL1-TKA8 (Auto-generate jika kosong)" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-xs font-mono uppercase focus:outline-none focus:border-cyan-500"
                />
              </div>

            </div>

            <!-- Deskripsi / Petunjuk untuk Siswa -->
            <div class="space-y-1">
              <label class="block font-medium text-foreground">Catatan / Petunjuk untuk Siswa (Opsional)</label>
              <input 
                type="text" 
                id="token-description" 
                placeholder="Contoh: Harap dikerjakan mandiri dalam waktu 30 menit." 
                class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground text-xs focus:outline-none focus:border-cyan-500"
              />
            </div>

            <div class="pt-2 flex items-center justify-end gap-3">
              <button 
                type="button" 
                id="cancel-create-token-btn"
                class="px-4 py-2.5 rounded-xl bg-accent hover:bg-accent/80 text-foreground font-semibold"
              >
                Batal
              </button>
              <button 
                type="submit" 
                id="submit-token-btn"
                class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold shadow-lg shadow-cyan-600/30 flex items-center gap-2"
              >
                <span id="token-btn-text">🎲 Terbitkan Token Sesi</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Tabel Daftar Token Sesi -->
        {allTokens.length === 0 ? (
          <div class="p-8 text-center text-xs text-muted-foreground bg-accent/20 rounded-2xl border border-dashed border-border/80">
            Belum ada Token Sesi yang dibuat. Klik tombol <b>"+ Buat (Roll) Token Baru"</b> untuk membuat token sesi kelas pertama Anda.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="text-[11px] text-muted-foreground uppercase font-mono border-b border-border/60">
                <tr>
                  <th class="py-3 px-4">Kode Token</th>
                  <th class="py-3 px-4">Nama Sesi & Tipe</th>
                  <th class="py-3 px-4">Target Kelas</th>
                  <th class="py-3 px-4">Siswa Enroll</th>
                  <th class="py-3 px-4">Ujian Selesai</th>
                  <th class="py-3 px-4">Status Sesi</th>
                  <th class="py-3 px-4 text-right">Aksi & Rekap Data</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/40 font-medium">
                {allTokens.map((t) => {
                  const enrolledCount = enrollmentCountMap[t.id] || 0;
                  const examCount = examCountMap[t.id] || 0;
                  const createdDate = new Date(t.createdAt).toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  });

                  return (
                    <tr class="hover:bg-accent/40 transition-colors">
                      <!-- Token Code with Copy Button -->
                      <td class="py-3.5 px-4 font-mono">
                        <div class="flex items-center gap-2">
                          <span class="px-2.5 py-1 rounded-lg font-mono font-extrabold text-xs bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 tracking-wider">
                            {t.token}
                          </span>
                          <button 
                            type="button" 
                            data-copy-token={t.token}
                            class="copy-token-btn p-1.5 rounded-lg text-muted-foreground hover:text-cyan-400 hover:bg-cyan-500/10 transition-colors"
                            title="Salin Kode Token"
                          >
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                          </button>
                        </div>
                      </td>

                      <!-- Judul Sesi -->
                      <td class="py-3.5 px-4">
                        <span class="font-bold text-foreground block">{t.title}</span>
                        <div class="flex items-center gap-2 text-[10px] text-muted-foreground mt-0.5">
                          <span class="font-mono text-cyan-400">
                            {t.targetType === 'tka' ? '🎯 Ujian TKA' : t.targetType === 'module' ? '📖 Modul Materi' : '📚 Global Hub'}
                          </span>
                          <span>•</span>
                          <span>{createdDate}</span>
                        </div>
                      </td>

                      <!-- Target Kelas -->
                      <td class="py-3.5 px-4 font-mono">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30">
                          {t.targetClass}
                        </span>
                      </td>

                      <!-- Siswa Enroll -->
                      <td class="py-3.5 px-4 font-mono font-bold text-foreground">
                        <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-400 text-xs">
                          👥 {enrolledCount} Siswa
                        </span>
                      </td>

                      <!-- Ujian Selesai -->
                      <td class="py-3.5 px-4 font-mono font-bold text-emerald-400">
                        {examCount} Selesai
                      </td>

                      <!-- Toggle Status -->
                      <td class="py-3.5 px-4">
                        <button 
                          type="button"
                          data-token-id={t.id}
                          data-token-active={t.isActive ? 'true' : 'false'}
                          class="toggle-token-status-btn px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase transition-all"
                          class:list={[
                            t.isActive 
                              ? "bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-500/30" 
                              : "bg-red-500/20 text-red-300 border border-red-500/40 hover:bg-red-500/30"
                          ]}
                          title="Klik untuk mengubah status sesi"
                        >
                          {t.isActive ? '● SESI AKTIF' : '○ NONAKTIF'}
                        </button>
                      </td>

                      <!-- Actions -->
                      <td class="py-3.5 px-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                          <button 
                            type="button"
                            data-view-report-token-id={t.id}
                            data-token-code={t.token}
                            data-token-title={t.title}
                            class="view-report-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-cyan-600 hover:bg-cyan-500 text-white shadow-md shadow-cyan-600/20 transition-all flex items-center gap-1.5"
                          >
                            <span>📊 Rekap Nilai</span>
                          </button>

                          <button 
                            type="button"
                            data-delete-token-id={t.id}
                            data-token-title={t.title}
                            data-token-code={t.token}
                            class="delete-token-btn p-1.5 rounded-xl text-muted-foreground hover:text-red-400 hover:bg-red-500/10 border border-border/40 hover:border-red-500/30 transition-all"
                            title="Hapus Token Sesi"
                          >
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </div>
                      </td>

                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}

      </div>
    </div>

    <!-- ========================================== -->
    <!-- SECTION 1: MANAJEMEN DATA PENGGUNA & ROLE SISWA -->
    <!-- ========================================== -->
    <div id="students" class="card p-6 sm:p-8 rounded-3xl border-border/60 bg-card/90 space-y-6 shadow-md">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/40 pb-4">
        <div>
          <h2 class="text-lg font-bold text-foreground flex items-center gap-2">
            <span>👥 Data Pengguna & Otoritas Hak Akses</span>
            {isCurrentSuperAdmin ? (
              <span class="text-[10px] px-2.5 py-0.5 rounded-full font-mono bg-purple-500/20 text-purple-300 border border-purple-500/40">
                👑 KONTROL SUPER ADMIN AKTIF
              </span>
            ) : (
              <span class="text-[10px] px-2.5 py-0.5 rounded-full font-mono bg-amber-500/20 text-amber-300 border border-amber-500/40">
                👨‍🏫 MODE PANTAU GURU
              </span>
            )}
          </h2>
          <p class="text-xs text-muted-foreground">
            {isCurrentSuperAdmin 
              ? "Sebagai Super Admin, Anda memiliki hak penuh untuk menetapkan pengguna menjadi Guru Pengampu atau mengembalikannya menjadi Siswa."
              : "Daftar seluruh siswa dan pengampu. Hak penambahan Guru dikelola terpusat oleh Super Admin."}
          </p>
        </div>
        
        <!-- Search filter input -->
        <div class="relative max-w-xs w-full">
          <input 
            type="text" 
            id="user-search-input" 
            placeholder="Cari nama / email siswa..." 
            class="w-full px-3.5 py-2 rounded-xl bg-background border border-border text-xs text-foreground focus:outline-none focus:border-amber-500"
          />
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs" id="users-table">
          <thead class="text-[11px] text-muted-foreground uppercase font-mono border-b border-border/60">
            <tr>
              <th class="py-3 px-4">Pengguna</th>
              <th class="py-3 px-4">Kelas / Rombel</th>
              <th class="py-3 px-4">Email</th>
              <th class="py-3 px-4">Role Hak Akses</th>
              <th class="py-3 px-4">Level & XP</th>
              <th class="py-3 px-4">Tgl Registrasi</th>
              <th class="py-3 px-4 text-right">Otoritas Peran</th>
