  <!-- ========================================== -->
  <!-- MODAL REKAPITULASI DATA PER-TOKEN -->
  <!-- ========================================== -->
  <div id="report-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="bg-card border border-cyan-500/40 rounded-3xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-fadeIn">
      
      <!-- Modal Header -->
      <div class="p-6 border-b border-border/60 flex items-center justify-between bg-cyan-950/20">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 text-xs font-mono font-bold" id="report-modal-token-code">
              TOKEN-CODE
            </span>
            <span class="text-xs text-muted-foreground" id="report-modal-target-class">10 RPL 1</span>
          </div>
          <h3 class="text-lg font-extrabold text-foreground" id="report-modal-title">
            Rekapitulasi Sesi Belajar
          </h3>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="print-report-btn"
            class="px-3.5 py-2 rounded-xl bg-accent hover:bg-accent/80 text-foreground font-semibold text-xs border border-border/60 transition-colors flex items-center gap-1.5"
          >
            <span>🖨️ Cetak / Print Rekap</span>
          </button>
          <button 
            type="button" 
            id="close-report-modal-btn"
            class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
