  </div>

  <!-- ========================================== -->
  <!-- MODAL REKAPITULASI DATA PER-TOKEN -->
  <!-- ========================================== -->
  <div id="report-modal" class="fixed inset-0 z-50 bg-background/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-card border border-border rounded-xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-lg overflow-hidden animate-fadeIn">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 border-b border-border flex items-center justify-between bg-secondary/40">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-secondary text-foreground border border-border text-xs font-mono font-bold" id="report-modal-token-code">
              TOKEN-CODE
            </span>
            <span class="text-xs text-muted-foreground" id="report-modal-target-class">10 RPL 1</span>
          </div>
          <h3 class="text-base font-bold text-foreground" id="report-modal-title">
            Rekapitulasi Sesi Belajar
          </h3>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="print-report-btn"
            class="px-3 py-1.5 rounded-lg bg-secondary hover:bg-accent text-foreground font-medium text-xs border border-border transition-colors flex items-center gap-1.5"
          >
            <span>🖨️ Cetak Rekap</span>
          </button>
          <button 
            type="button" 
            id="close-report-modal-btn"
            class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Modal Body (Printable Area) -->
      <div class="p-5 overflow-y-auto space-y-5 flex-grow" id="printable-report-area">
        
        <!-- Stats Summary Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5" id="report-stats-container">
          <div class="p-3.5 rounded-lg bg-secondary/50 border border-border space-y-0.5">
            <span class="text-[10px] text-muted-foreground uppercase font-mono">Siswa Enroll</span>
            <div class="text-xl font-bold font-mono text-foreground" id="stat-enrolled">0</div>
          </div>
          <div class="p-3.5 rounded-lg bg-secondary/50 border border-border space-y-0.5">
            <span class="text-[10px] text-muted-foreground uppercase font-mono">Ujian Selesai</span>
            <div class="text-xl font-bold font-mono text-cyan-600 dark:text-cyan-400" id="stat-taken">0</div>
          </div>
          <div class="p-3.5 rounded-lg bg-secondary/50 border border-border space-y-0.5">
            <span class="text-[10px] text-muted-foreground uppercase font-mono">Rata-Rata Nilai</span>
            <div class="text-xl font-bold font-mono text-amber-600 dark:text-amber-400" id="stat-avg">0</div>
          </div>
          <div class="p-3.5 rounded-lg bg-secondary/50 border border-border space-y-0.5">
            <span class="text-[10px] text-muted-foreground uppercase font-mono">Kelulusan</span>
            <div class="text-xl font-bold font-mono text-emerald-600 dark:text-emerald-400" id="stat-pass">0%</div>
          </div>
        </div>

        <!-- Student Records Table -->
        <div class="space-y-2">
          <h4 class="text-xs font-semibold text-foreground uppercase tracking-wider font-mono">
            Daftar Nilai & Pengerjaan Siswa
          </h4>
          <div class="overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-left text-xs">
              <thead class="bg-secondary/60 text-[10px] text-muted-foreground uppercase font-mono border-b border-border">
                <tr>
                  <th class="py-2.5 px-3">No</th>
                  <th class="py-2.5 px-3">Nama Siswa</th>
                  <th class="py-2.5 px-3">Kelas</th>
                  <th class="py-2.5 px-3">Status Ujian</th>
                  <th class="py-2.5 px-3">Nilai Skor</th>
                  <th class="py-2.5 px-3">Jawaban Benar</th>
                  <th class="py-2.5 px-3">Waktu Selesai</th>
                </tr>
              </thead>
              <tbody id="report-students-tbody" class="divide-y divide-border font-medium">
                <tr>
                  <td colspan="7" class="text-center py-6 text-muted-foreground">Memuat data...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </div>

</DashboardLayout>

<script>
  // 1. Alert Helper
  const alertBox = document.getElementById('admin-alert');
  function showAlert(msg: string, isError = false) {
    if (!alertBox) return;
    alertBox.className = isError 
      ? 'p-3 rounded-lg text-xs font-semibold text-center bg-destructive/10 border border-destructive/25 text-destructive block animate-fadeIn'
      : 'p-3 rounded-lg text-xs font-semibold text-center bg-emerald-500/10 border border-emerald-500/25 text-emerald-600 dark:text-emerald-400 block animate-fadeIn';
    alertBox.textContent = (isError ? '✕ ' : '✓ ') + msg;
  }

  // 2. Roll Token (Create Token) Form
  const toggleCreateTokenBtn = document.getElementById('toggle-create-token-btn');
  const createTokenCard = document.getElementById('create-token-card');
  const cancelCreateTokenBtn = document.getElementById('cancel-create-token-btn');
  const createTokenForm = document.getElementById('create-token-form') as HTMLFormElement | null;
  const submitTokenBtn = document.getElementById('submit-token-btn') as HTMLButtonElement | null;
  const tokenBtnText = document.getElementById('token-btn-text');

  toggleCreateTokenBtn?.addEventListener('click', () => {
    createTokenCard?.classList.toggle('hidden');
    if (!createTokenCard?.classList.contains('hidden')) {
      (document.getElementById('token-title') as HTMLInputElement)?.focus();
    }
  });

  cancelCreateTokenBtn?.addEventListener('click', () => {
    createTokenCard?.classList.add('hidden');
  });

  createTokenForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const title = (document.getElementById('token-title') as HTMLInputElement)?.value.trim();
    const targetClass = (document.getElementById('token-target-class') as HTMLSelectElement)?.value;
    const targetType = (document.getElementById('token-target-type') as HTMLSelectElement)?.value;
    const customToken = (document.getElementById('token-custom-code') as HTMLInputElement)?.value.trim();
    const description = (document.getElementById('token-description') as HTMLInputElement)?.value.trim();

    if (!title) {
      alert('Judul sesi token wajib diisi.');
      return;
    }

    if (submitTokenBtn) submitTokenBtn.disabled = true;
    if (tokenBtnText) tokenBtnText.textContent = 'Menerbitkan Token...';

    try {
      const res = await fetch('/api/admin/tokens/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          targetClass,
          targetType,
          customToken,
          description,
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        showAlert(`Token sesi "${data.token.token}" berhasil diterbitkan!`);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showAlert(data.error || 'Gagal menerbitkan token.', true);
        if (submitTokenBtn) submitTokenBtn.disabled = false;
        if (tokenBtnText) tokenBtnText.textContent = 'Terbitkan Token Sesi';
      }
    } catch (err: any) {
      showAlert(err.message || 'Terjadi kesalahan jaringan.', true);
      if (submitTokenBtn) submitTokenBtn.disabled = false;
      if (tokenBtnText) tokenBtnText.textContent = 'Terbitkan Token Sesi';
    }
  });

  // 3. Copy Token Clipboard
  document.querySelectorAll('.copy-token-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const token = btn.getAttribute('data-copy-token');
      if (token) {
        navigator.clipboard.writeText(token);
        showAlert(`Kode token ${token} disalin ke clipboard! Bagikan kode ini ke siswa.`);
      }
    });
  });

  // 4. Toggle Token Status
  document.querySelectorAll('.toggle-token-status-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tokenId = btn.getAttribute('data-token-id');
      const currentActive = btn.getAttribute('data-token-active') === 'true';
      const newActive = !currentActive;

      try {
        const res = await fetch('/api/admin/tokens/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tokenId: Number(tokenId), isActive: newActive })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showAlert(`Status token berhasil diubah menjadi ${newActive ? 'AKTIF' : 'NONAKTIF'}.`);
          setTimeout(() => window.location.reload(), 800);
        } else {
          showAlert(data.error || 'Gagal mengubah status token.', true);
        }
      } catch (err) {
        showAlert('Gangguan jaringan saat mengubah status token.', true);
      }
    });
  });

  // 5. Delete Token
  document.querySelectorAll('.delete-token-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tokenId = btn.getAttribute('data-delete-token-id');
      const tokenTitle = btn.getAttribute('data-token-title');
      const tokenCode = btn.getAttribute('data-token-code');

      if (!confirm(`Hapus Token Sesi:\n"${tokenTitle}" (${tokenCode})?\n\nPerhatian: Riwayat pendaftaran siswa pada token ini akan ikut terhapus.`)) {
        return;
      }

      try {
        const res = await fetch('/api/admin/tokens/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tokenId: Number(tokenId) })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showAlert('Token sesi berhasil dihapus.');
          setTimeout(() => window.location.reload(), 800);
        } else {
          showAlert(data.error || 'Gagal menghapus token.', true);
        }
      } catch (err) {
        showAlert('Gangguan jaringan saat menghapus token.', true);
      }
    });
  });

  // 6. View Report Modal per Token
  const reportModal = document.getElementById('report-modal');
  const closeReportModalBtn = document.getElementById('close-report-modal-btn');
  const printReportBtn = document.getElementById('print-report-btn');
  const modalTokenCode = document.getElementById('report-modal-token-code');
  const modalTargetClass = document.getElementById('report-modal-target-class');
  const modalTitle = document.getElementById('report-modal-title');
  const statEnrolled = document.getElementById('stat-enrolled');
  const statTaken = document.getElementById('stat-taken');
  const statAvg = document.getElementById('stat-avg');
  const statPass = document.getElementById('stat-pass');
  const reportTbody = document.getElementById('report-students-tbody');

  closeReportModalBtn?.addEventListener('click', () => {
    reportModal?.classList.add('hidden');
  });

  printReportBtn?.addEventListener('click', () => {
    window.print();
  });

  document.querySelectorAll('.view-report-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tokenId = btn.getAttribute('data-view-report-token-id');
      const tokenCode = btn.getAttribute('data-token-code') || '';
      const tokenTitle = btn.getAttribute('data-token-title') || '';

      if (modalTokenCode) modalTokenCode.textContent = tokenCode;
      if (modalTitle) modalTitle.textContent = tokenTitle;
      if (reportTbody) reportTbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-muted-foreground">Mengambil rekap data peserta...</td></tr>';
      
      reportModal?.classList.remove('hidden');

      try {
        const res = await fetch(`/api/admin/tokens/report?tokenId=${tokenId}`);
        const data = await res.json();

        if (res.ok && data.success) {
          if (modalTargetClass) modalTargetClass.textContent = `Kelas: ${data.token.targetClass}`;
          if (statEnrolled) statEnrolled.textContent = data.stats.totalEnrolled.toString();
          if (statTaken) statTaken.textContent = data.stats.totalExamTaken.toString();
          if (statAvg) statAvg.textContent = `${data.stats.avgScore} / 100`;
          if (statPass) statPass.textContent = `${data.stats.passRate}% (${data.stats.passCount} Siswa)`;

          if (!data.students || data.students.length === 0) {
            if (reportTbody) reportTbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-muted-foreground">Belum ada siswa yang melakukan enroll pada token ini.</td></tr>';
          } else {
            let html = '';
            data.students.forEach((s: any, idx: number) => {
              const dateStr = s.examSubmittedAt 
                ? new Date(s.examSubmittedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
                : '-';

              const isPass = s.examScore !== null && s.examScore >= 75;
              const statusBadge = s.hasTakenExam 
                ? `<span class="px-2 py-0.5 rounded text-[10px] font-semibold ${isPass ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25' : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25'}">${isPass ? 'KOMPETEN' : 'BELUM KOMPETEN'}</span>`
                : '<span class="text-muted-foreground text-[10px]">Belum Ujian</span>';

              const scoreVal = s.examScore !== null ? `<span class="font-bold text-foreground font-mono text-sm">${s.examScore}</span>` : '<span class="text-muted-foreground">-</span>';
              const correctVal = s.correctAnswers !== null ? `${s.correctAnswers}/${s.totalQuestions}` : '-';

              html += `
                <tr class="hover:bg-accent/40 transition-colors">
                  <td class="py-2.5 px-3 font-mono text-muted-foreground">${idx + 1}</td>
                  <td class="py-2.5 px-3 font-semibold text-foreground">${s.name}</td>
                  <td class="py-2.5 px-3 font-mono">${s.studentClass}</td>
                  <td class="py-2.5 px-3">${statusBadge}</td>
                  <td class="py-2.5 px-3">${scoreVal}</td>
                  <td class="py-2.5 px-3 font-mono text-muted-foreground">${correctVal}</td>
                  <td class="py-2.5 px-3 font-mono text-muted-foreground text-[11px]">${dateStr}</td>
                </tr>
              `;
            });
            if (reportTbody) reportTbody.innerHTML = html;
          }
        } else {
          if (reportTbody) reportTbody.innerHTML = `<tr><td colspan="7" class="text-center py-6 text-destructive">Gagal: ${data.error || 'Terjadi kesalahan'}</td></tr>`;
        }
      } catch (err) {
        if (reportTbody) reportTbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-destructive">Gangguan jaringan saat memuat rekap.</td></tr>';
      }
    });
  });

  // 7. Search filter for users
  const searchInput = document.getElementById('user-search-input') as HTMLInputElement | null;
  const userRows = document.querySelectorAll('.user-row');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    userRows.forEach(row => {
      const name = row.querySelector('.user-name')?.textContent?.toLowerCase() || '';
      const email = row.querySelector('.user-email')?.textContent?.toLowerCase() || '';
      const uClass = row.querySelector('.user-class')?.textContent?.toLowerCase() || '';
      if (name.includes(query) || email.includes(query) || uClass.includes(query)) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  });

  // 8. Role Toggle Action for Super Admin
  const roleButtons = document.querySelectorAll('.role-toggle-btn');
  roleButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetUserId = btn.getAttribute('data-user-id');
      const userName = btn.getAttribute('data-user-name') || 'Pengguna';
      const targetRole = btn.getAttribute('data-target-role') || 'student';
      
      const confirmMsg = targetRole === 'teacher'
        ? `Apakah Anda yakin ingin menetapkan ${userName} sebagai GURU PENGAMPU?\n\nPengguna ini akan memiliki akses ke Panel Guru untuk memonitor hasil belajar dan ujian siswa.`
        : `Apakah Anda yakin ingin mencabut akses Guru dari ${userName} dan mengembalikannya sebagai SISWA?`;

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin/users/role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUserId, newRole: targetRole })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showAlert(data.message || 'Perubahan role berhasil disimpan.');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showAlert(data.error || 'Gagal mengubah role pengguna.', true);
        }
      } catch (e) {
        showAlert('Gagal: Terjadi gangguan jaringan/server.', true);
      }
    });
  });

  // 9. Delete User Action for Admin / Teacher
  const deleteButtons = document.querySelectorAll('.delete-user-btn');
  deleteButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetUserId = btn.getAttribute('data-user-id');
      const userName = btn.getAttribute('data-user-name') || 'Pengguna';
      const userEmail = btn.getAttribute('data-user-email') || '';

      const confirmMsg = `PERINGATAN HAPUS AKUN:\n\nApakah Anda yakin ingin menghapus akun:\n• Nama: ${userName}\n• Email: ${userEmail}\n\nTindakan ini bersifat PERMANEN. Seluruh riwayat nilai tryout TKA, progres modul, dan poin XP siswa ini akan langsung dihapus dari database.`;

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin/users/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUserId })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showAlert(data.message || 'Akun pengguna berhasil dihapus.');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showAlert(data.error || 'Gagal menghapus akun pengguna.', true);
        }
      } catch (e) {
        showAlert('Gagal: Terjadi gangguan jaringan/server.', true);
      }
    });
  });
</script>
