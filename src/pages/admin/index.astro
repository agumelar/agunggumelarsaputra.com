                <span id="token-btn-text">Terbitkan Token Sesi</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Tabel Daftar Token Sesi -->
        {allTokens.length === 0 ? (
          <div class="p-8 text-center text-xs text-muted-foreground bg-secondary/30 rounded-lg border border-dashed border-border">
            Belum ada Token Sesi yang dibuat. Klik tombol <b>"+ Buat (Roll) Token Baru"</b> untuk membuat token sesi kelas pertama Anda.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="text-[11px] text-muted-foreground uppercase font-mono border-b border-border">
                <tr>
                  <th class="py-2.5 px-3">Kode Token</th>
                  <th class="py-2.5 px-3">Nama Sesi & Tipe</th>
                  <th class="py-2.5 px-3">Target Kelas</th>
                  <th class="py-2.5 px-3">Siswa Enroll</th>
                  <th class="py-2.5 px-3">Ujian Selesai</th>
                  <th class="py-2.5 px-3">Status Sesi</th>
                  <th class="py-2.5 px-3 text-right">Aksi & Rekap</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border font-medium">
                {allTokens.map((t) => {
                  const enrolledCount = enrollmentCountMap[t.id] || 0;
                  const examCount = examCountMap[t.id] || 0;
                  const createdDate = new Date(t.createdAt).toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  });

                  return (
                    <tr class="hover:bg-accent/40 transition-colors">
                      <!-- Token Code with Copy Button -->
                      <td class="py-3 px-3 font-mono">
                        <div class="flex items-center gap-1.5">
                          <span class="px-2 py-0.5 rounded font-mono font-bold text-xs bg-secondary text-foreground border border-border tracking-wider">
                            {t.token}
                          </span>
                          <button 
                            type="button" 
                            data-copy-token={t.token}
                            class="copy-token-btn p-1 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                            title="Salin Kode Token"
                          >
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                          </button>
                        </div>
                      </td>

                      <!-- Judul Sesi -->
                      <td class="py-3 px-3">
                        <span class="font-semibold text-foreground block">{t.title}</span>
                        <div class="flex items-center gap-2 text-[10px] text-muted-foreground mt-0.5">
                          <span class="font-mono">
                            {t.targetType === 'tka' ? '🎯 Ujian TKA' : t.targetType === 'module' ? '📖 Modul Materi' : '📚 Global Hub'}
                          </span>
                          <span>•</span>
                          <span>{createdDate}</span>
                        </div>
                      </td>

                      <!-- Target Kelas -->
                      <td class="py-3 px-3 font-mono">
                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-secondary text-foreground border border-border">
                          {t.targetClass}
                        </span>
                      </td>

                      <!-- Siswa Enroll -->
                      <td class="py-3 px-3 font-mono font-semibold text-foreground">
                        <span class="px-2 py-0.5 rounded bg-primary/10 text-primary text-xs">
                          👥 {enrolledCount} Siswa
                        </span>
                      </td>

                      <!-- Ujian Selesai -->
                      <td class="py-3 px-3 font-mono font-semibold text-emerald-600 dark:text-emerald-400">
                        {examCount} Selesai
                      </td>

                      <!-- Toggle Status -->
                      <td class="py-3 px-3">
                        <button 
                          type="button"
                          data-token-id={t.id}
                          data-token-active={t.isActive ? 'true' : 'false'}
                          class="toggle-token-status-btn px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase transition-colors"
                          class:list={[
                            t.isActive 
                              ? "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/25" 
                              : "bg-secondary text-muted-foreground border border-border hover:bg-accent"
                          ]}
                          title="Klik untuk mengubah status sesi"
                        >
                          {t.isActive ? '● AKTIF' : '○ NONAKTIF'}
                        </button>
                      </td>

                      <!-- Actions -->
                      <td class="py-3 px-3 text-right">
                        <div class="flex items-center justify-end gap-1.5">
                          <button 
                            type="button"
                            data-view-report-token-id={t.id}
                            data-token-code={t.token}
                            data-token-title={t.title}
                            class="view-report-btn px-2.5 py-1.5 rounded-md text-xs font-medium bg-cyan-600 hover:bg-cyan-500 text-white transition-colors flex items-center gap-1"
                            title="Tinjau & Cetak Rekapitulasi Sesi"
                          >
                            <span>📊 Rekap</span>
                          </button>

                          <a 
                            href={`/api/admin/tokens/export-excel?tokenId=${t.id}`}
                            class="px-2.5 py-1.5 rounded-md text-xs font-medium bg-emerald-600/90 hover:bg-emerald-500 text-white transition-colors flex items-center gap-1 shadow-sm"
                            title="Unduh File Excel Resmi (.xlsx)"
                            download
                          >
                            <span>📥 Excel</span>
                          </a>

                          <button 
                            type="button"
                            data-delete-token-id={t.id}
                            data-token-title={t.title}
                            data-token-code={t.token}
                            class="delete-token-btn p-1.5 rounded-md text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors"
                            title="Hapus Token Sesi"
                          >
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </div>
                      </td>

                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}

      </div>
    </div>

    <!-- ========================================== -->
    <!-- SECTION: PENILAIAN & EVALUASI LKPD SISWA -->
