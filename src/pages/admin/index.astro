      '          <td><strong>' + (Number(fs) >= 75 ? 'TUNTAS (SANGAT BAIK)' : Number(fs) > 0 ? 'PERLU PEMBINAAN' : 'MENUNGGU PENILAIAN') + '</strong></td>',
      '        </tr>',
