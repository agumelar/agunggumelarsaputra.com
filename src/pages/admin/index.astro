              <span>📝 Penilaian & Evaluasi LKPD Siswa</span>
            </h2>
            <span class="px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/25">
              EVALUASI KOMPETENSI LKPD
            </span>
          </div>
          <p class="text-xs text-muted-foreground">
            Periksa hasil kerja praktik / LKPD siswa, berikan skor angka (0-100) berbasis KKM (73), capaian KKTP (Level 0-4), serta catatan evaluasi guru.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 font-semibold">
              ⏳ {pendingLkpd} Menunggu
            </span>
            <span class="px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-semibold">
              ✓ {gradedLkpd} Dinilai
            </span>
          </div>

          <a 
            href="/api/admin/submissions/export-excel"
            class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs transition-colors flex items-center gap-1.5 shadow-sm"
            title="Unduh Rekap Lengkap Nilai LKPD Siswa ke Format Excel (.xlsx)"
            download
          >
            <span>📥 Rekap LKPD (.xlsx)</span>
          </a>
        </div>
      </div>

      <!-- Filter Controls for LKPD -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="relative">
          <input 
            type="text" 
            id="submission-search-input" 
            placeholder="Cari nama siswa / email / modul LKPD..." 
            class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs focus:outline-none focus:border-primary placeholder:text-muted-foreground"
          />
        </div>

        <div>
          <select 
            id="submission-class-filter" 
            class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs focus:outline-none focus:border-primary"
          >
            <option value="">Semua Kelas</option>
            <option value="10 RPL 1">10 RPL 1</option>
            <option value="10 RPL 2">10 RPL 2</option>
            <option value="10 RPL 3">10 RPL 3</option>
            <option value="10 RPL 4">10 RPL 4</option>
            <option value="11 RPL 1">11 RPL 1</option>
            <option value="11 RPL 2">11 RPL 2</option>
            <option value="11 RPL 3">11 RPL 3</option>
            <option value="11 RPL 4">11 RPL 4</option>
            <option value="12 RPL 1">12 RPL 1</option>
            <option value="12 RPL 2">12 RPL 2</option>
            <option value="12 RPL 3">12 RPL 3</option>
            <option value="12 RPL 4">12 RPL 4</option>
            <option value="Kelas Uji Coba">Kelas Uji Coba</option>
          </select>
        </div>

        <div>
          <select 
            id="submission-status-filter" 
            class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs focus:outline-none focus:border-primary"
          >
            <option value="">Semua Status LKPD</option>
            <option value="pending">Menunggu Penilaian</option>
            <option value="graded">Sudah Dinilai (Semua)</option>
            <option value="passed">✓ Tuntas KKM (>= 73)</option>
            <option value="remedial">⚠️ Belum Tuntas (< 73)</option>
          </select>
        </div>
      </div>

      <!-- LKPD Submissions Table -->
      {lkpdSubmissions.length === 0 ? (
        <div class="p-8 text-center bg-background rounded-lg border border-border/50 text-xs text-muted-foreground space-y-2">
          <div class="text-2xl">📥</div>
          <p class="font-medium text-foreground">Belum ada tugas LKPD yang dikumpulkan oleh siswa.</p>
          <p class="text-[11px]">Ketika siswa mengisi formulir LKPD di modul materi dan menekan tombol simpan, data akan muncul di sini.</p>
        </div>
      ) : (
        <div class="overflow-x-auto border border-border rounded-lg">
          <table class="w-full text-left text-xs" id="submissions-table">
            <thead class="text-[11px] text-muted-foreground uppercase font-mono bg-secondary/40 border-b border-border">
              <tr>
                <th class="py-3 px-3">Siswa & Kelas</th>
                <th class="py-3 px-3">Modul & Tipe LKPD</th>
                <th class="py-3 px-3">Waktu Kirim</th>
                <th class="py-3 px-3">Status / Nilai Guru</th>
                <th class="py-3 px-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border font-medium bg-card">
              {lkpdSubmissions.map((sub: any) => {
                const isGraded = sub.teacherScore !== null && sub.teacherScore !== undefined;
                const isPassed = isGraded && sub.teacherScore >= 73;
                const statusTag = isGraded ? (isPassed ? 'passed' : 'remedial') : 'pending';
                const dateFormatted = new Date(sub.submittedAt).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                });

                return (
                  <tr 
                    class="submission-row hover:bg-accent/40 transition-colors"
                    data-name={sub.userName.toLowerCase()}
                    data-email={sub.userEmail.toLowerCase()}
                    data-class={sub.studentClass || ''}
                    data-slug={sub.lessonSlug.toLowerCase()}
                    data-status={statusTag}
                    data-graded={isGraded ? 'graded' : 'pending'}
                  >
                    <td class="py-3 px-3">
                      <div class="space-y-0.5">
                        <div class="font-bold text-foreground">{sub.userName}</div>
                        <div class="text-[10px] text-muted-foreground font-mono flex items-center gap-1.5">
                          <span>{sub.userEmail}</span>
                          {sub.studentClass && (
                            <>
                              <span>•</span>
                              <span class="px-1.5 py-0.2 rounded bg-secondary text-foreground border border-border font-semibold">
                                {sub.studentClass}
                              </span>
                            </>
                          )}
                        </div>
                      </div>
                    </td>

                    <td class="py-3 px-3">
                      <div class="space-y-1">
                        <div class="flex items-center gap-1.5">
                          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-primary/10 text-primary border border-primary/20 uppercase">
                            {sub.submissionType || 'LKPD'}
                          </span>
                        </div>
                        <div class="text-[11px] font-mono text-muted-foreground truncate max-w-[220px]" title={sub.lessonSlug}>
                          {sub.lessonSlug}
                        </div>
                      </div>
                    </td>

                    <td class="py-3 px-3 font-mono text-muted-foreground text-[11px] whitespace-nowrap">
                      {dateFormatted}
                    </td>

                    <td class="py-3 px-3">
                      {isGraded ? (
                        <div class="space-y-1">
                          <div class="flex items-center gap-1.5 flex-wrap">
                            <span class={`px-2 py-0.5 rounded font-mono text-[11px] font-bold border ${sub.teacherScore >= 73 ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/30' : 'bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/30'}`}>
                              {sub.teacherScore >= 73 ? '✓ Tuntas (Terkunci)' : '⚠️ Remedial'}: {sub.teacherScore}
                            </span>
                            {sub.teacherLevel && (
                              <span class="text-[10px] font-mono text-primary px-1.5 py-0.5 bg-primary/10 rounded border border-primary/20">
                                {sub.teacherLevel}
                              </span>
                            )}
                          </div>
                          {sub.teacherFeedback && (
                            <div class="text-[10px] text-muted-foreground italic truncate max-w-[220px]" title={sub.teacherFeedback}>
                              "{sub.teacherFeedback}"
                            </div>
                          )}
                        </div>
                      ) : (
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25">
                          <span>⏳</span> Menunggu Penilaian
                        </span>
                      )}
                    </td>

                    <td class="py-3 px-3 text-right whitespace-nowrap">
                      <button 
                        type="button"
                        class="grade-submission-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-purple-600 hover:bg-purple-500 text-white transition-all shadow-sm flex items-center gap-1.5 ml-auto"
                        data-submission={JSON.stringify(sub)}
                      >
                        <span>{isGraded ? '✏️ Edit Nilai' : '🔍 Periksa & Nilai'}</span>
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

