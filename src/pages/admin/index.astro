                        </span>
                      ) : (
                        <span class="text-muted-foreground text-[10px]">-</span>
                      )}
                    </td>
                    <td class="py-3 px-3 font-mono text-primary">
                      /pembelajaran/{log.lessonSlug}
                    </td>
                    <td class="py-3 px-3 text-right font-mono text-muted-foreground">
                      {finishDate}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- ========================================== -->
    <!-- SECTION 4: PENILAIAN RABU LITERASI (RESIK) -->
    <!-- ========================================== -->
    <div id="literasi" class="card p-5 sm:p-6 rounded-xl border-border bg-card space-y-5 shadow-sm">
      <div class="space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-4">
          <div>
            <h2 class="text-base font-bold text-foreground flex items-center gap-2">
              <span>📚 Penilaian Rabu Literasi (RESIK)</span>
              <span class="text-[10px] px-2 py-0.5 rounded font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                RUBRIK RESIK
              </span>
            </h2>
            <p class="text-xs text-muted-foreground mt-0.5">Tinjau dan nilai resensi buku non-teks mingguan siswa berdasarkan rubrik Menulis & Presentasi.</p>
          </div>

          <div class="flex items-center gap-2 text-[10px] font-mono font-semibold flex-shrink-0 flex-wrap">
            <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
              ⏳ {pendingLiterasi} Menunggu
            </span>
            <span class="px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              ✓ {gradedLiterasi} Dinilai
            </span>

            <a 
              href="/api/literasi/export-rekap"
              class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs transition-colors flex items-center gap-1.5 shadow-sm"
              title="Unduh Rekap Literasi ke CSV"
              download
            >
              <span>📥 Rekap CSV</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Filter Controls for Literasi -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="relative">
          <input 
            type="text" 
            id="literasi-search-input" 
            placeholder="Cari nama siswa / judul buku..." 
            class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs focus:outline-none focus:border-primary placeholder:text-muted-foreground"
          />
        </div>
        <div>
          <select 
            id="literasi-class-filter" 
            class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs focus:outline-none focus:border-primary"
          >
            <option value="">Semua Kelas</option>
            <option value="10 RPL 1">10 RPL 1</option>
            <option value="10 RPL 2">10 RPL 2</option>
            <option value="10 RPL 3">10 RPL 3</option>
            <option value="10 RPL 4">10 RPL 4</option>
            <option value="11 RPL 1">11 RPL 1</option>
            <option value="11 RPL 2">11 RPL 2</option>
            <option value="11 RPL 3">11 RPL 3</option>
            <option value="11 RPL 4">11 RPL 4</option>
            <option value="12 RPL 1">12 RPL 1</option>
            <option value="12 RPL 2">12 RPL 2</option>
            <option value="12 RPL 3">12 RPL 3</option>
            <option value="12 RPL 4">12 RPL 4</option>
            <option value="Kelas Uji Coba">Kelas Uji Coba</option>
          </select>
        </div>
        <div>
          <select 
            id="literasi-status-filter" 
            class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs focus:outline-none focus:border-primary"
          >
            <option value="">Semua Status</option>
            <option value="submitted">Menunggu Penilaian</option>
            <option value="graded">Sudah Dinilai</option>
          </select>
        </div>
      </div>

      <!-- Literasi Reports Table -->
      {allLiterasiReports.length === 0 ? (
        <div class="p-8 text-center bg-background rounded-lg border border-border/50 text-xs text-muted-foreground space-y-2">
          <div class="text-2xl">📚</div>
          <p class="font-medium text-foreground">Belum ada resensi buku yang dikumpulkan oleh siswa.</p>
          <p class="text-[11px]">Ketika siswa mengisi formulir Rabu Literasi (RESIK) dan menekan tombol kirim, data akan muncul di sini.</p>
        </div>
      ) : (
        <div class="overflow-x-auto border border-border rounded-lg">
          <table class="w-full text-left text-xs" id="literasi-table">
            <thead class="text-[11px] text-muted-foreground uppercase font-mono bg-secondary/40 border-b border-border">
              <tr>
                <th class="py-3 px-3">Siswa & Kelas</th>
                <th class="py-3 px-3">Judul Buku & Penulis</th>
                <th class="py-3 px-3">Minggu</th>
                <th class="py-3 px-3">Waktu Kirim</th>
                <th class="py-3 px-3">Status / Nilai</th>
                <th class="py-3 px-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border font-medium bg-card">
              {allLiterasiReports.map((report: any) => {
                const isGraded = report.status === 'graded' && report.finalScore !== null;
                const dateFormatted = new Date(report.createdAt).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                });

                return (
                  <tr 
                    class="literasi-row hover:bg-accent/40 transition-colors"
                    data-name={report.userName.toLowerCase()}
                    data-email={(report.userEmail || '').toLowerCase()}
                    data-class={report.studentClass || ''}
                    data-book={report.bookTitle.toLowerCase()}
                    data-status={report.status}
                  >
                    <td class="py-3 px-3">
                      <div class="space-y-0.5">
                        <div class="font-bold text-foreground">{report.userName}</div>
                        <div class="text-[10px] text-muted-foreground font-mono flex items-center gap-1.5">
                          <span>{report.userEmail}</span>
                          {report.studentClass && (
                            <>
                              <span>•</span>
                              <span class="px-1.5 py-0.2 rounded bg-secondary text-foreground border border-border font-semibold">
                                {report.studentClass}
                              </span>
                            </>
                          )}
                        </div>
                      </div>
                    </td>
                    <td class="py-3 px-3">
                      <div class="space-y-0.5">
                        <div class="font-semibold text-foreground text-xs">{report.bookTitle}</div>
                        <div class="text-[10px] text-muted-foreground">{report.author}</div>
                      </div>
                    </td>
                    <td class="py-3 px-3">
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        Minggu {report.weekNumber}
                      </span>
                    </td>
                    <td class="py-3 px-3 font-mono text-muted-foreground text-[10px]">
                      {dateFormatted}
                    </td>
                    <td class="py-3 px-3">
                      {isGraded ? (
                        <div class="space-y-1">
                          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                            DINILAI: {report.finalScore}/100
                          </span>
                          <div class="text-[9px] text-muted-foreground font-mono">
                            ✍️ {report.writingScore}/16 • 🎤 {report.presentationScore}/20
                          </div>
                        </div>
                      ) : (
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/25 animate-pulse">
                          MENUNGGU PENILAIAN
                        </span>
                      )}
                    </td>
                    <td class="py-3 px-3 text-right">
                      <button 
                        type="button"
                        class="literasi-grade-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all shadow-sm"
                        class:list={[
                          isGraded
                            ? "bg-secondary hover:bg-accent text-foreground border border-border"
                            : "bg-emerald-600 hover:bg-emerald-500 text-white"
                        ]}
                        data-report-id={report.id}
                        data-student-name={report.userName}
                        data-student-class={report.studentClass || '-'}
                        data-book-title={report.bookTitle}
                        data-author={report.author}
                        data-publisher={`${report.publisher}, ${report.city} (${report.year})`}
                        data-page-count={report.pageCount}
                        data-summary={report.summary}
                        data-moral={report.moralMessage}
                        data-week={report.weekNumber}
                        data-writing-score={report.writingScore || ''}
                        data-presentation-score={report.presentationScore || ''}
                        data-final-score={report.finalScore || ''}
                        data-feedback={report.teacherFeedback || ''}
                        data-status={report.status}
                      >
                        {isGraded ? '✏️ Edit Nilai' : '🔍 Periksa & Nilai'}
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

  </div>

  <!-- ========================================== -->
  <!-- MODAL PENILAIAN RABU LITERASI (RESIK) -->
  <!-- ========================================== -->
  <div id="literasi-grade-modal" class="fixed inset-0 z-50 bg-background/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-card border border-border rounded-xl max-w-3xl w-full max-h-[90vh] flex flex-col shadow-lg overflow-hidden animate-fadeIn">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 border-b border-border flex items-center justify-between bg-emerald-950/30">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-mono font-bold">
              RESIK
            </span>
            <span class="text-xs text-muted-foreground" id="lit-modal-student-info">Nama Siswa - Kelas</span>
          </div>
          <h3 class="text-base font-bold text-foreground">
            Penilaian Resensi Buku Literasi
          </h3>
        </div>
        <button type="button" id="close-literasi-modal-btn" class="p-1.5 rounded-lg hover:bg-destructive/10 text-muted-foreground hover:text-destructive transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-5">
        
        <!-- Book Info Card -->
        <div class="p-4 rounded-xl bg-secondary/40 border border-border space-y-3">
          <div class="flex items-start gap-3">
            <div class="text-3xl">📖</div>
            <div class="space-y-1 flex-1">
              <h4 class="font-bold text-foreground text-sm" id="lit-modal-book-title">Judul Buku</h4>
              <p class="text-[11px] text-muted-foreground font-mono" id="lit-modal-book-meta">Penulis • Penerbit • Halaman</p>
              <span class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" id="lit-modal-week">Minggu 1</span>
            </div>
          </div>
        </div>

        <!-- Student's Summary -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold text-foreground flex items-center gap-1.5">📝 Ringkasan Isi Buku</h4>
          <div class="p-3.5 rounded-lg bg-background border border-border text-xs text-foreground leading-relaxed max-h-40 overflow-y-auto" id="lit-modal-summary">
            -
          </div>
        </div>

        <!-- Student's Moral Message -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold text-foreground flex items-center gap-1.5">💡 Pesan Moral / Pelajaran</h4>
          <div class="p-3.5 rounded-lg bg-background border border-border text-xs text-foreground leading-relaxed max-h-32 overflow-y-auto" id="lit-modal-moral">
            -
          </div>
        </div>

        <hr class="border-border" />

        <!-- Grading Form -->
        <form id="literasi-grade-form" class="space-y-5">
          <input type="hidden" name="reportId" id="lit-grade-report-id" />

          <!-- Writing Aspects (w1-w4, each 1-4, max 16) -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold text-foreground flex items-center gap-1.5">
              ✍️ Aspek Menulis <span class="text-[10px] text-muted-foreground font-normal">(Masing-masing 1-4, Total Maks 16)</span>
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">W1: Kelengkapan Identitas Buku</label>
                <input type="number" name="w1" id="lit-w1" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">W2: Kualitas Ringkasan</label>
                <input type="number" name="w2" id="lit-w2" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">W3: Pesan Moral & Refleksi</label>
                <input type="number" name="w3" id="lit-w3" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">W4: Ejaan & Tata Bahasa</label>
                <input type="number" name="w4" id="lit-w4" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
            </div>
            <div class="text-right text-[11px] font-mono font-bold text-emerald-400">
              Subtotal Menulis: <span id="lit-writing-subtotal">12</span> / 16
            </div>
          </div>

          <!-- Presentation Aspects (p1-p5, each 1-4, max 20) -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold text-foreground flex items-center gap-1.5">
              🎤 Aspek Presentasi <span class="text-[10px] text-muted-foreground font-normal">(Masing-masing 1-4, Total Maks 20)</span>
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">P1: Kelancaran Penyampaian</label>
                <input type="number" name="p1" id="lit-p1" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">P2: Kontak Mata & Ekspresi</label>
                <input type="number" name="p2" id="lit-p2" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">P3: Volume & Intonasi Suara</label>
                <input type="number" name="p3" id="lit-p3" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">P4: Penguasaan Materi</label>
                <input type="number" name="p4" id="lit-p4" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
              <div class="space-y-1">
                <label class="text-[11px] font-semibold text-muted-foreground">P5: Kemampuan Menjawab Pertanyaan</label>
                <input type="number" name="p5" id="lit-p5" min="1" max="4" value="3" class="w-full px-3 py-2 bg-background border border-border rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500" />
              </div>
            </div>
            <div class="text-right text-[11px] font-mono font-bold text-emerald-400">
              Subtotal Presentasi: <span id="lit-presentation-subtotal">15</span> / 20
            </div>
          </div>

          <!-- Auto-computed Final Score -->
          <div class="p-4 rounded-xl bg-emerald-950/20 border border-emerald-500/20 flex items-center justify-between">
            <div class="space-y-0.5">
              <span class="text-[11px] font-mono font-semibold text-muted-foreground uppercase">Nilai Akhir RESIK</span>
              <p class="text-[10px] text-muted-foreground">Formula: (Menulis + Presentasi) / 36 × 100</p>
            </div>
            <div class="text-3xl font-black font-mono text-emerald-400" id="lit-final-score-display">75</div>
          </div>

          <!-- Teacher Feedback -->
          <div class="space-y-2">
            <label class="text-xs font-bold text-foreground">💬 Catatan & Masukan Guru</label>
            <textarea 
              name="teacherFeedback" 
              id="lit-teacher-feedback" 
              rows="3" 
              placeholder="Tulis catatan, saran, atau apresiasi untuk resensi siswa ini..."
              class="w-full px-3 py-2.5 bg-background border border-border rounded-lg text-xs focus:outline-none focus:border-emerald-500 placeholder:text-muted-foreground resize-none"
            ></textarea>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" class="lit-feedback-preset px-2.5 py-1 rounded-md bg-secondary hover:bg-accent text-[10px] font-medium text-foreground border border-border transition-colors" data-text="Resensi sangat baik! Ringkasan mencerminkan pemahaman mendalam terhadap isi buku.">👏 Sangat Baik</button>
              <button type="button" class="lit-feedback-preset px-2.5 py-1 rounded-md bg-secondary hover:bg-accent text-[10px] font-medium text-foreground border border-border transition-colors" data-text="Ringkasan cukup baik namun perlu diperdalam analisis pesan moralnya.">📝 Cukup Baik</button>
              <button type="button" class="lit-feedback-preset px-2.5 py-1 rounded-md bg-secondary hover:bg-accent text-[10px] font-medium text-foreground border border-border transition-colors" data-text="Perlu diperbaiki: ringkasan terlalu singkat dan pesan moral belum tergali dengan baik. Silakan coba lagi.">⚠️ Perlu Perbaikan</button>
              <button type="button" class="lit-feedback-preset px-2.5 py-1 rounded-md bg-secondary hover:bg-accent text-[10px] font-medium text-foreground border border-border transition-colors" data-text="Presentasi sangat percaya diri dan menginspirasi teman sekelas. Luar biasa!">🌟 Presentasi Luar Biasa</button>
            </div>
          </div>
        </form>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 sm:p-5 border-t border-border flex items-center justify-between gap-3 bg-secondary/20">
        <button type="button" id="print-literasi-modal-btn" class="px-3.5 py-2 rounded-lg bg-secondary hover:bg-accent text-foreground font-semibold text-xs border border-border transition-colors flex items-center gap-1.5 shadow-sm">
          <span>🖨️</span> Cetak Dokumen Resmi PDF
        </button>
        <div class="flex items-center gap-2">
          <button type="button" id="cancel-literasi-grade-btn" class="px-4 py-2 rounded-lg bg-secondary hover:bg-accent text-foreground font-medium text-xs border border-border transition-colors">
            Batal
          </button>
          <button type="button" id="submit-literasi-grade-btn" class="px-5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-sm transition-colors flex items-center gap-2">
            <span>💾 Simpan Nilai RESIK</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL REKAPITULASI DATA PER-TOKEN -->
  <!-- ========================================== -->
  <div id="report-modal" class="fixed inset-0 z-50 bg-background/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-card border border-border rounded-xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-lg overflow-hidden animate-fadeIn">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 border-b border-border flex items-center justify-between bg-secondary/40">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-secondary text-foreground border border-border text-xs font-mono font-bold" id="report-modal-token-code">
              TOKEN-CODE
            </span>
            <span class="text-xs text-muted-foreground" id="report-modal-target-class">10 RPL 1</span>
          </div>
          <h3 class="text-base font-bold text-foreground" id="report-modal-title">
            Rekapitulasi Sesi Belajar
          </h3>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="download-excel-report-btn"
            class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors flex items-center gap-1.5 shadow-sm"
            title="Unduh Lembar Rekap Nilai Siswa ke Format Excel Resmi (.xlsx)"
          >
            <span>📥 Unduh Excel (.xlsx)</span>
          </button>
          <button 
            type="button" 
            id="print-report-btn"
            class="px-3 py-1.5 rounded-lg bg-secondary hover:bg-accent text-foreground font-medium text-xs border border-border transition-colors flex items-center gap-1.5"
            title="Pratinjau & Cetak Laporan (Print View)"
          >
            <span>🖨️ Cetak Rekap</span>
          </button>
          <button 
            type="button" 
            id="close-report-modal-btn"
            class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
            title="Tutup Jendela"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Modal Body (Printable Area) -->
      <div class="p-5 overflow-y-auto space-y-5 flex-grow" id="printable-report-area">
        
        <!-- Stats Summary Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5" id="report-stats-container">
          <div class="p-3.5 rounded-lg bg-secondary/50 border border-border space-y-0.5">
            <span class="text-[10px] text-muted-foreground uppercase font-mono">Siswa Enroll</span>
