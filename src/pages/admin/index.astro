          >
            <option value="">Semua Status Refleksi</option>
            <option value="pending">Menunggu Tanggapan Guru</option>
            <option value="reviewed">Telah Ditinjau Guru</option>
          </select>
        </div>
      </div>

      <!-- Reflection Submissions Table -->
      {reflectionSubmissions.length === 0 ? (
        <div class="p-8 text-center bg-background rounded-lg border border-border/50 text-xs text-muted-foreground space-y-2">
          <div class="text-2xl">💭</div>
          <p class="font-medium text-foreground">Belum ada jurnal refleksi yang dikirimkan oleh siswa.</p>
          <p class="text-[11px]">Ketika siswa mengisi formulir Refleksi di akhir modul pembelajaran, data kualitatif akan otomatis muncul di sini.</p>
        </div>
      ) : (
        <div class="overflow-x-auto border border-border rounded-lg">
          <table class="w-full text-left text-xs" id="reflections-table">
            <thead class="text-[11px] text-muted-foreground uppercase font-mono bg-secondary/40 border-b border-border">
              <tr>
                <th class="py-3 px-3">Siswa & Kelas</th>
                <th class="py-3 px-3">Modul Pembelajaran</th>
                <th class="py-3 px-3 min-w-[220px]">Cuplikan Pengalaman / Komitmen Siswa</th>
                <th class="py-3 px-3">Waktu Kirim</th>
                <th class="py-3 px-3">Status Tinjauan</th>
                <th class="py-3 px-3 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border font-medium bg-card">
              {reflectionSubmissions.map((sub: any) => {
                const isReviewed = sub.status === 'reviewed' || !!sub.teacherFeedback;
                const dateFormatted = new Date(sub.submittedAt).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                });

                // Parse reflection snippets safely
                let parsedFd: any = {};
                try {
                  let d = sub.formData;
                  while (typeof d === 'string') d = JSON.parse(d);
                  parsedFd = typeof d === 'object' && d !== null ? d : {};
                } catch { parsedFd = {}; }

                const q1Text = parsedFd.q1 || '';
                const q3Text = parsedFd.q3 || '';
                const q4Text = parsedFd.q4 || '';
                const previewSnippet = q4Text || q1Text || q3Text || 'Jurnal refleksi telah diisi.';

                return (
                  <tr 
                    class="reflection-row hover:bg-accent/40 transition-colors"
                    data-name={sub.userName.toLowerCase()}
                    data-email={sub.userEmail.toLowerCase()}
                    data-class={sub.studentClass || ''}
                    data-slug={sub.lessonSlug.toLowerCase()}
                    data-status={isReviewed ? 'reviewed' : 'pending'}
                  >
                    <td class="py-3 px-3">
                      <div class="space-y-0.5">
                        <div class="font-bold text-foreground">{sub.userName}</div>
                        <div class="text-[10px] text-muted-foreground font-mono flex items-center gap-1.5">
                          <span>{sub.userEmail}</span>
                          {sub.studentClass && (
                            <>
                              <span>•</span>
                              <span class="px-1.5 py-0.2 rounded bg-secondary text-foreground border border-border font-semibold">
                                {sub.studentClass}
                              </span>
                            </>
                          )}
                        </div>
                      </div>
                    </td>

