      </div>

      {allExamLogs.length === 0 ? (
        <div class="p-6 text-center text-xs text-muted-foreground">
          Belum ada rekaman ujian yang masuk dari siswa.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="text-[11px] text-muted-foreground uppercase font-mono border-b border-border">
              <tr>
                <th class="py-2.5 px-3">Nama Siswa</th>
                <th class="py-2.5 px-3">Kelas</th>
                <th class="py-2.5 px-3">Waktu Pengerjaan</th>
                <th class="py-2.5 px-3">Skor Nilai</th>
                <th class="py-2.5 px-3">Ketepatan</th>
                <th class="py-2.5 px-3">Status Hasil</th>
                <th class="py-2.5 px-3 text-right">XP Diberikan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border font-medium">
              {allExamLogs.map((exam) => {
                const examDate = new Date(exam.createdAt).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                });
                const isPass = exam.score >= 73;

                return (
                  <tr class="hover:bg-accent/40 transition-colors">
                    <td class="py-3 px-3 font-semibold text-foreground">
                      {exam.userName}
                      <span class="block text-[10px] text-muted-foreground font-mono font-normal">{exam.userEmail}</span>
                    </td>
                    <td class="py-3 px-3 font-mono">
                      {exam.studentClass ? (
                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-secondary text-foreground border border-border">
                          {exam.studentClass}
                        </span>
                      ) : (
                        <span class="text-muted-foreground text-[10px]">-</span>
                      )}
                    </td>
                    <td class="py-3 px-3 font-mono text-muted-foreground">
                      {examDate}
                    </td>
                    <td class="py-3 px-3 font-mono font-bold text-sm text-foreground">
                      {exam.score} / 100
                    </td>
                    <td class="py-3 px-3 font-mono text-muted-foreground">
                      {exam.correctAnswers} / {exam.totalQuestions} Soal
                    </td>
                    <td class="py-3 px-3">
                      <span class:list={[
                        "text-[10px] font-semibold px-2 py-0.5 rounded font-mono",
                        isPass 
                          ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25" 
                          : "bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25"
                      ]}>
                        {isPass ? 'KOMPETEN' : 'BELUM KOMPETEN'}
                      </span>
                    </td>
                    <td class="py-3 px-3 text-right font-mono font-semibold text-amber-600 dark:text-amber-400">
                      +{exam.xpEarned} XP
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

