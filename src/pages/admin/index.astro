                  <td class="py-3 px-3 text-muted-foreground font-mono user-email">
                    {u.email}
                  </td>
                  <td class="py-3 px-3">
                    {isUserSuperAdmin ? (
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/25">
                        Super Admin
                      </span>
                    ) : isUserTeacher ? (
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25">
                        Guru Pengampu
                      </span>
                    ) : (
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold uppercase bg-secondary text-muted-foreground border border-border">
                        Siswa
                      </span>
                    )}
                  </td>
                  <td class="py-3 px-3 font-mono">
                    <span class="text-emerald-600 dark:text-emerald-400 font-medium">Lvl {u.level || 1}</span>
                    <span class="text-muted-foreground text-[10px]"> • </span>
                    <span class="text-amber-600 dark:text-amber-400 font-semibold">{u.xp || 0} XP</span>
                  </td>
                  <td class="py-3 px-3 font-mono text-muted-foreground">
                    {regDate}
                  </td>
                  <td class="py-3 px-3 text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      {isUserSuperAdmin ? (
                        <span class="text-[10px] font-mono text-muted-foreground font-semibold px-2 py-0.5 rounded bg-secondary">
                          Root Owner
                        </span>
                      ) : (
                        <>
                          {isCurrentSuperAdmin && (
                            <button 
                              type="button"
                              data-user-id={u.id}
                              data-user-name={u.name}
                              data-current-role={isUserTeacher ? 'teacher' : 'student'}
                              data-target-role={isUserTeacher ? 'student' : 'teacher'}
                              class="role-toggle-btn px-2.5 py-1 rounded-md text-xs font-medium border transition-colors"
                              class:list={[
                                isUserTeacher
                                  ? "border-destructive/30 text-destructive hover:bg-destructive/10"
                                  : "border-amber-500/30 text-amber-600 dark:text-amber-400 bg-amber-500/10 hover:bg-amber-500/20"
                              ]}
                              title={isUserTeacher ? "Turunkan ke Siswa" : "Jadikan Guru"}
                            >
                              {isUserTeacher ? 'Cabut Guru' : 'Set Guru'}
                            </button>
                          )}

                          {!isSelf && (isCurrentSuperAdmin || !isUserTeacher) && (
                            <button 
                              type="button"
                              data-user-id={u.id}
                              data-user-name={u.name}
                              data-user-email={u.email}
                              class="delete-user-btn p-1 rounded-md text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors"
