        <div class="overflow-x-auto border border-border rounded-lg">
          <table class="w-full text-left text-xs" id="submissions-table">
            <thead class="text-[11px] text-muted-foreground uppercase font-mono bg-secondary/40 border-b border-border">
              <tr>
                <th class="py-3 px-3">Siswa & Kelas</th>
