                    </td>
                    <td class="py-3 px-3 text-right font-mono font-semibold text-amber-600 dark:text-amber-400">
                      +{exam.xpEarned} XP
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
