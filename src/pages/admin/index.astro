                    {u.studentClass ? (
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-secondary text-foreground border border-border user-class">
                        {u.studentClass}
                      </span>
                    ) : (
                      <span class="text-muted-foreground text-[10px] user-class">-</span>
                    )}
