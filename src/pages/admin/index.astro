            <thead class="text-[11px] text-muted-foreground uppercase font-mono border-b border-border">
              <tr>
                <th class="py-2.5 px-3">Nama Siswa</th>
                <th class="py-2.5 px-3">Kelas</th>
                <th class="py-2.5 px-3">Slug Modul Materi</th>
                <th class="py-2.5 px-3 text-right">Waktu Selesai</th>
