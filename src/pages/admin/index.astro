                        <div class="flex items-center justify-end gap-1.5">
                          <button 
                            type="button"
                            data-view-report-token-id={t.id}
                            data-token-code={t.token}
                            data-token-title={t.title}
                            class="view-report-btn px-2.5 py-1.5 rounded-md text-xs font-medium bg-cyan-600 hover:bg-cyan-500 text-white transition-colors flex items-center gap-1"
                          >
                            <span>📊 Rekap</span>
                          </button>

                          <button 
                            type="button"
                            data-delete-token-id={t.id}
                            data-token-title={t.title}
                            data-token-code={t.token}
                            class="delete-token-btn p-1.5 rounded-md text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors"
