          </thead>
          <tbody class="divide-y divide-border/40 font-medium">
            {allUsers.map((u) => {
              const regDate = new Date(u.createdAt).toLocaleDateString('id-ID', {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
              });
              const isSelf = u.id === user.userId;
              const isUserSuperAdmin = u.role === 'superadmin' || isSuperAdminEmail(u.email);
              const isUserTeacher = !isUserSuperAdmin && (u.role === 'teacher' || u.role === 'admin');

              return (
                <tr class="hover:bg-accent/40 transition-colors user-row">
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-2.5">
                      <div class:list={[
                        "w-8 h-8 rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0",
                        isUserSuperAdmin 
                          ? "bg-gradient-to-br from-purple-600 to-amber-500 shadow-md shadow-purple-500/20" 
                          : isUserTeacher 
                            ? "bg-gradient-to-br from-amber-500 to-orange-500"
                            : "bg-gradient-to-br from-blue-600 to-indigo-600"
                      ]}>
                        {u.name.substring(0, 2).toUpperCase()}
                      </div>
                      <div>
                        <span class="font-bold text-foreground block user-name">{u.name}</span>
                        {isSelf && (
                          <span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-400 font-mono">
                            Akun Anda
                          </span>
                        )}
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 font-mono">
                    {u.studentClass ? (
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 user-class">
                        {u.studentClass}
                      </span>
                    ) : (
                      <span class="text-muted-foreground text-[10px] user-class">-</span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-muted-foreground font-mono user-email">
                    {u.email}
                  </td>
                  <td class="py-3.5 px-4">
                    {isUserSuperAdmin ? (
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-purple-500/20 text-purple-300 border border-purple-500/40">
                        👑 Super Admin
                      </span>
                    ) : isUserTeacher ? (
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-amber-500/20 text-amber-300 border border-amber-500/40">
                        👨‍🏫 Guru Pengampu
                      </span>
                    ) : (
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-blue-500/20 text-blue-300 border border-blue-500/40">
                        👨‍🎓 Siswa
                      </span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 font-mono">
                    <span class="text-emerald-400 font-semibold">Lvl {u.level || 1}</span>
                    <span class="text-muted-foreground text-[10px]"> • </span>
                    <span class="text-amber-400 font-bold">{u.xp || 0} XP</span>
                  </td>
                  <td class="py-3.5 px-4 font-mono text-muted-foreground">
                    {regDate}
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      {isUserSuperAdmin ? (
                        <span class="text-[10px] font-mono text-purple-400 font-bold px-2.5 py-1 rounded-xl bg-purple-500/10 border border-purple-500/20">
                          Root Owner
                        </span>
                      ) : (
                        <>
                          {isCurrentSuperAdmin && (
                            <button 
                              type="button"
                              data-user-id={u.id}
                              data-user-name={u.name}
                              data-current-role={isUserTeacher ? 'teacher' : 'student'}
                              data-target-role={isUserTeacher ? 'student' : 'teacher'}
                              class="role-toggle-btn px-2.5 py-1.5 rounded-xl text-xs font-bold border transition-all hover:scale-105 shadow-sm"
                              class:list={[
                                isUserTeacher
                                  ? "border-red-500/40 text-red-400 hover:bg-red-500/10"
                                  : "border-amber-500/50 text-amber-300 bg-amber-500/10 hover:bg-amber-500/20"
                              ]}
                              title={isUserTeacher ? "Turunkan ke Siswa" : "Jadikan Guru"}
                            >
                              {isUserTeacher ? 'Cabut Guru' : '⭐ Set Guru'}
                            </button>
                          )}

                          {!isSelf && (isCurrentSuperAdmin || !isUserTeacher) && (
                            <button 
                              type="button"
                              data-user-id={u.id}
                              data-user-name={u.name}
                              data-user-email={u.email}
                              class="delete-user-btn p-1.5 rounded-xl text-muted-foreground hover:text-red-400 hover:bg-red-500/10 border border-border/40 hover:border-red-500/30 transition-all"
                              title="Hapus Akun Pengguna"
                            >
                              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                              </svg>
                            </button>
