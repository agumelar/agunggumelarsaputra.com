  function renderReflectionAnswers(rawFormData: any): string {
    const fd = parseFormDataSafe(rawFormData);
    const reflectionPrompts: Record<string, { label: string; icon: string }> = {
      q1: { label: 'Hal Baru yang Dipelajari tentang Rekayasa Perangkat Lunak & PPLG', icon: '🌱' },
      q2: { label: 'Urgensi Bukti Portofolio (Evidence) vs Ijazah Formal di Industri IT', icon: '💼' },
      q3: { label: 'Kendala & Solusi Teknis saat Menyiapkan Evidence Google Drive', icon: '⚠️' },
      q4: { label: 'Komitmen Belajar untuk Pertemuan / Modul Berikutnya', icon: '🎯' },
    };

    const keys = ['q1', 'q2', 'q3', 'q4'].filter(k => fd[k] !== undefined && fd[k] !== '');
    if (keys.length === 0) {
      // Check other fields
      const allKeys = Object.keys(fd).filter(k => !['studentName', 'studentNis', 'studentClass', 'submissionDate', 'driveUrl'].includes(k));
      if (allKeys.length === 0) {
        return '<div class="p-6 text-center text-muted-foreground italic bg-secondary/20 rounded-xl border border-border/50">Tidak ada isian refleksi yang tersimpan.</div>';
      }
      return `
        <div class="space-y-3">
          ${allKeys.map(k => `
            <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1.5">
              <span class="font-bold text-foreground block text-xs">${escapeHtml(k)}:</span>
              <div class="p-3 rounded-lg bg-card border border-border text-foreground text-xs leading-relaxed">
                ${escapeHtml(String(fd[k]))}
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    return `
      <div class="space-y-3">
        ${keys.map(k => {
          const item = reflectionPrompts[k] || { label: k, icon: '💡' };
          return `
            <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="text-base">${item.icon}</span>
                <span class="font-bold text-foreground text-xs font-mono">${escapeHtml(item.label)}</span>
              </div>
              <div class="p-3 rounded-lg bg-card border border-border text-foreground text-xs leading-relaxed font-normal whitespace-pre-wrap">
                ${escapeHtml(fd[k])}
              </div>
            </div>
