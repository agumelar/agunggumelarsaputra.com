---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { db, isDbConfigured, ensureDbInitialized } from '../../db';
import { users, userGamification, tkaAttempts, userProgress, enrollmentTokens, userEnrollments, userSubmissions, literasiReports } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

import { canAccessAdminPanel, isSuperAdmin, isSuperAdminEmail } from '../../utils/auth';

const user = Astro.locals.user;
if (!user || !canAccessAdminPanel(user.role)) {
  return Astro.redirect('/dashboard?error=unauthorized_admin');
}

const isCurrentSuperAdmin = isSuperAdmin(user.role) || isSuperAdminEmail(user.email);

let allUsers: any[] = [];
let allExamLogs: any[] = [];
let allLessonLogs: any[] = [];
let allTokens: any[] = [];
let allEnrollments: any[] = [];
let allSubmissions: any[] = [];
let allLiterasiReports: any[] = [];

if (isDbConfigured()) {
  try {
    await ensureDbInitialized();

    // Ensure Super Admin email has superadmin role in DB
    if (isCurrentSuperAdmin && user.email && isSuperAdminEmail(user.email)) {
      try {
        await db.update(users).set({ role: 'superadmin' }).where(eq(users.email, user.email.trim().toLowerCase()));
      } catch (e) {}
    }

    // 1. Fetch All Users + Gamification Info
    allUsers = await db.select({
      id: users.id,
      name: users.name,
      email: users.email,
      role: users.role,
      studentClass: users.studentClass,
      avatarUrl: users.avatarUrl,
      createdAt: users.createdAt,
      xp: userGamification.xp,
      level: userGamification.level,
      streakDays: userGamification.streakDays,
    }).from(users)
      .leftJoin(userGamification, eq(users.id, userGamification.userId))
      .orderBy(desc(users.createdAt));

    // 2. Fetch All Exam Attempts + User Info
    allExamLogs = await db.select({
      id: tkaAttempts.id,
      userId: tkaAttempts.userId,
      tokenId: tkaAttempts.tokenId,
      userName: users.name,
      userEmail: users.email,
      studentClass: users.studentClass,
      lessonSlug: tkaAttempts.lessonSlug,
      attemptNumber: tkaAttempts.attemptNumber,
      score: tkaAttempts.score,
      totalQuestions: tkaAttempts.totalQuestions,
      correctAnswers: tkaAttempts.correctAnswers,
      xpEarned: tkaAttempts.xpEarned,
      createdAt: tkaAttempts.createdAt,
    }).from(tkaAttempts)
      .innerJoin(users, eq(tkaAttempts.userId, users.id))
      .orderBy(desc(tkaAttempts.createdAt));

    // 3. Fetch All Lesson Progress + User Info
    allLessonLogs = await db.select({
      id: userProgress.id,
      userId: userProgress.userId,
      tokenId: userProgress.tokenId,
      userName: users.name,
      userEmail: users.email,
      studentClass: users.studentClass,
      lessonSlug: userProgress.lessonSlug,
      completedAt: userProgress.completedAt,
    }).from(userProgress)
      .innerJoin(users, eq(userProgress.userId, users.id))
      .orderBy(desc(userProgress.completedAt));

    // 4. Fetch All Enrollment Tokens
    allTokens = await db.select({
      id: enrollmentTokens.id,
      token: enrollmentTokens.token,
      title: enrollmentTokens.title,
      description: enrollmentTokens.description,
      targetType: enrollmentTokens.targetType,
      targetSlug: enrollmentTokens.targetSlug,
      targetClass: enrollmentTokens.targetClass,
      isActive: enrollmentTokens.isActive,
      createdAt: enrollmentTokens.createdAt,
      expiresAt: enrollmentTokens.expiresAt,
      creatorName: users.name,
    }).from(enrollmentTokens)
      .leftJoin(users, eq(enrollmentTokens.createdBy, users.id))
      .orderBy(desc(enrollmentTokens.createdAt));

    // 5. Fetch Enrollment counts
    allEnrollments = await db.select({
      id: userEnrollments.id,
      tokenId: userEnrollments.tokenId,
      userId: userEnrollments.userId,
    }).from(userEnrollments);

    // 6. Fetch All Submissions (LKPD & Reflection) + User Info
    try {
      const rawSubmissions = await db.select({
        id: userSubmissions.id,
        userId: userSubmissions.userId,
        tokenId: userSubmissions.tokenId,
        userName: users.name,
        userEmail: users.email,
        studentClass: users.studentClass,
        lessonSlug: userSubmissions.lessonSlug,
        submissionType: userSubmissions.submissionType,
        formData: userSubmissions.formData,
        driveUrl: userSubmissions.driveUrl,
        score: userSubmissions.score,
        teacherScore: userSubmissions.teacherScore,
        teacherLevel: userSubmissions.teacherLevel,
        teacherFeedback: userSubmissions.teacherFeedback,
        gradedBy: userSubmissions.gradedBy,
        gradedAt: userSubmissions.gradedAt,
        status: userSubmissions.status,
        submittedAt: userSubmissions.submittedAt,
        updatedAt: userSubmissions.updatedAt,
      }).from(userSubmissions)
        .innerJoin(users, eq(userSubmissions.userId, users.id))
        .orderBy(desc(userSubmissions.submittedAt));

      const uniqueSubMap = new Map();
      for (const sub of rawSubmissions) {
        const key = `${sub.userId}_${sub.lessonSlug}_${sub.submissionType}`;
        if (!uniqueSubMap.has(key)) {
          uniqueSubMap.set(key, sub);
        }
      }
      allSubmissions = Array.from(uniqueSubMap.values());
    } catch (subErr) {
      console.warn('Submissions query error in admin:', subErr);
      allSubmissions = [];
    }

    // 7. Fetch All Literasi Reports + User Info (Deduplicated: Keep latest per student per week)
    try {
      const rawLiterasiReports = await db.select({
        id: literasiReports.id,
        userId: literasiReports.userId,
        userName: users.name,
        userEmail: users.email,
        studentClass: users.studentClass,
        weekNumber: literasiReports.weekNumber,
        reportDate: literasiReports.reportDate,
        bookTitle: literasiReports.bookTitle,
        author: literasiReports.author,
        publisher: literasiReports.publisher,
        city: literasiReports.city,
        year: literasiReports.year,
        pageCount: literasiReports.pageCount,
        summary: literasiReports.summary,
        moralMessage: literasiReports.moralMessage,
        writingScore: literasiReports.writingScore,
        presentationScore: literasiReports.presentationScore,
        finalScore: literasiReports.finalScore,
        teacherFeedback: literasiReports.teacherFeedback,
        status: literasiReports.status,
        createdAt: literasiReports.createdAt,
      }).from(literasiReports)
        .innerJoin(users, eq(literasiReports.userId, users.id))
        .orderBy(desc(literasiReports.createdAt));

      const uniqueLitMap = new Map();
      for (const rep of rawLiterasiReports) {
        const key = `${rep.userId}_${rep.weekNumber}`;
        if (!uniqueLitMap.has(key)) {
          uniqueLitMap.set(key, rep);
        }
      }
      allLiterasiReports = Array.from(uniqueLitMap.values());
    } catch (litErr) {
      console.warn('Literasi query error in admin:', litErr);
      allLiterasiReports = [];
    }
  } catch (err) {
    console.error('Admin DB Error:', err);
  }
}

const enrollmentCountMap: Record<number, number> = {};
for (const e of allEnrollments) {
  enrollmentCountMap[e.tokenId] = (enrollmentCountMap[e.tokenId] || 0) + 1;
}

const examCountMap: Record<number, number> = {};
for (const ex of allExamLogs) {
  if (ex.tokenId) {
    examCountMap[ex.tokenId] = (examCountMap[ex.tokenId] || 0) + 1;
  }
}

// 6. Metrics Calculations (Checkpoint is automated & excluded from manual grading queue)
const lkpdSubmissions = allSubmissions.filter(s => s.submissionType === 'lkpd');
const reflectionSubmissions = allSubmissions.filter(s => s.submissionType === 'reflection');

const totalLkpd = lkpdSubmissions.length;
const pendingLkpd = lkpdSubmissions.filter(s => s.teacherScore === null || s.teacherScore === undefined).length;
const gradedLkpd = lkpdSubmissions.filter(s => s.teacherScore !== null && s.teacherScore !== undefined).length;

const totalReflections = reflectionSubmissions.length;
const pendingReflections = reflectionSubmissions.filter(s => s.status !== 'reviewed' && !s.teacherFeedback).length;
const reviewedReflections = reflectionSubmissions.filter(s => s.status === 'reviewed' || s.teacherFeedback).length;

const totalStudents = allUsers.filter(u => u.role === 'student' && !isSuperAdminEmail(u.email)).length;
const totalTeachers = allUsers.filter(u => (u.role === 'teacher' || u.role === 'admin') && !isSuperAdminEmail(u.email)).length;
const totalSuperAdmins = allUsers.filter(u => u.role === 'superadmin' || isSuperAdminEmail(u.email)).length;
const totalExamsTaken = allExamLogs.length;
const avgScoreAll = totalExamsTaken > 0
  ? Math.round(allExamLogs.reduce((acc, curr) => acc + curr.score, 0) / totalExamsTaken)
  : 0;
const passingExams = allExamLogs.filter(e => e.score >= 73).length;
const passRate = totalExamsTaken > 0 ? Math.round((passingExams / totalExamsTaken) * 100) : 0;

const totalLiterasi = allLiterasiReports.length;
const pendingLiterasi = allLiterasiReports.filter(r => r.status !== 'graded').length;
const gradedLiterasi = allLiterasiReports.filter(r => r.status === 'graded').length;
---

<DashboardLayout title="Panel Guru & Administrator" activeNav="/admin">
  <div class="space-y-6">
    
    <!-- Admin Hero Banner (High-Craft Dark Slate & Amber Gradient) -->
    <div class="card p-6 md:p-8 rounded-2xl border border-amber-500/20 bg-gradient-to-br from-card via-card to-amber-950/20 shadow-lg relative overflow-hidden space-y-5">
      <div class="absolute -right-8 -top-8 text-9xl opacity-5 pointer-events-none">⚡</div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
        <div class="space-y-2.5 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/20 text-[11px] font-mono font-bold uppercase tracking-wider">
              ADMINISTRATOR CONSOLE
            </span>
            <span class="px-2.5 py-0.5 rounded bg-secondary text-foreground border border-border text-[11px] font-mono font-semibold">
              GURU PENGAMPU RPL
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight">
            Konsol Manajemen Guru & Monitoring Siswa
          </h1>

          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            Kelola token sesi pembelajaran, evaluasi lembar kerja (LKPD), tinjau respon jurnal refleksi, pantau hak akses pengguna, dan analisis hasil ujian Drilling TKA secara <i>real-time</i>.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 flex-shrink-0">
          <a href="/admin/proyektor-leaderboard" target="_blank" class="btn btn-sm bg-gradient-to-r from-amber-500 via-orange-500 to-amber-400 hover:from-amber-400 hover:to-orange-400 text-black font-extrabold px-4 py-2 rounded-xl shadow-lg flex items-center gap-2 animate-pulse border-0">
            <span class="text-base">📺</span>
            <span>Layar Proyektor Live Score</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 5 KPI Metrics Premium Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
      
      <!-- Metric 1: Total Pengguna -->
      <div class="card p-4 rounded-xl border border-amber-500/20 bg-card space-y-1.5 shadow-sm hover:border-amber-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold text-muted-foreground uppercase font-mono">Siswa & Guru</span>
          <span class="text-xs px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 font-mono font-bold">👥 Users</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-foreground font-mono">
          {totalStudents} <span class="text-xs text-muted-foreground font-sans font-normal">Siswa</span>
        </div>
        <div class="text-[10px] font-mono text-muted-foreground truncate pt-0.5">
          <span class="text-amber-500 font-semibold">{totalTeachers} Guru</span> • <span class="text-purple-400 font-semibold">{totalSuperAdmins} Super Admin</span>
        </div>
      </div>

      <!-- Metric 2: Token Sesi Aktif -->
      <div class="card p-4 rounded-xl border border-cyan-500/20 bg-card space-y-1.5 shadow-sm hover:border-cyan-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold text-muted-foreground uppercase font-mono">Token Sesi</span>
          <span class="text-xs px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 font-mono font-bold">🎟️ Sesi</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-cyan-400 font-mono">
          {allTokens.filter(t => t.isActive).length} <span class="text-xs text-muted-foreground font-sans font-normal">Aktif</span>
        </div>
        <p class="text-[10px] text-muted-foreground font-mono">Total {allTokens.length} token terdaftar</p>
      </div>

      <!-- Metric 3: Penilaian LKPD -->
      <div class="card p-4 rounded-xl border border-purple-500/20 bg-card space-y-1.5 shadow-sm hover:border-purple-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold text-muted-foreground uppercase font-mono">Evaluasi LKPD</span>
          <span class="text-xs px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 font-mono font-bold">📝 LKPD</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-purple-400 font-mono">
          {totalLkpd} <span class="text-xs text-muted-foreground font-sans font-normal">Set</span>
        </div>
        <p class="text-[10px] text-muted-foreground font-mono">
          <span class="text-amber-400 font-bold">{pendingLkpd} Menunggu</span> • <span class="text-emerald-400 font-bold">{gradedLkpd} Dinilai</span>
        </p>
      </div>

      <!-- Metric 4: Jurnal Refleksi -->
      <div class="card p-4 rounded-xl border border-pink-500/20 bg-card space-y-1.5 shadow-sm hover:border-pink-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold text-muted-foreground uppercase font-mono">Jurnal Refleksi</span>
          <span class="text-xs px-2 py-0.5 rounded bg-pink-500/10 text-pink-400 font-mono font-bold">💭 Refleksi</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-pink-400 font-mono">
          {totalReflections} <span class="text-xs text-muted-foreground font-sans font-normal">Jurnal</span>
        </div>
        <p class="text-[10px] text-muted-foreground font-mono">
          <span class="text-amber-400 font-bold">{pendingReflections} Baru</span> • <span class="text-pink-400 font-bold">{reviewedReflections} Ditinjau</span>
        </p>
      </div>

      <!-- Metric 5: Rata-Rata TKA -->
      <div class="card p-4 rounded-xl border border-blue-500/20 bg-card space-y-1.5 shadow-sm hover:border-blue-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold text-muted-foreground uppercase font-mono">Rata-Rata TKA</span>
          <span class="text-xs px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 font-mono font-bold">📊 Score</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-amber-400 font-mono">
          {avgScoreAll} <span class="text-xs text-muted-foreground font-sans font-normal">/ 100</span>
        </div>
        <p class="text-[10px] text-muted-foreground font-mono">Lulus KKM: <span class="text-emerald-400 font-bold">{passRate}%</span></p>
      </div>

      <!-- Metric 6: Rabu Literasi RESIK -->
      <div class="card p-4 rounded-xl border border-emerald-500/20 bg-card space-y-1.5 shadow-sm hover:border-emerald-500/40 transition-all">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold text-muted-foreground uppercase font-mono">Rabu Literasi</span>
          <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono font-bold">📚 RESIK</span>
        </div>
        <div class="text-2xl sm:text-3xl font-bold text-emerald-400 font-mono">
          {totalLiterasi} <span class="text-xs text-muted-foreground font-sans font-normal">Resensi</span>
        </div>
        <p class="text-[10px] text-muted-foreground font-mono">
          <span class="text-amber-400 font-bold">{pendingLiterasi} Menunggu</span> • <span class="text-emerald-400 font-bold">{gradedLiterasi} Dinilai</span>
        </p>
      </div>

    </div>

    <!-- Alert Notification -->
    <div id="admin-alert" class="hidden p-3.5 rounded-lg text-xs font-medium text-center transition-all"></div>

    <!-- ========================================== -->
    <!-- STICKY TABBED CONSOLE NAVIGATION (Fix Clutter & Overwhelm) -->
    <!-- ========================================== -->
    <div class="sticky top-2 z-30 p-2 rounded-2xl bg-card/95 backdrop-blur-md border border-border shadow-xl flex items-center justify-between gap-2 overflow-x-auto">
      <div class="flex items-center gap-1.5 min-w-max">
        <button data-admin-tab="all" class="admin-tab-btn active px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 text-black shadow-md">
          <span>🌐</span>
          <span>Semua Tampilan</span>
        </button>

        <button data-admin-tab="tokens" class="admin-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all flex items-center gap-2">
          <span>🎟️</span>
          <span>Token Sesi</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">{allTokens.length}</span>
        </button>

        <button data-admin-tab="submissions" class="admin-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all flex items-center gap-2">
          <span>📝</span>
          <span>Evaluasi LKPD</span>
          {pendingLkpd > 0 ? (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">{pendingLkpd} Menunggu</span>
          ) : (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">{totalLkpd}</span>
          )}
        </button>

        <button data-admin-tab="reflections" class="admin-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all flex items-center gap-2">
          <span>💭</span>
          <span>Jurnal Refleksi</span>
          {pendingReflections > 0 ? (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-pink-500/10 text-pink-400 border border-pink-500/20 animate-pulse">{pendingReflections} Baru</span>
          ) : (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-purple-500/10 text-purple-400 border border-purple-500/20">{totalReflections}</span>
          )}
        </button>

        <button data-admin-tab="students" class="admin-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all flex items-center gap-2">
          <span>👥</span>
          <span>Data Siswa</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-amber-500/10 text-amber-400 border border-amber-500/20">{totalStudents}</span>
        </button>

        <button data-admin-tab="exams" class="admin-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all flex items-center gap-2">
          <span>📊</span>
          <span>Log Ujian TKA</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20">{totalExamsTaken}</span>
        </button>

        <button data-admin-tab="literasi" class="admin-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all flex items-center gap-2">
          <span>📚</span>
          <span>Rabu Literasi</span>
          {pendingLiterasi > 0 ? (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">{pendingLiterasi} Menunggu</span>
          ) : (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">{totalLiterasi}</span>
          )}
        </button>

        <button data-admin-tab="lesson-logs" class="admin-tab-btn px-3.5 py-2 rounded-xl text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-secondary/60 transition-all flex items-center gap-2">
          <span>📖</span>
          <span>Log Modul</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-secondary text-foreground border border-border">{allLessonLogs.length}</span>
        </button>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- SECTION 0: MANAJEMEN TOKEN SESI (ROLL & REKAP PER-TOKEN) -->
    <!-- ========================================== -->
    <div id="tokens" class="card p-5 sm:p-6 rounded-xl border-border bg-card space-y-6 shadow-sm">

      <!-- Header & Create Token Form -->
      <div class="space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-4">
          <div>
            <h2 class="text-base font-bold text-foreground flex items-center gap-2">
              <span>🎟️ Manajemen Token Sesi Belajar & Ujian (Roll Token)</span>
              <span class="text-[10px] px-2 py-0.5 rounded font-mono font-semibold bg-secondary text-foreground border border-border">
                REKAP PER-TOKEN
              </span>
            </h2>
            <p class="text-xs text-muted-foreground mt-1">
              Buat (Roll) Token baru untuk sesi kelas tertentu. Siswa wajib melakukan <b>Enroll Token</b> agar data pengerjaan ujian dan modul tercatat rapi per-sesi.
            </p>
          </div>

          <button 
            type="button" 
            id="toggle-create-token-btn"
            class="px-3.5 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs transition-colors flex items-center gap-2 flex-shrink-0"
          >
            <span>+ Buat (Roll) Token Baru</span>
          </button>
        </div>

        <!-- Form Pembuatan Token Baru (Collapsible) -->
        <div id="create-token-card" class="hidden p-5 rounded-lg bg-secondary/40 border border-border space-y-4">
          <div class="flex items-center justify-between border-b border-border pb-2.5">
            <h3 class="text-xs font-bold text-foreground flex items-center gap-2">
              <span>🎲 Formulir Penerbitan Token Sesi Baru</span>
            </h3>
            <span class="text-[11px] text-muted-foreground font-mono">Pengampu: {user.name}</span>
          </div>

          <form id="create-token-form" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              
              <!-- Judul Sesi -->
              <div class="md:col-span-2 space-y-1">
