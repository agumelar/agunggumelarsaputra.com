    printWindow.document.write(printHtml);
    printWindow.document.close();
    setTimeout(() => { printWindow.print(); }, 400);
  });

  // Feedback preset chips
  const litFeedbackPresets = document.querySelectorAll('.lit-feedback-preset');
  litFeedbackPresets.forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-text') || '';
      if (litTeacherFeedback) {
        litTeacherFeedback.value = litTeacherFeedback.value ? litTeacherFeedback.value + ' ' + text : text;
      }
    });
  });

  // Submit Literasi Grade
  submitLitGradeBtn?.addEventListener('click', async () => {
    const reportId = Number(litReportIdInput?.value);
    if (!reportId) {
      alert('Data laporan tidak valid.');
      return;
    }

    submitLitGradeBtn.textContent = 'Menyimpan...';
    (submitLitGradeBtn as HTMLButtonElement).disabled = true;

    const w1 = Number((document.getElementById('lit-w1') as HTMLInputElement)?.value) || 3;
    const w2 = Number((document.getElementById('lit-w2') as HTMLInputElement)?.value) || 3;
    const w3 = Number((document.getElementById('lit-w3') as HTMLInputElement)?.value) || 3;
    const w4 = Number((document.getElementById('lit-w4') as HTMLInputElement)?.value) || 3;
    const p1 = Number((document.getElementById('lit-p1') as HTMLInputElement)?.value) || 3;
    const p2 = Number((document.getElementById('lit-p2') as HTMLInputElement)?.value) || 3;
    const p3 = Number((document.getElementById('lit-p3') as HTMLInputElement)?.value) || 3;
    const p4 = Number((document.getElementById('lit-p4') as HTMLInputElement)?.value) || 3;
    const p5 = Number((document.getElementById('lit-p5') as HTMLInputElement)?.value) || 3;
    const teacherFeedback = litTeacherFeedback?.value.trim() || '';

    try {
      const res = await fetch('/api/literasi/grade', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reportId, w1, w2, w3, w4, p1, p2, p3, p4, p5, teacherFeedback })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        showAlert(data.message || 'Penilaian RESIK berhasil disimpan!');
        closeLitModal();
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showAlert(data.error || 'Gagal menyimpan penilaian RESIK.', true);
        submitLitGradeBtn.innerHTML = '<span>💾 Simpan Nilai RESIK</span>';
        (submitLitGradeBtn as HTMLButtonElement).disabled = false;
      }
    } catch (err: any) {
      showAlert(err.message || 'Terjadi kesalahan jaringan.', true);
      submitLitGradeBtn.innerHTML = '<span>💾 Simpan Nilai RESIK</span>';
      (submitLitGradeBtn as HTMLButtonElement).disabled = false;
    }
  });

</script>
