            </thead>
            <tbody class="divide-y divide-border font-medium">
              {allLessonLogs.map((log) => {
                const finishDate = new Date(log.completedAt).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                });

                return (
                  <tr class="hover:bg-accent/40 transition-colors">
                    <td class="py-3 px-3 font-semibold text-foreground">
                      {log.userName}
                    </td>
                    <td class="py-3 px-3 font-mono">
                      {log.studentClass ? (
                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-secondary text-foreground border border-border">
                          {log.studentClass}
                        </span>
                      ) : (
                        <span class="text-muted-foreground text-[10px]">-</span>
                      )}
                    </td>
                    <td class="py-3 px-3 font-mono text-primary">
                      /pembelajaran/{log.lessonSlug}
                    </td>
                    <td class="py-3 px-3 text-right font-mono text-muted-foreground">
                      {finishDate}
                    </td>
