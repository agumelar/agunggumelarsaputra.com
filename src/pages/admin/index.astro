  <!-- MODAL TINJAUAN JURNAL REFLEKSI SISWA (FORMATIF KUALITATIF) -->
  <!-- ========================================== -->
  <div id="reflection-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-5 transition-all">
    <div class="bg-card border border-border/80 rounded-2xl max-w-3xl w-full max-h-[92vh] flex flex-col shadow-2xl overflow-hidden animate-fadeIn">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 border-b border-border flex items-start sm:items-center justify-between bg-secondary/40 gap-3">
        <div class="space-y-1">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2.5 py-0.5 rounded font-mono font-bold text-xs bg-pink-500/15 text-pink-600 dark:text-pink-400 border border-pink-500/30">
              💭 JURNAL REFLEKSI SISWA
            </span>
            <span class="px-2.5 py-0.5 rounded font-mono text-xs bg-secondary text-foreground border border-border" id="refl-modal-class">
              -
            </span>
            <span class="text-xs text-muted-foreground font-mono hidden sm:inline" id="refl-modal-slug">
              -
            </span>
          </div>
          <h3 class="text-base sm:text-lg font-extrabold text-foreground tracking-tight" id="refl-modal-student">
            Refleksi Siswa
          </h3>
        </div>

        <button 
          type="button" 
          id="close-refl-modal-btn"
          class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-accent transition-colors shrink-0"
          title="Tutup Modal (Esc)"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-4 sm:p-6 overflow-y-auto space-y-6 flex-grow">
        
        <!-- Section A: Student Qualitative Voice / Responses -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-foreground uppercase tracking-wider font-mono flex items-center gap-2">
              <span>💡 Isian Jurnal Refleksi Mandiri Siswa</span>
            </h4>
            <div id="refl-modal-drive-container" class="hidden">
              <a 
                id="refl-modal-drive-link" 
                href="#" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-3 py-1 rounded-lg bg-pink-500/10 text-pink-600 dark:text-pink-400 border border-pink-500/25 text-xs font-semibold hover:bg-pink-500/20 transition-all flex items-center gap-1.5"
              >
                <span>📂 Buka Bukti Drive Siswa</span> ↗
              </a>
            </div>
          </div>

          <div id="refl-modal-answers-area" class="space-y-3">
            <!-- Dynamically populated reflection questions -->
          </div>
        </div>

        <!-- Section B: Teacher Qualitative Feedback & Appreciation Form -->
        <div class="p-4 sm:p-5 rounded-2xl bg-secondary/30 border border-border/90 space-y-4">
          <div class="flex items-center justify-between border-b border-border/60 pb-3">
            <div>
              <h4 class="text-xs font-bold text-foreground uppercase tracking-wider font-mono flex items-center gap-2">
                <span>💬 Tanggapan & Apresiasi Guru</span>
              </h4>
              <p class="text-[11px] text-muted-foreground mt-0.5">
                Refleksi tidak membutuhkan skor angka / KKM agar siswa terbiasa jujur dan terbuka saat mengevaluasi diri.
              </p>
            </div>
            <span class="text-[11px] font-mono text-muted-foreground hidden sm:inline">
              Pengampu: Agung Gumelar Saputra, S.Tr.T.
            </span>
          </div>

          <form id="teacher-reflection-form" class="space-y-4">
            <input type="hidden" id="refl-submission-id" />

            <!-- Feedback & Presets -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label for="refl-feedback-input" class="text-xs font-semibold text-foreground">
                  <span>Catatan Apresiasi / Tanggapan untuk Siswa</span>
                </label>
                <span class="text-[10px] text-muted-foreground">Klik preset cepat di bawah:</span>
              </div>

              <!-- Quick Reflection Preset Chips -->
              <div class="flex flex-wrap gap-1.5">
                <button type="button" class="quick-refl-chip px-2.5 py-1 rounded-md bg-card hover:bg-accent text-foreground text-[11px] border border-border transition-colors" data-preset="Terima kasih atas refleksimu yang sangat jujur dan mendalam! Pertahankan semangat eksplorasi dan rasa ingin tahumu. 🌟">
                  ✨ Sangat Mendalam
                </button>
                <button type="button" class="quick-refl-chip px-2.5 py-1 rounded-md bg-card hover:bg-accent text-foreground text-[11px] border border-border transition-colors" data-preset="Bagus sekali! Kendala yang kamu alami adalah hal wajar dalam belajar pemrograman. Terus berlatih dan jangan ragu bertanya. 💪">
                  💪 Apresiasi Kendala
                </button>
                <button type="button" class="quick-refl-chip px-2.5 py-1 rounded-md bg-card hover:bg-accent text-foreground text-[11px] border border-border transition-colors" data-preset="Pemahaman konsepmu terhadap materi modul ini sudah sangat baik. Komitmen belajarmu patut diacungi jempol! 👍">
                  👍 Konsep Sangat Baik
                </button>
                <button type="button" class="quick-refl-chip px-2.5 py-1 rounded-md bg-card hover:bg-accent text-foreground text-[11px] border border-border transition-colors" data-preset="Catatan kendala teknismu telah dicatat. Pada sesi tatap muka berikutnya kita akan bedah solusinya bersama. 🎯">
                  🎯 Solusi di Sesi Depan
                </button>
              </div>

              <textarea 
                id="refl-feedback-input" 
                rows="3" 
                placeholder="Tuliskan apresiasi, motivasi, atau jawaban atas kendala yang dialami siswa saat belajar..."
                class="w-full px-3.5 py-2.5 bg-background border border-border rounded-xl text-xs text-foreground focus:outline-none focus:border-primary placeholder:text-muted-foreground leading-relaxed"
              ></textarea>
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-2 border-t border-border/60">
              <button 
                type="button" 
                id="cancel-refl-btn"
                class="px-4 py-2.5 rounded-xl text-xs font-medium bg-secondary hover:bg-accent text-foreground border border-border transition-colors"
              >
                Batal
              </button>
              <button 
                type="submit" 
                id="submit-refl-btn"
                class="px-6 py-2.5 rounded-xl text-xs font-bold bg-pink-600 hover:bg-pink-500 text-white transition-all shadow-md hover:shadow-pink-500/20 flex items-center gap-1.5"
              >
                <span id="refl-btn-text">✓ Simpan Tanggapan Guru</span>
              </button>
            </div>
          </form>
        </div>

      </div>

    </div>
  </div>

</DashboardLayout>

<script>
  // 1. Alert Helper
  const alertBox = document.getElementById('admin-alert');
  function showAlert(msg: string, isError = false) {
    if (!alertBox) return;
    alertBox.className = isError 
      ? 'p-3 rounded-lg text-xs font-semibold text-center bg-destructive/10 border border-destructive/25 text-destructive block animate-fadeIn'
      : 'p-3 rounded-lg text-xs font-semibold text-center bg-emerald-500/10 border border-emerald-500/25 text-emerald-600 dark:text-emerald-400 block animate-fadeIn';
    alertBox.textContent = (isError ? '✕ ' : '✓ ') + msg;
  }

  // 2. Roll Token (Create Token) Form
  const toggleCreateTokenBtn = document.getElementById('toggle-create-token-btn');
  const createTokenCard = document.getElementById('create-token-card');
  const cancelCreateTokenBtn = document.getElementById('cancel-create-token-btn');
  const createTokenForm = document.getElementById('create-token-form') as HTMLFormElement | null;
  const submitTokenBtn = document.getElementById('submit-token-btn') as HTMLButtonElement | null;
  const tokenBtnText = document.getElementById('token-btn-text');

  toggleCreateTokenBtn?.addEventListener('click', () => {
    createTokenCard?.classList.toggle('hidden');
    if (!createTokenCard?.classList.contains('hidden')) {
      (document.getElementById('token-title') as HTMLInputElement)?.focus();
    }
  });

  cancelCreateTokenBtn?.addEventListener('click', () => {
    createTokenCard?.classList.add('hidden');
  });

  createTokenForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const title = (document.getElementById('token-title') as HTMLInputElement)?.value.trim();
    const targetClass = (document.getElementById('token-target-class') as HTMLSelectElement)?.value;
    const targetType = (document.getElementById('token-target-type') as HTMLSelectElement)?.value;
    const customToken = (document.getElementById('token-custom-code') as HTMLInputElement)?.value.trim();
    const description = (document.getElementById('token-description') as HTMLInputElement)?.value.trim();

    if (!title) {
      alert('Judul sesi token wajib diisi.');
      return;
    }

    if (submitTokenBtn) submitTokenBtn.disabled = true;
    if (tokenBtnText) tokenBtnText.textContent = 'Menerbitkan Token...';

    try {
      const res = await fetch('/api/admin/tokens/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title,
          targetClass,
          targetType,
          customToken,
          description,
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        showAlert(`Token sesi "${data.token.token}" berhasil diterbitkan!`);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showAlert(data.error || 'Gagal menerbitkan token.', true);
        if (submitTokenBtn) submitTokenBtn.disabled = false;
        if (tokenBtnText) tokenBtnText.textContent = 'Terbitkan Token Sesi';
      }
    } catch (err: any) {
      showAlert(err.message || 'Terjadi kesalahan jaringan.', true);
      if (submitTokenBtn) submitTokenBtn.disabled = false;
      if (tokenBtnText) tokenBtnText.textContent = 'Terbitkan Token Sesi';
    }
  });

  // 3. Copy Token Clipboard
  document.querySelectorAll('.copy-token-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const token = btn.getAttribute('data-copy-token');
      if (token) {
        navigator.clipboard.writeText(token);
        showAlert(`Kode token ${token} disalin ke clipboard! Bagikan kode ini ke siswa.`);
      }
    });
  });

  // 4. Toggle Token Status
  document.querySelectorAll('.toggle-token-status-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tokenId = btn.getAttribute('data-token-id');
      const currentActive = btn.getAttribute('data-token-active') === 'true';
      const newActive = !currentActive;

      try {
        const res = await fetch('/api/admin/tokens/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tokenId: Number(tokenId), isActive: newActive })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showAlert(`Status token berhasil diubah menjadi ${newActive ? 'AKTIF' : 'NONAKTIF'}.`);
          setTimeout(() => window.location.reload(), 800);
        } else {
          showAlert(data.error || 'Gagal mengubah status token.', true);
        }
      } catch (err) {
        showAlert('Gangguan jaringan saat mengubah status token.', true);
      }
    });
  });

  // 5. Delete Token
  document.querySelectorAll('.delete-token-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tokenId = btn.getAttribute('data-delete-token-id');
      const tokenTitle = btn.getAttribute('data-token-title');
      const tokenCode = btn.getAttribute('data-token-code');

      if (!confirm(`Hapus Token Sesi:\n"${tokenTitle}" (${tokenCode})?\n\nPerhatian: Riwayat pendaftaran siswa pada token ini akan ikut terhapus.`)) {
        return;
      }

      try {
        const res = await fetch('/api/admin/tokens/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tokenId: Number(tokenId) })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          showAlert('Token sesi berhasil dihapus.');
          setTimeout(() => window.location.reload(), 800);
        } else {
          showAlert(data.error || 'Gagal menghapus token.', true);
        }
      } catch (err) {
        showAlert('Gangguan jaringan saat menghapus token.', true);
      }
    });
  });

  // 6. View Report Modal per Token
  const reportModal = document.getElementById('report-modal');
  const closeReportModalBtn = document.getElementById('close-report-modal-btn');
  const printReportBtn = document.getElementById('print-report-btn');
  const modalTokenCode = document.getElementById('report-modal-token-code');
  const modalTargetClass = document.getElementById('report-modal-target-class');
  const modalTitle = document.getElementById('report-modal-title');
  const statEnrolled = document.getElementById('stat-enrolled');
  const statTaken = document.getElementById('stat-taken');
  const statAvg = document.getElementById('stat-avg');
  const statPass = document.getElementById('stat-pass');
  const reportTbody = document.getElementById('report-students-tbody');

  closeReportModalBtn?.addEventListener('click', () => {
    reportModal?.classList.add('hidden');
  });

  printReportBtn?.addEventListener('click', () => {
    window.print();
  });

  document.querySelectorAll('.view-report-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tokenId = btn.getAttribute('data-view-report-token-id');
      const tokenCode = btn.getAttribute('data-token-code') || '';
      const tokenTitle = btn.getAttribute('data-token-title') || '';

      if (modalTokenCode) modalTokenCode.textContent = tokenCode;
      if (modalTitle) modalTitle.textContent = tokenTitle;
      if (reportTbody) reportTbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-muted-foreground">Mengambil rekap data peserta...</td></tr>';
      
      reportModal?.classList.remove('hidden');

      try {
        const res = await fetch(`/api/admin/tokens/report?tokenId=${tokenId}`);
        const data = await res.json();

        if (res.ok && data.success) {
          if (modalTargetClass) modalTargetClass.textContent = `Kelas: ${data.token.targetClass}`;
          if (statEnrolled) statEnrolled.textContent = data.stats.totalEnrolled.toString();
          if (statTaken) statTaken.textContent = data.stats.totalExamTaken.toString();
          if (statAvg) statAvg.textContent = `${data.stats.avgScore} / 100`;
          if (statPass) statPass.textContent = `${data.stats.passRate}% (${data.stats.passCount} Siswa)`;

          if (!data.students || data.students.length === 0) {
            if (reportTbody) reportTbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-muted-foreground">Belum ada siswa yang melakukan enroll pada token ini.</td></tr>';
          } else {
            let html = '';
            data.students.forEach((s: any, idx: number) => {
              const dateStr = s.examSubmittedAt 
                ? new Date(s.examSubmittedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
                : '-';

              const isPass = s.examScore !== null && s.examScore >= 73;
              const statusBadge = s.hasTakenExam 
                ? `<span class="px-2 py-0.5 rounded text-[10px] font-semibold ${isPass ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25' : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25'}">${isPass ? 'KOMPETEN' : 'BELUM KOMPETEN'}</span>`
                : '<span class="text-muted-foreground text-[10px]">Belum Ujian</span>';

              const scoreVal = s.examScore !== null ? `<span class="font-bold text-foreground font-mono text-sm">${s.examScore}</span>` : '<span class="text-muted-foreground">-</span>';
              const correctVal = s.correctAnswers !== null ? `${s.correctAnswers}/${s.totalQuestions}` : '-';

              html += `
                <tr class="hover:bg-accent/40 transition-colors">
                  <td class="py-2.5 px-3 font-mono text-muted-foreground">${idx + 1}</td>
                  <td class="py-2.5 px-3 font-semibold text-foreground">${s.name}</td>
                  <td class="py-2.5 px-3 font-mono">${s.studentClass}</td>
                  <td class="py-2.5 px-3">${statusBadge}</td>
                  <td class="py-2.5 px-3">${scoreVal}</td>
                  <td class="py-2.5 px-3 font-mono text-muted-foreground">${correctVal}</td>
                  <td class="py-2.5 px-3 font-mono text-muted-foreground text-[11px]">${dateStr}</td>
                </tr>
              `;
            });
            if (reportTbody) reportTbody.innerHTML = html;
          }
        } else {
          if (reportTbody) reportTbody.innerHTML = `<tr><td colspan="7" class="text-center py-6 text-destructive">Gagal: ${data.error || 'Terjadi kesalahan'}</td></tr>`;
        }
      } catch (err) {
        if (reportTbody) reportTbody.innerHTML = '<tr><td colspan="7" class="text-center py-6 text-destructive">Gangguan jaringan saat memuat rekap.</td></tr>';
      }
    });
  });

  // 7. LKPD Submissions Filter & Search Logic
  const subSearchInput = document.getElementById('submission-search-input') as HTMLInputElement | null;
  const subClassFilter = document.getElementById('submission-class-filter') as HTMLSelectElement | null;
  const subStatusFilter = document.getElementById('submission-status-filter') as HTMLSelectElement | null;
  const subRows = document.querySelectorAll('.submission-row');

  function applySubmissionFilters() {
    const q = subSearchInput?.value.toLowerCase().trim() || '';
    const selectedClass = subClassFilter?.value || '';
    const selectedStatus = subStatusFilter?.value || '';

    subRows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const email = row.getAttribute('data-email') || '';
      const rowClass = row.getAttribute('data-class') || '';
      const slug = row.getAttribute('data-slug') || '';
      const status = row.getAttribute('data-status') || '';
      const graded = row.getAttribute('data-graded') || '';

      const matchesSearch = !q || name.includes(q) || email.includes(q) || slug.includes(q);
      const matchesClass = !selectedClass || rowClass === selectedClass;
      
      let matchesStatus = true;
      if (selectedStatus === 'pending') matchesStatus = graded === 'pending';
      else if (selectedStatus === 'graded') matchesStatus = graded === 'graded';
      else if (selectedStatus === 'passed') matchesStatus = status === 'passed';
      else if (selectedStatus === 'remedial') matchesStatus = status === 'remedial';

      if (matchesSearch && matchesClass && matchesStatus) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  }

  subSearchInput?.addEventListener('input', applySubmissionFilters);
  subClassFilter?.addEventListener('change', applySubmissionFilters);
  subStatusFilter?.addEventListener('change', applySubmissionFilters);

  // 7b. Jurnal Refleksi Filter & Search Logic
  const reflSearchInput = document.getElementById('reflection-search-input') as HTMLInputElement | null;
  const reflClassFilter = document.getElementById('reflection-class-filter') as HTMLSelectElement | null;
  const reflStatusFilter = document.getElementById('reflection-status-filter') as HTMLSelectElement | null;
  const reflRows = document.querySelectorAll('.reflection-row');

  function applyReflectionFilters() {
    const q = reflSearchInput?.value.toLowerCase().trim() || '';
    const selectedClass = reflClassFilter?.value || '';
    const selectedStatus = reflStatusFilter?.value || '';

    reflRows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const email = row.getAttribute('data-email') || '';
      const rowClass = row.getAttribute('data-class') || '';
      const slug = row.getAttribute('data-slug') || '';
      const status = row.getAttribute('data-status') || '';

      const matchesSearch = !q || name.includes(q) || email.includes(q) || slug.includes(q);
      const matchesClass = !selectedClass || rowClass === selectedClass;
      const matchesStatus = !selectedStatus || status === selectedStatus;

      if (matchesSearch && matchesClass && matchesStatus) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  }

  reflSearchInput?.addEventListener('input', applyReflectionFilters);
  reflClassFilter?.addEventListener('change', applyReflectionFilters);
  reflStatusFilter?.addEventListener('change', applyReflectionFilters);

  // 8. LKPD Teacher Grading Modal & Rich Answer Renderer
  const gradeModal = document.getElementById('grade-modal');
  const closeGradeModalBtn = document.getElementById('close-grade-modal-btn');
  const cancelGradeBtn = document.getElementById('cancel-grade-btn');
  const teacherGradeForm = document.getElementById('teacher-grade-form') as HTMLFormElement | null;
  const submitGradeBtn = document.getElementById('submit-grade-btn') as HTMLButtonElement | null;
  const gradeBtnText = document.getElementById('grade-btn-text');

  const gradeModalStudent = document.getElementById('grade-modal-student');
  const gradeModalClass = document.getElementById('grade-modal-class');
  const gradeModalType = document.getElementById('grade-modal-type');
  const gradeModalSlug = document.getElementById('grade-modal-slug');
  const gradeModalAnswersArea = document.getElementById('grade-modal-answers-area');
  const gradeModalDriveContainer = document.getElementById('grade-modal-drive-link-container');
  const gradeModalDriveLink = document.getElementById('grade-modal-drive-link') as HTMLAnchorElement | null;

  const inputSubmissionId = document.getElementById('grade-submission-id') as HTMLInputElement | null;
  const inputScore = document.getElementById('grade-score-input') as HTMLInputElement | null;
  const scoreStatusIndicator = document.getElementById('score-status-indicator');
  const selectLevel = document.getElementById('grade-level-select') as HTMLSelectElement | null;
  const textareaFeedback = document.getElementById('grade-feedback-input') as HTMLTextAreaElement | null;

  function closeGradeModal() {
    gradeModal?.classList.add('hidden');
  }

  closeGradeModalBtn?.addEventListener('click', closeGradeModal);
  cancelGradeBtn?.addEventListener('click', closeGradeModal);

  // Close on Escape or click outside
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (gradeModal && !gradeModal.classList.contains('hidden')) closeGradeModal();
      if (reflModal && !reflModal.classList.contains('hidden')) closeReflModal();
    }
  });

  gradeModal?.addEventListener('click', (e) => {
    if (e.target === gradeModal) {
      closeGradeModal();
    }
  });

  // Quick feedback presets
  document.querySelectorAll('.quick-feedback-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const preset = chip.getAttribute('data-preset');
      if (textareaFeedback && preset) {
        textareaFeedback.value = preset;
        textareaFeedback.focus();
      }
    });
  });

  // Score live status indicator
  function updateScoreIndicator(scoreVal: number) {
    if (!scoreStatusIndicator) return;
    if (isNaN(scoreVal) || inputScore?.value === '') {
      scoreStatusIndicator.textContent = 'KKM: 73';
      scoreStatusIndicator.className = 'text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-secondary text-muted-foreground border border-border';
    } else if (scoreVal >= 90) {
      scoreStatusIndicator.textContent = '🌟 Sangat Kompeten (A)';
      scoreStatusIndicator.className = 'text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30';
    } else if (scoreVal >= 73) {
      scoreStatusIndicator.textContent = '✓ Kompeten (KKM Tercapai)';
      scoreStatusIndicator.className = 'text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30';
    } else {
      scoreStatusIndicator.textContent = '⚠️ Belum Tuntas (< 73)';
      scoreStatusIndicator.className = 'text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30';
    }
  }

  inputScore?.addEventListener('input', () => {
    const val = Number(inputScore.value);
    updateScoreIndicator(val);
  });

  function escapeHtml(str: any): string {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function parseFormDataSafe(raw: any): any {
    if (!raw) return {};
    let data = raw;
    while (typeof data === 'string') {
      try {
        const parsed = JSON.parse(data);
        data = parsed;
      } catch (e) {
        break;
      }
    }
    return typeof data === 'object' && data !== null ? data : { 'Isi Jawaban': String(data) };
  }

  function renderFormattedAnswers(rawFormData: any, submissionType: string): string {
    const fd = parseFormDataSafe(rawFormData);
    const keys = Object.keys(fd);

    if (keys.length === 0) {
      return '<div class="p-6 text-center text-muted-foreground italic bg-secondary/20 rounded-xl border border-border/50">Tidak ada rincian formulir yang tersimpan.</div>';
    }

    let html = '<div class="space-y-4">';

    // 1. Identitas Siswa dari Form
    const hasStudentMeta = fd.studentName || fd.studentNis || fd.studentClass || fd.submissionDate;
    if (hasStudentMeta) {
      html += `
        <div class="p-3.5 rounded-xl bg-secondary/40 border border-border grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div>
            <span class="text-[10px] font-mono text-muted-foreground uppercase block mb-0.5">Nama Peserta Didik</span>
            <span class="font-bold text-foreground block">${escapeHtml(fd.studentName || '-')}</span>
          </div>
          <div>
            <span class="text-[10px] font-mono text-muted-foreground uppercase block mb-0.5">NIS / NISN</span>
            <span class="font-mono font-medium text-foreground block">${escapeHtml(fd.studentNis || '-')}</span>
          </div>
          <div>
            <span class="text-[10px] font-mono text-muted-foreground uppercase block mb-0.5">Rombel / Kelas</span>
            <span class="font-semibold text-primary block">${escapeHtml(fd.studentClass || '-')}</span>
          </div>
          <div>
            <span class="text-[10px] font-mono text-muted-foreground uppercase block mb-0.5">Waktu Pengumpulan</span>
            <span class="font-mono text-muted-foreground text-[11px] block">${escapeHtml(fd.submissionDate || '-')}</span>
          </div>
        </div>
      `;
    }

    // 2. Audit Apps Table (Khusus LKPD Analisis Aplikasi & Peran IT)
    if (Array.isArray(fd.auditApps) && fd.auditApps.length > 0) {
      html += `
        <div class="space-y-2 pt-1">
          <div class="flex items-center justify-between">
            <h5 class="text-xs font-bold text-foreground font-mono flex items-center gap-2 uppercase tracking-wider text-purple-600 dark:text-purple-400">
              <span>📊 Tabel Hasil Audit Aplikasi & Analisis Profesi RPL</span>
            </h5>
            <span class="text-[10px] font-mono text-muted-foreground">${fd.auditApps.length} Aplikasi Diaudit</span>
          </div>

          <div class="overflow-x-auto border border-border rounded-xl">
            <table class="w-full text-left text-xs">
              <thead class="bg-secondary/60 text-muted-foreground font-mono text-[10px] uppercase border-b border-border">
                <tr>
                  <th class="py-2.5 px-3 w-10 text-center">No</th>
                  <th class="py-2.5 px-3 min-w-[150px]">Nama Aplikasi & Platform</th>
                  <th class="py-2.5 px-3 min-w-[220px]">Fitur Utama yang Sering Digunakan</th>
                  <th class="py-2.5 px-3 min-w-[200px]">Peran Pengembang Terkait (Roles)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border bg-card">
                ${fd.auditApps.map((app: any, idx: number) => `
                  <tr class="hover:bg-accent/30 transition-colors">
                    <td class="py-3 px-3 font-mono text-muted-foreground text-center font-bold">${idx + 1}</td>
                    <td class="py-3 px-3 font-bold text-foreground">
                      <span class="px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 inline-block">
                        ${escapeHtml(app.name || '-')}
                      </span>
                    </td>
                    <td class="py-3 px-3 text-foreground leading-relaxed">
                      ${escapeHtml(app.feature || '-')}
                    </td>
                    <td class="py-3 px-3">
                      <span class="font-mono text-[11px] text-foreground bg-secondary/60 px-2 py-1 rounded border border-border inline-block">
                        ${escapeHtml(app.roles || '-')}
                      </span>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    // 3. Jurnal Refleksi Mandiri (q1, q2, q3, q4)
    const reflectionPrompts: Record<string, string> = {
      q1: '1. Hal Baru yang Dipelajari tentang Rekayasa Perangkat Lunak & PPLG',
      q2: '2. Urgensi Bukti Portofolio (Evidence) vs Ijazah Formal di Industri IT',
      q3: '3. Kendala & Solusi Teknis saat Menyiapkan Evidence Google Drive',
      q4: '4. Komitmen Belajar untuk Pertemuan / Modul Berikutnya',
    };

    const reflKeys = ['q1', 'q2', 'q3', 'q4'].filter(k => fd[k] !== undefined && fd[k] !== '');
    if (reflKeys.length > 0) {
      html += `
        <div class="space-y-3 pt-1">
          <h5 class="text-xs font-bold text-foreground font-mono flex items-center gap-2 uppercase tracking-wider text-cyan-600 dark:text-cyan-400">
            <span>💡 Jurnal Refleksi Mandiri Peserta Didik</span>
          </h5>
          <div class="space-y-3">
            ${reflKeys.map(k => `
              <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1.5">
                <span class="font-bold text-foreground block text-xs flex items-center gap-1.5">
                  <span class="text-primary font-mono">•</span>
                  <span>${reflectionPrompts[k] || k}:</span>
                </span>
                <div class="p-3 rounded-lg bg-card border border-border text-foreground text-xs leading-relaxed font-normal whitespace-pre-wrap">
                  ${escapeHtml(fd[k])}
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    // 4. General LKPD Fields (activityTitle, notes, checklist, dsb.)
    const excludedFields = new Set([
      'studentName', 'studentNis', 'studentClass', 'submissionDate', 
      'auditApps', 'q1', 'q2', 'q3', 'q4', 'driveUrl'
    ]);
    const extraFields = Object.keys(fd).filter(k => !excludedFields.has(k));

    if (extraFields.length > 0) {
      html += `
        <div class="space-y-3 pt-1">
          <h5 class="text-xs font-bold text-foreground font-mono flex items-center gap-2 uppercase tracking-wider text-foreground">
            <span>📝 Isian Formulir Tambahan Siswa</span>
          </h5>
          <div class="space-y-2.5">
            ${extraFields.map(k => {
              const val = fd[k];
              const title = k
                .replace(/([A-Z])/g, ' $1')
                .replace(/^./, str => str.toUpperCase())
                .replace(/_/g, ' ');

              if (Array.isArray(val)) {
                return `
                  <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1.5">
                    <span class="font-bold text-foreground block text-xs">${escapeHtml(title)}:</span>
                    <div class="p-2.5 rounded-lg bg-card border border-border overflow-x-auto">
                      <pre class="text-[11px] font-mono whitespace-pre-wrap text-foreground">${escapeHtml(JSON.stringify(val, null, 2))}</pre>
                    </div>
                  </div>
                `;
              } else if (typeof val === 'object' && val !== null) {
                return `
                  <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1.5">
                    <span class="font-bold text-foreground block text-xs">${escapeHtml(title)}:</span>
                    <div class="p-2.5 rounded-lg bg-card border border-border overflow-x-auto">
                      <pre class="text-[11px] font-mono whitespace-pre-wrap text-foreground">${escapeHtml(JSON.stringify(val, null, 2))}</pre>
                    </div>
                  </div>
                `;
              } else {
                return `
                  <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1">
                    <span class="font-semibold text-muted-foreground font-mono text-[11px] block">${escapeHtml(title)}:</span>
                    <div class="p-2.5 rounded-lg bg-card border border-border text-foreground text-xs leading-relaxed">
                      ${escapeHtml(String(val || '-'))}
                    </div>
                  </div>
                `;
              }
            }).join('')}
          </div>
        </div>
      `;
    }

    // 5. Bukti Google Drive Link Preview jika ada di form data
    if (fd.driveUrl) {
      html += `
        <div class="p-3.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">📁</span>
            <div>
              <span class="font-bold text-cyan-600 dark:text-cyan-400 text-xs block">Tautan Bukti Google Drive Portofolio Siswa</span>
              <span class="text-[11px] text-muted-foreground truncate max-w-sm block font-mono">${escapeHtml(fd.driveUrl)}</span>
            </div>
          </div>
          <a 
            href="${escapeHtml(fd.driveUrl)}" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-3.5 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold flex items-center gap-1.5 shrink-0 transition-colors shadow-sm"
          >
            <span>Buka Folder Drive</span> ↗
          </a>
        </div>
      `;
    }

    html += '</div>';
    return html;
  }

  document.querySelectorAll('.grade-submission-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const rawData = btn.getAttribute('data-submission');
      if (!rawData) return;

      try {
        const sub = JSON.parse(rawData);

        if (inputSubmissionId) inputSubmissionId.value = sub.id.toString();
        if (gradeModalStudent) gradeModalStudent.textContent = `${sub.userName} (${sub.userEmail})`;
        if (gradeModalClass) gradeModalClass.textContent = sub.studentClass ? `Kelas: ${sub.studentClass}` : 'Kelas Tidak Disetel';
        if (gradeModalType) gradeModalType.textContent = (sub.submissionType || 'LKPD').toUpperCase();
        if (gradeModalSlug) gradeModalSlug.textContent = `Materi: /pembelajaran/${sub.lessonSlug}`;

        // Populate Score, Level, Feedback
        const existingTeacherScore = sub.teacherScore !== null && sub.teacherScore !== undefined ? sub.teacherScore : (sub.score !== null && sub.score !== undefined ? sub.score : '');
        if (inputScore) {
          inputScore.value = existingTeacherScore.toString();
          updateScoreIndicator(Number(existingTeacherScore));
        }

        if (selectLevel && sub.teacherLevel) selectLevel.value = sub.teacherLevel;
        if (textareaFeedback) textareaFeedback.value = sub.teacherFeedback || '';

        // Google Drive link
        const driveUrl = sub.driveUrl || (parseFormDataSafe(sub.formData)?.driveUrl);
        if (driveUrl && gradeModalDriveContainer && gradeModalDriveLink) {
          gradeModalDriveContainer.classList.remove('hidden');
          gradeModalDriveLink.href = driveUrl;
        } else if (gradeModalDriveContainer) {
          gradeModalDriveContainer.classList.add('hidden');
        }

        // Render Answers cleanly
        if (gradeModalAnswersArea) {
          gradeModalAnswersArea.innerHTML = renderFormattedAnswers(sub.formData, sub.submissionType);
        }

        gradeModal?.classList.remove('hidden');
      } catch (err) {
        console.error('Parse submission error:', err);
        showAlert('Gagal membuka data submisi siswa.', true);
      }
    });
  });

  teacherGradeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submissionId = Number(inputSubmissionId?.value);
    const teacherScore = Number(inputScore?.value);
    const teacherLevel = selectLevel?.value;
    const teacherFeedback = textareaFeedback?.value.trim();

    if (isNaN(teacherScore) || teacherScore < 0 || teacherScore > 100) {
      alert('Skor harus berada di antara angka 0 dan 100.');
      return;
    }

    if (submitGradeBtn) submitGradeBtn.disabled = true;
    if (gradeBtnText) gradeBtnText.textContent = 'Menyimpan Nilai...';

    try {
      const res = await fetch('/api/admin/submissions/grade', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          submissionId,
          teacherScore,
          teacherLevel,
          teacherFeedback,
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        showAlert('Nilai & evaluasi LKPD berhasil disimpan dan dirilis ke dashboard siswa!');
        closeGradeModal();
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showAlert(data.error || 'Gagal menyimpan penilaian.', true);
        if (submitGradeBtn) submitGradeBtn.disabled = false;
        if (gradeBtnText) gradeBtnText.textContent = '💾 Simpan & Rilis Nilai ke Siswa';
      }
    } catch (err: any) {
      showAlert(err.message || 'Terjadi kesalahan jaringan.', true);
      if (submitGradeBtn) submitGradeBtn.disabled = false;
      if (gradeBtnText) gradeBtnText.textContent = '💾 Simpan & Rilis Nilai ke Siswa';
    }
  });

  // 8b. Jurnal Refleksi Review Modal Logic
  const reflModal = document.getElementById('reflection-modal');
  const closeReflModalBtn = document.getElementById('close-refl-modal-btn');
  const cancelReflBtn = document.getElementById('cancel-refl-btn');
  const teacherReflForm = document.getElementById('teacher-reflection-form') as HTMLFormElement | null;
  const submitReflBtn = document.getElementById('submit-refl-btn') as HTMLButtonElement | null;
  const reflBtnText = document.getElementById('refl-btn-text');

  const reflModalStudent = document.getElementById('refl-modal-student');
  const reflModalClass = document.getElementById('refl-modal-class');
  const reflModalSlug = document.getElementById('refl-modal-slug');
  const reflModalAnswersArea = document.getElementById('refl-modal-answers-area');
  const reflModalDriveContainer = document.getElementById('refl-modal-drive-container');
  const reflModalDriveLink = document.getElementById('refl-modal-drive-link') as HTMLAnchorElement | null;
  const inputReflSubmissionId = document.getElementById('refl-submission-id') as HTMLInputElement | null;
  const textareaReflFeedback = document.getElementById('refl-feedback-input') as HTMLTextAreaElement | null;

  function closeReflModal() {
    reflModal?.classList.add('hidden');
  }

  closeReflModalBtn?.addEventListener('click', closeReflModal);
  cancelReflBtn?.addEventListener('click', closeReflModal);

  reflModal?.addEventListener('click', (e) => {
    if (e.target === reflModal) closeReflModal();
  });

  // Quick reflection chips
  document.querySelectorAll('.quick-refl-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const preset = chip.getAttribute('data-preset');
      if (textareaReflFeedback && preset) {
        textareaReflFeedback.value = preset;
        textareaReflFeedback.focus();
      }
    });
  });

  function renderReflectionAnswers(rawFormData: any): string {
    const fd = parseFormDataSafe(rawFormData);
    const reflectionPrompts: Record<string, { label: string; icon: string }> = {
      q1: { label: 'Hal Baru yang Dipelajari tentang Rekayasa Perangkat Lunak & PPLG', icon: '🌱' },
      q2: { label: 'Urgensi Bukti Portofolio (Evidence) vs Ijazah Formal di Industri IT', icon: '💼' },
      q3: { label: 'Kendala & Solusi Teknis saat Menyiapkan Evidence Google Drive', icon: '⚠️' },
      q4: { label: 'Komitmen Belajar untuk Pertemuan / Modul Berikutnya', icon: '🎯' },
    };

    const keys = ['q1', 'q2', 'q3', 'q4'].filter(k => fd[k] !== undefined && fd[k] !== '');
    if (keys.length === 0) {
      // Check other fields
      const allKeys = Object.keys(fd).filter(k => !['studentName', 'studentNis', 'studentClass', 'submissionDate', 'driveUrl'].includes(k));
      if (allKeys.length === 0) {
        return '<div class="p-6 text-center text-muted-foreground italic bg-secondary/20 rounded-xl border border-border/50">Tidak ada isian refleksi yang tersimpan.</div>';
      }
      return `
        <div class="space-y-3">
          ${allKeys.map(k => `
            <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1.5">
              <span class="font-bold text-foreground block text-xs">${escapeHtml(k)}:</span>
              <div class="p-3 rounded-lg bg-card border border-border text-foreground text-xs leading-relaxed">
                ${escapeHtml(String(fd[k]))}
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    return `
      <div class="space-y-3">
        ${keys.map(k => {
          const item = reflectionPrompts[k] || { label: k, icon: '💡' };
          return `
            <div class="p-3.5 rounded-xl bg-secondary/30 border border-border space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="text-base">${item.icon}</span>
                <span class="font-bold text-foreground text-xs font-mono">${escapeHtml(item.label)}</span>
              </div>
              <div class="p-3 rounded-lg bg-card border border-border text-foreground text-xs leading-relaxed font-normal whitespace-pre-wrap">
                ${escapeHtml(fd[k])}
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  document.querySelectorAll('.review-reflection-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const rawData = btn.getAttribute('data-reflection');
      if (!rawData) return;

      try {
        const sub = JSON.parse(rawData);

        if (inputReflSubmissionId) inputReflSubmissionId.value = sub.id.toString();
        if (reflModalStudent) reflModalStudent.textContent = `${sub.userName} (${sub.userEmail})`;
        if (reflModalClass) reflModalClass.textContent = sub.studentClass ? `Kelas: ${sub.studentClass}` : 'Kelas Tidak Disetel';
        if (reflModalSlug) reflModalSlug.textContent = `Materi: /pembelajaran/${sub.lessonSlug}`;

        if (textareaReflFeedback) textareaReflFeedback.value = sub.teacherFeedback || '';

        // Google Drive link
        const driveUrl = sub.driveUrl || (parseFormDataSafe(sub.formData)?.driveUrl);
        if (driveUrl && reflModalDriveContainer && reflModalDriveLink) {
          reflModalDriveContainer.classList.remove('hidden');
          reflModalDriveLink.href = driveUrl;
        } else if (reflModalDriveContainer) {
          reflModalDriveContainer.classList.add('hidden');
        }

        // Render reflection answers
        if (reflModalAnswersArea) {
          reflModalAnswersArea.innerHTML = renderReflectionAnswers(sub.formData);
        }

        reflModal?.classList.remove('hidden');
      } catch (err) {
        console.error('Parse reflection error:', err);
        showAlert('Gagal membuka jurnal refleksi siswa.', true);
      }
    });
  });

  teacherReflForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submissionId = Number(inputReflSubmissionId?.value);
    const teacherFeedback = textareaReflFeedback?.value.trim();

    if (!submissionId) {
      alert('Data refleksi tidak valid.');
      return;
    }

    if (submitReflBtn) submitReflBtn.disabled = true;
    if (reflBtnText) reflBtnText.textContent = 'Menyimpan Tanggapan...';

    try {
      const res = await fetch('/api/admin/submissions/review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          submissionId,
          teacherFeedback,
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        showAlert('Tanggapan & apresiasi guru untuk refleksi siswa berhasil disimpan!');
        closeReflModal();
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showAlert(data.error || 'Gagal menyimpan tanggapan.', true);
        if (submitReflBtn) submitReflBtn.disabled = false;
        if (reflBtnText) reflBtnText.textContent = '✓ Simpan Tanggapan Guru';
      }
    } catch (err: any) {
      showAlert(err.message || 'Terjadi kesalahan jaringan.', true);
      if (submitReflBtn) submitReflBtn.disabled = false;
      if (reflBtnText) reflBtnText.textContent = '✓ Simpan Tanggapan Guru';
    }
  });

  // 9. Search filter for users
  const searchInput = document.getElementById('user-search-input') as HTMLInputElement | null;
  const userRows = document.querySelectorAll('.user-row');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    userRows.forEach(row => {
      const name = row.querySelector('.user-name')?.textContent?.toLowerCase() || '';
      const email = row.querySelector('.user-email')?.textContent?.toLowerCase() || '';
      const uClass = row.querySelector('.user-class')?.textContent?.toLowerCase() || '';
      if (name.includes(query) || email.includes(query) || uClass.includes(query)) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  });

  // 10. Role Toggle Action for Super Admin
  const roleButtons = document.querySelectorAll('.role-toggle-btn');
  roleButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetUserId = btn.getAttribute('data-user-id');
      const userName = btn.getAttribute('data-user-name') || 'Pengguna';
      const targetRole = btn.getAttribute('data-target-role') || 'student';
      
      const confirmMsg = targetRole === 'teacher'
        ? `Apakah Anda yakin ingin menetapkan ${userName} sebagai GURU PENGAMPU?\n\nPengguna ini akan memiliki akses ke Panel Guru untuk memonitor hasil belajar dan ujian siswa.`
        : `Apakah Anda yakin ingin mencabut akses Guru dari ${userName} dan mengembalikannya sebagai SISWA?`;

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin/users/role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUserId, newRole: targetRole })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showAlert(data.message || 'Perubahan role berhasil disimpan.');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showAlert(data.error || 'Gagal mengubah role pengguna.', true);
        }
      } catch (e) {
        showAlert('Gagal: Terjadi gangguan jaringan/server.', true);
      }
    });
  });

  // 11. Delete User Action for Admin / Teacher
  const deleteButtons = document.querySelectorAll('.delete-user-btn');
  deleteButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetUserId = btn.getAttribute('data-user-id');
      const userName = btn.getAttribute('data-user-name') || 'Pengguna';
      const userEmail = btn.getAttribute('data-user-email') || '';

      const confirmMsg = `PERINGATAN HAPUS AKUN:\n\nApakah Anda yakin ingin menghapus akun:\n• Nama: ${userName}\n• Email: ${userEmail}\n\nTindakan ini bersifat PERMANEN. Seluruh riwayat nilai tryout TKA, progres modul, dan poin XP siswa ini akan langsung dihapus dari database.`;

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin/users/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUserId })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showAlert(data.message || 'Akun pengguna berhasil dihapus.');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showAlert(data.error || 'Gagal menghapus akun pengguna.', true);
        }
      } catch (e) {
        showAlert('Gagal: Terjadi gangguan jaringan/server.', true);
      }
    });
  });
</script>
