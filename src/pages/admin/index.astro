      currentActiveLiterasiData = {
        reportId,
        studentName,
        studentClass,
        bookTitle,
        author,
        publisher,
        pageCount,
        summary,
        moral,
        week,
        writingScore,
        presentationScore,
        feedback,
      };

      if (litReportIdInput) litReportIdInput.value = reportId || '';
      if (litModalStudentInfo) litModalStudentInfo.textContent = `${studentName} — ${studentClass}`;
      if (litModalBookTitle) litModalBookTitle.textContent = bookTitle;
      if (litModalBookMeta) litModalBookMeta.textContent = `${author} • ${publisher} • ${pageCount} hal.`;
      if (litModalWeek) litModalWeek.textContent = `Minggu ${week}`;
      if (litModalSummary) litModalSummary.textContent = summary;
      if (litModalMoral) litModalMoral.textContent = moral;
      if (litTeacherFeedback) litTeacherFeedback.value = feedback;

      // Pre-fill scores if already graded
      if (writingScore) {
        const ws = Number(writingScore);
        const avg = Math.round(ws / 4);
        (document.getElementById('lit-w1') as HTMLInputElement).value = String(avg);
        (document.getElementById('lit-w2') as HTMLInputElement).value = String(avg);
        (document.getElementById('lit-w3') as HTMLInputElement).value = String(avg);
        (document.getElementById('lit-w4') as HTMLInputElement).value = String(ws - avg * 3);
      } else {
        ['lit-w1', 'lit-w2', 'lit-w3', 'lit-w4'].forEach(id => {
          (document.getElementById(id) as HTMLInputElement).value = '3';
        });
      }

      if (presentationScore) {
        const ps = Number(presentationScore);
        const avg = Math.round(ps / 5);
        (document.getElementById('lit-p1') as HTMLInputElement).value = String(avg);
        (document.getElementById('lit-p2') as HTMLInputElement).value = String(avg);
        (document.getElementById('lit-p3') as HTMLInputElement).value = String(avg);
        (document.getElementById('lit-p4') as HTMLInputElement).value = String(avg);
        (document.getElementById('lit-p5') as HTMLInputElement).value = String(ps - avg * 4);
      } else {
        ['lit-p1', 'lit-p2', 'lit-p3', 'lit-p4', 'lit-p5'].forEach(id => {
          (document.getElementById(id) as HTMLInputElement).value = '3';
