  // Auto-compute RESIK score when inputs change
  function updateLitScores() {
    const w1 = Number((document.getElementById('lit-w1') as HTMLInputElement)?.value) || 0;
    const w2 = Number((document.getElementById('lit-w2') as HTMLInputElement)?.value) || 0;
    const w3 = Number((document.getElementById('lit-w3') as HTMLInputElement)?.value) || 0;
    const w4 = Number((document.getElementById('lit-w4') as HTMLInputElement)?.value) || 0;
    const p1 = Number((document.getElementById('lit-p1') as HTMLInputElement)?.value) || 0;
    const p2 = Number((document.getElementById('lit-p2') as HTMLInputElement)?.value) || 0;
    const p3 = Number((document.getElementById('lit-p3') as HTMLInputElement)?.value) || 0;
    const p4 = Number((document.getElementById('lit-p4') as HTMLInputElement)?.value) || 0;
    const p5 = Number((document.getElementById('lit-p5') as HTMLInputElement)?.value) || 0;

    const totalWriting = Math.min(16, Math.max(4, w1 + w2 + w3 + w4));
    const totalPresentation = Math.min(20, Math.max(5, p1 + p2 + p3 + p4 + p5));
    const finalScore = Math.min(100, Math.max(0, Math.round(((totalWriting + totalPresentation) / 36) * 100)));

    if (litWritingSubtotal) litWritingSubtotal.textContent = String(totalWriting);
    if (litPresentationSubtotal) litPresentationSubtotal.textContent = String(totalPresentation);
    if (litFinalScoreDisplay) litFinalScoreDisplay.textContent = String(finalScore);

    if (currentActiveLiterasiData) {
      currentActiveLiterasiData.writingScore = totalWriting;
      currentActiveLiterasiData.presentationScore = totalPresentation;
      currentActiveLiterasiData.finalScore = finalScore;
    }
  }

  ['lit-w1', 'lit-w2', 'lit-w3', 'lit-w4', 'lit-p1', 'lit-p2', 'lit-p3', 'lit-p4', 'lit-p5'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', updateLitScores);
  });

