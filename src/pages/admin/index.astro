      const studentClass = btn.getAttribute('data-student-class') || '-';
      const bookTitle = btn.getAttribute('data-book-title') || '';
      const author = btn.getAttribute('data-author') || '';
      const publisher = btn.getAttribute('data-publisher') || '';
      const pageCount = btn.getAttribute('data-page-count') || '0';
      const summary = btn.getAttribute('data-summary') || '-';
      const moral = btn.getAttribute('data-moral') || '-';
      const week = btn.getAttribute('data-week') || '1';
      const writingScore = btn.getAttribute('data-writing-score') || '';
      const presentationScore = btn.getAttribute('data-presentation-score') || '';
