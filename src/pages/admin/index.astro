---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { db, isDbConfigured, ensureDbInitialized } from '../../db';
import { users, userGamification, tkaAttempts, userProgress, enrollmentTokens, userEnrollments, userSubmissions } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

import { canAccessAdminPanel, isSuperAdmin, isSuperAdminEmail } from '../../utils/auth';

const user = Astro.locals.user;
if (!user || !canAccessAdminPanel(user.role)) {
  return Astro.redirect('/dashboard?error=unauthorized_admin');
}

const isCurrentSuperAdmin = isSuperAdmin(user.role) || isSuperAdminEmail(user.email);

let allUsers: any[] = [];
let allExamLogs: any[] = [];
let allLessonLogs: any[] = [];
let allTokens: any[] = [];
let allEnrollments: any[] = [];
let allSubmissions: any[] = [];

if (isDbConfigured()) {
  try {
    await ensureDbInitialized();

    // Ensure Super Admin email has superadmin role in DB
    if (isCurrentSuperAdmin && user.email && isSuperAdminEmail(user.email)) {
      try {
        await db.update(users).set({ role: 'superadmin' }).where(eq(users.email, user.email.trim().toLowerCase()));
      } catch (e) {}
    }

    // 1. Fetch All Users + Gamification Info
    allUsers = await db.select({
      id: users.id,
      name: users.name,
      email: users.email,
      role: users.role,
      studentClass: users.studentClass,
      avatarUrl: users.avatarUrl,
      createdAt: users.createdAt,
      xp: userGamification.xp,
      level: userGamification.level,
      streakDays: userGamification.streakDays,
    }).from(users)
      .leftJoin(userGamification, eq(users.id, userGamification.userId))
      .orderBy(desc(users.createdAt));

    // 2. Fetch All Exam Attempts + User Info
    allExamLogs = await db.select({
      id: tkaAttempts.id,
      userId: tkaAttempts.userId,
      tokenId: tkaAttempts.tokenId,
      userName: users.name,
      userEmail: users.email,
      studentClass: users.studentClass,
      score: tkaAttempts.score,
      totalQuestions: tkaAttempts.totalQuestions,
      correctAnswers: tkaAttempts.correctAnswers,
      xpEarned: tkaAttempts.xpEarned,
      createdAt: tkaAttempts.createdAt,
    }).from(tkaAttempts)
      .innerJoin(users, eq(tkaAttempts.userId, users.id))
      .orderBy(desc(tkaAttempts.createdAt));

    // 3. Fetch All Lesson Progress + User Info
    allLessonLogs = await db.select({
      id: userProgress.id,
      userId: userProgress.userId,
      tokenId: userProgress.tokenId,
      userName: users.name,
      userEmail: users.email,
      studentClass: users.studentClass,
      lessonSlug: userProgress.lessonSlug,
      completedAt: userProgress.completedAt,
    }).from(userProgress)
      .innerJoin(users, eq(userProgress.userId, users.id))
      .orderBy(desc(userProgress.completedAt));

    // 4. Fetch All Enrollment Tokens
    allTokens = await db.select({
      id: enrollmentTokens.id,
      token: enrollmentTokens.token,
      title: enrollmentTokens.title,
      description: enrollmentTokens.description,
      targetType: enrollmentTokens.targetType,
      targetSlug: enrollmentTokens.targetSlug,
      targetClass: enrollmentTokens.targetClass,
      isActive: enrollmentTokens.isActive,
      createdAt: enrollmentTokens.createdAt,
      expiresAt: enrollmentTokens.expiresAt,
      creatorName: users.name,
    }).from(enrollmentTokens)
      .leftJoin(users, eq(enrollmentTokens.createdBy, users.id))
      .orderBy(desc(enrollmentTokens.createdAt));

    // 5. Fetch Enrollment counts
    allEnrollments = await db.select({
      id: userEnrollments.id,
      tokenId: userEnrollments.tokenId,
      userId: userEnrollments.userId,
    }).from(userEnrollments);

    // 6. Fetch All Submissions (LKPD & Reflection) + User Info
    try {
      const rawSubmissions = await db.select({
        id: userSubmissions.id,
        userId: userSubmissions.userId,
        tokenId: userSubmissions.tokenId,
        userName: users.name,
        userEmail: users.email,
        studentClass: users.studentClass,
        lessonSlug: userSubmissions.lessonSlug,
        submissionType: userSubmissions.submissionType,
        formData: userSubmissions.formData,
        driveUrl: userSubmissions.driveUrl,
        score: userSubmissions.score,
        teacherScore: userSubmissions.teacherScore,
        teacherLevel: userSubmissions.teacherLevel,
        teacherFeedback: userSubmissions.teacherFeedback,
        gradedBy: userSubmissions.gradedBy,
        gradedAt: userSubmissions.gradedAt,
        status: userSubmissions.status,
        submittedAt: userSubmissions.submittedAt,
        updatedAt: userSubmissions.updatedAt,
      }).from(userSubmissions)
        .innerJoin(users, eq(userSubmissions.userId, users.id))
        .orderBy(desc(userSubmissions.submittedAt));

      allSubmissions = rawSubmissions;
    } catch (subErr) {
      console.warn('Submissions query error in admin:', subErr);
      allSubmissions = [];
    }
  } catch (err) {
    console.error('Admin DB Error:', err);
  }
}

const enrollmentCountMap: Record<number, number> = {};
for (const e of allEnrollments) {
  enrollmentCountMap[e.tokenId] = (enrollmentCountMap[e.tokenId] || 0) + 1;
}

const examCountMap: Record<number, number> = {};
for (const ex of allExamLogs) {
  if (ex.tokenId) {
    examCountMap[ex.tokenId] = (examCountMap[ex.tokenId] || 0) + 1;
  }
}

// 6. Metrics Calculations
const lkpdSubmissions = allSubmissions.filter(s => s.submissionType !== 'reflection');
const reflectionSubmissions = allSubmissions.filter(s => s.submissionType === 'reflection');

const totalLkpd = lkpdSubmissions.length;
const pendingLkpd = lkpdSubmissions.filter(s => s.teacherScore === null || s.teacherScore === undefined).length;
const gradedLkpd = lkpdSubmissions.filter(s => s.teacherScore !== null && s.teacherScore !== undefined).length;

const totalReflections = reflectionSubmissions.length;
const pendingReflections = reflectionSubmissions.filter(s => s.status !== 'reviewed' && !s.teacherFeedback).length;
const reviewedReflections = reflectionSubmissions.filter(s => s.status === 'reviewed' || s.teacherFeedback).length;

const totalStudents = allUsers.filter(u => u.role === 'student' && !isSuperAdminEmail(u.email)).length;
const totalTeachers = allUsers.filter(u => (u.role === 'teacher' || u.role === 'admin') && !isSuperAdminEmail(u.email)).length;
const totalSuperAdmins = allUsers.filter(u => u.role === 'superadmin' || isSuperAdminEmail(u.email)).length;
const totalExamsTaken = allExamLogs.length;
const avgScoreAll = totalExamsTaken > 0
  ? Math.round(allExamLogs.reduce((acc, curr) => acc + curr.score, 0) / totalExamsTaken)
  : 0;
const passingExams = allExamLogs.filter(e => e.score >= 73).length;
const passRate = totalExamsTaken > 0 ? Math.round((passingExams / totalExamsTaken) * 100) : 0;
---

<DashboardLayout title="Panel Guru & Administrator" activeNav="/admin">
  <div class="space-y-6">
    
    <!-- Admin Hero Banner -->
    <div class="p-6 rounded-xl bg-card border border-border flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-sm">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-md bg-amber-500/10 border border-amber-500/25 text-amber-600 dark:text-amber-400 text-xs font-mono font-semibold">
          <span>Administrator Console</span>
          <span>•</span>
          <span>Guru Pengampu PPLG</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
          Panel Manajemen Guru & Monitoring Siswa
        </h1>
        <p class="text-xs sm:text-sm text-muted-foreground max-w-xl leading-relaxed">
          Kelola token sesi pembelajaran, evaluasi lembar kerja (LKPD), tinjau respon refleksi kualitatif siswa, pantau hak akses, dan analisis hasil ujian Drilling TKA secara real-time.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 flex-shrink-0">
        <a href="#tokens" class="btn btn-sm bg-cyan-600 hover:bg-cyan-500 text-white font-semibold rounded-lg shadow-sm">
          🎟️ Token ({allTokens.length})
        </a>
        <a href="#submissions" class="btn btn-sm bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-lg shadow-sm">
          📝 LKPD ({totalLkpd})
        </a>
        <a href="#reflections" class="btn btn-sm bg-pink-600 hover:bg-pink-500 text-white font-semibold rounded-lg shadow-sm">
          💭 Refleksi ({totalReflections})
        </a>
        <a href="#students" class="btn btn-sm bg-amber-500 hover:bg-amber-400 text-black font-semibold rounded-lg shadow-sm">
          👥 Siswa ({allUsers.length})
        </a>
        <a href="#exams" class="btn btn-sm btn-outline border-border text-foreground hover:bg-accent font-semibold rounded-lg">
          📈 Ujian ({totalExamsTaken})
        </a>
      </div>
    </div>

    <!-- 5 KPI Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Metric 1: Siswa & Guru -->
      <div class="card p-5 rounded-xl border-border bg-card space-y-1.5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Total Pengguna</span>
          <span class="text-base">👥</span>
        </div>
        <div class="text-2xl font-bold text-foreground font-mono">
          {totalStudents} <span class="text-xs text-muted-foreground font-sans font-normal">Siswa</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] font-mono text-muted-foreground pt-0.5">
          <span class="text-amber-600 dark:text-amber-400 font-semibold">{totalTeachers} Guru</span>
          <span>•</span>
          <span class="text-purple-600 dark:text-purple-400 font-semibold">{totalSuperAdmins} Super Admin</span>
        </div>
      </div>

      <!-- Metric 2: Sesi Token Aktif -->
      <div class="card p-5 rounded-xl border-border bg-card space-y-1.5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Token Sesi Kelas</span>
          <span class="text-base">🎟️</span>
        </div>
        <div class="text-2xl font-bold text-cyan-600 dark:text-cyan-400 font-mono">
          {allTokens.filter(t => t.isActive).length} <span class="text-xs text-muted-foreground font-sans font-normal">Aktif</span>
        </div>
        <p class="text-[11px] text-muted-foreground">Total {allTokens.length} sesi terdaftar</p>
      </div>

      <!-- Metric 3: Penilaian LKPD -->
      <div class="card p-5 rounded-xl border-border bg-card space-y-1.5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Evaluasi LKPD</span>
          <span class="text-base">📝</span>
        </div>
        <div class="text-2xl font-bold text-purple-600 dark:text-purple-400 font-mono">
          {totalLkpd} <span class="text-xs text-muted-foreground font-sans font-normal">Set</span>
        </div>
        <p class="text-[11px] text-muted-foreground">
          <span class="text-amber-600 dark:text-amber-400 font-bold">{pendingLkpd} Menunggu</span> • <span class="text-emerald-600 dark:text-emerald-400 font-bold">{gradedLkpd} Dinilai</span>
        </p>
      </div>

      <!-- Metric 4: Jurnal Refleksi Siswa -->
      <div class="card p-5 rounded-xl border-border bg-card space-y-1.5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Jurnal Refleksi</span>
          <span class="text-base">💭</span>
        </div>
        <div class="text-2xl font-bold text-pink-600 dark:text-pink-400 font-mono">
          {totalReflections} <span class="text-xs text-muted-foreground font-sans font-normal">Jurnal</span>
        </div>
        <p class="text-[11px] text-muted-foreground">
          <span class="text-amber-600 dark:text-amber-400 font-bold">{pendingReflections} Baru</span> • <span class="text-pink-600 dark:text-pink-400 font-bold">{reviewedReflections} Ditinjau</span>
        </p>
      </div>

      <!-- Metric 5: Rata-Rata Nilai TKA -->
      <div class="card p-5 rounded-xl border-border bg-card space-y-1.5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-medium text-muted-foreground">Rata-Rata Drilling TKA</span>
          <span class="text-base">📊</span>
        </div>
        <div class="text-2xl font-bold text-amber-600 dark:text-amber-400 font-mono">
          {avgScoreAll} <span class="text-xs text-muted-foreground font-sans font-normal">/ 100</span>
        </div>
        <p class="text-[11px] text-muted-foreground">Kelulusan KKM: <span class="text-emerald-600 dark:text-emerald-400 font-bold">{passRate}%</span></p>
      </div>

    </div>

    <!-- Alert Notification -->
    <div id="admin-alert" class="hidden p-3.5 rounded-lg text-xs font-medium text-center transition-all"></div>

    <!-- ========================================== -->
    <!-- SECTION 0: MANAJEMEN TOKEN SESI (ROLL & REKAP PER-TOKEN) -->
    <!-- ========================================== -->
    <div id="tokens" class="card p-5 sm:p-6 rounded-xl border-border bg-card space-y-6 shadow-sm">

      <!-- Header & Create Token Form -->
      <div class="space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-4">
          <div>
            <h2 class="text-base font-bold text-foreground flex items-center gap-2">
              <span>🎟️ Manajemen Token Sesi Belajar & Ujian (Roll Token)</span>
              <span class="text-[10px] px-2 py-0.5 rounded font-mono font-semibold bg-secondary text-foreground border border-border">
                REKAP PER-TOKEN
              </span>
            </h2>
            <p class="text-xs text-muted-foreground mt-1">
              Buat (Roll) Token baru untuk sesi kelas tertentu. Siswa wajib melakukan <b>Enroll Token</b> agar data pengerjaan ujian dan modul tercatat rapi per-sesi.
            </p>
          </div>

          <button 
            type="button" 
            id="toggle-create-token-btn"
            class="px-3.5 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs transition-colors flex items-center gap-2 flex-shrink-0"
          >
            <span>+ Buat (Roll) Token Baru</span>
          </button>
        </div>

        <!-- Form Pembuatan Token Baru (Collapsible) -->
        <div id="create-token-card" class="hidden p-5 rounded-lg bg-secondary/40 border border-border space-y-4">
          <div class="flex items-center justify-between border-b border-border pb-2.5">
            <h3 class="text-xs font-bold text-foreground flex items-center gap-2">
              <span>🎲 Formulir Penerbitan Token Sesi Baru</span>
            </h3>
            <span class="text-[11px] text-muted-foreground font-mono">Pengampu: {user.name}</span>
          </div>

          <form id="create-token-form" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              
              <!-- Judul Sesi -->
              <div class="md:col-span-2 space-y-1">
                <label class="block font-medium text-foreground">Judul / Nama Sesi Belajar <span class="text-destructive">*</span></label>
                <input 
                  type="text" 
                  id="token-title" 
                  required 
                  placeholder="Contoh: Tryout TKA PPLG Sesi 1 - 10 RPL 1" 
                  class="w-full px-3 py-2 rounded-lg bg-background border border-border text-foreground text-xs focus:outline-none focus:border-primary"
                />
              </div>

              <!-- Target Kelas -->
              <div class="space-y-1">
                <label class="block font-medium text-foreground">Target Kelas / Rombel</label>
                <select 
                  id="token-target-class" 
                  class="w-full px-3 py-2 rounded-lg bg-background border border-border text-foreground text-xs focus:outline-none focus:border-primary"
                >
                  <option value="Semua Kelas">Semua Kelas (Umum)</option>
                  <optgroup label="Kelas 10 RPL">
                    <option value="10 RPL 1">10 RPL 1</option>
                    <option value="10 RPL 2">10 RPL 2</option>
                    <option value="10 RPL 3">10 RPL 3</option>
                    <option value="10 RPL 4">10 RPL 4</option>
                  </optgroup>
                  <optgroup label="Kelas 11 RPL">
                    <option value="11 RPL 1">11 RPL 1</option>
                    <option value="11 RPL 2">11 RPL 2</option>
                    <option value="11 RPL 3">11 RPL 3</option>
                    <option value="11 RPL 4">11 RPL 4</option>
                  </optgroup>
                  <optgroup label="Kelas 12 RPL">
                    <option value="12 RPL 1">12 RPL 1</option>
                    <option value="12 RPL 2">12 RPL 2</option>
                    <option value="12 RPL 3">12 RPL 3</option>
                    <option value="12 RPL 4">12 RPL 4</option>
                  </optgroup>
                </select>
              </div>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              
              <!-- Tipe Sesi -->
              <div class="space-y-1">
                <label class="block font-medium text-foreground">Tipe Target Sesi</label>
                <select 
                  id="token-target-type" 
                  class="w-full px-3 py-2 rounded-lg bg-background border border-border text-foreground text-xs focus:outline-none focus:border-primary"
                >
                  <option value="orientasi-pplg">⭐ Mata Pelajaran: Orientasi PPLG (Fase E / 10 RPL)</option>
                  <option value="tka">🎯 Drilling TKA Simulator (Ujian CBT)</option>
                  <option value="all">📚 Semua Modul & Tryout (Global)</option>
                  <option value="module">📖 Modul Pembelajaran Tertentu</option>
                </select>
              </div>

              <!-- Kode Token Kustom (Opsional) -->
              <div class="space-y-1">
                <label class="block font-medium text-foreground">
                  Kode Token Kustom (Opsional - Kosongkan jika ingin auto-generate)
                </label>
                <input 
                  type="text" 
                  id="token-custom-code" 
                  placeholder="Contoh: RPL1-TKA8" 
                  class="w-full px-3 py-2 rounded-lg bg-background border border-border text-foreground text-xs font-mono uppercase focus:outline-none focus:border-primary"
                />
              </div>

            </div>

            <!-- Deskripsi / Petunjuk untuk Siswa -->
            <div class="space-y-1">
              <label class="block font-medium text-foreground">Catatan / Petunjuk untuk Siswa (Opsional)</label>
              <input 
                type="text" 
                id="token-description" 
                placeholder="Contoh: Harap dikerjakan mandiri dalam waktu 30 menit." 
                class="w-full px-3 py-2 rounded-lg bg-background border border-border text-foreground text-xs focus:outline-none focus:border-primary"
              />
            </div>

            <div class="pt-1 flex items-center justify-end gap-2.5">
              <button 
                type="button" 
                id="cancel-create-token-btn"
                class="px-3.5 py-2 rounded-lg bg-secondary hover:bg-accent text-foreground font-medium"
              >
                Batal
              </button>
              <button 
                type="submit" 
                id="submit-token-btn"
                class="px-4 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold flex items-center gap-2"
              >
                <span id="token-btn-text">Terbitkan Token Sesi</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Tabel Daftar Token Sesi -->
        {allTokens.length === 0 ? (
          <div class="p-8 text-center text-xs text-muted-foreground bg-secondary/30 rounded-lg border border-dashed border-border">
            Belum ada Token Sesi yang dibuat. Klik tombol <b>"+ Buat (Roll) Token Baru"</b> untuk membuat token sesi kelas pertama Anda.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="text-[11px] text-muted-foreground uppercase font-mono border-b border-border">
                <tr>
                  <th class="py-2.5 px-3">Kode Token</th>
                  <th class="py-2.5 px-3">Nama Sesi & Tipe</th>
                  <th class="py-2.5 px-3">Target Kelas</th>
                  <th class="py-2.5 px-3">Siswa Enroll</th>
                  <th class="py-2.5 px-3">Ujian Selesai</th>
                  <th class="py-2.5 px-3">Status Sesi</th>
                  <th class="py-2.5 px-3 text-right">Aksi & Rekap</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border font-medium">
                {allTokens.map((t) => {
                  const enrolledCount = enrollmentCountMap[t.id] || 0;
                  const examCount = examCountMap[t.id] || 0;
                  const createdDate = new Date(t.createdAt).toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  });

                  return (
                    <tr class="hover:bg-accent/40 transition-colors">
                      <!-- Token Code with Copy Button -->
                      <td class="py-3 px-3 font-mono">
                        <div class="flex items-center gap-1.5">
                          <span class="px-2 py-0.5 rounded font-mono font-bold text-xs bg-secondary text-foreground border border-border tracking-wider">
                            {t.token}
                          </span>
                          <button 
                            type="button" 
                            data-copy-token={t.token}
                            class="copy-token-btn p-1 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
                            title="Salin Kode Token"
                          >
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                          </button>
                        </div>
                      </td>

                      <!-- Judul Sesi -->
                      <td class="py-3 px-3">
                        <span class="font-semibold text-foreground block">{t.title}</span>
                        <div class="flex items-center gap-2 text-[10px] text-muted-foreground mt-0.5">
                          <span class="font-mono">
                            {t.targetType === 'tka' ? '🎯 Ujian TKA' : t.targetType === 'module' ? '📖 Modul Materi' : '📚 Global Hub'}
                          </span>
                          <span>•</span>
                          <span>{createdDate}</span>
                        </div>
                      </td>

                      <!-- Target Kelas -->
                      <td class="py-3 px-3 font-mono">
                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-secondary text-foreground border border-border">
                          {t.targetClass}
                        </span>
                      </td>

                      <!-- Siswa Enroll -->
                      <td class="py-3 px-3 font-mono font-semibold text-foreground">
                        <span class="px-2 py-0.5 rounded bg-primary/10 text-primary text-xs">
                          👥 {enrolledCount} Siswa
                        </span>
                      </td>

                      <!-- Ujian Selesai -->
                      <td class="py-3 px-3 font-mono font-semibold text-emerald-600 dark:text-emerald-400">
                        {examCount} Selesai
                      </td>

                      <!-- Toggle Status -->
                      <td class="py-3 px-3">
                        <button 
                          type="button"
                          data-token-id={t.id}
                          data-token-active={t.isActive ? 'true' : 'false'}
                          class="toggle-token-status-btn px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase transition-colors"
                          class:list={[
                            t.isActive 
                              ? "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/25" 
                              : "bg-secondary text-muted-foreground border border-border hover:bg-accent"
                          ]}
