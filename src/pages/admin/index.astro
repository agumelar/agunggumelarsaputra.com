                      <div class="space-y-1">
                        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-pink-500/10 text-pink-600 dark:text-pink-400 border border-pink-500/20 uppercase">
                          Refleksi
                        </span>
                        <div class="text-[11px] font-mono text-muted-foreground truncate max-w-[200px]" title={sub.lessonSlug}>
                          {sub.lessonSlug}
                        </div>
                      </div>
                    </td>

                    <td class="py-3 px-3">
                      <div class="space-y-1 max-w-[280px]">
                        <p class="text-xs text-foreground line-clamp-2 italic leading-snug">
                          "{previewSnippet}"
                        </p>
                        {q3Text && (
                          <div class="text-[10px] text-amber-600 dark:text-amber-400 truncate flex items-center gap-1">
                            <span>⚠️ Kendala:</span>
                            <span class="truncate">{q3Text}</span>
                          </div>
                        )}
                      </div>
                    </td>

                    <td class="py-3 px-3 font-mono text-muted-foreground text-[11px] whitespace-nowrap">
                      {dateFormatted}
                    </td>

                    <td class="py-3 px-3">
                      {isReviewed ? (
                        <div class="space-y-1">
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-pink-500/15 text-pink-600 dark:text-pink-400 border border-pink-500/30">
                            <span>✓</span> Telah Ditinjau
                          </span>
                          {sub.teacherFeedback && (
                            <div class="text-[10px] text-muted-foreground italic truncate max-w-[180px]" title={sub.teacherFeedback}>
                              Tanggapan: "{sub.teacherFeedback}"
                            </div>
                          )}
                        </div>
                      ) : (
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25">
                          <span>⏳</span> Menunggu Tanggapan
                        </span>
                      )}
                    </td>

                    <td class="py-3 px-3 text-right whitespace-nowrap">
                      <button 
                        type="button"
                        class="review-reflection-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-pink-600 hover:bg-pink-500 text-white transition-all shadow-sm flex items-center gap-1.5 ml-auto"
                        data-reflection={JSON.stringify(sub)}
                      >
                        <span>{isReviewed ? '✏️ Edit Tanggapan' : '📖 Baca & Balas'}</span>
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- ========================================== -->
    <!-- SECTION 1: MANAJEMEN DATA PENGGUNA & ROLE SISWA -->
    <!-- ========================================== -->
