---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { db, isDbConfigured, ensureDbInitialized } from '../db';
import { users, userGamification, userProgress, tkaAttempts, userSubmissions } from '../db/schema';
import { eq, desc } from 'drizzle-orm';
import { getCollection } from 'astro:content';
import { calculateLevel } from '../utils/gamification';
import { canAccessAdminPanel, isSuperAdmin, isSuperAdminEmail } from '../utils/auth';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

let dbUser: any = {
  id: user.userId,
  name: user.name || 'Siswa RPL',
  email: user.email,
  role: user.role || 'student',
  studentClass: null,
  createdAt: new Date(),
};

let stats: any = {
  xp: 0,
  level: 1,
  streakDays: 1,
};

let completedLessons: any[] = [];
let examHistory: any[] = [];
let topUsers: any[] = [];
let lkpdSubmissions: any[] = [];
let dbErrorNotice = '';

const dbReady = isDbConfigured();

if (dbReady) {
  try {
    await ensureDbInitialized();

    const [fetchedUser] = await db.select().from(users).where(eq(users.id, user.userId)).limit(1);
    if (fetchedUser) {
      dbUser = fetchedUser;
    }

    const [userStats] = await db.select().from(userGamification).where(eq(userGamification.userId, user.userId)).limit(1);
    if (userStats) {
      stats = userStats;
    } else if (fetchedUser) {
      try {
        const [newStats] = await db.insert(userGamification).values({ userId: user.userId, xp: 0, level: 1 }).returning();
        if (newStats) stats = newStats;
      } catch (insertErr) {
        console.error('Gamification row auto-create error:', insertErr);
      }
    }

    completedLessons = await db.select().from(userProgress).where(eq(userProgress.userId, user.userId));
    examHistory = await db.select().from(tkaAttempts).where(eq(tkaAttempts.userId, user.userId)).orderBy(desc(tkaAttempts.createdAt)).limit(5);
    
    try {
      lkpdSubmissions = await db.select()
        .from(userSubmissions)
        .where(eq(userSubmissions.userId, user.userId))
        .orderBy(desc(userSubmissions.submittedAt));
    } catch (e) {
      lkpdSubmissions = [];
    }

    topUsers = await db.select({
      id: users.id,
      name: users.name,
      studentClass: users.studentClass,
      avatarUrl: users.avatarUrl,
      xp: userGamification.xp,
      level: userGamification.level,
    }).from(userGamification)
      .innerJoin(users, eq(userGamification.userId, users.id))
      .orderBy(desc(userGamification.xp))
      .limit(5);
  } catch (err: any) {
    console.error('Dashboard DB Query Error:', err);
    dbErrorNotice = 'Terjadi kendala saat membaca data dari database Neon Postgres. Pastikan POSTGRES_URL diatur di Vercel Environment Variables.';
  }
} else {
  dbErrorNotice = 'Database Postgres belum terhubung. Silakan atur variabel POSTGRES_URL di Vercel Dashboard (Settings > Environment Variables) agar sistem autentikasi & rekap nilai tersimpan permanen.';
}

// Fetch All Learning Modules
let allModules: any[] = [];
try {
  allModules = await getCollection('pembelajaran');
  allModules.sort((a, b) => a.data.order - b.data.order);
} catch (e) {
  allModules = [];
}

// Calculate level and progress
const levelInfo = calculateLevel(stats.xp || 0);
const currentLevelMinXp = levelInfo.currentLevelMinXp;
const nextLevelXp = levelInfo.nextLevelXp;
const currentLevelProgress = Math.max(0, (stats.xp || 0) - currentLevelMinXp);
const levelRange = Math.max(1, nextLevelXp - currentLevelMinXp);
const xpProgressPercent = Math.min(100, Math.round((currentLevelProgress / levelRange) * 100));

const highestScore = examHistory.length > 0 ? Math.max(...examHistory.map(h => h.score)) : 0;

function getLevelTitle(lvl: number) {
  if (lvl >= 10) return 'Principal Software Architect';
  if (lvl >= 8) return 'Senior Fullstack Specialist';
  if (lvl >= 6) return 'Advanced PPLG Developer';
  if (lvl >= 4) return 'Proficient Web Engineer';
  if (lvl >= 2) return 'Junior Software Craftsman';
  return 'Apprentice Coder';
}

const isSuperAdminUser = isSuperAdmin(dbUser.role) || isSuperAdminEmail(dbUser.email);
const isTeacherOrAdmin = canAccessAdminPanel(dbUser.role);

// Pre-filter submissions by type
const subLkpd = lkpdSubmissions.filter(s => s.submissionType === 'lkpd');
const subRefleksi = lkpdSubmissions.filter(s => s.submissionType === 'reflection');
const subKuis = lkpdSubmissions.filter(s => s.submissionType === 'checkpoint');

// Calculate resume modules
const remainingModules = allModules.filter(mod => !completedLessons.some(c => c.lessonSlug === mod.slug));
const resumeModules = remainingModules.slice(0, 2);
---

<DashboardLayout title="Portal Belajar Siswa" activeNav="/dashboard">
  <div class="space-y-8 max-w-7xl mx-auto pb-12">

    <!-- DB Warning Banner -->
    {dbErrorNotice && (
      <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs shadow-lg">
        <div class="flex items-center gap-3">
          <span class="text-xl">⚠️</span>
          <div>
            <strong class="font-bold text-foreground">Perhatian Koneksi Database:</strong>
            <p class="text-muted-foreground mt-0.5">{dbErrorNotice}</p>
          </div>
        </div>
        <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="btn btn-sm bg-secondary hover:bg-accent text-foreground border border-border rounded-lg text-xs font-mono font-medium whitespace-nowrap self-end sm:self-auto">
          Buka Vercel Settings ↗
        </a>
      </div>
    )}

    <!-- Admin Banner -->
    {isTeacherOrAdmin && (
      <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-lg hover:shadow-amber-500/5 transition-all">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-amber-500/20 text-amber-500 flex items-center justify-center font-bold text-base flex-shrink-0">👑</div>
          <div>
            <div class="text-xs font-bold text-foreground flex items-center gap-2">
              <span>Akses Khusus Pengampu Terdeteksi</span>
              <span class="text-[10px] px-2 py-0.2 rounded font-mono font-bold bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30">
                {isSuperAdminUser ? 'SUPER ADMIN' : 'GURU & ADMIN'}
              </span>
            </div>
            <p class="text-xs text-muted-foreground mt-0.5">
              {isSuperAdminUser ? "Anda memiliki wewenang penuh mengelola kelas." : "Anda dapat memonitor hasil belajar."}
            </p>
          </div>
        </div>
        <a href="/admin" class="btn btn-sm bg-amber-500 hover:bg-amber-400 text-black font-semibold whitespace-nowrap">
          {isSuperAdminUser ? 'Buka Super Admin Panel →' : 'Buka Panel Guru →'}
        </a>
      </div>
    )}

    <!-- Premium Hero Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-card via-card to-primary/10 border border-white/5 shadow-xl hover:shadow-primary/5 transition-all">
      <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay"></div>
      <div class="relative p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-3 relative z-10">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-secondary/80 backdrop-blur-md border border-white/5 text-foreground text-xs font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-semibold">Student Hub</span>
            <span class="text-muted-foreground">•</span>
            <span>SMKN 1 Rongga</span>
            {dbUser?.studentClass && (
              <>
                <span class="text-muted-foreground">•</span>
                <span class="font-bold text-primary">{dbUser.studentClass}</span>
              </>
            )}
          </div>
          <h1 class="text-3xl md:text-4xl font-black text-foreground tracking-tight">
            Halo, <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">{user.name} 👋</span>
          </h1>
          <p class="text-xs sm:text-sm text-muted-foreground max-w-xl leading-relaxed">
            Terus tingkatkan kemampuan koding dan persiapkan dirimu menghadapi Ujian Kejuruan TKA PPLG.
          </p>
        </div>

        <!-- Daily Streak Glass Card -->
        <div class="relative z-10 flex items-center gap-4 bg-white/5 backdrop-blur-md p-4 rounded-2xl border border-white/10 shadow-lg">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-2xl shadow-inner">🔥</div>
          <div class="space-y-0.5 pr-2">
            <div class="text-[10px] text-muted-foreground font-mono font-bold uppercase tracking-widest">Daily Streak</div>
            <div class="text-lg font-black text-foreground font-mono">{stats.streakDays || 1} Hari</div>
            <div class="text-[10px] text-emerald-400 font-semibold tracking-wide">Aktif Hari Ini ✓</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 4 Glassmorphism KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <!-- XP Card -->
      <div class="group p-5 rounded-2xl border border-white/5 bg-card relative overflow-hidden shadow-lg hover:shadow-xl hover:shadow-amber-500/10 transition-all hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative z-10 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Experience</span>
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold shadow-inner">⚡</div>
          </div>
          <div class="space-y-2">
            <div class="text-3xl font-black text-foreground font-mono tracking-tight">
              {stats.xp} <span class="text-xs font-sans font-medium text-muted-foreground">XP</span>
            </div>
            <div class="space-y-1.5 pt-1">
              <div class="w-full bg-secondary/80 rounded-full h-1.5 overflow-hidden border border-white/5">
                <div class="bg-gradient-to-r from-amber-400 to-orange-500 h-full rounded-full transition-all duration-500" style={`width: ${xpProgressPercent}%`}></div>
              </div>
              <div class="flex justify-between text-[10px] text-muted-foreground font-mono font-medium">
                <span>Ke Level {stats.level + 1}</span>
                <span class="text-amber-500">{xpProgressPercent}%</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Level Card -->
      <div class="group p-5 rounded-2xl border border-white/5 bg-card relative overflow-hidden shadow-lg hover:shadow-xl hover:shadow-emerald-500/10 transition-all hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative z-10 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Tingkat Level</span>
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold shadow-inner">🏅</div>
          </div>
          <div class="space-y-1">
            <div class="text-3xl font-black text-foreground font-mono tracking-tight">
              Level {stats.level}
            </div>
            <p class="text-xs text-muted-foreground font-medium truncate">{getLevelTitle(stats.level)}</p>
          </div>
        </div>
      </div>

      <!-- Modules Card -->
      <div class="group p-5 rounded-2xl border border-white/5 bg-card relative overflow-hidden shadow-lg hover:shadow-xl hover:shadow-primary/10 transition-all hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative z-10 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Modul Selesai</span>
            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold shadow-inner">📚</div>
          </div>
          <div class="space-y-1">
            <div class="text-3xl font-black text-foreground font-mono tracking-tight">
              {completedLessons.length} <span class="text-sm font-sans font-medium text-muted-foreground">/ {allModules.length || 1}</span>
            </div>
            <a href="/pembelajaran" class="text-xs font-semibold text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1">
              Buka Katalog <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Exam Card -->
      <div class="group p-5 rounded-2xl border border-white/5 bg-card relative overflow-hidden shadow-lg hover:shadow-xl hover:shadow-cyan-500/10 transition-all hover:-translate-y-1">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative z-10 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Skor Tertinggi</span>
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold shadow-inner">🎯</div>
          </div>
          <div class="space-y-1">
            <div class="text-3xl font-black text-foreground font-mono tracking-tight">
              {highestScore} <span class="text-sm font-sans font-medium text-muted-foreground">/ 100</span>
            </div>
            <p class="text-xs text-muted-foreground font-medium">Dari {examHistory.length}x simulasi TKA</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Main Content Area: 2 Cols Left, 1 Col Right -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- LEFT (Main Features) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Tabbed Evaluations Section -->
        {lkpdSubmissions.length > 0 && (
          <div class="p-6 sm:p-8 rounded-3xl bg-card border border-white/5 shadow-xl relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-white/[0.02] to-transparent pointer-events-none"></div>
            
            <div class="relative z-10 space-y-6">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-5">
                <div class="space-y-1">
                  <h2 class="text-xl font-black text-foreground flex items-center gap-2">
                    <span class="text-2xl">📝</span> Rekap Penilaian
                  </h2>
                  <p class="text-sm text-muted-foreground">Riwayat evaluasi tugas, refleksi, dan kuis.</p>
                </div>
                
                <!-- Tab Navigation -->
                <div class="flex bg-background/50 backdrop-blur-md p-1.5 rounded-xl border border-white/10 shadow-inner">
                  <button class="tab-btn flex-1 px-4 py-2 text-xs font-bold rounded-lg transition-all text-foreground bg-secondary/80 shadow-sm" data-target="lkpd">
                    LKPD
                  </button>
                  <button class="tab-btn flex-1 px-4 py-2 text-xs font-bold rounded-lg transition-all text-muted-foreground hover:text-foreground" data-target="refleksi">
                    Refleksi
                  </button>
                  <button class="tab-btn flex-1 px-4 py-2 text-xs font-bold rounded-lg transition-all text-muted-foreground hover:text-foreground" data-target="kuis">
                    Kuis
                  </button>
                </div>
              </div>

              <!-- Tab Contents -->
              <div class="min-h-[250px]">
                <!-- LKPD Tab -->
                <div id="tab-lkpd" class="tab-content block space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
                  {subLkpd.length === 0 ? (
                    <div class="text-center py-10 text-muted-foreground text-sm font-medium bg-background/30 rounded-2xl border border-dashed border-white/10">Belum ada data Lembar Kerja (LKPD).</div>
                  ) : subLkpd.map((sub: any) => {
                    const isGraded = sub.teacherScore !== null && sub.teacherScore !== undefined;
                    const matchedMod = allModules.find(m => m.slug === sub.lessonSlug);
                    const title = matchedMod?.data.title || sub.lessonSlug;
                    return (
                      <div class="p-4 rounded-2xl bg-background border border-white/5 hover:border-primary/30 transition-all space-y-3 shadow-sm">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-3">
                          <div class="space-y-1">
                            <span class="text-sm font-bold text-foreground">{title}</span>
                            <div class="text-[10px] text-muted-foreground font-mono">Diserahkan: {new Date(sub.submittedAt).toLocaleDateString('id-ID')}</div>
                          </div>
                          <div class="flex items-center gap-2">
                            {isGraded ? (
                              <div class="flex items-center gap-2">
                                {sub.teacherLevel && <span class="px-2 py-1 rounded bg-primary/10 text-primary font-mono text-[10px] font-bold border border-primary/20">{sub.teacherLevel}</span>}
                                <span class="px-2.5 py-1 rounded bg-amber-500/15 text-amber-500 font-mono text-xs font-black border border-amber-500/30">⭐ {sub.teacherScore}/100</span>
                              </div>
                            ) : (
                              <span class="px-2.5 py-1 rounded bg-secondary text-muted-foreground font-mono text-[10px] font-bold border border-white/5">⏳ MENUNGGU</span>
                            )}
                          </div>
                        </div>
                        {isGraded && sub.teacherFeedback && (
                          <div class="p-3 rounded-xl bg-primary/5 border border-primary/10 text-xs text-foreground space-y-1">
                            <span class="text-[10px] font-bold text-primary">💬 EVALUASI:</span>
                            <p class="italic text-muted-foreground">"{sub.teacherFeedback}"</p>
                          </div>
                        )}
                        <div class="text-right pt-1">
                          <a href={`/pembelajaran/${sub.lessonSlug}`} class="text-[11px] font-bold text-primary hover:underline">Lihat Detail →</a>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <!-- Refleksi Tab -->
                <div id="tab-refleksi" class="tab-content hidden space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
                  {subRefleksi.length === 0 ? (
                    <div class="text-center py-10 text-muted-foreground text-sm font-medium bg-background/30 rounded-2xl border border-dashed border-white/10">Belum ada data Jurnal Refleksi.</div>
                  ) : subRefleksi.map((sub: any) => {
                    const isGraded = sub.teacherScore !== null && sub.teacherScore !== undefined;
                    const matchedMod = allModules.find(m => m.slug === sub.lessonSlug);
                    const title = matchedMod?.data.title || sub.lessonSlug;
                    return (
                      <div class="p-4 rounded-2xl bg-background border border-white/5 hover:border-primary/30 transition-all space-y-3 shadow-sm">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-3">
                          <div class="space-y-1">
                            <span class="text-sm font-bold text-foreground">{title}</span>
                            <div class="text-[10px] text-muted-foreground font-mono">Diserahkan: {new Date(sub.submittedAt).toLocaleDateString('id-ID')}</div>
                          </div>
                          <div class="flex items-center gap-2">
                            {isGraded ? (
                              <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 rounded bg-amber-500/15 text-amber-500 font-mono text-xs font-black border border-amber-500/30">⭐ {sub.teacherScore}/100</span>
                              </div>
                            ) : (
                              <span class="px-2.5 py-1 rounded bg-secondary text-muted-foreground font-mono text-[10px] font-bold border border-white/5">⏳ MENUNGGU</span>
                            )}
                          </div>
                        </div>
                        <div class="text-right pt-1">
                          <a href={`/pembelajaran/${sub.lessonSlug}`} class="text-[11px] font-bold text-primary hover:underline">Lihat Detail →</a>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <!-- Kuis Tab -->
                <div id="tab-kuis" class="tab-content hidden space-y-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
                  {subKuis.length === 0 ? (
                    <div class="text-center py-10 text-muted-foreground text-sm font-medium bg-background/30 rounded-2xl border border-dashed border-white/10">Belum ada data Kuis Checkpoint.</div>
                  ) : subKuis.map((sub: any) => {
                    const isGraded = sub.teacherScore !== null && sub.teacherScore !== undefined;
                    const matchedMod = allModules.find(m => m.slug === sub.lessonSlug);
                    const title = matchedMod?.data.title || sub.lessonSlug;
                    return (
                      <div class="p-4 rounded-2xl bg-background border border-white/5 hover:border-primary/30 transition-all space-y-3 shadow-sm">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-3">
                          <div class="space-y-1">
                            <span class="text-sm font-bold text-foreground">{title}</span>
                            <div class="text-[10px] text-muted-foreground font-mono">Diserahkan: {new Date(sub.submittedAt).toLocaleDateString('id-ID')}</div>
                          </div>
                          <div class="flex items-center gap-2">
                            {isGraded ? (
                              <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 rounded bg-amber-500/15 text-amber-500 font-mono text-xs font-black border border-amber-500/30">⭐ {sub.teacherScore}/100</span>
                              </div>
                            ) : (
                              <span class="px-2.5 py-1 rounded bg-secondary text-muted-foreground font-mono text-[10px] font-bold border border-white/5">⏳ MENUNGGU</span>
                            )}
                          </div>
                        </div>
                        <div class="text-right pt-1">
                          <a href={`/pembelajaran/${sub.lessonSlug}`} class="text-[11px] font-bold text-primary hover:underline">Lihat Detail →</a>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- Resume Learning (Compact) -->
        <div class="space-y-4">
          <div class="flex items-center justify-between px-1">
            <h2 class="text-lg font-black text-foreground">Lanjutkan Belajar</h2>
            <a href="/pembelajaran" class="text-sm font-bold text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1">
              Katalog Lengkap <span>→</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {resumeModules.length > 0 ? resumeModules.map((mod: any) => (
              <a href={`/pembelajaran/${mod.slug}`} class="group p-5 rounded-2xl bg-card border border-white/5 shadow-lg hover:shadow-xl hover:border-primary/30 transition-all flex flex-col justify-between h-full gap-6">
                <div class="space-y-3">
                  <span class="inline-block px-2.5 py-1 rounded-md bg-secondary text-muted-foreground border border-white/5 text-[10px] font-mono font-bold uppercase tracking-wider">
                    {mod.data.category || 'Materi'}
                  </span>
                  <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors leading-snug">
                    {mod.data.title}
                  </h3>
                </div>
                <div class="flex items-center justify-between border-t border-white/5 pt-4">
                  <span class="text-xs font-mono font-bold text-amber-500">✨ +10 XP</span>
                  <span class="text-xs font-bold text-primary group-hover:translate-x-1 transition-transform">Lanjutkan →</span>
                </div>
              </a>
            )) : (
              <div class="col-span-1 sm:col-span-2 p-6 rounded-2xl bg-card border border-white/5 text-center shadow-sm">
                <p class="text-sm font-bold text-foreground">🎉 Luar Biasa!</p>
                <p class="text-xs text-muted-foreground mt-1">Anda telah menyelesaikan semua materi yang tersedia.</p>
              </div>
            )}
          </div>
        </div>

      </div>

      <!-- RIGHT (Leaderboard & TKA CTA) -->
      <div class="space-y-6 lg:space-y-8">

        <!-- TKA Banner (Elevated) -->
        <a href="/pembelajaran/tka-pplg" class="group block p-6 rounded-3xl bg-gradient-to-br from-cyan-900/40 to-blue-900/20 border border-cyan-500/20 shadow-xl hover:shadow-cyan-500/10 transition-all hover:-translate-y-1 relative overflow-hidden">
          <div class="absolute -right-6 -top-6 text-7xl opacity-10 group-hover:opacity-20 group-hover:rotate-12 transition-all">🎯</div>
          <div class="relative z-10 space-y-4">
            <span class="inline-block px-3 py-1 rounded-lg bg-cyan-500/20 text-cyan-300 text-[10px] font-mono font-black uppercase tracking-widest border border-cyan-500/30">
              Ujian Kejuruan
            </span>
            <h3 class="text-xl font-black text-white leading-tight">Drilling Simulator TKA PPLG</h3>
            <p class="text-xs text-cyan-100/70 font-medium">Ukur kesiapanmu dengan CBT standar industri. Real-time scoring.</p>
            <div class="pt-2">
              <span class="inline-flex items-center justify-center bg-cyan-500 text-black font-bold text-xs px-4 py-2 rounded-xl group-hover:bg-cyan-400 transition-colors">
                Mulai Ujian Sekarang →
              </span>
            </div>
          </div>
        </a>

        <!-- Leaderboard -->
        <div class="p-6 rounded-3xl bg-card border border-white/5 shadow-xl">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-base font-black text-foreground flex items-center gap-2">
              <span class="text-xl">🏆</span> Peringkat
            </h2>
            <a href="/dashboard/leaderboard" class="text-xs font-bold text-primary hover:text-primary/80 transition-colors">
              Semua →
            </a>
          </div>

          <div class="space-y-3">
            {topUsers.length === 0 ? (
              <p class="text-xs text-center text-muted-foreground py-4 bg-background/50 rounded-xl">Belum ada data peringkat.</p>
            ) : (
              topUsers.map((top, idx) => {
                let badgeClass = "bg-secondary text-muted-foreground border-border";
                if (idx === 0) badgeClass = "bg-gradient-to-br from-yellow-300 to-amber-500 text-black border-yellow-200 shadow-md shadow-amber-500/20"; // Gold
                else if (idx === 1) badgeClass = "bg-gradient-to-br from-slate-200 to-slate-400 text-black border-slate-300 shadow-md shadow-slate-400/20"; // Silver
                else if (idx === 2) badgeClass = "bg-gradient-to-br from-orange-300 to-orange-600 text-white border-orange-400 shadow-md shadow-orange-500/20"; // Bronze

                return (
                  <div class="flex items-center justify-between p-3 rounded-2xl bg-background border border-white/5 hover:border-white/10 hover:bg-white/[0.02] transition-colors">
                    <div class="flex items-center gap-3 min-w-0">
                      <div class={`w-8 h-8 rounded-xl flex items-center justify-center font-black font-mono text-xs border ${badgeClass} flex-shrink-0`}>
                        {idx + 1}
                      </div>
                      <div class="min-w-0 pr-2">
                        <div class="text-sm font-bold text-foreground truncate">{top.name}</div>
                        <div class="flex items-center gap-2 mt-0.5">
                          <span class="text-[10px] text-muted-foreground font-mono font-medium">Lvl {top.level}</span>
                          {top.studentClass && <span class="text-[9px] px-1.5 py-0.5 rounded-md bg-secondary/50 text-muted-foreground font-mono">{top.studentClass}</span>}
                        </div>
                      </div>
                    </div>
                    <div class="font-mono text-xs font-black text-amber-500 flex-shrink-0 bg-amber-500/10 px-2 py-1 rounded-lg border border-amber-500/20">
                      {top.xp} <span class="text-[9px] text-amber-500/70">XP</span>
                    </div>
                  </div>
                )
              })
            )}
          </div>
        </div>

      </div>
    </div>
  </div>
</DashboardLayout>

<!-- Client Script for Tabs -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset all buttons
        btns.forEach(b => {
          b.classList.remove('text-foreground', 'bg-secondary/80', 'shadow-sm');
          b.classList.add('text-muted-foreground');
        });
        
        // Active button
        btn.classList.remove('text-muted-foreground');
        btn.classList.add('text-foreground', 'bg-secondary/80', 'shadow-sm');

        // Hide all contents
        contents.forEach(c => {
          c.classList.remove('block');
          c.classList.add('hidden');
        });

        // Show target content
        const targetId = `tab-${btn.getAttribute('data-target')}`;
        document.getElementById(targetId)?.classList.remove('hidden');
        document.getElementById(targetId)?.classList.add('block');
      });
    });
  });
</script>

