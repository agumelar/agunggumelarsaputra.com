---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GamificationWidget from '../../components/GamificationWidget.astro';
import { getCollection } from 'astro:content';
import { db, isDbConfigured, ensureDbInitialized } from '../../db';
import { enrollmentTokens, userEnrollments } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
let modules: any[] = [];
try {
  modules = await getCollection('pembelajaran');
} catch (e) {
  modules = [];
}
const sortedModules = modules.sort((a, b) => a.data.order - b.data.order);

let studentEnrollments: any[] = [];
if (user && isDbConfigured()) {
  try {
    await ensureDbInitialized();
    studentEnrollments = await db.select({
      id: userEnrollments.id,
      enrolledAt: userEnrollments.enrolledAt,
      tokenId: enrollmentTokens.id,
      token: enrollmentTokens.token,
      title: enrollmentTokens.title,
      description: enrollmentTokens.description,
      targetType: enrollmentTokens.targetType,
      targetSlug: enrollmentTokens.targetSlug,
      targetClass: enrollmentTokens.targetClass,
      isActive: enrollmentTokens.isActive,
    }).from(userEnrollments)
      .innerJoin(enrollmentTokens, eq(userEnrollments.tokenId, enrollmentTokens.id))
      .where(eq(userEnrollments.userId, user.userId))
      .orderBy(desc(userEnrollments.enrolledAt));
  } catch (err) {
    console.error('Pembelajaran index DB Error:', err);
  }
}
---

{user ? (
  <DashboardLayout 
    title="Katalog Modul Pembelajaran PPLG" 
    description="Pusat modul pembelajaran interaktif Rekayasa Perangkat Lunak SMKN 1 Rongga"
    activeNav="/pembelajaran"
  >
    <div class="space-y-6 max-w-6xl mx-auto">
      
      <!-- Header Banner -->
      <div class="p-6 rounded-xl bg-card border border-border flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-sm">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-md bg-secondary text-foreground border border-border text-xs font-mono font-semibold">
            <span>Kurikulum Merdeka</span>
            <span>•</span>
            <span>SMKN 1 Rongga</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
            Katalog Modul Pembelajaran PPLG
          </h1>
          <p class="text-xs sm:text-sm text-muted-foreground max-w-xl leading-relaxed">
            Pelajari setiap materi secara mandiri. Tandai modul selesai untuk mendapatkan Experience Points (+15 XP) dan menaikkan level belajarmu!
          </p>
        </div>

        <a href="/pembelajaran/tka-pplg" class="btn btn-sm bg-cyan-600 hover:bg-cyan-500 text-white font-semibold whitespace-nowrap px-4 py-2.5 rounded-lg shadow-sm">
          🎯 Drilling TKA Simulator →
        </a>
      </div>

      <!-- ========================================== -->
      <!-- ENROLL TOKEN SESI WIDGET -->
      <!-- ========================================== -->
      <div class="card p-5 sm:p-6 rounded-xl border-border bg-card shadow-sm space-y-5">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border pb-4">
          <div class="space-y-1">
            <h2 class="text-base font-bold text-foreground flex items-center gap-2">
              <span>🎟️ Gabung Sesi Kelas (Enroll Token)</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-secondary text-foreground border border-border font-mono font-semibold">
                PRESENSI & REKAP KELAS
              </span>
            </h2>
            <p class="text-xs text-muted-foreground">
              Masukkan Kode Token dari Guru Pengampu (contoh: <code class="text-foreground font-mono font-semibold bg-secondary px-1.5 py-0.5 rounded border border-border">10RPL1-49XA</code>) untuk menghubungkan nilai tryout dan progres belajar ke rekapitulasi kelas.
            </p>
          </div>

          <!-- Alert for Token Feedback -->
          <div id="enroll-alert" class="hidden text-xs font-medium px-3 py-1.5 rounded-lg text-center"></div>
        </div>

        <!-- Token Input Form -->
        <form id="enroll-token-form" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <div class="relative flex-grow">
            <input 
              type="text" 
              id="token-input" 
              placeholder="Masukkan Kode Token Sesi..." 
              required
              class="w-full px-3.5 py-2.5 rounded-lg bg-background border border-border text-foreground font-mono font-bold text-xs sm:text-sm tracking-wider uppercase placeholder:normal-case placeholder:font-normal focus:outline-none focus:border-primary"
            />
          </div>
          <button 
            type="submit" 
            id="btn-enroll-submit"
            class="px-5 py-2.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs sm:text-sm whitespace-nowrap transition-colors flex items-center justify-center gap-2"
          >
            <span id="enroll-btn-text">Gabung (Enroll) Sesi</span>
          </button>
        </form>

        <!-- Active Enrolled Sessions List -->
        {studentEnrollments.length > 0 && (
          <div class="pt-2 space-y-3">
            <h3 class="text-xs font-semibold text-muted-foreground uppercase font-mono tracking-wider">
              Sesi Belajar & Ujian yang Sedang Anda Ikuti ({studentEnrollments.length})
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
              {studentEnrollments.map((enr) => (
                <div class="p-4 rounded-lg bg-secondary/40 border border-border flex flex-col justify-between space-y-3">
                  <div class="space-y-1">
                    <div class="flex items-center justify-between gap-2">
                      <span class="px-2 py-0.5 rounded bg-secondary text-foreground font-mono font-bold text-xs tracking-wider border border-border">
                        {enr.token}
                      </span>
                      <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-secondary text-foreground border border-border">
                        {enr.targetClass}
                      </span>
                    </div>
                    <h4 class="text-sm font-semibold text-foreground line-clamp-1">{enr.title}</h4>
                    {enr.description && (
