                Rencana pembelajaran 16 pertemuan mencakup wawasan 8 profesi kunci industri, ekosistem software house, jenjang karier, dan review produk digital berdasarkan BSKAP No. 046/H/KR/2025.
              </p>
            </div>

            <div class="pt-2">
              <a href="/pembelajaran/orientasi-pplg" class="btn btn-primary text-white font-semibold text-xs sm:text-sm px-5 py-2.5 rounded-lg inline-block">
                Lihat Silabus & 8 Modul Lengkap →
              </a>
            </div>
          </div>

          <!-- Public TKA Card -->
          <div class="card p-6 md:p-8 rounded-2xl bg-card border border-border space-y-5 shadow-sm flex flex-col justify-between">
            <div class="space-y-3">
              <span class="px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 text-[11px] font-mono font-bold uppercase">
                SIMULASI CBT
              </span>
              <h3 class="text-xl font-bold text-foreground">Drilling TKA PPLG Simulator</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Simulasi ujian kejuruan interaktif untuk mengukur pemahaman teori dan logika pemrograman.
              </p>
            </div>

            <a href="/pembelajaran/tka-pplg" class="btn bg-cyan-600 hover:bg-cyan-500 text-white text-xs sm:text-sm font-semibold py-2.5 rounded-lg text-center block">
              Mulai Ujian TKA →
            </a>
          </div>
        </div>

      </div>
    </section>
  </BaseLayout>
)}

<script>
  const enrollForm = document.getElementById('enroll-token-form') as HTMLFormElement | null;
  const tokenInput = document.getElementById('token-input') as HTMLInputElement | null;
  const enrollAlert = document.getElementById('enroll-alert');
  const btnEnrollSubmit = document.getElementById('btn-enroll-submit') as HTMLButtonElement | null;
  const enrollBtnText = document.getElementById('enroll-btn-text');

  function showEnrollAlert(msg: string, isError = false) {
    if (!enrollAlert) return;
    enrollAlert.className = isError 
      ? 'text-xs font-semibold px-3 py-1.5 rounded-lg text-center bg-destructive/10 border border-destructive/25 text-destructive block animate-fadeIn'
      : 'text-xs font-semibold px-3 py-1.5 rounded-lg text-center bg-emerald-500/10 border border-emerald-500/25 text-emerald-600 dark:text-emerald-400 block animate-fadeIn';
    enrollAlert.textContent = (isError ? '✕ ' : '✓ ') + msg;
  }

  enrollForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const tokenCode = tokenInput?.value.trim().toUpperCase();

    if (!tokenCode) {
      showEnrollAlert('Harap masukkan kode token sesi terlebih dahulu.', true);
      return;
    }

    if (btnEnrollSubmit) btnEnrollSubmit.disabled = true;
    if (enrollBtnText) enrollBtnText.textContent = 'Mendaftarkan...';

    try {
      const res = await fetch('/api/enroll', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tokenCode })
      });

      const data = await res.json();

      if (res.ok && data.success) {
        // Save active token info in localStorage for quiz/module tracking
        localStorage.setItem('ags_active_token_id', data.token.id.toString());
        localStorage.setItem('ags_active_token_code', data.token.token);
        localStorage.setItem('ags_active_token_title', data.token.title);

        showEnrollAlert(data.message || 'Berhasil mendaftar ke sesi!');
        setTimeout(() => window.location.reload(), 1200);
      } else {
        showEnrollAlert(data.error || 'Gagal mendaftar token sesi.', true);
        if (btnEnrollSubmit) btnEnrollSubmit.disabled = false;
        if (enrollBtnText) enrollBtnText.textContent = 'Gabung (Enroll) Sesi';
      }
    } catch (err: any) {
      showEnrollAlert(err.message || 'Gangguan jaringan / server.', true);
      if (btnEnrollSubmit) btnEnrollSubmit.disabled = false;
      if (enrollBtnText) enrollBtnText.textContent = 'Gabung (Enroll) Sesi';
    }
  });
</script>
