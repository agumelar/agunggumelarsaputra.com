---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GamificationWidget from '../../components/GamificationWidget.astro';
import { getCollection } from 'astro:content';

const user = Astro.locals.user;
let modules: any[] = [];
try {
  modules = await getCollection('pembelajaran');
} catch (e) {
  modules = [];
}
const sortedModules = modules.sort((a, b) => a.data.order - b.data.order);
---

{user ? (
  <DashboardLayout 
    title="Katalog Pembelajaran PPLG" 
    description="Pusat modul pembelajaran interaktif Rekayasa Perangkat Lunak SMKN 1 Rongga"
    activeNav="/pembelajaran"
  >
    <div class="space-y-8 max-w-6xl mx-auto pb-12">
      
      <!-- 1. GAMIFICATION WIDGET (TOP PRIORITY) -->
      <GamificationWidget />

      <!-- 2. HERO SECTION (MINIMALIST ELEGANT) -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-card via-card to-blue-900/10 border border-white/5 shadow-xl">
        <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay"></div>
        <div class="relative p-8 md:p-12 flex flex-col md:flex-row md:items-center justify-between gap-8">
          <div class="space-y-4 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-mono font-semibold">
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              <span>Kurikulum Merdeka 2026/2027</span>
            </div>
            <h1 class="text-3xl md:text-5xl font-black text-foreground tracking-tight leading-tight">
              Eksplorasi Modul <br class="hidden md:block"/>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">
                Rekayasa Perangkat Lunak
              </span>
            </h1>
            <p class="text-sm md:text-base text-muted-foreground leading-relaxed max-w-xl">
              Akses materi komprehensif, bangun portofolio, dan kumpulkan Experience Points (XP) untuk setiap modul yang Anda selesaikan.
            </p>
          </div>

          <div class="flex-shrink-0">
            <a href="/pembelajaran/tka-pplg" class="group relative inline-flex items-center justify-center gap-2 bg-card border border-white/10 hover:border-primary/50 text-foreground px-6 py-3.5 rounded-2xl shadow-lg hover:shadow-primary/20 transition-all hover:-translate-y-1">
              <div class="absolute inset-0 bg-gradient-to-r from-blue-500/10 to-cyan-500/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <span class="text-xl">🎯</span>
              <div class="text-left">
                <div class="text-[10px] font-mono text-muted-foreground font-semibold uppercase tracking-wider">Drilling Simulator</div>
                <div class="text-sm font-bold">Tryout TKA PPLG</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- 3. COURSE GRID -->
      <div class="space-y-6">
        <div class="flex items-center justify-between border-b border-border/50 pb-4">
          <h2 class="text-xl md:text-2xl font-bold text-foreground">Program & Mata Pelajaran</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- COURSE CARD: ORIENTASI PPLG -->
          <a href="/pembelajaran/orientasi-pplg" class="group relative flex flex-col justify-between bg-card rounded-3xl border border-white/5 hover:border-blue-500/30 overflow-hidden shadow-lg hover:shadow-2xl hover:shadow-blue-900/20 transition-all duration-300 hover:-translate-y-1.5 cursor-pointer">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="p-8 space-y-6 relative z-10">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-1 rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-mono font-bold uppercase tracking-wider">
                  Mata Pelajaran Utama
                </span>
                <span class="px-2.5 py-1 rounded-md bg-secondary text-foreground border border-border text-[10px] font-mono font-semibold">
                  Fase E • Kelas 10
                </span>
              </div>

              <div>
                <h3 class="text-2xl font-bold text-foreground group-hover:text-blue-400 transition-colors mb-3">
                  Orientasi PPLG & Skill Passport
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
                  Fondasi wawasan industri, 8 profesi kunci, ekosistem software house vs startup, dan review produk digital berdasarkan standar industri.
                </p>
              </div>

              <div class="grid grid-cols-2 gap-3 pt-2">
                <div class="p-3 rounded-xl bg-secondary/30 border border-white/5">
                  <span class="text-[10px] font-mono text-muted-foreground block mb-1">JUMLAH PERTEMUAN</span>
                  <span class="text-xs font-bold text-foreground">16 Pertemuan</span>
                </div>
                <div class="p-3 rounded-xl bg-secondary/30 border border-white/5">
                  <span class="text-[10px] font-mono text-muted-foreground block mb-1">TOTAL XP</span>
                  <span class="text-xs font-bold text-emerald-400 font-mono">✨ +120 XP</span>
                </div>
              </div>
            </div>

            <div class="px-8 py-5 border-t border-white/5 bg-secondary/10 flex items-center justify-between transition-colors group-hover:bg-blue-500/5 relative z-10">
              <span class="text-xs font-medium text-muted-foreground">Oleh Agung Gumelar S.</span>
              <span class="text-sm font-semibold text-blue-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
                Buka Modul 
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <!-- COURSE CARD: TKA PPLG -->
          <a href="/pembelajaran/tka-pplg" class="group relative flex flex-col justify-between bg-card rounded-3xl border border-white/5 hover:border-cyan-500/30 overflow-hidden shadow-lg hover:shadow-2xl hover:shadow-cyan-900/20 transition-all duration-300 hover:-translate-y-1.5 cursor-pointer">
            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="p-8 space-y-6 relative z-10">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-1 rounded-md bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-[10px] font-mono font-bold uppercase tracking-wider">
                  Simulasi CBT
                </span>
                <span class="px-2.5 py-1 rounded-md bg-secondary text-foreground border border-border text-[10px] font-mono font-semibold">
                  Persiapan Ujian
                </span>
              </div>

              <div>
                <h3 class="text-2xl font-bold text-foreground group-hover:text-cyan-400 transition-colors mb-3">
                  Drilling TKA RPL Simulator
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
                  Latihan soal Tes Kemampuan Akademik & Kejuruan Software Engineering berbasis waktu dengan analisis skor instan secara real-time.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-secondary/30 border border-white/5 flex items-center justify-between">
                <div>
                  <span class="text-[10px] font-mono text-muted-foreground block mb-1">SISTEM PENILAIAN</span>
                  <span class="text-xs font-bold text-foreground">Standardized CBT</span>
                </div>
                <div class="text-right">
                  <span class="text-[10px] font-mono text-muted-foreground block mb-1">DURASI</span>
                  <span class="text-xs font-bold text-foreground">40 Menit</span>
                </div>
              </div>
            </div>

            <div class="px-8 py-5 border-t border-white/5 bg-secondary/10 flex items-center justify-between transition-colors group-hover:bg-cyan-500/5 relative z-10">
              <span class="text-xs font-medium text-muted-foreground">Auto-Sync Nilai</span>
              <span class="text-sm font-semibold text-cyan-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
                Mulai Ujian 
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <!-- COURSE CARD: RABU LITERASI ASIK (RESIK) -->
          <a href="/pembelajaran/literasi-resik" class="group relative flex flex-col justify-between bg-card rounded-3xl border border-white/5 hover:border-emerald-500/30 overflow-hidden shadow-lg hover:shadow-2xl hover:shadow-emerald-900/20 transition-all duration-300 hover:-translate-y-1.5 cursor-pointer md:col-span-2 lg:col-span-1">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="p-8 space-y-6 relative z-10">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-mono font-bold uppercase tracking-wider">
                  Pembiasaan Mingguan
                </span>
                <span class="px-2.5 py-1 rounded-md bg-secondary text-foreground border border-border text-[10px] font-mono font-semibold">
                  Program RESIK
                </span>
              </div>

              <div>
                <h3 class="text-2xl font-bold text-foreground group-hover:text-emerald-400 transition-colors mb-3">
                  Rabu Literasi ASIK (RESIK)
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
                  Laporan resensi buku mingguan, evaluasi rubrik 9 aspek, peer review antarteman sekelas, dan cetak dokumen resmi resensi.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-secondary/30 border border-white/5 flex items-center justify-between">
                <div>
                  <span class="text-[10px] font-mono text-muted-foreground block mb-1">FREKUENSI</span>
                  <span class="text-xs font-bold text-foreground">1 Minggu Sekali (Hari Rabu)</span>
                </div>
                <div class="text-right">
                  <span class="text-[10px] font-mono text-muted-foreground block mb-1">REWARD</span>
                  <span class="text-xs font-bold text-emerald-400 font-mono">✨ +30 XP / Resensi</span>
                </div>
              </div>
            </div>

            <div class="px-8 py-5 border-t border-white/5 bg-secondary/10 flex items-center justify-between transition-colors group-hover:bg-emerald-500/5 relative z-10">
              <span class="text-xs font-medium text-muted-foreground">Unduh PDF & CSV Rekap</span>
              <span class="text-sm font-semibold text-emerald-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
                Buka Portal RESIK 
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

        </div>

        <!-- PENGAYAAN -->
        {sortedModules.filter((m) => !m.data.category.startsWith('Orientasi PPLG')).length > 0 && (
          <div class="space-y-4 pt-8">
            <h2 class="text-lg font-bold text-foreground border-b border-border/50 pb-3">Materi Pengayaan & Praktis</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              {sortedModules.filter((m) => !m.data.category.startsWith('Orientasi PPLG')).map((mod) => (
                <a href={`/pembelajaran/${mod.id || mod.slug}`} class="group flex flex-col justify-between bg-card p-6 rounded-2xl border border-white/5 hover:border-primary/40 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all">
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="px-2 py-1 rounded text-[9px] uppercase tracking-wider bg-secondary text-muted-foreground font-bold border border-white/5">
                        {mod.data.category}
                      </span>
                    </div>
                    <h3 class="text-base font-bold text-foreground group-hover:text-primary transition-colors">
                      {mod.data.title}
                    </h3>
                    <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">
                      {mod.data.description}
                    </p>
                  </div>
                  <div class="pt-4 mt-4 border-t border-white/5 flex items-center justify-between">
                    <span class="text-[10px] text-amber-400 font-mono font-bold">✨ +15 XP</span>
                    <span class="text-xs font-semibold text-muted-foreground group-hover:text-primary transition-colors">Belajar →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </DashboardLayout>
) : (
  <BaseLayout 
    title="Katalog Pembelajaran PPLG" 
    description="Pusat modul pembelajaran interaktif Rekayasa Perangkat Lunak (RPL) SMKN 1 Rongga oleh Agung Gumelar Saputra, S.Tr.T."
  >
    <!-- Public Hero Section (Dark Slate & Glow Accents) -->
    <section class="relative pt-12 pb-16 overflow-hidden border-b border-border bg-gradient-to-b from-card via-background to-background">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-cyan-900/20 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="container-main relative z-10 space-y-6 text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs font-mono font-semibold shadow-sm">
          <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
          <span>KATALOG PEMBELAJARAN PPLG & REKAYASA PERANGKAT LUNAK</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight leading-tight">
          Platform Belajar <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-emerald-400 to-teal-300">PPLG & Software Engineer</span>
        </h1>

        <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
          Jelajahi silabus materi interaktif, 16 pertemuan Orientasi PPLG, 10 simulasi CBT Drilling TKA, dan ekosistem gamifikasi XP khusus siswa Rekayasa Perangkat Lunak SMKN 1 Rongga.
        </p>

        <!-- Quick Login / Register Prompt Card -->
        <div class="p-4 rounded-2xl bg-card/80 border border-cyan-500/20 shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4 text-left backdrop-blur-md">
          <div class="space-y-0.5">
            <div class="text-xs font-bold text-foreground flex items-center gap-1.5">
              <span>🔑</span>
              <span>Akses Penuh Modul & Gamifikasi XP</span>
            </div>
            <p class="text-[11px] text-muted-foreground">Pilih modul di bawah ini untuk memulai. Saat mengklik modul, kamu akan diarahkan untuk masuk/daftar akun siswa.</p>
          </div>
          <a href="/login?redirect=/pembelajaran" class="btn btn-sm bg-gradient-to-r from-cyan-600 to-emerald-500 hover:from-cyan-500 hover:to-emerald-400 text-white font-bold text-xs px-5 py-2.5 rounded-xl border-0 shadow-md flex-shrink-0">
            Masuk Portal Siswa →
          </a>
        </div>
      </div>
    </section>

    <!-- Public Course Catalog Grid Section -->
    <section class="py-14 bg-background">
      <div class="container-main space-y-10">
        
        <!-- Header & Category Stats Bar -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-border/60 pb-5">
          <div>
            <span class="px-2.5 py-0.5 rounded text-[10px] bg-secondary text-foreground font-mono font-semibold border border-border">
              PROGRAM & MATA PELAJARAN
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground mt-1">
              Katalog Silabus & Modul Pembelajaran
            </h2>
          </div>

          <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground">
            <span class="px-3 py-1 rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-bold">16 Modul Orientasi</span>
            <span>•</span>
            <span class="px-3 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 font-bold">10 Tryout TKA</span>
          </div>
        </div>

        <!-- 2 Main Course Highlight Cards -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- MAIN CARD 1: ORIENTASI PPLG -->
          <div class="card p-8 rounded-3xl border border-blue-500/30 bg-gradient-to-br from-card via-card to-blue-950/20 shadow-xl space-y-6 relative overflow-hidden group hover:border-blue-500/60 transition-all">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-mono font-bold uppercase tracking-wider">
                  MATA PELAJARAN UTAMA • FASE E (KELAS 10)
                </span>
                <span class="text-xs font-mono text-emerald-400 font-bold">✨ +120 XP</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-foreground group-hover:text-blue-400 transition-colors">
                Orientasi PPLG & Skill Passport
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                Fondasi wawasan industri perangkat lunak, 8 profesi kunci PPLG, ekosistem software house vs startup, review produk digital, dan jejak kompetensi Skill Passport (Level 0-4).
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 pt-2">
              <div class="p-3.5 rounded-xl bg-secondary/40 border border-border/60">
                <span class="text-[10px] font-mono text-muted-foreground block mb-0.5">ESTIMASI MATERI</span>
                <span class="text-xs font-bold text-foreground">16 Pertemuan</span>
              </div>
              <div class="p-3.5 rounded-xl bg-secondary/40 border border-border/60">
                <span class="text-[10px] font-mono text-muted-foreground block mb-0.5">STANDAR ASESMEN</span>
                <span class="text-xs font-bold text-foreground">Rubrik KKTP Level 0-4</span>
              </div>
            </div>

            <div class="pt-4 border-t border-border/60 flex items-center justify-between">
              <span class="text-xs text-muted-foreground font-mono">Pengampu: Agung Gumelar S., S.Tr.T.</span>
              <a href="/login?redirect=/pembelajaran/orientasi-pplg" class="btn btn-sm bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-4 py-2 rounded-xl transition-all shadow-md">
                Buka Silabus Modul →
              </a>
            </div>
          </div>

          <!-- MAIN CARD 2: DRILLING TKA PPLG -->
          <div class="card p-8 rounded-3xl border border-amber-500/30 bg-gradient-to-br from-card via-card to-amber-950/20 shadow-xl space-y-6 relative overflow-hidden group hover:border-amber-500/60 transition-all">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-mono font-bold uppercase tracking-wider">
                  TRYOUT CBT SIMULATOR • KELAS 12
                </span>
                <span class="text-xs font-mono text-amber-400 font-bold">🎯 600 SOAL A-E</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-foreground group-hover:text-amber-400 transition-colors">
                Drilling TKA RPL Simulator
              </h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                Simulasi Ujian Tes Keahlian Akademik PPLG berbasis CBT waktu 60 menit, pengacakan otomatis opsi (A-E), dan penjelasan lengkap khas Pak Agung.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 pt-2">
              <div class="p-3.5 rounded-xl bg-secondary/40 border border-border/60">
                <span class="text-[10px] font-mono text-muted-foreground block mb-0.5">TOTAL TOPIK UJIAN</span>
                <span class="text-xs font-bold text-foreground">10 Pertemuan</span>
              </div>
              <div class="p-3.5 rounded-xl bg-secondary/40 border border-border/60">
                <span class="text-[10px] font-mono text-muted-foreground block mb-0.5">SISTEM SKOR</span>
                <span class="text-xs font-bold text-emerald-400 font-mono">KKM 73 • Auto Score</span>
              </div>
            </div>

            <div class="pt-4 border-t border-border/60 flex items-center justify-between">
              <span class="text-xs text-muted-foreground font-mono">Pengacak: Fisher-Yates</span>
              <a href="/login?redirect=/pembelajaran/tka-pplg" class="btn btn-sm bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-black font-bold text-xs px-4 py-2 rounded-xl transition-all shadow-md">
                🎯 Mulai Simulator Ujian →
              </a>
            </div>
          </div>

        </div>

        <!-- 16 ORIENTASI PPLG MODULES PUBLIC LIST -->
        <div class="space-y-5 pt-6">
          <div class="flex items-center justify-between border-b border-border/60 pb-3">
            <h3 class="text-xl font-bold text-foreground flex items-center gap-2">
              <span>📖 Modul Pembelajaran Orientasi PPLG</span>
              <span class="px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                16 Pertemuan
              </span>
            </h3>
            <span class="text-xs text-muted-foreground">Fase E / Kelas 10 RPL</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {sortedModules.map((mod) => (
              <div class="card p-5 rounded-2xl border border-border bg-card space-y-3.5 shadow-sm hover:border-cyan-500/40 transition-all flex flex-col justify-between">
                <div class="space-y-2.5">
                  <div class="flex items-center justify-between text-xs font-mono">
                    <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-bold">
                      Modul #{mod.data.order}
                    </span>
                    <span class="text-muted-foreground">{mod.data.duration}</span>
                  </div>
                  <h4 class="text-sm font-bold text-foreground leading-snug line-clamp-2">
                    {mod.data.title}
                  </h4>
                  <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">
                    {mod.data.description}
                  </p>
                </div>

                <div class="pt-3 border-t border-border/60 flex items-center justify-between">
                  <span class="text-[11px] font-mono text-emerald-400 font-bold">✨ +15 XP</span>
                  <a 
                    href={`/login?redirect=${encodeURIComponent('/pembelajaran/' + (mod.id || mod.slug))}`}
                    class="px-3 py-1.5 rounded-lg bg-secondary hover:bg-cyan-500/20 text-foreground hover:text-cyan-400 border border-border text-xs font-semibold transition-all flex items-center gap-1"
                  >
                    <span>🔒 Pelajari</span>
                    <span>→</span>
                  </a>
                </div>
