        </div>

        <!-- SECTION 2: MATERI PENGAYAAN & KEAHLIAN TEKNIS -->
        {sortedModules.filter((m) => !m.data.category.startsWith('Orientasi PPLG')).length > 0 && (
          <div class="space-y-4 pt-6">
            <div class="border-b border-border pb-2.5">
              <h2 class="text-base font-bold text-foreground">Modul Kejuruan & Pengayaan Praktis</h2>
              <p class="text-xs text-muted-foreground">Materi mandiri tambahan untuk mengasah kemampuan teknis Web, Database, dan Algoritma.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {sortedModules.filter((m) => !m.data.category.startsWith('Orientasi PPLG')).map((mod) => (
                <div class="card p-5 border-border bg-card transition-colors flex flex-col justify-between space-y-4 rounded-xl shadow-sm hover:border-primary/50">
                  <div class="space-y-2.5">
                    <div class="flex items-center justify-between">
                      <span class="px-2 py-0.5 rounded text-[10px] bg-secondary text-foreground font-mono font-semibold border border-border">
                        {mod.data.category}
                      </span>
                      <span class="text-xs text-muted-foreground font-mono">{mod.data.duration}</span>
                    </div>

                    <h3 class="text-sm font-bold text-foreground hover:text-primary transition-colors">
                      <a href={`/pembelajaran/${mod.id || mod.slug}`}>{mod.data.title}</a>
                    </h3>
                    <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">
                      {mod.data.description}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-border flex items-center justify-between text-xs">
                    <span class="text-amber-600 dark:text-amber-400 font-medium font-mono">✨ +15 XP</span>
                    <a href={`/pembelajaran/${mod.id || mod.slug}`} class="btn btn-sm btn-primary text-xs font-semibold px-3 py-1.5 rounded-lg">
                      Mulai Belajar →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </DashboardLayout>
) : (
  <BaseLayout 
    title="Learning Hub & Modul PPLG" 
    description="Pusat modul pembelajaran interaktif Rekayasa Perangkat Lunak (PPLG) SMKN 1 Rongga oleh Agung Gumelar Saputra."
  >
    <section class="py-12 bg-secondary/30 border-b border-border">
      <div class="container-main space-y-3">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-md bg-secondary text-foreground border border-border text-xs font-semibold">
            📚 Learning Hub PPLG
          </span>
        </div>
        <h1 class="text-2xl md:text-4xl font-bold text-foreground tracking-tight">
          Modul Pembelajaran & Gamification Hub
        </h1>
        <p class="text-sm md:text-base text-muted-foreground max-w-2xl leading-relaxed">
          Pelajari materi Rekayasa Perangkat Lunak secara mandiri dan terstruktur. Kumpulkan poin XP, buka Lencana Prestasi, dan ikuti simulasi ujian TKA kelas!
        </p>

        <div class="pt-2 flex items-center gap-3">
          <a href="/login" class="btn btn-primary text-white font-semibold text-xs sm:text-sm px-4 py-2 rounded-lg">
            Masuk untuk Mulai Belajar & Enroll Sesi →
          </a>
        </div>
