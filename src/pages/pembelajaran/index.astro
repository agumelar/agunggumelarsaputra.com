                </span>
              </div>
            </div>

            <div class="pt-4 border-t border-border">
              <a href="/pembelajaran/tka-pplg" class="btn bg-cyan-600 hover:bg-cyan-500 text-white w-full text-xs sm:text-sm font-semibold py-2.5 rounded-lg text-center block shadow-sm">
