    </section>

    <!-- Public Preview of Courses -->
    <section class="py-10">
      <div class="container-main space-y-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Public Orientasi Card -->
          <div class="lg:col-span-2 card p-6 md:p-8 rounded-2xl bg-card border border-border space-y-5 shadow-sm">
            <div class="flex flex-wrap items-center gap-2">
