                </span>
                <span class="px-2.5 py-0.5 rounded bg-secondary text-muted-foreground border border-border text-[11px] font-mono">
                  SEMESTER GANJIL
                </span>
              </div>

              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-foreground hover:text-primary transition-colors">
                  <a href="/pembelajaran/orientasi-pplg">Orientasi PPLG & Skill Passport</a>
                </h3>
                <p class="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
