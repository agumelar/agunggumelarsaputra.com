---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GamificationWidget from '../../components/GamificationWidget.astro';
import { getCollection } from 'astro:content';

const user = Astro.locals.user;
const modules = await getCollection('pembelajaran');
const sortedModules = modules.sort((a, b) => a.data.order - b.data.order);
---

{user ? (
  <DashboardLayout 
    title="Katalog Modul Pembelajaran PPLG" 
    description="Pusat modul pembelajaran interaktif Rekayasa Perangkat Lunak SMKN 1 Rongga"
    activeNav="/pembelajaran"
  >
    <div class="space-y-8 max-w-6xl mx-auto">
      <!-- Header Banner -->
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-blue-950/40 via-indigo-950/30 to-card border border-blue-500/30 flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-xl">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-400 text-xs font-mono font-bold">
            <span>📚 Modul Kurikulum Merdeka</span>
            <span>•</span>
            <span>SMKN 1 Rongga</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-foreground tracking-tight">
            Katalog Modul Pembelajaran PPLG
          </h1>
          <p class="text-xs sm:text-sm text-muted-foreground max-w-xl">
            Pelajari setiap materi secara mandiri. Tandai modul selesai untuk mendapatkan Experience Points (+10 XP) dan menaikkan level belajarmu!
          </p>
        </div>

        <a href="/pembelajaran/tka-pplg" class="btn btn-primary bg-cyan-600 hover:bg-cyan-500 text-white font-bold whitespace-nowrap px-5 py-3 rounded-xl shadow-lg shadow-cyan-600/20">
          🎯 Drilling TKA Simulator →
        </a>
      </div>

      <!-- Gamification Summary Widget -->
      <div class="p-6 rounded-2xl bg-card border border-border/60 shadow-sm">
        <GamificationWidget />
      </div>

      <!-- Modules Catalog Cards -->
      <div class="space-y-6">
        <div class="border-b border-border/40 pb-3">
          <h2 class="text-lg font-bold text-foreground">Daftar Modul Tersedia</h2>
          <p class="text-xs text-muted-foreground">Pilih topik materi untuk mulai membaca dan belajar.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedModules.map((mod) => (
            <div class="card p-6 border-border/60 hover:border-blue-500/50 bg-card/80 transition-all flex flex-col justify-between space-y-4 group">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-mono font-semibold">
                    {mod.data.category}
                  </span>
                  <span class="text-xs text-emerald-400 font-mono">+{mod.data.duration}</span>
                </div>

                <h3 class="text-base font-bold text-foreground group-hover:text-blue-400 transition-colors">
                  <a href={`/pembelajaran/${mod.id || mod.slug}`}>{mod.data.title}</a>
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">
                  {mod.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs">
                <span class="text-emerald-400 font-medium font-mono">✨ +10 XP</span>
                <a href={`/pembelajaran/${mod.id || mod.slug}`} class="btn btn-primary btn-sm bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs">
                  Mulai Belajar →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </DashboardLayout>
) : (
  <BaseLayout 
    title="Learning Hub & Modul PPLG"
    description="Pusat modul pembelajaran interaktif Rekayasa Perangkat Lunak (PPLG) SMKN 1 Rongga oleh Agung Gumelar Saputra."
  >
    <section class="py-12 bg-gradient-to-b from-blue-950/20 to-background border-b border-border/40">
      <div class="container-main space-y-4">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold">
            📚 Learning Hub PPLG
          </span>
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-foreground tracking-tight">
          Modul Pembelajaran & Gamification Hub
        </h1>
        <p class="text-base md:text-lg text-muted-foreground max-w-2xl">
          Pelajari materi Rekayasa Perangkat Lunak secara mandiri dan interaktif. Kumpulkan poin XP, buka Lencana Prestasi, dan uji keahlian Anda!
        </p>
      </div>
    </section>

    <!-- Gamification Status -->
    <section class="py-8 bg-background border-b border-border/40">
      <div class="container-main">
        <GamificationWidget />
      </div>
    </section>

    <!-- Modules Catalog -->
    <section class="py-12">
      <div class="container-main space-y-8">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/40 pb-4">
          <div>
            <h2 class="text-2xl font-bold text-foreground">Daftar Modul Pembelajaran</h2>
            <p class="text-xs text-muted-foreground">Pilih materi yang ingin Anda pelajari hari ini</p>
          </div>

          <a href="/pembelajaran/tka-pplg" class="btn btn-primary btn-sm bg-cyan-600 hover:bg-cyan-500 text-white font-semibold">
            🎯 Drilling TKA PPLG Simulator →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedModules.map((mod) => (
            <div class="card p-6 border-border/60 hover:border-blue-500/50 transition-all flex flex-col justify-between space-y-4 group">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold">
                    {mod.data.category}
                  </span>
                  <span class="text-xs text-emerald-400 font-mono">+{mod.data.duration}</span>
                </div>

                <h3 class="text-lg font-bold text-foreground group-hover:text-blue-400 transition-colors">
                  <a href={`/pembelajaran/${mod.id || mod.slug}`}>{mod.data.title}</a>
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">
                  {mod.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs">
                <span class="text-emerald-400 font-medium">✨ +10 XP</span>
                <a href={`/pembelajaran/${mod.id || mod.slug}`} class="btn btn-primary btn-sm bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs">
                  Mulai Belajar →
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>
  </BaseLayout>
)}
