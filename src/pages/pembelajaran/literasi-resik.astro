          '    .section-header { font-weight: bold; font-size: 10.5pt; margin-top: 10px; margin-bottom: 4px; text-transform: uppercase; border-bottom: 1px solid #000; padding-bottom: 2px; }',
          '    .content-box { border: 1px solid #444; padding: 8px 10px; background: #fff; margin-bottom: 10px; text-align: justify; font-size: 10pt; line-height: 1.4; }',
          '    .score-box { border: 1.5px solid #000; padding: 8px 10px; margin-top: 12px; page-break-inside: avoid; }',
          '    .score-table { width: 100%; border-collapse: collapse; text-align: center; font-size: 9.5pt; margin-top: 4px; }',
          '    .score-table th, .score-table td { border: 1px solid #000; padding: 4px 6px; }',
          '    .score-table th { background: #f2f2f2; font-weight: bold; }',
          '    .footer-signature { margin-top: 24px; width: 100%; page-break-inside: avoid; }',
          '    .footer-signature td { text-align: center; width: 50%; vertical-align: top; font-size: 10pt; }',
          '    @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }',
          '  </style>',
          '</head>',
          '<body>',
          '  <!-- KOP SURAT RESMI DENGAN LOGO SMKN 1 RONGGA -->',
          '  <div class="kop-container">',
          '    <img src="' + logoUrl + '" class="kop-logo" alt="Logo SMKN 1 Rongga" />',
          '    <div class="kop-text">',
          '      <h4>PEMERINTAH DAERAH PROVINSI JAWA BARAT</h4>',
          '      <h4>DINAS PENDIDIKAN</h4>',
