          '    .kop-text h3 { margin: 2px 0; font-size: 11.5pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; }',
          '    .kop-text h2 { margin: 2px 0; font-size: 14.5pt; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; }',
          '    .kop-text p.meta-sub { margin: 2px 0 0 0; font-size: 9.5pt; font-weight: bold; text-transform: uppercase; }',
          '    .kop-text p.address { margin: 2px 0 0 0; font-size: 8.5pt; font-style: italic; line-height: 1.2; }',
          '    .kop-line-thick { border-top: 3px solid #000; margin-top: 4px; }',
          '    .kop-line-thin { border-top: 1px solid #000; margin-top: 2px; margin-bottom: 14px; }',
          '    .doc-title { text-align: center; margin-bottom: 14px; }',
          '    .doc-title h3 { margin: 0; font-size: 12pt; font-weight: bold; text-decoration: underline; text-transform: uppercase; letter-spacing: 0.5px; }',
          '    .doc-title p { margin: 2px 0 0 0; font-size: 9.5pt; font-family: monospace; font-weight: bold; }',
          '    .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 10pt; }',
