---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AntiCopyPasteGuardian from '../../components/modul/AntiCopyPasteGuardian.astro';
import { db, isDbConfigured, ensureDbInitialized } from '../../db';
import { literasiReports, literasiPeerReviews, users, userGamification } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { canAccessAdminPanel } from '../../utils/auth';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/pembelajaran/literasi-resik');
}

let userReports: any[] = [];
let peerFeed: any[] = [];
let allSubmissionsForTeacher: any[] = [];
let userStats: any = { xp: 0, level: 1 };
const isTeacherOrAdmin = canAccessAdminPanel(user.role);

if (isDbConfigured()) {
  try {
    await ensureDbInitialized();

    // 1. Fetch user's own reports
    userReports = await db.select().from(literasiReports)
      .where(eq(literasiReports.userId, user.userId))
      .orderBy(desc(literasiReports.reportDate));

    // 2. Fetch user gamification stats
    const [stats] = await db.select().from(userGamification).where(eq(userGamification.userId, user.userId)).limit(1);
    if (stats) userStats = stats;

    // 3. Fetch peer feed (latest submissions from all students)
    const rawFeed = await db.select({
      id: literasiReports.id,
      userId: literasiReports.userId,
      studentName: users.name,
      studentClass: users.studentClass,
      avatarUrl: users.avatarUrl,
      weekNumber: literasiReports.weekNumber,
      reportDate: literasiReports.reportDate,
      bookTitle: literasiReports.bookTitle,
      author: literasiReports.author,
      publisher: literasiReports.publisher,
      summary: literasiReports.summary,
      moralMessage: literasiReports.moralMessage,
      finalScore: literasiReports.finalScore,
      status: literasiReports.status,
    }).from(literasiReports)
      .innerJoin(users, eq(literasiReports.userId, users.id))
      .orderBy(desc(literasiReports.reportDate))
      .limit(20);

    // Fetch peer review ratings for each feed item
    const feedWithReviews = await Promise.all(rawFeed.map(async (item) => {
      const reviews = await db.select({
        rating: literasiPeerReviews.rating,
        comment: literasiPeerReviews.comment,
        reviewerName: users.name,
      }).from(literasiPeerReviews)
        .innerJoin(users, eq(literasiPeerReviews.reviewerId, users.id))
        .where(eq(literasiPeerReviews.reportId, item.id));

      const avgRating = reviews.length > 0 
        ? (reviews.reduce((acc, r) => acc + r.rating, 0) / reviews.length).toFixed(1)
        : null;

      return {
        ...item,
        reviews,
        avgRating,
      };
    }));

    peerFeed = feedWithReviews;

    // 4. If teacher/admin, fetch all submissions for grading
    if (isTeacherOrAdmin) {
      allSubmissionsForTeacher = await db.select({
        id: literasiReports.id,
        userId: literasiReports.userId,
        studentName: users.name,
        studentEmail: users.email,
        studentClass: users.studentClass,
        weekNumber: literasiReports.weekNumber,
        reportDate: literasiReports.reportDate,
        bookTitle: literasiReports.bookTitle,
        author: literasiReports.author,
        publisher: literasiReports.publisher,
        city: literasiReports.city,
        year: literasiReports.year,
        pageCount: literasiReports.pageCount,
        edition: literasiReports.edition,
        summary: literasiReports.summary,
        moralMessage: literasiReports.moralMessage,
        selfChecklist: literasiReports.selfChecklist,
        writingScore: literasiReports.writingScore,
        presentationScore: literasiReports.presentationScore,
        finalScore: literasiReports.finalScore,
        teacherFeedback: literasiReports.teacherFeedback,
        status: literasiReports.status,
      }).from(literasiReports)
        .innerJoin(users, eq(literasiReports.userId, users.id))
        .orderBy(desc(literasiReports.reportDate));
    }

  } catch (e) {
    console.error('Error loading Literasi RESIK data:', e);
  }
}

// Calculate summary metrics
const totalUserResensi = userReports.length;
const gradedUserResensi = userReports.filter(r => r.status === 'graded');
const avgScore = gradedUserResensi.length > 0 
  ? Math.round(gradedUserResensi.reduce((acc, r) => acc + (r.finalScore || 0), 0) / gradedUserResensi.length) 
  : 0;

const currentWeek = userReports.length + 1;
---

<BaseLayout title="Program Rabu Literasi ASIK (RESIK) - SMKN 1 Rongga" description="Portal Laporan Literasi Siswa & Peer Review Program Pembiasaan Rabu Literasi ASIK (RESIK)">
  <AntiCopyPasteGuardian />

  <div class="container-main py-8 space-y-8 max-w-7xl mx-auto pb-16">
    
    <!-- Navigation Breadcrumb -->
    <div class="flex items-center justify-between">
      <a href="/pembelajaran" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Kembali ke Katalog Pembelajaran
      </a>

      {isTeacherOrAdmin && (
        <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 font-mono text-xs font-bold border border-amber-500/30 flex items-center gap-1.5 shadow-sm">
          👑 Mode Guru: Evaluator Rubrik RESIK
        </span>
      )}
    </div>

    <!-- Hero Card RESIK -->
    <div class="m3-card-elevated rounded-m3-2xl p-6 md:p-8 shadow-sm space-y-6 relative overflow-hidden">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
        <div class="space-y-3 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2">
            <span class="m3-chip-primary text-[11px] font-mono font-bold uppercase">
              PEMBIASAAN RABU LITERASI ASIK (RESIK)
            </span>
            <span class="px-2.5 py-0.5 rounded-m3-full bg-[var(--md-sys-color-surface-container-high)] text-foreground text-[11px] font-mono font-semibold border border-[var(--md-sys-color-outline-variant)]">
              SMK NEGERI 1 RONGGA
            </span>
            <span class="m3-chip-success text-[11px] font-mono font-bold">
              ✨ +30 XP / Resensi Buku
            </span>
          </div>

          <h1 class="text-3xl md:text-4xl font-extrabold text-foreground font-display tracking-tight">
            Portal Laporan Literasi Siswa <span class="text-[var(--md-sys-color-primary)]">(RESIK)</span>
          </h1>

          <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
            Program rutin membaca dan meresensi buku mingguan. Buat ringkasan runtut, tentukan amanat moral, beri penilaian peer-review teman sekelas, dan cetak dokumen resmi resensi berstandar sekolah.
          </p>

          <!-- Quick Metrics -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            <div class="p-3 rounded-m3-md bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)]">
              <span class="text-[10px] font-mono text-muted-foreground block uppercase">TOTAL RESENSI SAYA</span>
              <span class="text-base font-bold text-foreground font-mono">{totalUserResensi} Buku</span>
            </div>
            <div class="p-3 rounded-m3-md bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)]">
              <span class="text-[10px] font-mono text-muted-foreground block uppercase">SUDAH DINILAI GURU</span>
              <span class="text-base font-bold text-emerald-400 font-mono">{gradedUserResensi.length} Resensi</span>
            </div>
            <div class="p-3 rounded-m3-md bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)]">
              <span class="text-[10px] font-mono text-muted-foreground block uppercase">RATA-RATA NILAI RESIK</span>
              <span class="text-base font-bold text-sky-400 font-mono">{avgScore > 0 ? `${avgScore} / 100` : '-'}</span>
            </div>
            <div class="p-3 rounded-m3-md bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)]">
              <span class="text-[10px] font-mono text-muted-foreground block uppercase">LEVEL GAMIFIKASI</span>
              <span class="text-base font-bold text-amber-400 font-mono">Lvl {userStats.level} ({userStats.xp} XP)</span>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="w-full lg:w-72 p-5 rounded-m3-xl bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)] flex flex-col justify-between space-y-4 shadow-sm shrink-0">
          <div>
            <div class="text-xs font-bold text-foreground font-display mb-1">
              🎯 Minggu Ini: Resensi Ke-{currentWeek}
            </div>
            <p class="text-[11px] text-muted-foreground leading-relaxed">
              Pastikan Anda membaca buku minimal 15 menit dan melengkapi format resensi 4 kriteria sebelum dikumpulkan.
            </p>
          </div>

          <a href="#form-resensi" class="m3-btn-filled text-xs py-2.5 text-center font-bold">
            ✍️ Tulis Resensi Baru ➔
          </a>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="m3-segmented-container overflow-x-auto hide-scrollbar p-1.5" id="resik-tab-headers">
      <button 
        type="button" 
        data-tab="form" 
        class="resik-tab-btn m3-segmented-item active text-xs font-bold shrink-0"
      >
        <span>✍️</span> 1. Form Tulis Resensi Baru
      </button>
      <button 
        type="button" 
        data-tab="my-reports" 
        class="resik-tab-btn m3-segmented-item text-xs font-bold shrink-0"
      >
        <span>📚</span> 2. Riwayat & Cetak PDF Resensi Saya ({totalUserResensi})
      </button>
      <button 
        type="button" 
        data-tab="peer-feed" 
        class="resik-tab-btn m3-segmented-item text-xs font-bold shrink-0"
      >
        <span>🌟</span> 3. Galeri Literasi Teman & Peer Review
      </button>
      {isTeacherOrAdmin && (
        <button 
          type="button" 
          data-tab="teacher-panel" 
          class="resik-tab-btn px-4 py-2.5 rounded-xl text-xs font-bold transition-all border border-amber-500/40 bg-amber-500/10 text-amber-300 flex items-center gap-2 shrink-0"
        >
          <span>👑</span> 4. Panel Evaluasi & Rekap Guru ({allSubmissionsForTeacher.length})
        </button>
      )}
    </div>

    <!-- TAB 1: FORM TULIS RESENSI BUKU -->
    <div id="tab-panel-form" class="tab-panel space-y-6">
      <form id="form-resensi" data-no-paste="true" class="card p-6 md:p-8 rounded-2xl border border-border bg-card shadow-sm space-y-6">
        <div class="border-b border-border pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-cyan-400">FORMAT RESENSI BUKU (ASPEK MENULIS RESIK)</span>
            <h2 class="text-xl font-extrabold text-foreground">Lembar Pengumpulan Resensi Minggu Ke-{currentWeek}</h2>
          </div>
          <div class="px-3 py-1 rounded-lg bg-secondary text-foreground text-xs font-mono font-semibold border border-border">
            Minggu Ke: <input type="number" id="input-week-number" min="1" max="52" value={currentWeek} class="w-12 px-1 py-0.5 rounded bg-background border border-border text-center text-xs font-bold text-cyan-400" />
          </div>
        </div>

        <div id="alert-resensi-submit" class="hidden p-4 rounded-xl text-xs font-semibold text-center"></div>

        <!-- 1. IDENTITAS BUKU -->
        <div class="space-y-4">
          <h3 class="text-sm font-bold text-foreground flex items-center gap-2 border-b border-border/50 pb-2">
            <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 text-xs flex items-center justify-center font-mono font-bold">1</span>
            Kelengkapan Identitas Buku (Skor Max 4)
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
            <div>
              <label class="block font-semibold mb-1 text-foreground">Judul Buku <span class="text-rose-500">*</span></label>
              <input type="text" id="resensi-title" required class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground focus:outline-none focus:border-cyan-500" placeholder="Contoh: Laskar Pelangi" />
            </div>

            <div>
              <label class="block font-semibold mb-1 text-foreground">Penulis / Pengarang <span class="text-rose-500">*</span></label>
              <input type="text" id="resensi-author" required class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground focus:outline-none focus:border-cyan-500" placeholder="Contoh: Andrea Hirata" />
            </div>

            <div>
              <label class="block font-semibold mb-1 text-foreground">Penerbit <span class="text-rose-500">*</span></label>
              <input type="text" id="resensi-publisher" required class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground focus:outline-none focus:border-cyan-500" placeholder="Contoh: Bentang Pustaka" />
            </div>

            <div>
              <label class="block font-semibold mb-1 text-foreground">Kota Terbit <span class="text-rose-500">*</span></label>
              <input type="text" id="resensi-city" required class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground focus:outline-none focus:border-cyan-500" placeholder="Contoh: Yogyakarta" />
            </div>

            <div>
              <label class="block font-semibold mb-1 text-foreground">Tahun Terbit <span class="text-rose-500">*</span></label>
              <input type="number" id="resensi-year" required min="1900" max="2030" value="2024" class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground focus:outline-none focus:border-cyan-500" />
            </div>

            <div>
              <label class="block font-semibold mb-1 text-foreground">Jumlah Halaman <span class="text-rose-500">*</span></label>
              <input type="number" id="resensi-pages" required min="1" value="250" class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground focus:outline-none focus:border-cyan-500" />
            </div>

            <div class="md:col-span-3">
              <label class="block font-semibold mb-1 text-foreground">Cetakan / Edisi (Opsional)</label>
              <input type="text" id="resensi-edition" class="w-full px-3.5 py-2.5 rounded-xl bg-background border border-border text-foreground focus:outline-none focus:border-cyan-500" placeholder="Contoh: Cetakan Ke-15 / Edisi Revisi" />
            </div>
          </div>
        </div>

        <!-- 2. RINGKASAN BUKU -->
        <div class="space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border/50 pb-2">
            <h3 class="text-sm font-bold text-foreground flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 text-xs flex items-center justify-center font-mono font-bold">2</span>
              Isi / Ringkasan Buku (Aspek Menulis • Skor Max 4)
            </h3>
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/30 font-semibold" id="summary-char-counter">
              📝 0 / 100 kata (Min. 100 kata)
            </span>
          </div>

          <div class="p-3.5 rounded-xl bg-cyan-950/20 border border-cyan-500/20 text-xs text-muted-foreground space-y-1.5">
            <p class="font-semibold text-cyan-300">💡 Panduan Menyusun Ringkasan 3 Bagian Runtut (Minimal 100 Kata):</p>
            <ul class="list-disc list-inside space-y-0.5 text-[11px]">
              <li><strong>Paragraf 1 (Awal):</strong> Kenalkan tokoh utama, latar tempat/waktu, dan situasi pembuka cerita/buku.</li>
              <li><strong>Paragraf 2 (Tengah):</strong> Uraikan inti konflik, alur peristiwa penting, atau gagasan utama buku.</li>
              <li><strong>Paragraf 3 (Akhir):</strong> Jelaskan penyelesaian masalah, klimaks cerita, dan simpulan akhir bacaan.</li>
            </ul>
          </div>

          <textarea 
            id="resensi-summary" 
            data-no-paste="true" 
            onpaste="return false;" 
            ondrop="return false;" 
            oncontextmenu="return false;" 
            required 
            rows="8" 
            class="w-full p-4 rounded-xl bg-background border border-border text-foreground text-xs leading-relaxed focus:outline-none focus:border-cyan-500 placeholder:text-muted-foreground/60" 
            placeholder="Paragraf 1 (Awal): Buku ini menceritakan tentang latar dan tokoh...&#10;&#10;Paragraf 2 (Tengah): Konflik utama mulai muncul ketika...&#10;&#10;Paragraf 3 (Akhir): Pada akhirnya, cerita ini diselesaikan dengan..."
          ></textarea>
        </div>

        <!-- 3. AMANAT / PESAN BUKU -->
        <div class="space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border/50 pb-2">
            <h3 class="text-sm font-bold text-foreground flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 text-xs flex items-center justify-center font-mono font-bold">3</span>
              Amanat / Pesan Bacaan & Refleksi (Skor Max 4)
            </h3>
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/30 font-semibold" id="moral-char-counter">
              💡 0 / 30 kata (Min. 30 kata)
            </span>
          </div>

          <div class="p-3.5 rounded-xl bg-emerald-950/20 border border-emerald-500/20 text-xs text-muted-foreground space-y-1">
            <p class="font-semibold text-emerald-300">💡 Panduan Menulis Amanat & Refleksi (Minimal 30 Kata):</p>
            <p class="text-[11px] leading-relaxed">
              Tuliskan nilai moral, hikmah kehidupan, atau relevansinya dengan pembentukan karakter / etika kerja kejuruan RPL minimal dalam 2–3 kalimat mendalam (hindari jawaban singkat 1 baris).
            </p>
          </div>

          <textarea 
            id="resensi-moral" 
            data-no-paste="true" 
            onpaste="return false;" 
            ondrop="return false;" 
            oncontextmenu="return false;" 
            required 
            rows="4" 
            class="w-full p-4 rounded-xl bg-background border border-border text-foreground text-xs leading-relaxed focus:outline-none focus:border-cyan-500 placeholder:text-muted-foreground/60" 
            placeholder="Amanat atau pelajaran berharga yang saya peroleh dari buku ini adalah... Nilai ini penting diterapkan dalam kehidupan dan kebiasaan belajar saya karena..."
          ></textarea>
        </div>

        <!-- 4. CHECKLIST MANDATORI & KERAPIHAN BAHASA -->
        <div class="space-y-3 p-5 rounded-2xl bg-secondary/30 border border-border">
          <h3 class="text-sm font-bold text-foreground flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 text-xs flex items-center justify-center font-mono font-bold">4</span>
            Checklist Mandatori Kerapihan dan Penggunaan Bahasa (Skor Max 4)
          </h3>
          <p class="text-xs text-muted-foreground">
            Centang keempat poin di bawah ini setelah Anda memeriksa kembali ejaan dan efektivitas kalimat resensi Anda:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1 text-xs">
            <label class="flex items-center gap-2.5 cursor-pointer p-2.5 rounded-lg bg-background/80 border border-border hover:border-cyan-500/40 transition-all select-none">
              <input type="checkbox" id="chk-rapi" class="w-4 h-4 rounded text-cyan-500 border-border focus:ring-cyan-500" checked />
              <span class="text-foreground font-medium">☐ Tulisan rapi & mudah dibaca</span>
            </label>
            <label class="flex items-center gap-2.5 cursor-pointer p-2.5 rounded-lg bg-background/80 border border-border hover:border-cyan-500/40 transition-all select-none">
              <input type="checkbox" id="chk-ejaan" class="w-4 h-4 rounded text-cyan-500 border-border focus:ring-cyan-500" checked />
              <span class="text-foreground font-medium">☐ Ejaan dan tanda baca sudah diperiksa</span>
            </label>
            <label class="flex items-center gap-2.5 cursor-pointer p-2.5 rounded-lg bg-background/80 border border-border hover:border-cyan-500/40 transition-all select-none">
              <input type="checkbox" id="chk-efektif" class="w-4 h-4 rounded text-cyan-500 border-border focus:ring-cyan-500" checked />
              <span class="text-foreground font-medium">☐ Kalimat efektif, tidak bertele-tele</span>
            </label>
            <label class="flex items-center gap-2.5 cursor-pointer p-2.5 rounded-lg bg-background/80 border border-border hover:border-cyan-500/40 transition-all select-none">
              <input type="checkbox" id="chk-santun" class="w-4 h-4 rounded text-cyan-500 border-border focus:ring-cyan-500" checked />
              <span class="text-foreground font-medium">☐ Bahasa baku dan santun</span>
            </label>
          </div>
        </div>

        <div class="flex justify-end pt-2">
          <button type="submit" id="btn-submit-resensi" class="btn btn-primary bg-gradient-to-r from-cyan-600 to-emerald-600 hover:from-cyan-500 hover:to-emerald-500 text-white font-extrabold text-xs px-6 py-3 rounded-xl shadow-lg border-0 flex items-center gap-2">
            <span>✨ Kumpulkan Resensi Minggu Ke-{currentWeek} (+30 XP)</span>
            <span>→</span>
          </button>
        </div>
      </form>
    </div>

    <!-- TAB 2: RIWAYAT & CETAK PDF RESENSI SAYA -->
    <div id="tab-panel-my-reports" class="tab-panel hidden space-y-6">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div>
          <h2 class="text-lg font-bold text-foreground">Riwayat Resensi Buku Saya</h2>
          <p class="text-xs text-muted-foreground">Daftar laporan resensi yang telah Anda kumpulkan pada kegiatan Rabu Literasi ASIK (RESIK).</p>
        </div>
        <span class="text-xs font-mono font-semibold px-3 py-1 rounded-lg bg-secondary border border-border text-foreground">
          {totalUserResensi} Resensi Buku
        </span>
      </div>

      {userReports.length === 0 ? (
        <div class="card p-12 text-center space-y-3 rounded-2xl border-dashed border-border">
          <span class="text-4xl block">📚</span>
          <h3 class="text-base font-bold text-foreground">Belum Ada Resensi Dikumpulkan</h3>
          <p class="text-xs text-muted-foreground max-w-md mx-auto">
            Anda belum pernah mengisi resensi buku. Klik tab "1. Form Tulis Resensi Baru" di atas untuk mulai membuat laporan mingguan Anda.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {userReports.map((rep) => {
            const checklist = JSON.parse(rep.selfChecklist || '[]');
            return (
              <div class="card p-6 rounded-2xl border border-border bg-card shadow-sm space-y-4 flex flex-col justify-between relative overflow-hidden">
                <div class="space-y-3">
                  <div class="flex items-center justify-between gap-2">
                    <span class="px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 font-mono text-[11px] font-bold border border-cyan-500/20">
                      Minggu Ke-{rep.weekNumber}
                    </span>
                    {rep.status === 'graded' ? (
                      <span class="px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono text-[11px] font-bold border border-emerald-500/20">
                        ✓ Nilai Akhir: {rep.finalScore}/100
                      </span>
                    ) : (
                      <span class="px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 font-mono text-[11px] font-bold border border-amber-500/20">
                        ⏳ Menunggu Evaluasi Guru
                      </span>
                    )}
                  </div>

                  <div>
                    <h3 class="text-base font-extrabold text-foreground">{rep.bookTitle}</h3>
                    <p class="text-xs text-muted-foreground">
                      Oleh: <strong>{rep.author}</strong> • Penerbit: {rep.publisher} ({rep.year}) • {rep.pageCount} Hal.
                    </p>
                  </div>

                  <div class="p-3 rounded-xl bg-background/80 border border-border/60 text-xs space-y-2">
                    <div>
                      <span class="font-bold text-foreground block">Ringkasan:</span>
                      <p class="text-muted-foreground line-clamp-3 leading-relaxed mt-0.5">{rep.summary}</p>
                    </div>
                    <div>
                      <span class="font-bold text-foreground block">Amanat:</span>
                      <p class="text-muted-foreground line-clamp-2 leading-relaxed mt-0.5">{rep.moralMessage}</p>
                    </div>
                  </div>

                  {rep.status === 'graded' && (
                    <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs space-y-1">
                      <div class="font-bold text-emerald-400 flex items-center justify-between">
                        <span>Rincian Skor RESIK:</span>
                        <span>Menulis: {rep.writingScore}/16 • Presentasi: {rep.presentationScore}/20</span>
                      </div>
                      {rep.teacherFeedback && (
                        <p class="text-emerald-300/80 italic text-[11px] mt-1">
                          "Catatan Guru: {rep.teacherFeedback}"
                        </p>
                      )}
                    </div>
                  )}
                </div>

                <div class="pt-3 border-t border-border flex items-center justify-between gap-2 text-xs">
                  <span class="text-[11px] text-muted-foreground font-mono">
                    {new Date(rep.reportDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>

                  <button 
                    type="button" 
                    class="btn-print-resensi btn btn-sm bg-secondary hover:bg-accent text-foreground font-bold text-xs px-3 py-1.5 rounded-lg border border-border flex items-center gap-1.5"
                    data-report={JSON.stringify(rep)}
                    data-user={JSON.stringify({ name: user.name, studentClass: user.studentClass || '10 RPL' })}
                  >
                    <span>🖨️</span> Cetak / Unduh PDF
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    <!-- TAB 3: GALERI LITERASI TEMAN & PEER REVIEW -->
    <div id="tab-panel-peer-feed" class="tab-panel hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border pb-4">
        <div>
          <h2 class="text-lg font-bold text-foreground">Galeri Literasi & Resensi Teman</h2>
          <p class="text-xs text-muted-foreground">Baca resensi teman sekelas, pelajari gaya penulisannya, dan berikan rating bintang + apresiasi.</p>
        </div>
        <div class="w-full sm:w-64">
          <input type="text" id="search-peer-resensi" class="w-full px-3 py-2 rounded-xl bg-background border border-border text-xs text-foreground focus:outline-none focus:border-cyan-500" placeholder="🔍 Cari judul/penulis/siswa..." />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="peer-resensi-grid">
        {peerFeed.map((item) => (
          <div class="card p-5 rounded-2xl border border-border bg-card shadow-sm space-y-4 flex flex-col justify-between peer-card-item" data-search={`${item.bookTitle} ${item.author} ${item.studentName}`.toLowerCase()}>
            <div class="space-y-3">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-xs border border-cyan-500/30 shrink-0">
                  {item.studentName ? item.studentName.charAt(0).toUpperCase() : 'S'}
                </div>
                <div class="truncate">
                  <div class="text-xs font-bold text-foreground truncate">{item.studentName}</div>
                  <div class="text-[10px] text-muted-foreground font-mono">{item.studentClass || 'Siswa RPL'} • Minggu Ke-{item.weekNumber}</div>
                </div>
              </div>

              <div>
                <span class="text-[10px] font-mono text-cyan-400 font-bold uppercase">JUDUL BUKU:</span>
                <h3 class="text-sm font-extrabold text-foreground leading-snug">{item.bookTitle}</h3>
                <p class="text-[11px] text-muted-foreground mt-0.5">Penulis: {item.author}</p>
              </div>

              <div class="p-3 rounded-xl bg-background/80 border border-border/60 text-xs space-y-1.5">
                <span class="font-bold text-foreground text-[11px] block">Ringkasan:</span>
                <p class="text-muted-foreground line-clamp-3 leading-relaxed text-[11px]">{item.summary}</p>
              </div>

              <!-- Peer Rating Badge -->
              <div class="flex items-center justify-between text-xs pt-1">
                <span class="text-muted-foreground text-[11px]">Ulasan Teman ({item.reviews.length}):</span>
                <span class="font-bold text-amber-400 font-mono text-xs flex items-center gap-1">
                  ⭐ {item.avgRating ? `${item.avgRating} / 5` : 'Belum Ada Rating'}
                </span>
              </div>
            </div>

            <button 
              type="button" 
              class="btn-open-peer-modal btn btn-sm bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 font-bold text-xs py-2 rounded-xl border border-cyan-500/30 w-full flex items-center justify-center gap-1.5 mt-2"
              data-item={JSON.stringify(item)}
            >
              <span>⭐</span> Beri Ulasan & Rating (+5 XP)
            </button>
          </div>
        ))}
      </div>
    </div>

    <!-- TAB 4: PANEL EVALUASI GURU (KHUSUS GURU/ADMIN) -->
    {isTeacherOrAdmin && (
      <div id="tab-panel-teacher-panel" class="tab-panel hidden space-y-6">
        <div class="p-6 rounded-2xl bg-amber-500/10 border-2 border-amber-500/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
          <div>
            <div class="text-xs font-bold text-foreground flex items-center gap-2">
              <span>PANEL EVALUASI RUBRIK MENULIS & PRESENTASI RESIK</span>
              <span class="text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-amber-500 text-black">GURU PENGAMPU</span>
            </div>
            <p class="text-xs text-muted-foreground mt-1">
              Beri nilai 4 Aspek Menulis (Max 16) + 5 Aspek Presentasi (Max 20). Sistem akan secara otomatis menghitung Nilai Akhir sesuai rumus resmi RESIK.
            </p>
          </div>

          <a href="/api/literasi/export-rekap" target="_blank" class="btn btn-sm bg-amber-500 hover:bg-amber-400 text-black font-extrabold text-xs px-4 py-2.5 rounded-xl border-0 shadow-md shrink-0 flex items-center gap-2">
            <span>📊</span> Unduh Rekap Excel / CSV Kelas →
          </a>
        </div>

        <div class="space-y-4">
          <h3 class="text-base font-bold text-foreground">Daftar Pengumpulan Resensi Siswa ({allSubmissionsForTeacher.length})</h3>

          <div class="overflow-x-auto rounded-2xl border border-border bg-card">
            <table class="w-full text-left text-xs">
              <thead class="bg-secondary/60 text-muted-foreground uppercase font-mono text-[10px] border-b border-border">
                <tr>
                  <th class="p-3">Siswa</th>
                  <th class="p-3">Minggu</th>
                  <th class="p-3">Judul Buku & Penulis</th>
                  <th class="p-3">Tanggal Submit</th>
                  <th class="p-3">Status / Nilai</th>
                  <th class="p-3 text-right">Aksi Evaluasi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/60">
                {allSubmissionsForTeacher.map((sub) => (
                  <tr class="hover:bg-accent/40 transition-colors">
                    <td class="p-3">
                      <div class="font-bold text-foreground">{sub.studentName}</div>
                      <div class="text-[10px] text-muted-foreground font-mono">{sub.studentClass || '10 RPL'}</div>
                    </td>
                    <td class="p-3 font-mono font-bold text-cyan-400">Minggu #{sub.weekNumber}</td>
                    <td class="p-3">
                      <div class="font-bold text-foreground">{sub.bookTitle}</div>
                      <div class="text-[10px] text-muted-foreground">{sub.author} ({sub.year})</div>
                    </td>
                    <td class="p-3 font-mono text-muted-foreground">
                      {new Date(sub.reportDate).toLocaleDateString('id-ID')}
                    </td>
                    <td class="p-3">
                      {sub.status === 'graded' ? (
                        <span class="px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 font-mono font-bold border border-emerald-500/20">
                          {sub.finalScore} / 100
                        </span>
                      ) : (
                        <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-400 font-mono font-bold border border-amber-500/20">
                          Belum Dinilai
                        </span>
                      )}
                    </td>
                    <td class="p-3 text-right">
                      <button 
                        type="button" 
                        class="btn-open-grade-modal btn btn-sm bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 font-bold text-xs px-3 py-1.5 rounded-lg border border-amber-500/40"
                        data-report={JSON.stringify(sub)}
                      >
                        ⭐ Evaluasi Rubrik →
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
