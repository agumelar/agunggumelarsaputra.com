          '      <h2>SMK NEGERI 1 RONGGA</h2>',
          '      <p class="meta-sub">PROGRAM KEAHLIAN PENGEMBANGAN PERANGKAT LUNAK DAN GIM (PPLG)</p>',
          '      <p class="address">Jl. Raya Rongga, Desa. Cibedug Kec. Rongga Kab. Bandung Barat Prov. Jawa Barat Telp. 022-6950350</p>',
          '      <p class="address"><u>Website :</u> smkn1rongga.sch.id Email : mail@smkn1rongga.sch.id</p>',
          '      <p class="address">Bandung Barat 40565</p>',
          '    </div>',
          '    <div style="width: 85px; flex-shrink: 0;"></div>',
          '  </div>',
          '  <div class="kop-line-thick"></div>',
          '  <div class="kop-line-thin"></div>',
          '',
          '  <div class="doc-title">',
          '    <h3>LEMBAR LAPORAN RESENSI BUKU (RABU LITERASI RESIK)</h3>',
          '    <p>MINGGU KE-' + reportData.weekNumber + ' • SEMESTER GANJIL TAHUN AJARAN 2026/2027</p>',
          '  </div>',
          '',
          '  <!-- IDENTITAS SISWA -->',
          '  <table class="meta-table">',
          '    <tr>',
          '      <td width="22%"><strong>Nama Peserta Didik</strong></td>',
