  </div>

  <!-- MODAL 1: PEER REVIEW MODAL -->
  <div id="modal-peer-review" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="card w-full max-w-lg p-6 rounded-2xl border border-cyan-500/30 bg-card shadow-2xl space-y-5 relative animate-in zoom-in-95">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 class="text-base font-extrabold text-foreground" id="modal-peer-title">Beri Rating & Ulasan Resensi</h3>
        <button type="button" id="close-peer-modal" class="text-muted-foreground hover:text-foreground text-lg">✕</button>
      </div>

      <div id="modal-peer-body" class="p-3 rounded-xl bg-secondary/30 border border-border text-xs space-y-1">
        <!-- Injected via JS -->
      </div>

      <form id="form-peer-submit" class="space-y-4 text-xs">
        <input type="hidden" id="peer-report-id" />
        
        <div>
          <label class="block font-semibold mb-1 text-foreground">Rating Bintang (1-5)</label>
          <div class="flex items-center gap-2" id="star-rating-selector">
            {[1, 2, 3, 4, 5].map((star) => (
              <button type="button" class="btn-star text-2xl text-muted-foreground hover:text-amber-400 transition-colors" data-star={star}>★</button>
            ))}
            <input type="hidden" id="peer-rating-val" value="5" />
          </div>
        </div>

        <div>
          <label class="block font-semibold mb-1 text-foreground">Komentar / Apresiasi Literasi</label>
          <textarea id="peer-comment" required rows="3" class="w-full p-3 rounded-xl bg-background border border-border text-foreground text-xs focus:outline-none focus:border-cyan-500" placeholder="Tuliskan ulasan positif atau masukan konstruktif untuk karya resensi temanmu..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-full py-2.5 font-bold bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl">
          Kirim Ulasan Peer Review (+5 XP)
        </button>
      </form>
    </div>
  </div>

  <!-- MODAL 2: TEACHER GRADING MODAL (RUBRIK RESIK 9 ASPEK) -->
  {isTeacherOrAdmin && (
    <div id="modal-teacher-grade" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4 overflow-y-auto">
      <div class="card w-full max-w-3xl p-6 md:p-8 rounded-2xl border border-amber-500/40 bg-card shadow-2xl space-y-6 my-8">
        <div class="flex items-center justify-between border-b border-border pb-4">
          <div>
            <span class="text-[10px] font-mono font-bold uppercase text-amber-400">RUBRIK EVALUASI GURU SMKN 1 RONGGA</span>
            <h3 class="text-xl font-extrabold text-foreground" id="grade-modal-title">Penilaian RESIK Siswa</h3>
          </div>
          <button type="button" id="close-grade-modal" class="text-muted-foreground hover:text-foreground text-xl">✕</button>
        </div>

        <form id="form-teacher-grade" class="space-y-6 text-xs">
          <input type="hidden" id="grade-report-id" />

          <!-- Summary Display -->
          <div id="grade-modal-summary" class="p-4 rounded-xl bg-secondary/30 border border-border space-y-2">
            <!-- Injected via JS -->
          </div>

          <!-- ASPEK 1: MENULIS (4 Kriteria, @1-4, Max 16) -->
          <div class="space-y-4 border-t border-border pt-4">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-amber-400 text-sm uppercase font-mono">1. Aspek Menulis (Skor Max 16)</h4>
              <span class="font-mono text-xs font-bold text-foreground" id="calc-writing-total">Total Menulis: 16 / 16</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">1. Kelengkapan Identitas (1-4)</label>
                <p class="text-[10px] text-muted-foreground">4: Judul & pengarang lengkap | 1: Tidak ditulis</p>
                <input type="range" id="score-w1" min="1" max="4" value="4" class="w-full accent-amber-500" />
                <div class="text-right font-mono font-bold text-amber-400" id="val-w1">Skor: 4</div>
              </div>

              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">2. Isi / Ringkasan (1-4)</label>
                <p class="text-[10px] text-muted-foreground">4: Sangat sesuai, lengkap & runtut | 1: Tidak sesuai</p>
                <input type="range" id="score-w2" min="1" max="4" value="4" class="w-full accent-amber-500" />
                <div class="text-right font-mono font-bold text-amber-400" id="val-w2">Skor: 4</div>
              </div>

              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">3. Amanat / Pesan (1-4)</label>
                <p class="text-[10px] text-muted-foreground">4: Tepat, logis & mendalam | 1: Tidak menemukan</p>
                <input type="range" id="score-w3" min="1" max="4" value="4" class="w-full accent-amber-500" />
                <div class="text-right font-mono font-bold text-amber-400" id="val-w3">Skor: 4</div>
              </div>

              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">4. Kerapihan & Bahasa (1-4)</label>
                <p class="text-[10px] text-muted-foreground">4: Sangat rapi, bahasa baik | 1: Sulit dibaca</p>
                <input type="range" id="score-w4" min="1" max="4" value="4" class="w-full accent-amber-500" />
                <div class="text-right font-mono font-bold text-amber-400" id="val-w4">Skor: 4</div>
              </div>
            </div>
          </div>

          <!-- ASPEK 2: PRESENTASI (5 Kriteria, @1-4, Max 20) -->
          <div class="space-y-4 border-t border-border pt-4">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-cyan-400 text-sm uppercase font-mono">2. Aspek Presentasi (Skor Max 20)</h4>
              <span class="font-mono text-xs font-bold text-foreground" id="calc-presentation-total">Total Presentasi: 20 / 20</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">5. Penguasaan Bacaan</label>
                <input type="range" id="score-p1" min="1" max="4" value="4" class="w-full accent-cyan-500" />
                <div class="text-right font-mono font-bold text-cyan-400" id="val-p1">Skor: 4</div>
              </div>

              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">6. Ketepatan Pesan</label>
                <input type="range" id="score-p2" min="1" max="4" value="4" class="w-full accent-cyan-500" />
                <div class="text-right font-mono font-bold text-cyan-400" id="val-p2">Skor: 4</div>
              </div>

              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">7. Komunikasi</label>
                <input type="range" id="score-p3" min="1" max="4" value="4" class="w-full accent-cyan-500" />
                <div class="text-right font-mono font-bold text-cyan-400" id="val-p3">Skor: 4</div>
              </div>

              <div class="p-3 rounded-xl bg-background border border-border space-y-1">
                <label class="block font-bold text-foreground">8. Sistematika</label>
                <input type="range" id="score-p4" min="1" max="4" value="4" class="w-full accent-cyan-500" />
                <div class="text-right font-mono font-bold text-cyan-400" id="val-p4">Skor: 4</div>
              </div>

              <div class="p-3 rounded-xl bg-background border border-border space-y-1 md:col-span-2 lg:col-span-1">
                <label class="block font-bold text-foreground">9. Sikap Presentasi</label>
                <input type="range" id="score-p5" min="1" max="4" value="4" class="w-full accent-cyan-500" />
                <div class="text-right font-mono font-bold text-cyan-400" id="val-p5">Skor: 4</div>
              </div>
            </div>
          </div>

          <!-- KALKULASI NILAI AKHIR -->
          <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-500/20 to-emerald-500/20 border border-emerald-500/30 flex items-center justify-between">
            <div>
              <span class="text-[10px] font-mono font-bold uppercase text-emerald-400 block">RUMUS RESIK: (MENULIS + PRESENTASI) / 36 * 100</span>
              <span class="text-sm font-bold text-foreground">NILAI AKHIR EVALUASI RESIK</span>
            </div>
            <div class="text-2xl font-black font-mono text-emerald-400" id="calc-final-score">
              100 / 100
            </div>
          </div>

          <div>
            <label class="block font-semibold mb-1 text-foreground">Catatan / Feedback Evaluasi Guru</label>
            <textarea id="grade-feedback" rows="3" class="w-full p-3 rounded-xl bg-background border border-border text-foreground text-xs focus:outline-none focus:border-amber-500" placeholder="Tuliskan catatan apresiasi atau perbaikan untuk siswa..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary w-full py-3 font-extrabold bg-gradient-to-r from-amber-500 to-emerald-500 hover:from-amber-400 hover:to-emerald-400 text-black rounded-xl text-xs shadow-lg border-0">
            💾 Simpan Penilaian & Evaluasi RESIK →
          </button>
        </form>
      </div>
    </div>
  )}

  <script>
    // Tab Navigation Logic
    const tabBtns = document.querySelectorAll('.resik-tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        
        tabBtns.forEach(b => {
          b.classList.remove('active', 'border-cyan-500/30', 'bg-cyan-500/10', 'text-cyan-400', 'border-amber-500/40', 'bg-amber-500/10', 'text-amber-300');
          b.classList.add('border-border', 'bg-card', 'text-muted-foreground');
        });

        if (targetTab === 'form' || targetTab === 'peer-feed') {
          btn.classList.add('active', 'border-cyan-500/30', 'bg-cyan-500/10', 'text-cyan-400');
        } else if (targetTab === 'teacher-panel') {
          btn.classList.add('active', 'border-amber-500/40', 'bg-amber-500/10', 'text-amber-300');
        } else {
          btn.classList.add('active', 'border-cyan-500/30', 'bg-cyan-500/10', 'text-cyan-400');
        }

        tabPanels.forEach(panel => {
          if (panel.id === `tab-panel-${targetTab}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });

    // Word & Character Counter with Dynamic UX Badges
    const summaryInput = document.getElementById('resensi-summary') as HTMLTextAreaElement;
    const summaryCounter = document.getElementById('summary-char-counter');
    const moralInput = document.getElementById('resensi-moral') as HTMLTextAreaElement;
    const moralCounter = document.getElementById('moral-char-counter');

    function getWordCount(text: string) {
      return text.trim().split(/\s+/).filter(Boolean).length;
    }

    function updateSummaryCounter() {
      if (!summaryInput || !summaryCounter) return;
      const text = summaryInput.value;
      const words = getWordCount(text);
      const chars = text.length;

      if (words < 100) {
        summaryCounter.className = 'text-xs font-mono px-2.5 py-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/30 font-semibold transition-all';
        summaryCounter.textContent = `📝 ${words} / 100 kata (Kurang ${100 - words} kata • ${chars} kar)`;
      } else if (words < 150) {
        summaryCounter.className = 'text-xs font-mono px-2.5 py-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/30 font-semibold transition-all';
        summaryCounter.textContent = `✓ ${words} kata (Standar Baik • ${chars} kar)`;
      } else {
        summaryCounter.className = 'text-xs font-mono px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold transition-all';
        summaryCounter.textContent = `⭐ ${words} kata (Sangat Lengkap & Mahir • ${chars} kar)`;
      }
    }

    function updateMoralCounter() {
      if (!moralInput || !moralCounter) return;
      const text = moralInput.value;
      const words = getWordCount(text);
      const chars = text.length;

      if (words < 30) {
        moralCounter.className = 'text-xs font-mono px-2.5 py-1 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/30 font-semibold transition-all';
        moralCounter.textContent = `💡 ${words} / 30 kata (Kurang ${30 - words} kata • ${chars} kar)`;
      } else if (words < 50) {
        moralCounter.className = 'text-xs font-mono px-2.5 py-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/30 font-semibold transition-all';
        moralCounter.textContent = `✓ ${words} kata (Standar Baik • ${chars} kar)`;
      } else {
        moralCounter.className = 'text-xs font-mono px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold transition-all';
        moralCounter.textContent = `⭐ ${words} kata (Sangat Lengkap & Reflektif • ${chars} kar)`;
      }
    }

    summaryInput?.addEventListener('input', updateSummaryCounter);
    moralInput?.addEventListener('input', updateMoralCounter);

    // Submit Resensi Handler
    const formResensi = document.getElementById('form-resensi') as HTMLFormElement;
    const alertBox = document.getElementById('alert-resensi-submit');

    formResensi?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!alertBox) return;

      alertBox.classList.add('hidden');

      const weekNumber = (document.getElementById('input-week-number') as HTMLInputElement).value;
      const bookTitle = (document.getElementById('resensi-title') as HTMLInputElement).value;
      const author = (document.getElementById('resensi-author') as HTMLInputElement).value;
      const publisher = (document.getElementById('resensi-publisher') as HTMLInputElement).value;
      const city = (document.getElementById('resensi-city') as HTMLInputElement).value;
      const year = (document.getElementById('resensi-year') as HTMLInputElement).value;
      const pageCount = (document.getElementById('resensi-pages') as HTMLInputElement).value;
      const edition = (document.getElementById('resensi-edition') as HTMLInputElement).value;
      const summary = summaryInput.value;
      const moralMessage = moralInput.value;

      const sWords = getWordCount(summary);
      const mWords = getWordCount(moralMessage);

      if (sWords < 100) {
        alertBox.className = 'p-4 rounded-xl text-xs font-semibold text-center bg-rose-500/10 border border-rose-500/30 text-rose-400 block';
        alertBox.textContent = `Ringkasan buku belum mencapai batas minimal (${sWords} / 100 kata). Silakan lengkapi 3 bagian: awal, tengah, dan penutup cerita.`;
        summaryInput.focus();
        return;
      }

      if (mWords < 30) {
        alertBox.className = 'p-4 rounded-xl text-xs font-semibold text-center bg-rose-500/10 border border-rose-500/30 text-rose-400 block';
        alertBox.textContent = `Amanat / pesan moral belum mencapai batas minimal (${mWords} / 30 kata). Uraikan nilai moral secara lebih jelas dan mendalam.`;
        moralInput.focus();
        return;
      }

      const selfChecklist: string[] = [];
      if ((document.getElementById('chk-rapi') as HTMLInputElement).checked) selfChecklist.push('Tulisan rapi & mudah dibaca');
      if ((document.getElementById('chk-ejaan') as HTMLInputElement).checked) selfChecklist.push('Ejaan dan tanda baca sudah diperiksa');
      if ((document.getElementById('chk-efektif') as HTMLInputElement).checked) selfChecklist.push('Kalimat efektif, tidak bertele-tele');
      if ((document.getElementById('chk-santun') as HTMLInputElement).checked) selfChecklist.push('Bahasa baku dan santun');

      try {
        const res = await fetch('/api/literasi/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            weekNumber,
            bookTitle,
            author,
            publisher,
            city,
            year,
            pageCount,
            edition,
            summary,
            moralMessage,
            selfChecklist,
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alertBox.className = 'p-4 rounded-xl text-xs font-semibold text-center bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 block';
          alertBox.textContent = data.message || 'Resensi berhasil dikumpulkan!';
          setTimeout(() => window.location.reload(), 1500);
        } else {
          alertBox.className = 'p-4 rounded-xl text-xs font-semibold text-center bg-rose-500/10 border border-rose-500/30 text-rose-400 block';
          alertBox.textContent = data.error || 'Gagal mengumpulkan resensi.';
        }
      } catch (err) {
        alertBox.className = 'p-4 rounded-xl text-xs font-semibold text-center bg-rose-500/10 border border-rose-500/30 text-rose-400 block';
        alertBox.textContent = 'Koneksi bermasalah.';
      }
    });

    // Search Peer Resensi Filter
    const searchPeer = document.getElementById('search-peer-resensi') as HTMLInputElement;
    const peerCards = document.querySelectorAll('.peer-card-item');

    searchPeer?.addEventListener('input', () => {
      const q = searchPeer.value.toLowerCase().trim();
      peerCards.forEach(card => {
        const s = card.getAttribute('data-search') || '';
        if (s.includes(q)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });

    // Peer Review Modal Logic
    const peerModal = document.getElementById('modal-peer-review');
    const closePeerModal = document.getElementById('close-peer-modal');
    const peerReportId = document.getElementById('peer-report-id') as HTMLInputElement;
    const modalPeerTitle = document.getElementById('modal-peer-title');
    const modalPeerBody = document.getElementById('modal-peer-body');

    document.querySelectorAll('.btn-open-peer-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const dataStr = btn.getAttribute('data-item');
        if (!dataStr || !peerModal) return;
        const item = JSON.parse(dataStr);

        if (peerReportId) peerReportId.value = item.id;
        if (modalPeerTitle) modalPeerTitle.textContent = `Ulas Resensi: "${item.bookTitle}"`;
        if (modalPeerBody) {
          modalPeerBody.innerHTML = `
            <div class="font-bold text-foreground">${item.bookTitle} (${item.author})</div>
            <div class="text-muted-foreground text-[11px]">Ditulis oleh: ${item.studentName} (${item.studentClass || 'Siswa RPL'})</div>
          `;
        }
        peerModal.classList.remove('hidden');
        peerModal.classList.add('flex');
      });
    });

    closePeerModal?.addEventListener('click', () => {
      peerModal?.classList.add('hidden');
      peerModal?.classList.remove('flex');
    });

    // Star Selector
    const starBtns = document.querySelectorAll('.btn-star');
    const ratingVal = document.getElementById('peer-rating-val') as HTMLInputElement;

    starBtns.forEach(star => {
      star.addEventListener('click', () => {
        const val = Number(star.getAttribute('data-star') || 5);
        if (ratingVal) ratingVal.value = String(val);
        starBtns.forEach((s, idx) => {
          if (idx < val) {
            s.classList.add('text-amber-400');
            s.classList.remove('text-muted-foreground');
          } else {
            s.classList.remove('text-amber-400');
            s.classList.add('text-muted-foreground');
          }
        });
      });
    });

    // Peer Review Form Submit
    const formPeer = document.getElementById('form-peer-submit');
    formPeer?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const reportId = peerReportId.value;
      const rating = ratingVal.value;
      const comment = (document.getElementById('peer-comment') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/literasi/peer-review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reportId, rating, comment }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert(data.message || 'Ulasan berhasil dikirim!');
          window.location.reload();
        } else {
          alert(data.error || 'Gagal meriview.');
        }
      } catch (e) {
        alert('Koneksi bermasalah.');
      }
    });

    // Teacher Grading Modal & Calculator Logic
    const gradeModal = document.getElementById('modal-teacher-grade');
    const closeGradeModal = document.getElementById('close-grade-modal');
    const gradeReportId = document.getElementById('grade-report-id') as HTMLInputElement;

    const w1 = document.getElementById('score-w1') as HTMLInputElement;
    const w2 = document.getElementById('score-w2') as HTMLInputElement;
    const w3 = document.getElementById('score-w3') as HTMLInputElement;
    const w4 = document.getElementById('score-w4') as HTMLInputElement;

    const p1 = document.getElementById('score-p1') as HTMLInputElement;
    const p2 = document.getElementById('score-p2') as HTMLInputElement;
    const p3 = document.getElementById('score-p3') as HTMLInputElement;
    const p4 = document.getElementById('score-p4') as HTMLInputElement;
    const p5 = document.getElementById('score-p5') as HTMLInputElement;

    function recalculateFinalScore() {
      const vW1 = Number(w1?.value || 4);
      const vW2 = Number(w2?.value || 4);
      const vW3 = Number(w3?.value || 4);
      const vW4 = Number(w4?.value || 4);

      const vP1 = Number(p1?.value || 4);
      const vP2 = Number(p2?.value || 4);
      const vP3 = Number(p3?.value || 4);
      const vP4 = Number(p4?.value || 4);
      const vP5 = Number(p5?.value || 4);

      const totalWriting = vW1 + vW2 + vW3 + vW4;
      const totalPresentation = vP1 + vP2 + vP3 + vP4 + vP5;
      const finalScore = Math.round(((totalWriting + totalPresentation) / 36) * 100);

      document.getElementById('val-w1')!.textContent = `Skor: ${vW1}`;
      document.getElementById('val-w2')!.textContent = `Skor: ${vW2}`;
      document.getElementById('val-w3')!.textContent = `Skor: ${vW3}`;
      document.getElementById('val-w4')!.textContent = `Skor: ${vW4}`;

      document.getElementById('val-p1')!.textContent = `Skor: ${vP1}`;
      document.getElementById('val-p2')!.textContent = `Skor: ${vP2}`;
      document.getElementById('val-p3')!.textContent = `Skor: ${vP3}`;
      document.getElementById('val-p4')!.textContent = `Skor: ${vP4}`;
      document.getElementById('val-p5')!.textContent = `Skor: ${vP5}`;

      document.getElementById('calc-writing-total')!.textContent = `Total Menulis: ${totalWriting} / 16`;
      document.getElementById('calc-presentation-total')!.textContent = `Total Presentasi: ${totalPresentation} / 20`;
      document.getElementById('calc-final-score')!.textContent = `${finalScore} / 100`;
    }

    [w1, w2, w3, w4, p1, p2, p3, p4, p5].forEach(input => {
      input?.addEventListener('input', recalculateFinalScore);
    });

    document.querySelectorAll('.btn-open-grade-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        const dataStr = btn.getAttribute('data-report');
        if (!dataStr || !gradeModal) return;
        const sub = JSON.parse(dataStr);

        if (gradeReportId) gradeReportId.value = sub.id;
        document.getElementById('grade-modal-title')!.textContent = `Penilaian RESIK: ${sub.studentName} (Minggu #${sub.weekNumber})`;
        document.getElementById('grade-modal-summary')!.innerHTML = `
          <div class="font-bold text-foreground">Buku: "${sub.bookTitle}" (Penulis: ${sub.author})</div>
          <div class="text-muted-foreground mt-1 font-semibold">Ringkasan Siswa:</div>
          <p class="text-muted-foreground line-clamp-3 leading-relaxed text-[11px]">${sub.summary}</p>
          <div class="text-muted-foreground mt-1 font-semibold">Amanat:</div>
          <p class="text-muted-foreground text-[11px]">${sub.moralMessage}</p>
        `;

        if (sub.teacherFeedback) {
          (document.getElementById('grade-feedback') as HTMLTextAreaElement).value = sub.teacherFeedback;
        }

        recalculateFinalScore();
        gradeModal.classList.remove('hidden');
        gradeModal.classList.add('flex');
      });
    });

    closeGradeModal?.addEventListener('click', () => {
      gradeModal?.classList.add('hidden');
      gradeModal?.classList.remove('flex');
    });

    // Submit Teacher Grade
    const formTeacherGrade = document.getElementById('form-teacher-grade');
    formTeacherGrade?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const reportId = gradeReportId.value;
      const teacherFeedback = (document.getElementById('grade-feedback') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/literasi/grade', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            reportId,
            w1: w1.value, w2: w2.value, w3: w3.value, w4: w4.value,
            p1: p1.value, p2: p2.value, p3: p3.value, p4: p4.value, p5: p5.value,
            teacherFeedback,
          }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert(data.message || 'Penilaian berhasil disimpan!');
          window.location.reload();
        } else {
          alert(data.error || 'Gagal menyimpan nilai.');
        }
      } catch (err) {
        alert('Koneksi bermasalah.');
      }
    });

    // Print PDF Resensi Trigger with Official School Kop & Logo
    document.querySelectorAll('.btn-print-resensi').forEach(btn => {
      btn.addEventListener('click', () => {
        const reportData = JSON.parse(btn.getAttribute('data-report') || '{}');
        const userData = JSON.parse(btn.getAttribute('data-user') || '{}');

        const printWindow = window.open('', '_blank');
        if (!printWindow) return;

        const logoUrl = window.location.origin + '/logo-smkn1rongga.png';

        const printHtml = [
          '<!DOCTYPE html>',
          '<html lang="id">',
          '<head>',
          '  <meta charset="UTF-8">',
          '  <title>LAPORAN_RESIK_' + (userData.name || 'SISWA').replace(/\s+/g, '_') + '_MINGGU_' + reportData.weekNumber + '</title>',
          '  <style>',
          '    @page { size: A4 portrait; margin: 12mm 15mm 15mm 15mm; }',
          '    * { box-sizing: border-box; }',
          '    body { font-family: "Times New Roman", Times, serif; margin: 0; color: #000; line-height: 1.35; font-size: 11pt; background: #fff; }',
          '    .kop-container { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding-bottom: 8px; margin-bottom: 2px; }',
          '    .kop-logo { width: 85px; height: 95px; object-fit: contain; flex-shrink: 0; }',
          '    .kop-text { text-align: center; flex: 1; line-height: 1.2; }',
