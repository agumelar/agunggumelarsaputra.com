          '    <tr><td>Tahun Terbit / Tebal</td><td>:</td><td>Tahun ' + reportData.year + ' • ' + reportData.pageCount + ' Halaman ' + (reportData.edition ? '(' + reportData.edition + ')' : '') + '</td></tr>',
          '  </table>',
          '',
          '  <!-- RINGKASAN ISI BUKU -->',
          '  <div class="section-header">2. Isi Ringkasan Buku (Aspek Menulis)</div>',
          '  <div class="content-box">' + reportData.summary.replace(/\n/g, '<br/>') + '</div>',
          '',
          '  <!-- AMANAT / PESAN MORAL -->',
          '  <div class="section-header">3. Amanat / Pesan Moral Bacaan</div>',
          '  <div class="content-box">' + reportData.moralMessage.replace(/\n/g, '<br/>') + '</div>',
          '',
          '  <!-- EVALUASI GURU -->',
          '  <div class="score-box">',
          '    <div style="font-weight: bold; font-size: 10.5pt; text-align: center; margin-bottom: 4px; text-transform: uppercase;">EVALUASI & PENILAIAN RUBRIK RESIK RESMI</div>',
          '    <table class="score-table">',
          '      <thead>',
          '        <tr>',
          '          <th>Aspek Menulis (Max 16)</th>',
          '          <th>Aspek Presentasi (Max 20)</th>',
          '          <th>Nilai Akhir (0-100)</th>',
          '          <th>Ketercapaian Kompetensi</th>',
          '        </tr>',
          '      </thead>',
          '      <tbody>',
          '        <tr>',
          '          <td><strong>' + (reportData.writingScore !== null && reportData.writingScore !== undefined ? reportData.writingScore + ' / 16' : '-') + '</strong></td>',
          '          <td><strong>' + (reportData.presentationScore !== null && reportData.presentationScore !== undefined ? reportData.presentationScore + ' / 20' : '-') + '</strong></td>',
          '          <td><strong style="font-size: 13pt; color: #000;">' + (reportData.finalScore !== null && reportData.finalScore !== undefined ? reportData.finalScore : '-') + '</strong></td>',
          '          <td><strong>' + (reportData.finalScore >= 75 ? 'TUNTAS (SANGAT BAIK)' : reportData.finalScore !== null && reportData.finalScore !== undefined ? 'PERLU PEMBINAAN' : 'MENUNGGU PENILAIAN') + '</strong></td>',
          '        </tr>',
          '      </tbody>',
          '    </table>',
          (reportData.teacherFeedback ? '    <div style="font-style: italic; margin-top: 6px; font-size: 9.5pt; background: #fafafa; padding: 4px 8px; border-left: 3px solid #000;"><strong>Catatan Guru Pengampu:</strong> "' + reportData.teacherFeedback + '"</div>' : ''),
          '  </div>',
          '',
          '  <!-- TANDA TANGAN -->',
          '  <table class="footer-signature">',
          '    <tr>',
          '      <td>',
          '        Peserta Didik,<br/><br/><br/><br/>',
          '        <strong><u>( ' + (userData.name || 'Siswa PPLG') + ' )</u></strong><br/>',
          '        <span style="font-size: 8.5pt; font-family: monospace;">NIS/Kelas: ' + (userData.studentClass || '10 RPL') + '</span>',
          '      </td>',
          '      <td>',
          '        Rongga, ' + new Date(reportData.reportDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) + '<br/>',
          '        Guru Pengampu RPL / Literasi,<br/><br/><br/><br/>',
          '        <strong><u>( Agung Gumelar Saputra, S.Tr.T. )</u></strong><br/>',
          '        <span style="font-size: 8.5pt; font-family: monospace;">NIP. 199306012022211013</span>',
          '      </td>',
          '    </tr>',
          '  </table>',
          '</body>',
          '</html>'
        ].join('');

        printWindow.document.write(printHtml);
        printWindow.document.close();
        setTimeout(() => { printWindow.print(); }, 400);
      });
    });
  </script>
</BaseLayout>
