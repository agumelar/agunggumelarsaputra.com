          '    </tr>',
          '    <tr>',
          '      <td><strong>Kelas / Rombel</strong></td>',
          '      <td>:</td>',
          '      <td>' + (userData.studentClass || '10 RPL') + '</td>',
          '      <td><strong>Tanggal Pengerjaan</strong></td>',
          '      <td>:</td>',
          '      <td>' + new Date(reportData.reportDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) + '</td>',
          '    </tr>',
          '  </table>',
          '',
          '  <!-- IDENTITAS BUKU -->',
          '  <div class="section-header">1. Kelengkapan Identitas Buku</div>',
          '  <table class="meta-table" style="margin-left: 6px; margin-bottom: 6px;">',
          '    <tr><td width="22%">Judul Buku</td><td width="2%">:</td><td><strong>' + reportData.bookTitle + '</strong></td></tr>',
