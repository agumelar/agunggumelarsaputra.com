---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import InteractiveMaterialP1 from '../../components/modul/InteractiveMaterialP1.astro';
import InteractiveLkpdP1 from '../../components/modul/InteractiveLkpdP1.astro';
import GeneralInteractiveLkpd from '../../components/modul/GeneralInteractiveLkpd.astro';
import InteractiveReflectionForm from '../../components/modul/InteractiveReflectionForm.astro';
import KktpGuideCard from '../../components/modul/KktpGuideCard.astro';
import InteractiveKnowledgeCheck from '../../components/modul/InteractiveKnowledgeCheck.astro';
import LiveScoreWidget from '../../components/modul/LiveScoreWidget.astro';
import AntiCopyPasteGuardian from '../../components/modul/AntiCopyPasteGuardian.astro';
import SmartMarkdownWrapper from '../../components/modul/SmartMarkdownWrapper.astro';
import TeacherMessageCard from '../../components/modul/TeacherMessageCard.astro';
import OrientasiLearningScene from '../../components/modul/OrientasiLearningScene.astro';
import { db, isDbConfigured, ensureDbInitialized } from '../../db';
import { userSubmissions, userProgress } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import { isCanonicalOrientasiSlug, selectCanonicalOrientasiModules } from '../../utils/orientasiPplgPolicy.ts';
import { getOrientasiInteractiveMaterial } from '../../utils/orientasiInteractiveMaterials.ts';
import { getOrientasiServerState } from '../../utils/orientasiPplgServer.ts';

const { slug } = Astro.params;
const allModules = await getCollection('pembelajaran');
const entry = allModules.find((m) => (m.id || m.slug) === slug);

if (!entry) {
  return Astro.redirect('/pembelajaran');
}

const user = Astro.locals.user;
const { Content } = await render(entry);
const isModul1 = (entry.id || entry.slug) === 'orientasi-pplg-01-pengantar-skill-passport';
const lessonSlug = entry.id || entry.slug;
const isOrientasiModule = isCanonicalOrientasiSlug(lessonSlug);
const orientasiMaterial = isOrientasiModule && !isModul1
  ? getOrientasiInteractiveMaterial(lessonSlug)
  : null;
const sortedSidebarModules = selectCanonicalOrientasiModules(allModules);

// Fetch user completed lessons and submission states from database
let completedSlugs: string[] = [];
let hasPassedCheckpoint = false;
let hasSubmittedLkpd = false;
let hasSubmittedReflection = false;
let hasOrientasiEnrollment = user?.role === 'admin';

if (user && isDbConfigured()) {
  try {
    await ensureDbInitialized();
    let existingSubs: Array<{ submissionType: string }> = [];
    if (isOrientasiModule) {
      const serverState = await getOrientasiServerState(user.userId, lessonSlug);
      completedSlugs = serverState.completedSlugs;
      existingSubs = serverState.submissionTypes.map((submissionType) => ({ submissionType }));
      hasOrientasiEnrollment = serverState.isEnrolled || user.role === 'admin';
    } else {
      const progressList = await db.select({ lessonSlug: userProgress.lessonSlug })
        .from(userProgress).where(eq(userProgress.userId, user.userId));
      completedSlugs = progressList.map(p => p.lessonSlug);
      existingSubs = await db.select({ submissionType: userSubmissions.submissionType })
        .from(userSubmissions)
        .where(and(eq(userSubmissions.userId, user.userId), eq(userSubmissions.lessonSlug, lessonSlug)));
    }

    hasSubmittedLkpd = existingSubs.some(s => s.submissionType === 'lkpd');
    hasSubmittedReflection = existingSubs.some(s => s.submissionType === 'reflection');
    hasPassedCheckpoint = existingSubs.some(s => s.submissionType === 'checkpoint') || hasSubmittedLkpd;
  } catch (e) {
    console.error('Error fetching student progression states:', e);
  }
}

// Sequential Module Gating Logic
const currentIndex = sortedSidebarModules.findIndex((m) => (m.id || m.slug) === slug);
const prevModule = currentIndex > 0 ? sortedSidebarModules[currentIndex - 1] : null;
const nextModule = currentIndex >= 0 && currentIndex < sortedSidebarModules.length - 1 ? sortedSidebarModules[currentIndex + 1] : null;

const isCurrentModuleCompleted = completedSlugs.includes(lessonSlug);
// Modul 1 selalu terbuka. Modul N hanya terkunci jika user bukan admin dan modul N-1 belum selesai
const isCurrentModuleLocked = isOrientasiModule && user?.role !== 'admin' && (!hasOrientasiEnrollment || (prevModule !== null && !completedSlugs.includes(prevModule.id || prevModule.slug)));

const totalCompletedModules = sortedSidebarModules.filter(m => completedSlugs.includes(m.id || m.slug)).length;
const progressPercentage = sortedSidebarModules.length > 0 ? Math.round((totalCompletedModules / sortedSidebarModules.length) * 100) : 0;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="container-main py-8" id="module-container" data-slug={lessonSlug} data-init-checkpoint={hasPassedCheckpoint ? "true" : "false"} data-init-lkpd={hasSubmittedLkpd ? "true" : "false"} data-init-reflection={hasSubmittedReflection ? "true" : "false"}>

    <!-- Module Header Banner & Gamification Bar -->
    <div class="p-6 md:p-8 rounded-2xl bg-card border border-border mb-8 space-y-4 shadow-sm relative overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <a href="/pembelajaran/orientasi-pplg" class="text-xs text-muted-foreground hover:text-foreground font-medium transition-colors flex items-center gap-1">
            ← Silabus Orientasi PPLG
          </a>
          <span class="text-muted-foreground">•</span>
          <span class="px-2.5 py-0.5 rounded bg-primary/10 text-primary text-xs font-mono font-semibold border border-primary/20">{entry.data.category}</span>
        </div>

        <div class="flex items-center gap-3">
          {isCurrentModuleCompleted ? (
            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold border border-emerald-500/20 flex items-center gap-1.5">
              ✅ Modul Selesai
            </span>
          ) : (
            <span class="px-2.5 py-1 rounded-lg bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 font-mono text-xs font-bold border border-cyan-500/20 flex items-center gap-1.5">
              📖 Sedang Dipelajari
            </span>
          )}
          <span class="px-2.5 py-1 rounded-lg bg-secondary text-foreground font-mono text-xs font-semibold border border-border flex items-center gap-1.5">
            ⏱️ {entry.data.duration || '2 JP'}
          </span>
          <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 font-mono text-xs font-bold border border-amber-500/20 flex items-center gap-1">
            ⚡ +50 XP
          </span>
        </div>
      </div>

      <div class="space-y-1">
        <h1 class="text-2xl md:text-3xl font-extrabold text-foreground tracking-tight">
          {entry.data.title}
        </h1>
        <p class="text-xs md:text-sm text-muted-foreground leading-relaxed max-w-4xl">
          {entry.data.description}
        </p>
      </div>

      <!-- Course Progress Bar -->
      <div class="p-3.5 rounded-xl bg-secondary/40 border border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="font-bold text-foreground">📊 Progres Mapel Orientasi PPLG:</span>
          <span class="font-mono text-primary font-bold">{totalCompletedModules} dari {sortedSidebarModules.length} Modul Selesai ({progressPercentage}%)</span>
        </div>
        <div class="w-full sm:w-56 bg-secondary rounded-full h-2.5 overflow-hidden shrink-0 border border-border">
          <div class="bg-gradient-to-r from-cyan-500 to-emerald-500 h-2.5 rounded-full transition-all duration-500" style={`width: ${progressPercentage}%`}></div>
        </div>
      </div>

      {entry.data.teacherTip && (!isOrientasiModule || isModul1) && (
        <div class="p-3.5 rounded-xl bg-secondary/40 border border-border text-xs md:text-sm font-medium flex items-start gap-2.5">
          <span class="text-base">💡</span>
          <div class="text-muted-foreground">
            <strong class="font-semibold text-foreground">Catatan Guru:</strong> {entry.data.teacherTip}
          </div>
        </div>
      )}

      {!isCurrentModuleLocked && (
        <div class="pt-4 border-t border-border flex flex-wrap gap-2" id="module-tab-nav">
          <button
            type="button"
            data-tab="materi"
            class="module-tab-btn active-tab px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border"
          >
            <span>📖</span>
            <span>1. Materi & Visual</span>
          </button>

          <button
            type="button"
            data-tab="lkpd"
            id="tab-btn-lkpd"
            class={`module-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border ${!hasPassedCheckpoint ? 'tab-locked opacity-75' : ''}`}
          >
            <span id="tab-icon-lkpd">{hasPassedCheckpoint ? '📝' : '🔒'}</span>
            <span>2. Form LKPD Interaktif</span>
            <span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-600 dark:text-amber-400 text-[10px] font-mono">+25 XP</span>
          </button>

          <button
            type="button"
            data-tab="refleksi"
            id="tab-btn-refleksi"
            class={`module-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border ${!hasSubmittedLkpd ? 'tab-locked opacity-75' : ''}`}
          >
            <span id="tab-icon-refleksi">{hasSubmittedLkpd ? '💭' : '🔒'}</span>
            <span>3. Jurnal Refleksi</span>
            <span class="px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-600 dark:text-purple-400 text-[10px] font-mono">+15 XP</span>
          </button>

          <button
            type="button"
            data-tab="kktp"
            class="module-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border"
          >
            <span>🎯</span>
            <span>4. Panduan Kriteria Guru</span>
          </button>
        </div>
      )}

      <!-- Locked Warning Toast / Alert Bar -->
      <div id="tab-lock-toast" class="hidden p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-medium flex items-center justify-between animate-shake">
        <div class="flex items-center gap-2">
          <span>🔒</span>
          <span id="tab-lock-message">Selesaikan tantangan kuis checkpoint di Tab Materi terlebih dahulu untuk membuka Form LKPD.</span>
        </div>
        <button type="button" id="close-lock-toast" class="text-xs font-bold px-2 py-0.5 rounded hover:bg-amber-500/20">✕</button>
      </div>
    </div>

    <!-- Layout: Sidebar + Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8" id="module-content-area">

      <!-- Sticky Sidebar Navigation & Live Scoreboard -->
      <aside class="lg:col-span-1 space-y-5">

        <!-- Live Class Score Widget -->
        <LiveScoreWidget initialClass="Semua Kelas" />

        <!-- Silabus Navigation Card -->
        <div class="sticky top-24 p-4 rounded-2xl bg-card border border-border space-y-3.5 shadow-sm">
          <div class="flex items-center justify-between border-b border-border pb-2.5">
            <h3 class="text-xs font-bold text-foreground uppercase tracking-wider font-mono">Silabus Modul RPL</h3>
            <span class="text-[10px] text-primary font-mono font-bold">Sprint 1 & 2</span>
          </div>

          <nav class="space-y-1 text-sm max-h-[50vh] overflow-y-auto pr-1">
            {sortedSidebarModules.map((mod, idx) => {
              const modSlug = mod.id || mod.slug;
              const currentSlug = entry.id || entry.slug;
              const isCurrent = modSlug === currentSlug;
              const isModDone = completedSlugs.includes(modSlug);
              const isModLocked = user?.role !== 'admin' && idx > 0 && !completedSlugs.includes(sortedSidebarModules[idx - 1].id || sortedSidebarModules[idx - 1].slug);

              if (isModLocked) {
                return (
                  <div class="px-3 py-2 rounded-lg text-xs font-medium text-muted-foreground/40 bg-secondary/10 flex items-center justify-between gap-2 cursor-not-allowed select-none border border-transparent" title="Selesaikan modul sebelumnya terlebih dahulu">
                    <div class="flex items-center gap-2 truncate">
                      <span class="w-4 text-center font-mono text-[10px] font-bold text-muted-foreground/40 shrink-0">{mod.data.order}</span>
                      <span class="truncate">{mod.data.title}</span>
                    </div>
                    <span class="text-[10px] shrink-0">🔒</span>
                  </div>
                );
              }

              return (
                <a
                  href={`/pembelajaran/${modSlug}`}
                  class:list={[
                    "block px-3 py-2 rounded-lg text-xs font-medium transition-all flex items-center justify-between gap-2",
                    isCurrent
                      ? "bg-primary/10 text-primary font-bold border border-primary/20 shadow-sm"
                      : "text-muted-foreground hover:bg-secondary hover:text-foreground"
                  ]}
                >
                  <div class="flex items-center gap-2 truncate">
                    <span class="w-4 text-center font-mono text-[10px] font-bold text-muted-foreground shrink-0">{mod.data.order}</span>
                    <span class="truncate">{mod.data.title}</span>
                  </div>
                  <div class="flex items-center gap-1 shrink-0">
                    {isModDone && <span class="text-[10px] text-emerald-500 font-bold">✅</span>}
                    {isCurrent && <span class="text-[9px] px-1.5 py-0.5 rounded bg-primary text-primary-foreground font-mono font-bold">Buka</span>}
                  </div>
                </a>
              );
            })}
          </nav>

          <div class="pt-3 border-t border-border space-y-2">
            <a href="/pembelajaran/tka-pplg" class="btn btn-sm w-full text-xs font-bold bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl shadow-sm flex items-center justify-center gap-1.5">
              <span>🎯 Ujian Simulator TKA</span>
            </a>
          </div>
        </div>

      </aside>

      <!-- Main Content Area -->
      <main class="lg:col-span-3 space-y-6">

        {isCurrentModuleLocked ? (
          <div class="card p-8 md:p-12 text-center rounded-3xl border-border bg-card shadow-lg space-y-6">
            <div class="w-20 h-20 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-500 text-4xl flex items-center justify-center mx-auto animate-bounce">
              🔒
            </div>
            <div class="space-y-2">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-xs font-mono font-bold">
                AKSES MODUL BELUM TERBUKA
              </div>
              <h2 class="text-2xl font-extrabold text-foreground tracking-tight">
                {!hasOrientasiEnrollment ? 'Enrollment Orientasi PPLG Diperlukan' : `Selesaikan Modul ${prevModule?.data.order} Terlebih Dahulu`}
              </h2>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed max-w-lg mx-auto">
                {!hasOrientasiEnrollment
                  ? 'Masuk dan klaim token akses resmi dari Guru Pengampu RPL pada halaman silabus sebelum memulai modul.'
                  : <>Untuk menjamin pemahaman konsep yang terstruktur dan tuntas, kamu perlu menyelesaikan kuis, lembar kerja, dan jurnal refleksi pada <strong>Modul {prevModule?.data.order}: {prevModule?.data.title}</strong> sebelum membuka modul ini.</>}
              </p>
            </div>

            <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-3">
              {prevModule && (
                <a
                  href={`/pembelajaran/${prevModule.id || prevModule.slug}`}
                  class="btn btn-primary text-xs sm:text-sm font-bold px-6 py-3 rounded-xl flex items-center gap-2 shadow-md hover:scale-105 transition-all"
                >
                  <span>← Buka Modul {prevModule.data.order}: {prevModule.data.title}</span>
                </a>
              )}
              <a
                href="/pembelajaran/orientasi-pplg"
                class="btn btn-secondary text-xs sm:text-sm font-semibold px-5 py-3 rounded-xl border border-border"
              >
                Lihat Silabus Lengkap
              </a>
            </div>
          </div>
        ) : (
          <>
            <section id="panel-materi" class="tab-panel space-y-6">
              {isModul1 && (
                <details data-reference-material class="group p-4 sm:p-5 rounded-2xl bg-secondary/30 border border-border/80 hover:border-border transition-all shadow-sm">
                  <summary class="cursor-pointer font-bold text-xs sm:text-sm text-foreground flex items-center justify-between list-none select-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400 focus-visible:outline-offset-4">
                    <span class="flex items-center gap-2">
                      <span class="text-base">📜</span>
                      <span>Bacaan Rujukan Silabus & Catatan Kurikulum Lengkap</span>
                    </span>
                    <span class="group-open:rotate-180 transition-transform duration-200 text-muted-foreground text-xs font-mono">▼</span>
                  </summary>
                  <div class="pt-4 border-t border-border mt-3.5">
                    <article class="prose prose-invert max-w-none text-xs leading-relaxed">
                      <Content />
                    </article>
                  </div>
                </details>
              )}

              {isModul1 ? (
                <InteractiveMaterialP1 user={user} />
              ) : !isOrientasiModule ? (
                <SmartMarkdownWrapper>
                  <Content />
                </SmartMarkdownWrapper>
              ) : null}

              {isOrientasiModule && !isModul1 && (
                <>
                  <details data-reference-material class="group p-4 sm:p-5 rounded-2xl bg-secondary/30 border border-border/80 hover:border-border transition-all shadow-sm">
                    <summary class="cursor-pointer font-bold text-xs sm:text-sm text-foreground flex items-center justify-between list-none select-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400 focus-visible:outline-offset-4">
                      <span class="flex items-center gap-2">
                        <span class="text-base">📜</span>
                        <span>Bacaan Rujukan & Materi Lengkap</span>
                      </span>
                      <span class="group-open:rotate-180 transition-transform duration-200 text-muted-foreground text-xs font-mono">▼</span>
                    </summary>
                    <div class="pt-4 border-t border-border mt-3.5">
                      <article class="prose prose-invert max-w-none text-xs leading-relaxed">
                        <Content />
                      </article>
                    </div>
                  </details>

                  <TeacherMessageCard
                    lessonSlug={lessonSlug}
                    teacherMessage={orientasiMaterial!.teacherMessage}
                  />

                  <OrientasiLearningScene
                    lessonSlug={lessonSlug}
                    moduleTitle={entry.data.title}
                    moduleDuration={entry.data.duration}
                  />
                </>
              )}

              <div class="space-y-4 pt-2" id="checkpoint-challenge-area">
                <InteractiveKnowledgeCheck
                  lessonSlug={lessonSlug}
                  moduleTitle={entry.data.title}
                  isCompleted={hasPassedCheckpoint}
                />
              </div>
            </section>

            <section id="panel-lkpd" class="tab-panel hidden space-y-6">
              {isModul1 ? (
                <InteractiveLkpdP1 lessonSlug={lessonSlug} user={user} />
              ) : (
                <GeneralInteractiveLkpd
                  lessonSlug={lessonSlug}
                  moduleTitle={entry.data.title}
                  user={user}
                />
              )}

              <div class="p-6 rounded-2xl bg-secondary/30 border border-border flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="space-y-0.5 text-center sm:text-left">
                  <h3 class="text-sm font-bold text-foreground">Selesai Mengisi LKPD?</h3>
                  <p class="text-xs text-muted-foreground">Simpan jawaban di atas untuk membuka Tab 3 (Jurnal Refleksi) dan mengunci pemahaman kalian.</p>
                </div>
                <button
                  type="button"
                  data-switch-tab="refleksi"
                  class="btn btn-primary text-xs font-semibold px-5 py-2.5 rounded-xl shrink-0"
                >
                  Lanjut ke Jurnal Refleksi →
                </button>
              </div>
            </section>

            <section id="panel-refleksi" class="tab-panel hidden space-y-6">
              <InteractiveReflectionForm
                lessonSlug={lessonSlug}
                moduleTitle={entry.data.title}
                user={user}
              />

              <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-br from-card via-card to-primary/5 border border-border text-center space-y-4 shadow-sm relative overflow-hidden" id="module-completion-card">
                <div class="space-y-1.5">
                  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-mono font-bold">
                    🏁 TAHAP AKHIR MODUL
                  </div>
                  <h3 class="text-lg md:text-xl font-extrabold text-foreground">
                    Tuntaskan Modul & Buka Modul Berikutnya
                  </h3>
                  <p class="text-xs md:text-sm text-muted-foreground max-w-lg mx-auto leading-relaxed">
                    Setelah menyelesaikan materi kuis checkpoint, form LKPD, dan menyimpan jurnal refleksi di atas, klik tombol di bawah untuk mengunci progres belajar Anda dan membuka modul selanjutnya.
                  </p>
                </div>

                <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
                  <button
                    id="btn-complete-lesson"
                    data-next-slug={nextModule ? (nextModule.id || nextModule.slug) : ''}
                    class={`btn text-xs sm:text-sm font-bold px-7 py-3 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 ${
                      isCurrentModuleCompleted
                        ? 'bg-emerald-600 hover:bg-emerald-500 text-white'
                        : 'btn-primary hover:scale-105'
                    }`}
                  >
                    <span>{isCurrentModuleCompleted ? '✅ Modul Telah Selesai Dituntaskan' : '✅ Tandai Selesai & Buka Modul Selanjutnya'}</span>
                    {nextModule && !isCurrentModuleCompleted && <span>➔</span>}
                  </button>

                  {nextModule && (
                    <a
                      href={`/pembelajaran/${nextModule.id || nextModule.slug}`}
                      id="btn-goto-next"
                      class={`btn btn-secondary text-xs sm:text-sm font-semibold px-5 py-3 rounded-xl border border-border flex items-center justify-center gap-1.5 hover:bg-secondary ${!isCurrentModuleCompleted ? 'hidden' : ''}`}
                    >
                      <span>🚀 Lanjut ke Modul {nextModule.data.order}: {nextModule.data.title}</span>
                      <span>➔</span>
                    </a>
                  )}
                </div>
              </div>

              <div class="p-6 rounded-2xl bg-secondary/30 border border-border flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="space-y-0.5 text-center sm:text-left">
                  <h3 class="text-sm font-bold text-foreground">Ingin Melihat Standar Penilaian Guru?</h3>
                  <p class="text-xs text-muted-foreground">Cek rubrik KKTP untuk mengetahui kriteria pencapaian Level 0 sampai Level 4.</p>
                </div>
                <button
                  type="button"
                  data-switch-tab="kktp"
                  class="btn btn-secondary text-xs font-semibold px-5 py-2.5 rounded-xl shrink-0 border border-border hover:bg-secondary"
                >
                  Lihat Panduan KKTP →
                </button>
              </div>
            </section>

            <section id="panel-kktp" class="tab-panel hidden space-y-6">
              <KktpGuideCard
                skillCode={entry.data.category?.includes('OR-02') || entry.data.order > 8 ? "OR-02" : entry.data.category?.includes('OR-01') || entry.data.order <= 8 ? "OR-01" : "RPL-CORE"}
                moduleTitle={entry.data.title}
                order={entry.data.order}
                targetLevel="Level 2 (Mencoba ★)"
              />

              <div class="p-6 rounded-2xl bg-secondary/30 border border-border flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="space-y-0.5 text-center sm:text-left">
                  <h3 class="text-sm font-bold text-foreground">Kembali ke Materi atau LKPD?</h3>
                  <p class="text-xs text-muted-foreground">Pastikan seluruh berkas bukti karya kalian sudah sesuai dengan rubrik Level 2.</p>
                </div>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    data-switch-tab="materi"
                    class="btn btn-secondary text-xs font-semibold px-4 py-2 rounded-xl border border-border hover:bg-secondary"
                  >
                    ← Kembali ke Materi
                  </button>
                  <button
                    type="button"
                    data-switch-tab="lkpd"
                    class="btn btn-primary text-xs font-semibold px-4 py-2 rounded-xl"
                  >
                    Ke Form LKPD →
                  </button>
                </div>
              </div>
            </section>
          </>
        )}

      </main>

    </div>
  </div>

  <style>
    .module-tab-btn {
      background-color: var(--secondary);
      border-color: var(--border);
      color: var(--muted-foreground);
    }
    .module-tab-btn:hover {
      background-color: hsl(var(--secondary-foreground) / 0.1);
      color: var(--foreground);
    }
    .module-tab-btn.active-tab {
      background-color: hsl(var(--primary) / 0.15);
      border-color: var(--primary);
      color: var(--primary);
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .tab-locked {
      cursor: not-allowed;
    }
  </style>

  <script>
    import { markLessonComplete } from '../../utils/gamification';

    const container = document.getElementById('module-container');
    const slug = container?.getAttribute('data-slug') || '';
    const tabBtns = document.querySelectorAll('.module-tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');
    const btnComplete = document.getElementById('btn-complete-lesson');
    const btnGotoNext = document.getElementById('btn-goto-next');

    // Gating Elements
    const tabBtnLkpd = document.getElementById('tab-btn-lkpd');
    const tabIconLkpd = document.getElementById('tab-icon-lkpd');
    const tabBtnRefleksi = document.getElementById('tab-btn-refleksi');
    const tabIconRefleksi = document.getElementById('tab-icon-refleksi');
    const lockToast = document.getElementById('tab-lock-toast');
    const lockMessage = document.getElementById('tab-lock-message');
    const closeLockToast = document.getElementById('close-lock-toast');

    // Progression state tracking
    // Server-rendered state is authoritative. localStorage is written only as a display cache.
    let isCheckpointPassed = container?.getAttribute('data-init-checkpoint') === 'true';
    let isLkpdSubmitted = container?.getAttribute('data-init-lkpd') === 'true';
    let isReflectionSubmitted = container?.getAttribute('data-init-reflection') === 'true';

    // Show toast message when clicking locked tab
    function showLockWarning(msg: string) {
      if (lockToast && lockMessage) {
        lockMessage.textContent = msg;
        lockToast.classList.remove('hidden');
        setTimeout(() => {
          lockToast.classList.add('hidden');
        }, 5000);
      }
    }

    closeLockToast?.addEventListener('click', () => {
      lockToast?.classList.add('hidden');
    });

    // Update UI unlock states
    function updateTabLockVisuals() {
      if (isCheckpointPassed) {
        tabBtnLkpd?.classList.remove('tab-locked', 'opacity-75');
        if (tabIconLkpd) tabIconLkpd.textContent = '📝';
      } else {
        tabBtnLkpd?.classList.add('tab-locked', 'opacity-75');
        if (tabIconLkpd) tabIconLkpd.textContent = '🔒';
      }

      if (isLkpdSubmitted) {
        tabBtnRefleksi?.classList.remove('tab-locked', 'opacity-75');
        if (tabIconRefleksi) tabIconRefleksi.textContent = '💭';
      } else {
        tabBtnRefleksi?.classList.add('tab-locked', 'opacity-75');
        if (tabIconRefleksi) tabIconRefleksi.textContent = '🔒';
      }
    }

    updateTabLockVisuals();

    // Universal tab switcher function with gating validation
    function switchTab(targetTab: string) {
      if (!targetTab) return;

      // Validate Gating Rules
      if (targetTab === 'lkpd' && !isCheckpointPassed) {
        showLockWarning('🔒 Selesaikan kuis checkpoint di Tab Materi terlebih dahulu untuk membuka Form LKPD.');
        const checkpointArea = document.getElementById('checkpoint-challenge-area');
        if (checkpointArea) {
          checkpointArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      if (targetTab === 'refleksi' && !isLkpdSubmitted) {
        showLockWarning('🔒 Lengkapi dan simpan data Form LKPD terlebih dahulu untuk membuka Jurnal Refleksi.');
        return;
      }

      // Hide toast if allowed
      lockToast?.classList.add('hidden');

      // Update button active state
      tabBtns.forEach((btn) => {
        if (btn.getAttribute('data-tab') === targetTab) {
          btn.classList.add('active-tab');
        } else {
          btn.classList.remove('active-tab');
        }
      });

      // Update panel visibility
      tabPanels.forEach((panel) => {
        if (panel.id === `panel-${targetTab}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      // Update URL hash without jumping
      history.replaceState(null, '', `#${targetTab}`);

      // Smooth scroll to top of content area
      const contentArea = document.getElementById('module-content-area');
      if (contentArea) {
        const topOffset = contentArea.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top: topOffset, behavior: 'smooth' });
      }
    }

    // Attach to window so any component can invoke
    (window as any).switchModuleTab = switchTab;

    // Attach click listeners to top tab buttons
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        if (targetTab) switchTab(targetTab);
      });
    });

    // Delegated click listener for any element with data-switch-tab
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-switch-tab]');
      if (target) {
        e.preventDefault();
        const tab = target.getAttribute('data-switch-tab');
        if (tab) switchTab(tab);
      }
    });

    // Listen to Checkpoint Passed event
    window.addEventListener('checkpoint-passed', () => {
      isCheckpointPassed = true;
      localStorage.setItem(`ags_checkpoint_${slug}`, 'true');
      updateTabLockVisuals();
      switchTab('lkpd');
    });

    // Listen to LKPD submitted event (or storage event)
    window.addEventListener('lkpd-submitted', () => {
      isLkpdSubmitted = true;
      localStorage.setItem(`ags_lkpd_${slug}`, 'true');
      updateTabLockVisuals();
      switchTab('refleksi');
    });

    // Check hash on page load (e.g. #lkpd or #refleksi)
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && ['materi', 'lkpd', 'refleksi', 'kktp'].includes(initialHash)) {
      switchTab(initialHash);
    }

    // Mark complete button logic
    btnComplete?.addEventListener('click', async () => {
      if (btnComplete.getAttribute('data-processing') === 'true') return;
      btnComplete.setAttribute('data-processing', 'true');
      btnComplete.textContent = '⏳ Menyimpan progres...';

      const activeTokenId = localStorage.getItem('ags_active_token_id');

      try {
        const res = await fetch('/api/progress/complete-lesson', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lessonSlug: slug,
            tokenId: activeTokenId ? Number(activeTokenId) : null
          })
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Progres modul ditolak server.');
        markLessonComplete(slug);
        localStorage.setItem(`ags_completed_${slug}`, 'true');

        btnComplete.textContent = `🎉 Modul Berhasil Dituntaskan! (+${data.xpEarned || 15} XP)`;
        btnComplete.className = 'btn text-xs sm:text-sm font-bold px-7 py-3 rounded-xl shadow-lg bg-emerald-600 hover:bg-emerald-500 text-white flex items-center justify-center gap-2';

        if (btnGotoNext) {
          btnGotoNext.classList.remove('hidden');
        }

        window.dispatchEvent(new CustomEvent('refresh-live-score'));

        const nextSlug = btnComplete.getAttribute('data-next-slug');
        if (nextSlug) {
          setTimeout(() => {
            window.location.href = `/pembelajaran/${nextSlug}`;
          }, 1200);
        }
      } catch (e) {
        btnComplete.removeAttribute('data-processing');
        btnComplete.textContent = 'Coba Lagi: Tandai Selesai';
        alert(e instanceof Error ? e.message : 'Progres modul gagal disimpan.');
      }
    });
  </script>

  <AntiCopyPasteGuardian />
</BaseLayout>
