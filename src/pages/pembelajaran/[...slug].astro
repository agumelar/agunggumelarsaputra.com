---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import InteractiveMaterialP1 from '../../components/modul/InteractiveMaterialP1.astro';
import InteractiveLkpdP1 from '../../components/modul/InteractiveLkpdP1.astro';
import GeneralInteractiveLkpd from '../../components/modul/GeneralInteractiveLkpd.astro';
import InteractiveReflectionForm from '../../components/modul/InteractiveReflectionForm.astro';
import KktpGuideCard from '../../components/modul/KktpGuideCard.astro';
import InteractiveKnowledgeCheck from '../../components/modul/InteractiveKnowledgeCheck.astro';

const { slug } = Astro.params;
const allModules = await getCollection('pembelajaran');
const entry = allModules.find((m) => (m.id || m.slug) === slug);

if (!entry) {
  return Astro.redirect('/pembelajaran');
}

const user = Astro.locals.user;
const { Content } = await render(entry);
const sortedSidebarModules = allModules.sort((a, b) => a.data.order - b.data.order);
const isModul1 = (entry.id || entry.slug) === 'orientasi-pplg-01-pengantar-skill-passport';
const lessonSlug = entry.id || entry.slug;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="container-main py-8" id="module-container" data-slug={lessonSlug}>
    
    <!-- Module Header Banner & Gamification Bar -->
    <div class="p-6 md:p-8 rounded-2xl bg-card border border-border mb-8 space-y-4 shadow-sm relative overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <a href="/pembelajaran/orientasi-pplg" class="text-xs text-muted-foreground hover:text-foreground font-medium transition-colors flex items-center gap-1">
            ← Silabus Orientasi PPLG
          </a>
          <span class="text-muted-foreground">•</span>
          <span class="px-2.5 py-0.5 rounded bg-primary/10 text-primary text-xs font-mono font-semibold border border-primary/20">{entry.data.category}</span>
        </div>

        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-lg bg-secondary text-foreground font-mono text-xs font-semibold border border-border flex items-center gap-1.5">
            ⏱️ {entry.data.duration || '2 JP'}
          </span>
          <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 font-mono text-xs font-bold border border-amber-500/20 flex items-center gap-1">
            ⚡ Total: +50 XP
          </span>
        </div>
      </div>

      <div class="space-y-1">
        <h1 class="text-2xl md:text-3xl font-extrabold text-foreground tracking-tight">
          {entry.data.title}
        </h1>
        <p class="text-xs md:text-sm text-muted-foreground leading-relaxed max-w-4xl">
          {entry.data.description}
        </p>
      </div>

      {entry.data.teacherTip && (
        <div class="p-3.5 rounded-xl bg-secondary/40 border border-border text-xs md:text-sm font-medium flex items-start gap-2.5">
          <span class="text-base">💡</span>
          <div class="text-muted-foreground">
            <strong class="font-semibold text-foreground">Catatan Guru:</strong> {entry.data.teacherTip}
          </div>
        </div>
      )}

      <!-- Gamified Module Tabs Navigation -->
      <div class="pt-4 border-t border-border flex flex-wrap gap-2" id="module-tab-nav">
        <button 
          type="button" 
          data-tab="materi"
          class="module-tab-btn active-tab px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border"
        >
          <span>📖</span>
          <span>1. Materi & Visual</span>
        </button>

        <button 
          type="button" 
          data-tab="lkpd"
          class="module-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border"
        >
          <span>📝</span>
          <span>2. Form LKPD Interaktif</span>
          <span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-600 dark:text-amber-400 text-[10px] font-mono">+25 XP</span>
        </button>

        <button 
          type="button" 
          data-tab="refleksi"
          class="module-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border"
        >
          <span>💭</span>
          <span>3. Jurnal Refleksi</span>
          <span class="px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-600 dark:text-purple-400 text-[10px] font-mono">+15 XP</span>
        </button>

        <button 
          type="button" 
          data-tab="kktp"
          class="module-tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 border"
        >
          <span>🎯</span>
          <span>4. Panduan Kriteria Guru</span>
        </button>
      </div>
    </div>

    <!-- Layout: Sidebar + Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8" id="module-content-area">
      
      <!-- Sticky Sidebar Navigation -->
      <aside class="lg:col-span-1 space-y-4">
        <div class="sticky top-24 p-4 rounded-2xl bg-card border border-border space-y-3.5 shadow-sm">
          <div class="flex items-center justify-between border-b border-border pb-2.5">
            <h3 class="text-xs font-bold text-foreground uppercase tracking-wider font-mono">Silabus Modul RPL</h3>
            <span class="text-[10px] text-primary font-mono font-bold">Sprint 1 & 2</span>
          </div>

          <nav class="space-y-1 text-sm max-h-[65vh] overflow-y-auto pr-1">
            {sortedSidebarModules.map((mod) => {
              const modSlug = mod.id || mod.slug;
              const currentSlug = entry.id || entry.slug;
              const isCurrent = modSlug === currentSlug;
              return (
                <a 
                  href={`/pembelajaran/${modSlug}`}
                  class:list={[
                    "block px-3 py-2 rounded-lg text-xs font-medium transition-all flex items-center justify-between gap-2",
                    isCurrent 
                      ? "bg-primary/10 text-primary font-bold border border-primary/20 shadow-sm" 
                      : "text-muted-foreground hover:bg-secondary hover:text-foreground"
                  ]}
                >
                  <div class="flex items-center gap-2 truncate">
                    <span class="w-4 text-center font-mono text-[10px] font-bold text-muted-foreground shrink-0">{mod.data.order}</span>
                    <span class="truncate">{mod.data.title}</span>
                  </div>
                  {isCurrent && <span class="text-[9px] px-1.5 py-0.5 rounded bg-primary text-primary-foreground font-mono font-bold shrink-0">Buka</span>}
                </a>
              );
            })}
          </nav>

          <div class="pt-3 border-t border-border space-y-2">
            <a href="/pembelajaran/tka-pplg" class="btn btn-sm w-full text-xs font-bold bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl shadow-sm flex items-center justify-center gap-1.5">
              <span>🎯 Ujian Simulator TKA</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Content Area with Tab Panels -->
      <main class="lg:col-span-3 space-y-6">
        
        <!-- Tab Panel 1: Materi Pembelajaran -->
        <section id="panel-materi" class="tab-panel space-y-6">
          
          {isModul1 ? (
            <InteractiveMaterialP1 user={user} />
          ) : (
            <div class="card p-6 md:p-8 rounded-2xl border-border bg-card shadow-sm">
              <article class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-code:font-mono prose-code:bg-secondary prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-secondary prose-pre:border prose-pre:border-border prose-table:border-collapse">
                <Content />
              </article>
            </div>
          )}

          <!-- Micro Knowledge Check if Modul 1 -->
          {isModul1 && (
            <div class="space-y-4">
              <InteractiveKnowledgeCheck 
                id="check-1"
                question="Mengapa sistem Skill Passport di RPL SMKN 1 Rongga berfokus pada pengumpulan Evidence (Bukti Karya Nyata) ketimbang sekadar nilai ujian angka?"
                options={[
                  { 
                    label: "Karena di industri software, portofolio dan kode nyata yang dibuat adalah bukti kompetensi utama yang dilihat oleh recruiter/klien.", 
                    isCorrect: true, 
                    explanation: "Tepat sekali! Rekam jejak karya nyata (portfolio) membuktikan kemampuan praktis problem solving dan engineering di dunia kerja." 
                  },
                  { 
                    label: "Hanya untuk memenuhi formalitas kurikulum agar terlihat banyak tugas.", 
                    isCorrect: false, 
                    explanation: "Bukan formalitas, melainkan pembiasaan standar industri berbasis unjuk kerja nyata." 
                  },
                  { 
                    label: "Karena siswa RPL dilarang mendapatkan nilai angka di sekolah.", 
                    isCorrect: false, 
                    explanation: "Nilai tetap ada, namun evidence portofolio menjadi validasi substansi ketercapaian kompetensi." 
                  }
                ]}
                xpReward={5}
              />
            </div>
          )}

          <!-- Supplementary Curriculum Reference Accordion for Modul 1 -->
          {isModul1 && (
            <details class="group p-5 rounded-2xl bg-secondary/20 border border-border transition-all">
              <summary class="cursor-pointer font-bold text-xs text-foreground flex items-center justify-between list-none">
                <span class="flex items-center gap-2">
                  <span>📜</span>
                  <span>Bacaan Rujukan Silabus & Catatan Kurikulum Lengkap</span>
                </span>
                <span class="group-open:rotate-180 transition-transform text-muted-foreground">▼</span>
              </summary>
              <div class="pt-4 border-t border-border mt-3">
                <article class="prose prose-invert max-w-none text-xs leading-relaxed">
                  <Content />
                </article>
              </div>
            </details>
          )}

          <!-- Quick Navigation to Next Tab -->
          <div class="p-6 rounded-2xl bg-secondary/30 border border-border flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="space-y-0.5 text-center sm:text-left">
              <h3 class="text-sm font-bold text-foreground">Sudah Selesai Mempelajari Materi?</h3>
              <p class="text-xs text-muted-foreground">Lanjutkan ke tahap pengerjaan LKPD Interaktif untuk mengklaim reward XP.</p>
            </div>
            <button 
              type="button" 
              data-switch-tab="lkpd"
              class="btn btn-primary text-xs font-semibold px-5 py-2.5 rounded-xl shrink-0"
            >
              Lanjut ke Form LKPD →
            </button>
          </div>
        </section>

        <!-- Tab Panel 2: Form LKPD Interaktif -->
        <section id="panel-lkpd" class="tab-panel hidden space-y-6">
          {isModul1 ? (
            <InteractiveLkpdP1 lessonSlug={lessonSlug} user={user} />
          ) : (
            <GeneralInteractiveLkpd 
              lessonSlug={lessonSlug} 
              moduleTitle={entry.data.title}
              user={user} 
            />
          )}

          <div class="p-6 rounded-2xl bg-secondary/30 border border-border flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="space-y-0.5 text-center sm:text-left">
              <h3 class="text-sm font-bold text-foreground">Selesai Mengisi LKPD?</h3>
              <p class="text-xs text-muted-foreground">Lengkapi jurnal refleksi pembelajaran untuk mengunci pemahaman kalian.</p>
            </div>
            <button 
              type="button" 
              data-switch-tab="refleksi"
              class="btn btn-primary text-xs font-semibold px-5 py-2.5 rounded-xl shrink-0"
            >
              Lanjut ke Jurnal Refleksi →
            </button>
          </div>
        </section>

        <!-- Tab Panel 3: Jurnal Refleksi -->
        <section id="panel-refleksi" class="tab-panel hidden space-y-6">
          <InteractiveReflectionForm lessonSlug={lessonSlug} user={user} />

          <div class="p-6 rounded-2xl bg-secondary/30 border border-border flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="space-y-0.5 text-center sm:text-left">
              <h3 class="text-sm font-bold text-foreground">Ingin Melihat Standar Penilaian Guru?</h3>
              <p class="text-xs text-muted-foreground">Cek rubrik KKTP untuk mengetahui kriteria pencapaian Level 0 sampai Level 4.</p>
            </div>
            <button 
              type="button" 
              data-switch-tab="kktp"
              class="btn btn-secondary text-xs font-semibold px-5 py-2.5 rounded-xl shrink-0 border border-border hover:bg-secondary"
            >
              Lihat Panduan KKTP →
            </button>
          </div>
        </section>

        <!-- Tab Panel 4: Panduan Kriteria Guru (KKTP) -->
        <section id="panel-kktp" class="tab-panel hidden space-y-6">
          <KktpGuideCard 
            skillCode={isModul1 ? "OR-01" : "OR-PPLG"}
            targetLevel="Level 2 (Mencoba ★)"
          />

          <div class="p-6 rounded-2xl bg-secondary/30 border border-border flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="space-y-0.5 text-center sm:text-left">
              <h3 class="text-sm font-bold text-foreground">Kembali ke Materi atau LKPD?</h3>
              <p class="text-xs text-muted-foreground">Pastikan seluruh berkas bukti karya kalian sudah sesuai dengan rubrik Level 2.</p>
            </div>
            <div class="flex items-center gap-2">
              <button 
                type="button" 
                data-switch-tab="materi"
                class="btn btn-secondary text-xs font-semibold px-4 py-2 rounded-xl border border-border hover:bg-secondary"
              >
                ← Kembali ke Materi
              </button>
              <button 
                type="button" 
                data-switch-tab="lkpd"
                class="btn btn-primary text-xs font-semibold px-4 py-2 rounded-xl"
              >
                Ke Form LKPD →
              </button>
            </div>
          </div>
        </section>

        <!-- Completion Box & Overall XP Claim -->
        <div class="p-6 rounded-2xl bg-card border border-border text-center space-y-3 shadow-sm">
          <h3 class="text-base font-bold text-foreground">Tandai Modul Selesai Dibaca</h3>
          <p class="text-xs text-muted-foreground">Tandai modul ini untuk memperbarui progres status di dashboard belajar Anda.</p>

          <button id="btn-complete-lesson" class="btn btn-primary text-xs font-semibold px-6 py-2.5 rounded-xl">
            ✅ Tandai Selesai & Perbarui Progres
          </button>
        </div>

      </main>

    </div>
  </div>

  <style>
    .module-tab-btn {
      background-color: var(--secondary);
      border-color: var(--border);
      color: var(--muted-foreground);
    }
    .module-tab-btn:hover {
      background-color: hsl(var(--secondary-foreground) / 0.1);
      color: var(--foreground);
    }
    .module-tab-btn.active-tab {
      background-color: hsl(var(--primary) / 0.15);
      border-color: var(--primary);
      color: var(--primary);
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
  </style>

  <script>
    import { markLessonComplete } from '../../utils/gamification';

    const container = document.getElementById('module-container');
    const slug = container?.getAttribute('data-slug') || '';
    const tabBtns = document.querySelectorAll('.module-tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');
    const btnComplete = document.getElementById('btn-complete-lesson');

    // Universal tab switcher function
    function switchTab(targetTab: string) {
      if (!targetTab) return;

      // Update button active state
      tabBtns.forEach((btn) => {
        if (btn.getAttribute('data-tab') === targetTab) {
          btn.classList.add('active-tab');
        } else {
          btn.classList.remove('active-tab');
        }
      });

      // Update panel visibility
      tabPanels.forEach((panel) => {
        if (panel.id === `panel-${targetTab}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      // Update URL hash without jumping
      history.replaceState(null, '', `#${targetTab}`);

      // Smooth scroll to top of content area
      const contentArea = document.getElementById('module-content-area');
      if (contentArea) {
        const topOffset = contentArea.getBoundingClientRect().top + window.scrollY - 100;
        window.scrollTo({ top: topOffset, behavior: 'smooth' });
      }
    }

    // Attach to window so any component can invoke
    (window as any).switchModuleTab = switchTab;

    // Attach click listeners to top tab buttons
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        if (targetTab) switchTab(targetTab);
      });
    });

    // Delegated click listener for any element with data-switch-tab
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-switch-tab]');
      if (target) {
        e.preventDefault();
        const tab = target.getAttribute('data-switch-tab');
        if (tab) switchTab(tab);
      }
    });

    // Check hash on page load (e.g. #lkpd or #refleksi)
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && ['materi', 'lkpd', 'refleksi', 'kktp'].includes(initialHash)) {
      switchTab(initialHash);
    }

    // Mark complete button logic
    btnComplete?.addEventListener('click', async () => {
      markLessonComplete(slug);
      const activeTokenId = localStorage.getItem('ags_active_token_id');
      
      try {
        const res = await fetch('/api/progress/complete-lesson', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            lessonSlug: slug,
            tokenId: activeTokenId ? Number(activeTokenId) : null
          })
        });
        const data = await res.json();
        if (data.success) {
          btnComplete.textContent = `🎉 Progres Diperbarui (+${data.xpEarned} XP)`;
        } else {
          btnComplete.textContent = '🎉 Modul Selesai!';
        }
      } catch (e) {
        btnComplete.textContent = '🎉 Modul Selesai!';
      }

      btnComplete.classList.add('opacity-75', 'cursor-default');
      (btnComplete as HTMLButtonElement).disabled = true;
    });
  </script>
</BaseLayout>
