---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const { slug } = Astro.params;
const allModules = await getCollection('pembelajaran');
const entry = allModules.find((m) => (m.id || m.slug) === slug);

if (!entry) {
  return Astro.redirect('/pembelajaran');
}

const { Content } = await render(entry);
const sortedSidebarModules = allModules.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="container-main py-8">
    
    <!-- Module Header Banner -->
    <div class="p-6 md:p-7 rounded-xl bg-card border border-border mb-8 space-y-3 shadow-sm">
      <div class="flex items-center gap-2">
        <a href="/pembelajaran" class="text-xs text-muted-foreground hover:text-foreground font-medium transition-colors">← Kembali ke Learning Hub</a>
        <span class="text-muted-foreground">•</span>
        <span class="px-2 py-0.5 rounded bg-secondary text-foreground text-xs font-mono font-semibold border border-border">{entry.data.category}</span>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight">
        {entry.data.title}
      </h1>

      <p class="text-sm text-muted-foreground leading-relaxed max-w-3xl">
        {entry.data.description}
      </p>

      {entry.data.teacherTip && (
        <div class="p-3.5 rounded-lg bg-secondary/50 border border-border text-xs md:text-sm font-medium flex items-start gap-2.5">
          <span class="text-base">💡</span>
          <div class="text-muted-foreground">
            <strong class="font-semibold text-foreground">Catatan Guru:</strong> {entry.data.teacherTip}
          </div>
        </div>
      )}
    </div>

    <!-- Layout: Sidebar + Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Sticky Sidebar Navigation -->
      <aside class="lg:col-span-1 space-y-4">
        <div class="sticky top-24 p-4 rounded-xl bg-card border border-border space-y-3.5 shadow-sm">
          <div class="flex items-center justify-between border-b border-border pb-2.5">
            <h3 class="text-xs font-bold text-foreground uppercase tracking-wider font-mono">Daftar Modul RPL</h3>
            <span class="text-[10px] text-amber-600 dark:text-amber-400 font-mono font-semibold">XP System</span>
          </div>

          <nav class="space-y-1 text-sm">
            {sortedSidebarModules.map((mod) => {
              const modSlug = mod.id || mod.slug;
              const currentSlug = entry.id || entry.slug;
              const isCurrent = modSlug === currentSlug;
              return (
                <a 
                  href={`/pembelajaran/${modSlug}`}
                  class:list={[
                    "block px-2.5 py-1.5 rounded-md text-xs font-medium transition-colors flex items-center justify-between",
                    isCurrent 
                      ? "bg-secondary text-foreground font-semibold border-l-2 border-primary" 
                      : "text-muted-foreground hover:bg-secondary hover:text-foreground"
                  ]}
                >
                  <span class="truncate">{mod.data.title}</span>
                  {isCurrent && <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-mono font-semibold">Aktif</span>}
                </a>
              );
            })}
          </nav>

          <div class="pt-3 border-t border-border">
            <a href="/pembelajaran/tka-pplg" class="btn btn-sm w-full text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg">
              🎯 Uji TKA PPLG (+100 XP)
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Lesson Content Area -->
      <main class="lg:col-span-3">
        <article class="prose prose-invert max-w-none prose-headings:font-bold prose-code:font-mono prose-code:bg-secondary prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-secondary prose-pre:border prose-pre:border-border">
          <Content />
        </article>

        <!-- Completion Button & Mark XP -->
        <div class="mt-10 p-6 rounded-xl bg-card border border-border text-center space-y-3 shadow-sm">
          <h3 class="text-base font-bold text-foreground">Sudah Selesai Membaca Modul Ini?</h3>
          <p class="text-xs text-muted-foreground">Tandai modul ini sebagai selesai untuk mengklaim <strong>+10 XP Belajar</strong>!</p>

          <button id="btn-complete-lesson" class="btn btn-primary text-xs font-semibold px-5 py-2.5 rounded-lg">
            ✅ Tandai Selesai & Klaim XP
          </button>
        </div>
      </main>

    </div>
  </div>

  <script data-slug={entry.id || entry.slug}>
    import { markLessonComplete } from '../../utils/gamification';

    const btnComplete = document.getElementById('btn-complete-lesson');
    const slug = document.currentScript?.dataset.slug || '';

    btnComplete?.addEventListener('click', async () => {
      markLessonComplete(slug);
      const activeTokenId = localStorage.getItem('ags_active_token_id');
      
      try {
        const res = await fetch('/api/progress/complete-lesson', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            lessonSlug: slug,
            tokenId: activeTokenId ? Number(activeTokenId) : null
          })
        });
        const data = await res.json();
        if (data.success) {
          btnComplete.textContent = `🎉 Modul Selesai (+${data.xpEarned} XP Ditambahkan)`;
        } else {
          btnComplete.textContent = '🎉 Modul Selesai!';
        }
      } catch (e) {
        btnComplete.textContent = '🎉 Modul Selesai!';
      }

      btnComplete.classList.add('opacity-75', 'cursor-default');
      (btnComplete as HTMLButtonElement).disabled = true;
    });
  </script>
</BaseLayout>
