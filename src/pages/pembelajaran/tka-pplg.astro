---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import TkaQuiz from '../../components/TkaQuiz.astro';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<DashboardLayout 
  title="Drilling TKA PPLG Simulator"
  description="Simulasi CBT Ujian Tes Keahlian Akademik PPLG Kurikulum Merdeka Kemendikdasmen oleh Agung Gumelar Saputra."
  activeNav="/pembelajaran/tka-pplg"
>
  <div class="space-y-6 max-w-5xl mx-auto">
    <!-- Header Banner -->
    <div class="p-6 rounded-xl bg-card border border-border space-y-2 shadow-sm">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-md bg-secondary text-foreground border border-border text-xs font-mono font-semibold">
          🎯 Ujian Vokasi SMK
        </span>
        <span class="px-2.5 py-0.5 rounded-md bg-emerald-500/10 border border-emerald-500/25 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-semibold">
          ✨ Hingga +100 XP
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
        Drilling & Tryout TKA PPLG
      </h1>

      <p class="text-xs sm:text-sm text-muted-foreground max-w-3xl leading-relaxed">
        Asesmen Tes Keahlian Akademik untuk siswa <strong>Pengembangan Perangkat Lunak dan Gim (PPLG)</strong>. Uji pemahaman mengenai Algoritma, Database, OOP, K3LH, dan Proses Bisnis PPLG secara real-time. Nilai dan rekaman pengerjaan otomatis tercatat di akun belajarmu.
      </p>
    </div>

    <!-- Quiz Engine Component -->
    <div>
      <TkaQuiz />
    </div>
  </div>
</DashboardLayout>
