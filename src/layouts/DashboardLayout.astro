---
import '../styles/global.css';
import { db } from '../db';
import { users, userGamification } from '../db/schema';
import { eq } from 'drizzle-orm';

import { canAccessAdminPanel, isSuperAdmin, isSuperAdminEmail } from '../utils/auth';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { 
  title, 
  description = "Portal Belajar dan Manajemen Pembelajaran RPL SMKN 1 Rongga",
  activeNav = '/dashboard'
} = Astro.props;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

// Fetch live user info & gamification stats for header/sidebar
const [dbCurrentUserData] = await db.select({
  role: users.role,
  studentClass: users.studentClass
}).from(users).where(eq(users.id, user.userId)).limit(1);

let [stats] = await db.select().from(userGamification).where(eq(userGamification.userId, user.userId)).limit(1);
if (!stats) {
  [stats] = await db.insert(userGamification).values({ userId: user.userId, xp: 0, level: 1 }).returning();
}

const currentPath = Astro.url.pathname;
const isTeacherOrAdmin = canAccessAdminPanel(dbCurrentUserData?.role || user.role);
const isSuperAdminUser = isSuperAdmin(dbCurrentUserData?.role || user.role) || isSuperAdminEmail(user.email);
const userStudentClass = dbCurrentUserData?.studentClass;

const sidebarRoleLabel = isSuperAdminUser 
  ? 'Super Admin' 
  : isTeacherOrAdmin 
    ? 'Guru Pengampu' 
    : (userStudentClass === 'Guru / Staf Pengampu' 
        ? 'Guru Pengampu' 
        : (userStudentClass ? `Siswa ${userStudentClass}` : 'Siswa RPL'));

const isAdminRoute = currentPath.startsWith('/admin');

const studentNavItems = [
  { href: '/dashboard', label: 'Ringkasan Belajar', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/pembelajaran', label: 'Modul Pembelajaran', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { href: '/pembelajaran/tka-pplg', label: 'Drilling TKA PPLG', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z', badge: 'Tryout' },
  { href: '/dashboard/leaderboard', label: 'Papan Peringkat', icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' },
  { href: '/dashboard/riwayat', label: 'Riwayat & Statistik', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { href: '/dashboard/profil', label: 'Profil & Akun Saya', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
];

const adminNavItems = [
  { href: '/admin', label: 'Ringkasan & Metrik Kelas', icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { href: '/admin#students', label: 'Kelola Data & Hak Akses', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
  { href: '/admin#exams', label: 'Hasil Ujian & Nilai Siswa', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
  { href: '/dashboard/profil', label: 'Pengaturan Akun & Profil', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
];
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=0" />
    <meta name="theme-color" content="#090d16" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title} | PPLG SMKN 1 Rongga</title>
    <meta name="title" content={`${title} | PPLG SMKN 1 Rongga`} />
    <meta name="description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Theme Inline Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased flex selection:bg-primary/20 selection:text-primary">

    <!-- Backdrop Overlay for Mobile Drawer -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-background/80 z-40 lg:hidden hidden transition-opacity"></div>

    <!-- LEFT SIDEBAR NAVIGATION -->
    <aside id="app-sidebar" class="fixed top-0 left-0 bottom-0 z-50 w-64 bg-card border-r border-border flex flex-col justify-between transition-transform duration-200 ease-in-out -translate-x-full lg:translate-x-0">
      
      <!-- Top Brand Header -->
      <div class="h-16 px-4 border-b border-border flex items-center justify-between">
        <a href={isAdminRoute ? "/admin" : "/dashboard"} class="flex items-center gap-3">
          {isAdminRoute ? (
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-500 font-mono font-bold text-xs">
              ADM
            </div>
            <div class="flex flex-col min-w-0">
              <span class="font-bold text-xs tracking-tight text-foreground flex items-center gap-1.5 truncate">
                Panel Manajemen
              </span>
              <span class="text-[11px] text-muted-foreground font-mono">Guru & Admin</span>
            </div>
          ) : (
            <div class="w-8 h-8 rounded-lg bg-primary/10 border border-primary/30 flex items-center justify-center text-primary font-mono font-bold text-xs">
              RPL
            </div>
            <div class="flex flex-col min-w-0">
              <span class="font-bold text-xs tracking-tight text-foreground flex items-center gap-1.5 truncate">
                Learning Hub
              </span>
              <span class="text-[11px] text-muted-foreground font-mono">SMKN 1 Rongga</span>
            </div>
          )}
        </a>
        <button id="close-sidebar-btn" class="lg:hidden p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent" aria-label="Tutup Menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Main Navigation Menu -->
      <div class="flex-1 overflow-y-auto px-3 py-4 space-y-5">
        
        {isAdminRoute ? (
          <div class="space-y-1">
            <div class="px-2.5 pb-1 text-[11px] font-semibold text-muted-foreground font-mono uppercase tracking-wider">
              Manajemen Guru
            </div>
            <div class="space-y-0.5">
              {adminNavItems.map((item) => {
                const isActive = currentPath === item.href || (item.href === '/admin' && currentPath === '/admin');
                return (
                  <a 
                    href={item.href}
                    class:list={[
                      "flex items-center justify-between px-2.5 py-2 rounded-md text-xs font-medium transition-colors",
                      isActive 
                        ? "bg-amber-500/10 text-amber-500 dark:text-amber-400 font-semibold border border-amber-500/25" 
                        : "text-muted-foreground hover:text-foreground hover:bg-accent"
                    ]}
                  >
                    <div class="flex items-center gap-2.5">
                      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                      </svg>
                      <span>{item.label}</span>
                    </div>
                  </a>
                );
              })}
            </div>

            <!-- Portal Mode Switcher to Student View -->
            <div class="pt-4 mt-4 border-t border-border">
              <div class="px-2.5 pb-1 text-[11px] font-semibold text-muted-foreground font-mono uppercase tracking-wider">
                Navigasi Cepat
              </div>
              <a 
                href="/dashboard"
                class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
              >
                <span class="w-4 text-center">🎓</span>
                <span>Buka Portal Siswa</span>
              </a>
            </div>

          </div>
        ) : (
          <div class="space-y-1">
            
            {/* Quick Switcher for Teachers when in Student Portal */}
            {isTeacherOrAdmin && (
              <div class="mb-3 pb-3 border-b border-border">
                <a 
                  href="/admin"
                  class="flex items-center justify-between px-2.5 py-2 rounded-md text-xs font-medium bg-amber-500/10 border border-amber-500/25 text-amber-500 dark:text-amber-400 hover:bg-amber-500/15 transition-colors"
                >
                  <div class="flex items-center gap-2">
                    <span>👑</span>
                    <span class="font-semibold">{isSuperAdminUser ? 'Super Admin Panel' : 'Panel Manajemen Guru'}</span>
                  </div>
                  <span class="text-[10px] font-mono">→</span>
                </a>
              </div>
            )}

            <div class="px-2.5 pb-1 text-[11px] font-semibold text-muted-foreground font-mono uppercase tracking-wider">
              Menu Pembelajaran
            </div>
            <div class="space-y-0.5">
              {studentNavItems.map((item) => {
                const isActive = currentPath === item.href || (item.href !== '/dashboard' && currentPath.startsWith(item.href));
                return (
                  <a 
                    href={item.href}
                    class:list={[
                      "flex items-center justify-between px-2.5 py-2 rounded-md text-xs font-medium transition-colors",
                      isActive 
                        ? "bg-primary/10 text-primary font-semibold border border-primary/20" 
                        : "text-muted-foreground hover:text-foreground hover:bg-accent"
                    ]}
                  >
                    <div class="flex items-center gap-2.5">
                      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                      </svg>
                      <span>{item.label}</span>
                    </div>
                    {item.badge && (
                      <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 font-semibold">
                        {item.badge}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- External Website Links -->
        <div class="pt-3 border-t border-border space-y-1">
          <div class="px-2.5 pb-1 text-[11px] font-semibold text-muted-foreground font-mono uppercase tracking-wider">
            Tautan Eksternal
          </div>
          <div class="space-y-0.5">
            <a 
              href="/"
              class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span>Portofolio Utama</span>
            </a>
            <a 
              href="/blog"
              class="flex items-center gap-2.5 px-2.5 py-2 rounded-md text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
            >
              <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <span>Artikel & Jurnal</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Bottom User Profile Card & Logout -->
      <div class="p-3 border-t border-border bg-card">
        <div class="flex items-center justify-between gap-2.5">
          <a href="/dashboard/profil" class="flex items-center gap-2.5 min-w-0 flex-1 hover:opacity-80 transition-opacity" title="Pengaturan Profil">
            <div class="w-8 h-8 rounded-md bg-secondary border border-border flex-shrink-0 flex items-center justify-center text-foreground font-mono font-bold text-xs">
              {user.name.substring(0, 2).toUpperCase()}
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-xs font-semibold text-foreground truncate">
                {user.name}
              </div>
              <div class="text-[11px] text-muted-foreground truncate">
                {sidebarRoleLabel}
              </div>
            </div>
          </a>
          
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="p-1.5 rounded-md text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors" title="Keluar">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          </form>
        </div>
      </div>

    </aside>

    <!-- RIGHT MAIN CONTENT WORKSPACE -->
    <div class="flex-1 flex flex-col min-w-0 lg:pl-64 min-h-screen bg-background pb-[calc(env(safe-area-inset-bottom)+5rem)] lg:pb-0">
      
      <!-- Top Application Header -->
      <header class="sticky top-0 z-30 w-full h-16 bg-background/95 border-b border-border flex items-center justify-between px-4 sm:px-6">
        
        <!-- Left: Mobile Toggle & Page Title -->
        <div class="flex items-center gap-3">
          <button id="open-sidebar-btn" class="lg:hidden p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" aria-label="Buka Menu Sidebar">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <div class="flex flex-col">
            <h1 class="text-sm sm:text-base font-semibold text-foreground tracking-tight flex items-center gap-2">
              <span>{title}</span>
              {isAdminRoute && (
                <span class="text-[10px] px-2 py-0.5 rounded-md font-mono font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/25">
                  {isSuperAdminUser ? 'Super Admin' : 'Guru Pengampu'}
                </span>
              )}
            </h1>
            <span class="text-[11px] text-muted-foreground hidden sm:block">SMKN 1 Rongga • PPLG Learning Management System</span>
          </div>
        </div>

        <!-- Right: Gamification Badge, Theme Switcher, Quick Profile Action -->
        <div class="flex items-center gap-2.5">
          
          <!-- Gamification XP / Level Chip -->
          <a href="/dashboard" class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-secondary border border-border text-xs font-mono font-semibold text-foreground hover:bg-accent transition-colors">
            <span class="text-amber-500">⚡</span>
            <span id="dashboard-xp-val" class="text-foreground">{stats.xp} XP</span>
            <span class="text-muted-foreground">·</span>
            <span id="dashboard-level-val" class="text-muted-foreground">Lvl {stats.level}</span>
          </a>

          <!-- Workspace Switcher Button in Header -->
          {isTeacherOrAdmin && (
            <a 
              href={isAdminRoute ? "/dashboard" : "/admin"} 
              class:list={[
                "hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-colors border",
                isAdminRoute 
                  ? "bg-secondary border-border text-foreground hover:bg-accent" 
                  : "bg-amber-500/10 border-amber-500/25 text-amber-600 dark:text-amber-400 hover:bg-amber-500/20"
              ]}
            >
              <span>{isAdminRoute ? '🎓 Portal Siswa' : '👨‍🏫 Panel Guru'}</span>
            </a>
          )}

          <!-- Quick Profile Button -->
          <a 
            href="/dashboard/profil" 
            class="p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors hidden sm:flex items-center justify-center" 
            title="Pengaturan Profil Saya"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </a>

          <!-- Dark/Light Theme Toggle -->
          <button 
            id="theme-toggle" 
            type="button" 
            class="p-2 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
            aria-label="Ganti Tema"
          >
            <svg id="sun-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="moon-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

        </div>

      </header>

      <!-- Main Slot Content -->
      <main class="flex-1 p-4 sm:p-6 max-w-7xl w-full mx-auto">
        <slot />
      </main>

      <!-- Minimal Footer -->
      <footer class="border-t border-border py-4 px-6 text-center text-xs text-muted-foreground hidden lg:block">
        <p>&copy; 2026 PPLG SMKN 1 Rongga • Dikembangkan oleh Agung Gumelar Saputra</p>
      </footer>

    </div>

    <!-- MOBILE BOTTOM NAVIGATION (STUDENTS ONLY) -->
    {!isAdminRoute && (
      <nav class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-background/95 backdrop-blur-md border-t border-border flex items-center justify-around pb-[env(safe-area-inset-bottom)] h-16 shadow-[0_-4px_20px_rgba(0,0,0,0.05)]">
        {[
          { href: '/dashboard', label: 'Ringkasan', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
          { href: '/pembelajaran', label: 'Modul', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
          { href: '/pembelajaran/tka-pplg', label: 'TKA', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' },
          { href: '/dashboard/profil', label: 'Profil', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' }
        ].map(item => {
          const isActive = currentPath === item.href || (item.href !== '/dashboard' && currentPath.startsWith(item.href));
          return (
            <a href={item.href} class="flex flex-col items-center justify-center w-full h-full space-y-1 relative group">
              <span class:list={["absolute -top-3 w-8 h-1 rounded-full transition-all", isActive ? "bg-primary opacity-100" : "opacity-0"]}></span>
              <svg class:list={["w-6 h-6 transition-colors", isActive ? "text-primary" : "text-muted-foreground group-hover:text-foreground"]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width={isActive ? "2.5" : "2"} d={item.icon} />
              </svg>
              <span class:list={["text-[10px] font-medium transition-colors", isActive ? "text-primary font-semibold" : "text-muted-foreground group-hover:text-foreground"]}>
                {item.label}
              </span>
            </a>
          );
        })}
      </nav>
    )}

    <!-- Interactive Client Scripts for Sidebar & XP Sync -->
    <script>
      import { getGamificationState } from '../utils/gamification';

      // Sidebar Mobile Toggle
      const openBtn = document.getElementById('open-sidebar-btn');
      const closeBtn = document.getElementById('close-sidebar-btn');
      const sidebar = document.getElementById('app-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');

      function toggleSidebar() {
        const isOpen = !sidebar?.classList.contains('-translate-x-full');
        if (isOpen) {
          sidebar?.classList.add('-translate-x-full');
          backdrop?.classList.add('hidden');
        } else {
          sidebar?.classList.remove('-translate-x-full');
          backdrop?.classList.remove('hidden');
        }
      }

      openBtn?.addEventListener('click', toggleSidebar);
      closeBtn?.addEventListener('click', toggleSidebar);
      backdrop?.addEventListener('click', toggleSidebar);

      // Dynamic Gamification Sync
      function syncGamification() {
        const state = getGamificationState();
        const xpEl = document.getElementById('dashboard-xp-val');
        const levelEl = document.getElementById('dashboard-level-val');
        if (xpEl && levelEl) {
          xpEl.textContent = `${state.xp} XP`;
          levelEl.textContent = `Lvl ${state.level}`;
        }
      }

      syncGamification();
      window.addEventListener('ags-xp-updated', syncGamification);

      // Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('sun-icon');
      const moonIcon = document.getElementById('moon-icon');

      function initTheme() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
        } else {
          moonIcon?.classList.remove('hidden');
          sunIcon?.classList.add('hidden');
        }
      }

      initTheme();

      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        initTheme();
      });
    </script>
  </body>
</html>
