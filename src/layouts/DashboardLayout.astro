---
import '../styles/global.css';
import { db } from '../db';
import { userGamification } from '../db/schema';
import { eq } from 'drizzle-orm';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { 
  title, 
  description = "Student & Teacher Learning Hub Dashboard PPLG SMKN 1 Rongga",
  activeNav = '/dashboard'
} = Astro.props;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

// Fetch live user gamification stats for header/sidebar
let [stats] = await db.select().from(userGamification).where(eq(userGamification.userId, user.userId)).limit(1);
if (!stats) {
  [stats] = await db.insert(userGamification).values({ userId: user.userId, xp: 0, level: 1 }).returning();
}

const currentPath = Astro.url.pathname;
const isAdmin = user.role === 'admin';
const isAdminRoute = currentPath.startsWith('/admin');

const studentNavItems = [
  { href: '/dashboard', label: 'Ringkasan Belajar', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/pembelajaran', label: 'Modul Pembelajaran', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { href: '/pembelajaran/tka-pplg', label: 'Drilling TKA PPLG', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z', badge: 'Tryout' },
  { href: '/dashboard/leaderboard', label: 'Papan Peringkat', icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6' },
  { href: '/dashboard/riwayat', label: 'Riwayat & Statistik', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
];

const adminNavItems = [
  { href: '/admin', label: 'Ringkasan & Metrik Kelas', icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { href: '/admin#students', label: 'Kelola Data & Role Siswa', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
  { href: '/admin#exams', label: 'Hasil Ujian & Nilai Siswa', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
];
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title} | PPLG Learning Hub</title>
    <meta name="title" content={`${title} | PPLG Learning Hub`} />
    <meta name="description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Theme Inline Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased flex selection:bg-blue-500/30 selection:text-blue-400">

    <!-- Backdrop Overlay for Mobile Drawer -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/60 z-40 lg:hidden hidden transition-opacity backdrop-blur-sm"></div>

    <!-- LEFT SIDEBAR NAVIGATION (Strict Portal Separation) -->
    <aside id="app-sidebar" class="fixed top-0 left-0 bottom-0 z-50 w-72 bg-card/95 backdrop-blur-xl border-r border-border/60 flex flex-col justify-between transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0">
      
      <!-- Top Brand Header -->
      <div class="p-5 border-b border-border/40">
        <div class="flex items-center justify-between">
          <a href={isAdminRoute ? "/admin" : "/dashboard"} class="flex items-center gap-3 group">
            {isAdminRoute ? (
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 via-orange-500 to-yellow-400 p-0.5 shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform flex items-center justify-center">
                <div class="w-full h-full bg-background rounded-[10px] flex items-center justify-center">
                  <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-yellow-300 font-extrabold text-sm">AGS</span>
                </div>
              </div>
              <div class="flex flex-col">
                <span class="font-extrabold text-sm tracking-tight text-foreground flex items-center gap-1.5">
                  Panel Guru
                  <span class="text-[9px] px-1.5 py-0.5 rounded-full font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">ADMIN</span>
                </span>
                <span class="text-[11px] text-muted-foreground font-medium">SMKN 1 Rongga • Manajemen</span>
              </div>
            ) : (
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 via-indigo-500 to-cyan-400 p-0.5 shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform flex items-center justify-center">
                <div class="w-full h-full bg-background rounded-[10px] flex items-center justify-center">
                  <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300 font-extrabold text-sm">AGS</span>
                </div>
              </div>
              <div class="flex flex-col">
                <span class="font-extrabold text-sm tracking-tight text-foreground flex items-center gap-1.5">
                  Learning Hub
                  <span class="text-[9px] px-1.5 py-0.5 rounded-full font-mono font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30">PPLG</span>
                </span>
                <span class="text-[11px] text-muted-foreground font-medium">SMKN 1 Rongga • Siswa</span>
              </div>
            )}
          </a>
          <button id="close-sidebar-btn" class="lg:hidden p-1.5 rounded-lg text-muted-foreground hover:bg-accent">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Main Navigation Menu -->
      <div class="flex-1 overflow-y-auto px-4 py-5 space-y-6">
        
        {isAdminRoute ? (
          <div class="space-y-1.5">
            <span class="px-3 text-[10px] font-bold uppercase tracking-wider text-amber-400 font-mono flex items-center gap-1.5">
              <span>🛡️ Menu Manajemen Guru</span>
            </span>
            <div class="space-y-1 pt-1">
              {adminNavItems.map((item) => {
                const isActive = currentPath === item.href || (item.href === '/admin' && currentPath === '/admin');
                return (
                  <a 
                    href={item.href}
                    class:list={[
                      "flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-semibold transition-all group",
                      isActive 
                        ? "bg-amber-500/15 text-amber-400 border border-amber-500/30 shadow-sm" 
                        : "text-muted-foreground hover:text-foreground hover:bg-accent/60"
                    ]}
                  >
                    <div class="flex items-center gap-3">
                      <svg class:list={["w-4 h-4 transition-colors", isActive ? "text-amber-400" : "text-muted-foreground group-hover:text-foreground"]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                      </svg>
                      <span>{item.label}</span>
                    </div>
                  </a>
                );
              })}
            </div>

            <!-- Portal Mode Switcher to Student View -->
            <div class="pt-5 mt-5 border-t border-border/40">
              <span class="px-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground font-mono">
                Beralih Workspace
              </span>
              <div class="pt-2">
                <a 
                  href="/dashboard"
                  class="flex items-center gap-3 p-3 rounded-xl bg-gradient-to-r from-blue-500/10 to-indigo-500/10 border border-blue-500/30 hover:border-blue-500/60 hover:bg-blue-500/15 transition-all group"
                >
                  <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                    🎓
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="text-xs font-bold text-blue-400 group-hover:text-blue-300">Buka Portal Siswa</div>
                    <div class="text-[10px] text-muted-foreground truncate">Mode belajar & tryout siswa</div>
                  </div>
                  <svg class="w-4 h-4 text-blue-400/60 group-hover:text-blue-400 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        ) : (
          <div class="space-y-1.5">
            
            {/* Quick Switcher for Teachers when in Student Portal */}
            {isAdmin && (
              <div class="mb-4 pb-4 border-b border-border/40">
                <a 
                  href="/admin"
                  class="flex items-center gap-3 p-3 rounded-xl bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-amber-500/5 border border-amber-500/30 hover:border-amber-500/60 hover:bg-amber-500/15 transition-all group"
                >
                  <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                    👑
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="text-xs font-bold text-amber-400 group-hover:text-amber-300">Mode Guru Aktif</div>
                    <div class="text-[10px] text-muted-foreground truncate">Buka Panel Manajemen →</div>
                  </div>
                  <svg class="w-4 h-4 text-amber-400/60 group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            )}

            <span class="px-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground font-mono">
              Portal Belajar Siswa
            </span>
            <div class="space-y-1 pt-1">
              {studentNavItems.map((item) => {
                const isActive = currentPath === item.href || (item.href !== '/dashboard' && currentPath.startsWith(item.href));
                return (
                  <a 
                    href={item.href}
                    class:list={[
                      "flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-semibold transition-all group",
                      isActive 
                        ? "bg-blue-600/15 text-blue-400 border border-blue-500/30 shadow-sm" 
                        : "text-muted-foreground hover:text-foreground hover:bg-accent/60"
                    ]}
                  >
                    <div class="flex items-center gap-3">
                      <svg class:list={["w-4 h-4 transition-colors", isActive ? "text-blue-400" : "text-muted-foreground group-hover:text-foreground"]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                      </svg>
                      <span>{item.label}</span>
                    </div>
                    {item.badge && (
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
                        {item.badge}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- External Website Links -->
        <div class="space-y-1.5 pt-2 border-t border-border/40">
          <span class="px-3 text-[10px] font-bold uppercase tracking-wider text-muted-foreground font-mono">
            Website Guru
          </span>
          <div class="space-y-1 pt-1">
            <a 
              href="/"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-all"
            >
              <svg class="w-4 h-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span>Kembali ke Portofolio Web</span>
            </a>
            <a 
              href="/blog"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-accent/60 transition-all"
            >
              <svg class="w-4 h-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <span>Artikel & Blog</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Bottom User Profile Card & Logout -->
      <div class="p-4 border-t border-border/40 bg-accent/20">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class={isAdminRoute ? "w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-600 to-yellow-400 p-0.5 flex-shrink-0 flex items-center justify-center text-white font-bold text-xs shadow" : "w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-cyan-400 p-0.5 flex-shrink-0 flex items-center justify-center text-white font-bold text-xs shadow"}>
              {user.name.substring(0, 2).toUpperCase()}
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-xs font-bold text-foreground truncate">{user.name}</div>
              <div class="flex items-center gap-1.5">
                <span class:list={[
                  "text-[9px] px-1.5 py-0.2 rounded font-mono font-bold uppercase",
                  isAdmin ? "bg-amber-500/20 text-amber-300 border border-amber-500/30" : "bg-blue-500/20 text-blue-400 border border-blue-500/30"
                ]}>
                  {isAdmin ? 'Guru / Admin' : 'Siswa PPLG'}
                </span>
                <span class="text-[10px] text-muted-foreground truncate">{user.email}</span>
              </div>
            </div>
          </div>
          
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="p-2 rounded-lg text-muted-foreground hover:text-red-400 hover:bg-red-500/10 transition-colors" title="Keluar / Logout">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          </form>
        </div>
      </div>

    </aside>

    <!-- RIGHT MAIN CONTENT WORKSPACE -->
    <div class="flex-1 flex flex-col min-w-0 lg:pl-72 min-h-screen bg-background">
      
      <!-- Top Application Header -->
      <header class="sticky top-0 z-30 w-full h-16 bg-background/85 backdrop-blur-md border-b border-border/40 flex items-center justify-between px-4 sm:px-8">
        
        <!-- Left: Mobile Toggle & Page Title -->
        <div class="flex items-center gap-3">
          <button id="open-sidebar-btn" class="lg:hidden p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" aria-label="Buka Menu Sidebar">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <div class="flex flex-col">
            <h1 class="text-sm sm:text-base font-bold text-foreground tracking-tight flex items-center gap-2">
              <span>{title}</span>
              {isAdminRoute && (
                <span class="text-[10px] px-2 py-0.5 rounded-full font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                  ADMIN CONSOLE
                </span>
              )}
            </h1>
            <span class="text-[10px] text-muted-foreground hidden sm:block">SMKN 1 Rongga • PPLG Learning Management System</span>
          </div>
        </div>

        <!-- Right: Real-time Gamification Badge, Theme Switcher, Quick Profile Action -->
        <div class="flex items-center gap-3">
          
          <!-- Live Gamification Badge -->
          <a href="/dashboard" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-gradient-to-r from-amber-500/10 via-emerald-500/10 to-blue-500/10 border border-amber-500/30 text-xs font-medium text-amber-400 hover:scale-105 transition-transform shadow-sm">
            <span class="animate-pulse">⚡</span>
            <span id="dashboard-xp-val" class="font-bold font-mono text-amber-400">{stats.xp} XP</span>
            <span class="text-muted-foreground text-[10px]">|</span>
            <span id="dashboard-level-val" class="font-bold font-mono text-emerald-400">Lvl {stats.level}</span>
          </a>

          <!-- Workspace Switcher Button in Header -->
          {isAdmin && (
            <a 
              href={isAdminRoute ? "/dashboard" : "/admin"} 
              class:list={[
                "hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-semibold transition-all border shadow-sm",
                isAdminRoute 
                  ? "bg-blue-500/10 border-blue-500/30 text-blue-400 hover:bg-blue-500/20" 
                  : "bg-amber-500/10 border-amber-500/30 text-amber-300 hover:bg-amber-500/20"
              ]}
            >
              <span>{isAdminRoute ? '🎓 Buka Portal Siswa' : '👑 Panel Guru'}</span>
            </a>
          )}

          <!-- Dark/Light Theme Toggle -->
          <button 
            id="theme-toggle" 
            type="button" 
            class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
            aria-label="Toggle theme"
          >
            <svg id="sun-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="moon-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

        </div>

      </header>

      <!-- Main Slot Content -->
      <main class="flex-1 p-4 sm:p-8 max-w-7xl w-full mx-auto">
        <slot />
      </main>

      <!-- Minimal LMS Footer -->
      <footer class="border-t border-border/40 py-6 px-8 text-center text-xs text-muted-foreground">
        <p>&copy; 2026 PPLG SMKN 1 Rongga • Dikembangkan oleh Agung Gumelar Saputra, S.Pd.</p>
      </footer>

    </div>

    <!-- Interactive Client Scripts for Sidebar & XP Sync -->
    <script>
      import { getGamificationState } from '../utils/gamification';

      // Sidebar Mobile Toggle
      const openBtn = document.getElementById('open-sidebar-btn');
      const closeBtn = document.getElementById('close-sidebar-btn');
      const sidebar = document.getElementById('app-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');

      function toggleSidebar() {
        const isOpen = !sidebar?.classList.contains('-translate-x-full');
        if (isOpen) {
          sidebar?.classList.add('-translate-x-full');
          backdrop?.classList.add('hidden');
        } else {
          sidebar?.classList.remove('-translate-x-full');
          backdrop?.classList.remove('hidden');
        }
      }

      openBtn?.addEventListener('click', toggleSidebar);
      closeBtn?.addEventListener('click', toggleSidebar);
      backdrop?.addEventListener('click', toggleSidebar);

      // Dynamic Gamification Sync
      function syncGamification() {
        const state = getGamificationState();
        const xpEl = document.getElementById('dashboard-xp-val');
        const levelEl = document.getElementById('dashboard-level-val');
        if (xpEl && levelEl) {
          xpEl.textContent = `${state.xp} XP`;
          levelEl.textContent = `Lvl ${state.level}`;
        }
      }

      syncGamification();
      window.addEventListener('ags-xp-updated', syncGamification);

      // Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('sun-icon');
      const moonIcon = document.getElementById('moon-icon');

      function initTheme() {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
        } else {
          moonIcon?.classList.remove('hidden');
          sunIcon?.classList.add('hidden');
        }
      }

      initTheme();

      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        initTheme();
      });
    </script>
  </body>
</html>
