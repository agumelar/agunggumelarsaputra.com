---
interface Props {
  lessonSlug: string;
  moduleTitle: string;
  user: any;
}

const { lessonSlug, moduleTitle, user } = Astro.props;
---

<div class="card p-6 md:p-8 rounded-2xl border-border bg-card shadow-sm space-y-6" id="general-lkpd-card" data-slug={lessonSlug}>
  
  <!-- Header LKPD -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-5">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 text-[11px] font-mono font-bold uppercase">
          LEMBAR KERJA PESERTA DIDIK (LKPD)
        </span>
        <span class="px-2.5 py-0.5 rounded bg-secondary text-foreground text-[11px] font-mono font-semibold border border-border">
          FORMULIR INTERAKTIF
        </span>
      </div>
      <h2 class="text-xl md:text-2xl font-extrabold text-foreground tracking-tight">
        Lembar Kerja: {moduleTitle}
      </h2>
      <p class="text-xs text-muted-foreground">
        Kerjakan aktivitas pembelajaran ini secara langsung. Jawaban Anda akan tersimpan otomatis ke database portofolio.
      </p>
    </div>

    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
        ✨ Reward: +25 XP
      </span>
      <span id="gen-lkpd-status" class="text-[11px] font-mono text-muted-foreground px-2 py-1 bg-secondary rounded border border-border">
        Belum Disimpan
      </span>
    </div>
  </div>

  <!-- Dynamic Teacher Grade & Feedback Card -->
  <div id="gen-teacher-grade-card" class="hidden p-5 rounded-2xl bg-gradient-to-r from-amber-500/10 via-primary/10 to-purple-500/10 border-2 border-primary/30 space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-primary/20 pb-3">
      <div class="flex items-center gap-2">
        <span class="text-xl">🏆</span>
        <div>
          <span class="text-xs font-mono font-bold text-primary uppercase tracking-wider">Hasil Penilaian Guru</span>
          <h3 class="text-base font-extrabold text-foreground">Evaluasi Lembar Kerja LKPD</h3>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span id="gen-display-teacher-level" class="px-2.5 py-1 rounded-lg bg-primary text-primary-foreground font-mono text-xs font-bold">
          Level 2 (Mencoba ★)
        </span>
        <span id="gen-display-teacher-score" class="px-3 py-1 rounded-lg bg-amber-500 text-black font-mono text-xs font-extrabold">
          Nilai: 85 / 100
        </span>
      </div>
    </div>

    <div class="space-y-1.5 text-xs">
      <div class="text-muted-foreground font-semibold flex items-center gap-1.5">
        <span>👨‍🏫 Catatan & Masukan Evaluasi Guru:</span>
      </div>
      <div id="gen-display-teacher-feedback" class="p-3.5 rounded-xl bg-card border border-border text-foreground leading-relaxed italic">
        "Telah dinilai oleh Guru."
      </div>
      <div class="text-[11px] text-muted-foreground font-mono flex items-center justify-between pt-1">
        <span id="gen-display-graded-date">🕒 Dinilai pada: -</span>
        <span class="text-primary font-semibold">Pengampu: Agung Gumelar Saputra, S.Tr.T.</span>
      </div>
    </div>
  </div>

  <form id="form-general-lkpd" class="space-y-8">
    
    <!-- Identitas Siswa -->
    <div class="space-y-4 p-5 rounded-xl bg-secondary/30 border border-border">
      <h3 class="text-sm font-bold text-foreground font-mono flex items-center gap-2">
        <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">A</span>
        IDENTITAS PESERTA DIDIK
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Nama Lengkap</label>
          <input 
            type="text" 
            name="studentName" 
            id="gen_studentName"
            value={user?.name || ''} 
            required 
            placeholder="Nama lengkap siswa"
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">NIS / NISN</label>
          <input 
            type="text" 
            name="studentNis" 
            id="gen_studentNis"
            required 
            placeholder="Contoh: 262710001"
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Kelas</label>
          <select 
            name="studentClass" 
            id="gen_studentClass"
            required
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
          >
            <option value="10 RPL 1">10 RPL 1</option>
            <option value="10 RPL 2">10 RPL 2</option>
            <option value="10 RPL 3">10 RPL 3</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Tanggal Pengerjaan</label>
          <input 
            type="date" 
            name="submissionDate" 
            id="gen_submissionDate"
            required 
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono"
          />
        </div>
      </div>
    </div>

    <!-- Aktivitas LKPD Utama -->
    <div class="space-y-4">
      <h3 class="text-sm font-bold text-foreground font-mono flex items-center gap-2">
        <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">B</span>
        HASIL ANALISIS & LAPORAN AKTIVITAS
      </h3>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">
            1. Ringkasan Temuan / Analisis Tugas Materi:
          </label>
          <textarea 
            name="analysisSummary" 
            id="gen_analysisSummary"
            rows="4" 
            required
            placeholder="Tuliskan temuan analisis, hasil eksplorasi, atau ringkasan tugas sesuai petunjuk modul ini..."
            class="w-full px-3.5 py-2.5 rounded-xl bg-secondary/30 border border-border text-xs text-foreground focus:outline-none focus:border-primary leading-relaxed"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">
            2. Bukti Karya / Evidence Tautan Google Drive atau Repository (Opsional):
          </label>
          <input 
            type="url" 
            name="driveUrl" 
            id="gen_driveUrl"
            placeholder="https://drive.google.com/... atau https://github.com/..." 
            class="w-full px-3 py-2.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono"
          />
          <p class="text-[11px] text-muted-foreground mt-1">
            💡 Tautan file bukti karya bersifat opsional untuk sekarang dan dapat dilengkapi menjelang akhir semester.
          </p>
        </div>
      </div>
    </div>

    <!-- Tombol Simpan & Submit -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-border">
      <div class="text-xs text-muted-foreground">
        💡 <em>Jawaban akan langsung tersimpan dan tercatat di dashboard guru.</em>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button 
          type="button" 
          id="btn-gen-save-draft" 
          class="btn btn-secondary text-xs font-semibold px-4 py-2.5 rounded-lg border border-border hover:bg-secondary w-full sm:w-auto"
        >
          💾 Simpan Draf
        </button>

        <button 
          type="submit" 
          id="btn-gen-submit-lkpd" 
          class="btn btn-primary text-xs font-semibold px-6 py-2.5 rounded-lg w-full sm:w-auto flex items-center justify-center gap-2"
        >
          <span>🚀 Kirim LKPD (+25 XP)</span>
        </button>
      </div>
    </div>

  </form>
</div>

<script>
  const genCardEl = document.getElementById('general-lkpd-card');
  const genSlug = genCardEl?.getAttribute('data-slug') || '';
  const genForm = document.getElementById('form-general-lkpd') as HTMLFormElement;
  const genStatusEl = document.getElementById('gen-lkpd-status');
  const genSaveDraftBtn = document.getElementById('btn-gen-save-draft');
  const dateInput = document.getElementById('gen_submissionDate') as HTMLInputElement;

  const teacherGradeCard = document.getElementById('gen-teacher-grade-card');
  const displayScore = document.getElementById('gen-display-teacher-score');
  const displayLevel = document.getElementById('gen-display-teacher-level');
  const displayFeedback = document.getElementById('gen-display-teacher-feedback');
  const displayGradedDate = document.getElementById('gen-display-graded-date');

  if (dateInput && !dateInput.value) {
    dateInput.value = new Date().toISOString().split('T')[0];
  }

  async function loadExistingGenSubmission() {
    try {
      const res = await fetch(`/api/submissions/get?slug=${encodeURIComponent(genSlug)}`);
      const data = await res.json();
      if (data.success && data.submissions) {
        const lkpdSub = data.submissions.find((s: any) => s.submissionType === 'lkpd');
        if (lkpdSub && lkpdSub.formData) {
          const formPayload = lkpdSub.formData;
          if (formPayload.studentName) (document.getElementById('gen_studentName') as HTMLInputElement).value = formPayload.studentName;
          if (formPayload.studentNis) (document.getElementById('gen_studentNis') as HTMLInputElement).value = formPayload.studentNis;
          if (formPayload.studentClass) (document.getElementById('gen_studentClass') as HTMLSelectElement).value = formPayload.studentClass;
          if (formPayload.submissionDate) (document.getElementById('gen_submissionDate') as HTMLInputElement).value = formPayload.submissionDate;
          if (formPayload.analysisSummary) (document.getElementById('gen_analysisSummary') as HTMLTextAreaElement).value = formPayload.analysisSummary;
          if (lkpdSub.driveUrl) (document.getElementById('gen_driveUrl') as HTMLInputElement).value = lkpdSub.driveUrl;

          // Check if Graded
          if (lkpdSub.teacherScore !== null && lkpdSub.teacherScore !== undefined) {
            if (teacherGradeCard) teacherGradeCard.classList.remove('hidden');
            if (displayScore) displayScore.textContent = `Nilai Guru: ${lkpdSub.teacherScore} / 100`;
            if (displayLevel) displayLevel.textContent = lkpdSub.teacherLevel || 'Level 2 (Mencoba ★)';
            if (displayFeedback) displayFeedback.textContent = lkpdSub.teacherFeedback || 'Telah dinilai oleh Guru.';
            if (displayGradedDate && lkpdSub.gradedAt) {
              const formattedDate = new Date(lkpdSub.gradedAt).toLocaleDateString('id-ID', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              });
              displayGradedDate.textContent = `🕒 Dinilai pada: ${formattedDate}`;
            }

            if (genStatusEl) {
              genStatusEl.className = 'text-[11px] font-mono px-2 py-1 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded border border-amber-500/20 font-bold';
              genStatusEl.textContent = `⭐ Dinilai: ${lkpdSub.teacherScore}/100`;
            }
          } else if (genStatusEl) {
            genStatusEl.className = 'text-[11px] font-mono px-2 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-semibold';
            genStatusEl.textContent = '✅ LKPD Terkumpul';
          }
        }
      }
    } catch (e) {
      console.warn('Failed to load existing submission:', e);
    }
  }

  loadExistingGenSubmission();

  async function submitGenLkpd(isDraft = false) {
    const studentName = (document.getElementById('gen_studentName') as HTMLInputElement).value;
    const studentNis = (document.getElementById('gen_studentNis') as HTMLInputElement).value;
    const studentClass = (document.getElementById('gen_studentClass') as HTMLSelectElement).value;
    const submissionDate = (document.getElementById('gen_submissionDate') as HTMLInputElement).value;
    const analysisSummary = (document.getElementById('gen_analysisSummary') as HTMLTextAreaElement).value;
    const driveUrl = (document.getElementById('gen_driveUrl') as HTMLInputElement).value;

    const payload = {
      studentName,
      studentNis,
      studentClass,
      submissionDate,
      analysisSummary,
      driveUrl,
    };

    const activeTokenId = localStorage.getItem('ags_active_token_id');
    if (genStatusEl) genStatusEl.textContent = 'Menyimpan...';

    try {
      const res = await fetch('/api/submissions/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lessonSlug: genSlug,
          submissionType: 'lkpd',
          formData: payload,
          driveUrl,
          tokenId: activeTokenId ? Number(activeTokenId) : null,
        }),
      });

      const data = await res.json();
      if (data.success) {
        if (genStatusEl) {
          genStatusEl.className = 'text-[11px] font-mono px-2 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-semibold';
          genStatusEl.textContent = isDraft ? '💾 Draf Tersimpan' : '✅ LKPD Terkumpul (+25 XP)';
        }
        alert(data.message || 'Jawaban LKPD berhasil disimpan!');
      } else {
        alert(data.error || 'Gagal menyimpan LKPD.');
      }
    } catch (e) {
      alert('Terjadi kesalahan jaringan.');
    }
  }

  genSaveDraftBtn?.addEventListener('click', () => submitGenLkpd(true));

  genForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitGenLkpd(false);
  });
</script>
