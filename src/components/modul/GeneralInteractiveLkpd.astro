---
import { getOrientasiLkpdSchema } from '../../utils/orientasiLkpdSchemas.ts';
import { isCanonicalOrientasiSlug } from '../../utils/orientasiPplgPolicy.ts';

interface Props {
  lessonSlug: string;
  moduleTitle: string;
  user: any;
}

const { lessonSlug, moduleTitle, user } = Astro.props;
const lkpdSchema = isCanonicalOrientasiSlug(lessonSlug) && !lessonSlug.startsWith('orientasi-pplg-01-')
  ? getOrientasiLkpdSchema(lessonSlug)
  : null;

const MODULE_LKPD_GUIDES: Record<string, { prompt: string; placeholder: string; tip?: string }> = {
  'orientasi-pplg-02-profesi-peluang-karier': {
    prompt: '1. Analisis Profil Profesi & Peran Tim Software Pilihan:',
    placeholder: 'Uraikan 1 profesi PPLG yang paling kalian minati (tanggung jawab kerja, tech stack esensial, dan bagaimana peran tersebut berkolaborasi dengan profesi lain dalam siklus Agile)...',
    tip: '💡 Petunjuk: Sertakan alasan pemilihan dan target keterampilan (hard skill & soft skill) yang ingin diasah.'
  },
  'orientasi-pplg-03-ekosistem-industri-pplg': {
    prompt: '1. Analisis Komparasi Model Bisnis Ekosistem Software:',
    placeholder: 'Bandingkan karakteristik Software House vs Product Company/SaaS. Jelaskan model bisnis yang diterapkan serta kelebihan dan tantangan bekerja di model tersebut...',
    tip: '💡 Petunjuk: Ambil contoh studi kasus aplikasi riil yang kalian kenal (misal: SaaS, Software House agensi, atau Open Source).'
  },
  'orientasi-pplg-04-matriks-skill-jenjang-karier': {
    prompt: '1. Pemetaan Matriks Skill T-Shaped & Target Jenjang Karier:',
    placeholder: 'Petakan keahlian T-Shaped pribadi kalian: keahlian spesialis mendalam (vertikal) yang ingin dicapai, dan wawasan lintas disiplin (horizontal) untuk kolaborasi tim...',
    tip: '💡 Petunjuk: Uraikan perbedaan tanggung jawab antara level Junior, Mid-Level, dan Senior/Tech Lead.'
  },
  'orientasi-pplg-05-job-fair-kelas': {
    prompt: '1. Catatan Kunjungan Booth Job Fair & Elevator Pitch Diri:',
    placeholder: 'Tuliskan rangkuman hasil wawancara minimal ke 2 booth profesi lain (rentang gaji riil, tech stack, tantangan) serta naskah Elevator Pitch 30-60 detik profil keahlian diri...',
    tip: '💡 Petunjuk: Tunjukkan rasa percaya diri dalam mengomunikasikan kesiapan belajar dan keunggulan diri.'
  },
  'orientasi-pplg-06-rencana-minat-awal': {
    prompt: '1. Rencana Minat Belajar & Target SMART Goal Portofolio:',
    placeholder: 'Rumuskan target belajar coding semester ini menggunakan metode SMART (Specific, Measurable, Achievable, Relevant, Time-bound) pada jalur peminatan yang kalian pilih...',
    tip: '💡 Petunjuk: Buat target yang realistis dengan batas waktu jelas (contoh: 1 website portofolio dalam 1 bulan).'
  },
  'orientasi-pplg-07-mind-map-profesi-pplg': {
    prompt: '1. Deskripsi Arsitektur & Cabang Utama Mind Map Profesi:',
    placeholder: 'Jelaskan cabang-cabang utama diagram Mind Map yang kalian buat (profesi inti, bahasa/framework, dan relasi kerja). Lampirkan file/tautan gambar diagram pada kolom evidence...',
    tip: '💡 Petunjuk: Jelaskan alasan pemilihan cabang dan relasi kolaborasi antar peran.'
  },
  'orientasi-pplg-08-finalisasi-validasi-or01': {
    prompt: '1. Rangkuman Kesiapan Asesmen Sumatif & Audit Portofolio OR-01:',
    placeholder: 'Verifikasi checklist kelengkapan seluruh LKPD P1 s/d P7, pastikan folder Google Drive publik (Viewer), dan refleksikan pencapaian kompetensi menuju standar Level 2 (KKM 73)...',
    tip: '💡 Petunjuk: Pastikan tidak ada tautan bukti yang rusak atau berstatus Request Access.'
  },
  'orientasi-pplg-09-app-audit-produk-digital': {
    prompt: '1. Laporan Temuan App Audit & Uji Kualitas Produk Digital:',
    placeholder: 'Tentukan 1 aplikasi yang diaudit. Uraikan hasil pengujian aspek Usability (UX), Performa respon aplikasi, dan keandalan sistem saat menangani kondisi error...',
    tip: '💡 Petunjuk: Tuliskan temuan secara objektif berdasarkan pengalaman penggunaan langsung (User Journey).'
  },
  'orientasi-pplg-10-ui-ux-fungsi-produk': {
    prompt: '1. Analisis Komparasi UI vs UX & Evaluasi Desain Komponen:',
    placeholder: 'Bedah antarmuka visual (UI: konsistensi warna, tipografi, icon) dan kenyamanan interaksi (UX: kecepatan navigasi, kemudahan mencapai tujuan) pada aplikasi pilihan...',
    tip: '💡 Petunjuk: Terapkan prinsip konsistensi dan standar Design System industri.'
  },
  'orientasi-pplg-11-framework-review-6-komponen': {
    prompt: '1. Laporan Analisis Framework Review 6 Komponen Aplikasi:',
    placeholder: 'Uraikan hasil evaluasi terstruktur: (1) Profil Produk & Target User, (2) UI/UX, (3) Analisis Fitur Utama, (4) Kinerja & Stabilitas, (5) Aksesibilitas, dan (6) Rekomendasi Solusi Engineering...',
    tip: '💡 Petunjuk: Dukung setiap poin evaluasi dengan argumen teknis yang logis.'
  },
  'orientasi-pplg-12-latihan-analisis-anotasi-visual': {
    prompt: '1. Catatan Rekayasa Anotasi Visual & Deskripsi Screenshot:',
    placeholder: 'Jelaskan temuan kritis pada tangkapan layar (screenshot) beranotasi: kotak merah (bug/kendala UX), kotak hijau (keunggulan fitur), beserta deskripsi dampak bagi pengguna...',
    tip: '💡 Petunjuk: Unggah berkas gambar screenshot beranotasi ke Google Drive portofolio.'
  },
  'orientasi-pplg-13-review-show-peer-feedback': {
    prompt: '1. Log Evaluasi Peer Review Show & Catatan Umpan Balik:',
    placeholder: 'Tuliskan masukan konstruktif yang kalian berikan kepada kelompok lain (metode Sandwich Feedback: Pujian -> Masukan Perbaikan -> Semangat) serta saran yang diterima dari rekan...',
    tip: '💡 Petunjuk: Tunjukkan etika profesional dan keterbukaan dalam menerima kritik teknis.'
  },
  'orientasi-pplg-14-finalisasi-dokumen-review': {
    prompt: '1. Ringkasan Eksekutif (Executive Summary) Laporan Dokumen Review:',
    placeholder: 'Tuliskan Executive Summary laporan audit produk: skor total, daftar temuan prioritas utama (High Severity), dan usulan perbaikan fitur mendesak dari sudut pandang software engineer...',
    tip: '💡 Petunjuk: Gunakan gaya bahasa ringkas, padat, dan berorientasi solusi praktis.'
  },
  'orientasi-pplg-15-pengumpulan-validasi-or02': {
    prompt: '1. Checklist Validasi Asesmen Sumatif OR-02 & Berkas Portofolio:',
    placeholder: 'Verifikasi kelengkapan dokumen PDF review produk 6 komponen, pastikan bukti visual terlampir rapi, dan tautan Google Drive siap diuji asesor untuk penilaian Level 2 (KKM 73)...',
    tip: '💡 Petunjuk: Pastikan penamaan berkas PDF sesuai standar pengumpulan resmi.'
  },
  'orientasi-pplg-16-rekap-skill-clinic-refleksi': {
    prompt: '1. Rekapitulasi Portofolio Semester & Evaluasi Sesi Skill Clinic:',
    placeholder: 'Tuliskan rekap capaian seluruh modul Orientasi PPLG (Sprint 1 OR-01 & Sprint 2 OR-02), solusi atas kendala yang dibahas saat Skill Clinic, dan kesiapan melangkah ke materi kejuruan lanjutan...',
    tip: '💡 Petunjuk: Refleksikan transformasi integritas dan kematangan pola pikir belajar kalian.'
  },
  'pengenalan-html5-smk': {
    prompt: '1. Laporan Praktikum Struktur Semantik HTML5 & Kode Proyek:',
    placeholder: 'Tuliskan penjelasan struktur halaman HTML5 yang kalian rancang (penggunaan header, main, section, footer) serta ringkasan logika dokumen...',
    tip: '💡 Petunjuk: Lampirkan link repositori GitHub / file HTML pada kolom tautan evidence.'
  },
  'dasar-basis-data-sql': {
    prompt: '1. Laporan Desain Tabel Relasional & Eksekusi Query SQL:',
    placeholder: 'Uraikan skema tabel yang dirancang (nama tabel, primary key, foreign key) beserta perintah query SELECT, INSERT, UPDATE, atau DELETE yang diuji...',
    tip: '💡 Petunjuk: Jelaskan mengapa relasi antar-tabel tersebut dibutuhkan dalam aplikasi.'
  },
  'konsep-oop-javascript': {
    prompt: '1. Laporan Implementasi Paradigma OOP (Class & Object):',
    placeholder: 'Jelaskan Class yang kalian buat, atribut (properties), method, serta implementasi konsep inheritance (pewarisan) atau encapsulation yang diterapkan...',
    tip: '💡 Petunjuk: Sertakan cuplikan kode program atau link repo pada bukti karya.'
  }
};

const lkpdGuide = MODULE_LKPD_GUIDES[lessonSlug] || {
  prompt: `1. Ringkasan Temuan & Laporan Analisis Tugas "${moduleTitle}":`,
  placeholder: `Tuliskan temuan analisis, hasil eksplorasi, atau ringkasan tugas sesuai petunjuk modul "${moduleTitle}" (wajib diketik sendiri secara mandiri)...`,
  tip: '💡 Petunjuk: Jawab dengan jujur dan orisinal untuk mengasah pemahaman konsep.'
};
---

<div class="card p-6 md:p-8 rounded-2xl border-border bg-card shadow-sm space-y-6" id="general-lkpd-card" data-slug={lessonSlug}>
  
  <!-- Header LKPD -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-5">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 text-[11px] font-mono font-bold uppercase">
          LEMBAR KERJA PESERTA DIDIK (LKPD)
        </span>
        <span class="px-2.5 py-0.5 rounded bg-secondary text-foreground text-[11px] font-mono font-semibold border border-border">
          FORMULIR INTERAKTIF
        </span>
      </div>
      <h2 class="text-xl md:text-2xl font-extrabold text-foreground tracking-tight">
        Lembar Kerja: {moduleTitle}
      </h2>
      <p class="text-xs text-muted-foreground">
        Kerjakan aktivitas pembelajaran ini secara langsung. Jawaban Anda akan tersimpan otomatis ke database portofolio.
      </p>
    </div>

    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
        ✨ Reward: +25 XP
      </span>
      <span id="gen-lkpd-status" class="text-[11px] font-mono text-muted-foreground px-2 py-1 bg-secondary rounded border border-border">
        Belum Disimpan
      </span>
    </div>
  </div>

  <!-- Dynamic Teacher Grade & Feedback Card -->
  <div id="gen-teacher-grade-card" class="hidden p-5 rounded-2xl border-2 space-y-3 transition-all">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b pb-3" id="gen-teacher-grade-header-border">
      <div class="flex items-center gap-2">
        <span class="text-xl" id="gen-teacher-grade-icon">🏆</span>
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider" id="gen-teacher-grade-tag">Hasil Penilaian Guru</span>
          <h3 class="text-base font-extrabold text-foreground" id="gen-teacher-grade-title">Evaluasi Lembar Kerja LKPD</h3>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span id="gen-display-teacher-level" class="px-2.5 py-1 rounded-lg bg-primary text-primary-foreground font-mono text-xs font-bold">
          Level 2 (Mencoba ★)
        </span>
        <span id="gen-display-teacher-score" class="px-3 py-1 rounded-lg font-mono text-xs font-extrabold">
          Nilai: 85 / 100
        </span>
      </div>
    </div>

    <div class="space-y-1.5 text-xs">
      <div class="text-muted-foreground font-semibold flex items-center gap-1.5">
        <span>👨‍🏫 Catatan & Masukan Evaluasi Guru:</span>
      </div>
      <div id="gen-display-teacher-feedback" class="p-3.5 rounded-xl bg-card border border-border text-foreground leading-relaxed italic">
        "Telah dinilai oleh Guru."
      </div>
      <div class="text-[11px] text-muted-foreground font-mono flex items-center justify-between pt-1">
        <span id="gen-display-graded-date">🕒 Dinilai pada: -</span>
        <span class="text-primary font-semibold">Pengampu: Agung Gumelar Saputra, S.Tr.T.</span>
      </div>
    </div>

    <!-- Status Alert Notice: Lock vs Remedial -->
    <div id="gen-teacher-lock-notice" class="hidden p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-medium flex items-center gap-2.5">
      <span class="text-lg">🔒</span>
      <div>
        <strong class="font-bold">Lembar Kerja Terkunci:</strong> Nilai Anda telah memenuhi KKM (Minimal 73). Isian lembar kerja ini telah dikunci sebagai bukti portofolio pembelajaran resmi.
      </div>
    </div>

    <div id="gen-teacher-remedial-notice" class="hidden p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-medium space-y-1">
      <div class="font-bold flex items-center gap-1.5 text-amber-600 dark:text-amber-400">
        <span class="text-base">⚠️</span>
        <span>Perlu Perbaikan / Remedial LKPD (Nilai di bawah KKM 73)</span>
      </div>
      <p class="leading-relaxed">
        Pelajari catatan evaluasi guru di atas, perbaiki isian analisis/jawaban formulir di bawah ini, kemudian klik tombol <strong>"Kirim Ulang Hasil Perbaikan"</strong>.
      </p>
    </div>
  </div>

  <form id="form-general-lkpd" class="space-y-8">
    
    <!-- Identitas Siswa (Copy-Paste Diizinkan) -->
    <div class="space-y-4 p-5 rounded-xl bg-secondary/30 border border-border" id="identity-section" data-allow-paste-container="true">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-sm font-bold text-foreground font-mono flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">A</span>
          IDENTITAS PESERTA DIDIK
        </h3>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-medium">
          📋 Copy-Paste Diperbolehkan
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Nama Lengkap</label>
          <input 
            type="text" 
            name="studentName" 
            id="gen_studentName"
            value={user?.name || ''} 
            data-allow-paste="true"
            required 
            placeholder="Nama lengkap siswa"
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary allow-paste"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">NIS / NISN</label>
          <input 
            type="text" 
            name="studentNis" 
            id="gen_studentNis"
            data-allow-paste="true"
            required 
            placeholder="Contoh: 262710001"
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono allow-paste"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Kelas</label>
          <select 
            name="studentClass" 
            id="gen_studentClass"
            data-allow-paste="true"
            required
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
          >
            <option value="10 RPL 1">10 RPL 1</option>
            <option value="10 RPL 2">10 RPL 2</option>
            <option value="10 RPL 3">10 RPL 3</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Tanggal Pengerjaan</label>
          <input 
            type="date" 
            name="submissionDate" 
            id="gen_submissionDate"
            data-allow-paste="true"
            required 
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono"
          />
        </div>
      </div>
    </div>

    <!-- Aktivitas LKPD Utama (Wajib Diketik Mandiri) -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-sm font-bold text-foreground font-mono flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">B</span>
          HASIL ANALISIS & LAPORAN AKTIVITAS
        </h3>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 font-bold">
          ✍️ Wajib Diketik Mandiri (No Copy-Paste)
        </span>
      </div>

      <div class="space-y-5">
        {lkpdSchema ? (
          <>
            <div class="p-3.5 rounded-xl bg-primary/5 border border-primary/20 text-xs text-muted-foreground">
              <strong class="text-foreground">Evidence wajib:</strong> {lkpdSchema.evidence}
            </div>
            {lkpdSchema.sections.map((section, sectionIndex) => (
              <fieldset class="space-y-4 p-4 rounded-xl bg-secondary/20 border border-border">
                <legend class="px-2 text-sm font-bold text-foreground">{section.title}</legend>
                {section.description && <p class="text-xs text-muted-foreground">{section.description}</p>}
                {section.fields.map((field) => (
                  <div>
                    <label for={`gen_${field.name}`} class="block text-xs font-semibold text-foreground mb-1.5">
                      {field.label}
                    </label>
                    {field.type === 'textarea' ? (
                      <textarea
                        name={field.name}
                        id={`gen_${field.name}`}
                        rows="4"
                        required={field.required}
                        placeholder={field.placeholder}
                        class="w-full px-3.5 py-2.5 rounded-xl bg-secondary/30 border border-border text-xs text-foreground focus:outline-none focus:border-primary leading-relaxed"
                      ></textarea>
                    ) : (
                      <input
                        type={field.type || 'text'}
                        name={field.name}
                        id={`gen_${field.name}`}
                        required={field.required}
                        placeholder={field.placeholder}
                        data-allow-paste={field.type === 'url' ? 'true' : undefined}
                        class={`w-full px-3.5 py-2.5 rounded-xl bg-secondary/30 border border-border text-xs text-foreground focus:outline-none focus:border-primary ${field.type === 'url' ? 'font-mono allow-paste' : ''}`}
                      />
                    )}
                  </div>
                ))}
                <span class="sr-only">Bagian {sectionIndex + 1}</span>
              </fieldset>
            ))}
          </>
        ) : (
        <div>
          <div class="flex items-center justify-between gap-2 mb-1">
            <label class="block text-xs font-semibold text-foreground">
              {lkpdGuide.prompt}
            </label>
            {lkpdGuide.tip && (
              <span class="text-[11px] text-primary/90 font-mono hidden sm:inline-block">
                {lkpdGuide.tip}
              </span>
            )}
          </div>
          <textarea 
            name="analysisSummary" 
            id="gen_analysisSummary"
            rows="5"
            required
            placeholder={lkpdGuide.placeholder}
            class="w-full px-3.5 py-2.5 rounded-xl bg-secondary/30 border border-border text-xs text-foreground focus:outline-none focus:border-primary leading-relaxed"
          ></textarea>
        </div>
        )}

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">
            2. Bukti Karya / Evidence Tautan Google Drive atau Repository (Opsional):
          </label>
          <div class="relative">
            <input
              type="url"
              name="driveUrl"
              id="gen_driveUrl"
              data-allow-paste="true"
              placeholder="https://drive.google.com/... atau https://github.com/..."
              class="w-full px-3 py-2.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono allow-paste"
            />
          </div>
          <div class="flex items-center justify-between mt-1 text-[11px] text-muted-foreground">
            <p>💡 Tautan file bukti karya bersifat opsional untuk sekarang dan dapat dilengkapi menjelang akhir semester.</p>
            <span class="font-mono text-emerald-600 dark:text-emerald-400 shrink-0 ml-2">📋 Copy-Paste URL Diizinkan</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tombol Simpan & Submit -->
    <div id="gen-lkpd-action-footer" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-border">
      <div class="text-xs text-muted-foreground" id="gen-lkpd-footer-note">
        💡 <em>Jawaban akan langsung tersimpan dan tercatat di dashboard guru.</em>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto" id="gen-lkpd-btn-group">
        <button 
          type="button" 
          id="btn-gen-save-draft" 
          class="btn btn-secondary text-xs font-semibold px-4 py-2.5 rounded-lg border border-border hover:bg-secondary w-full sm:w-auto"
        >
          💾 Simpan Draf
        </button>

        <button 
          type="submit" 
          id="btn-gen-submit-lkpd" 
          class="btn btn-primary text-xs font-semibold px-6 py-2.5 rounded-lg w-full sm:w-auto flex items-center justify-center gap-2 transition-all shadow-md"
        >
          <span id="gen-submit-icon">🚀</span>
          <span id="gen-submit-text">Kirim LKPD (+25 XP)</span>
        </button>
      </div>

      <!-- Locked Banner when Graded >= 75 -->
      <div id="gen-lkpd-locked-banner" class="hidden w-full p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold text-center flex items-center justify-center gap-2">
        <span>🔒</span>
        <span>Lembar Kerja Ini Telah Dinilai & Tuntas KKM (Formulir Terkunci sebagai Portofolio Resmi)</span>
      </div>
    </div>

  </form>
</div>

<script>
  const genCardEl = document.getElementById('general-lkpd-card');
  const genSlug = genCardEl?.getAttribute('data-slug') || '';
  const genForm = document.getElementById('form-general-lkpd') as HTMLFormElement;
  const genStatusEl = document.getElementById('gen-lkpd-status');
  const genSaveDraftBtn = document.getElementById('btn-gen-save-draft');
  const dateInput = document.getElementById('gen_submissionDate') as HTMLInputElement;

  const teacherGradeCard = document.getElementById('gen-teacher-grade-card');
  const displayScore = document.getElementById('gen-display-teacher-score');
  const displayLevel = document.getElementById('gen-display-teacher-level');
  const displayFeedback = document.getElementById('gen-display-teacher-feedback');
  const displayGradedDate = document.getElementById('gen-display-graded-date');

  if (dateInput && !dateInput.value) {
    dateInput.value = new Date().toISOString().split('T')[0];
  }

  async function loadExistingGenSubmission() {
    try {
      const res = await fetch(`/api/submissions/get?slug=${encodeURIComponent(genSlug)}`);
      const data = await res.json();
      if (data.success && data.submissions) {
        const lkpdSub = data.submissions.find((s: any) => s.submissionType === 'lkpd');
        if (lkpdSub && lkpdSub.formData) {
          const formPayload = lkpdSub.formData;
          Object.entries(formPayload).forEach(([name, value]) => {
            const field = genForm?.elements.namedItem(name);
            if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
              field.value = String(value ?? '');
            }
          });
          if (lkpdSub.driveUrl) (document.getElementById('gen_driveUrl') as HTMLInputElement).value = lkpdSub.driveUrl;

          // Check if Graded
          if (lkpdSub.teacherScore !== null && lkpdSub.teacherScore !== undefined) {
            const score = Number(lkpdSub.teacherScore);
            const isPassedKKM = score >= 73;

            if (teacherGradeCard) {
              teacherGradeCard.classList.remove('hidden');
              teacherGradeCard.className = isPassedKKM
                ? 'p-5 rounded-2xl border-2 border-emerald-500/40 bg-emerald-500/5 space-y-3 transition-all'
                : 'p-5 rounded-2xl border-2 border-amber-500/40 bg-amber-500/5 space-y-3 transition-all';
            }

            const headerBorder = document.getElementById('gen-teacher-grade-header-border');
            if (headerBorder) {
              headerBorder.className = isPassedKKM ? 'flex flex-wrap items-center justify-between gap-2 border-b border-emerald-500/20 pb-3' : 'flex flex-wrap items-center justify-between gap-2 border-b border-amber-500/20 pb-3';
            }

            const tagEl = document.getElementById('gen-teacher-grade-tag');
            if (tagEl) {
              tagEl.className = isPassedKKM ? 'text-xs font-mono font-bold uppercase tracking-wider text-emerald-500' : 'text-xs font-mono font-bold uppercase tracking-wider text-amber-500';
              tagEl.textContent = isPassedKKM ? '✓ Hasil Penilaian: Tuntas KKM' : '⚠️ Hasil Penilaian: Perlu Remedial';
            }

            const titleEl = document.getElementById('gen-teacher-grade-title');
            if (titleEl) {
              titleEl.textContent = isPassedKKM ? 'Evaluasi LKPD — Kompetensi Tercapai' : 'Evaluasi LKPD — Perlu Perbaikan';
            }

            const iconEl = document.getElementById('gen-teacher-grade-icon');
            if (iconEl) iconEl.textContent = isPassedKKM ? '🏆' : '📝';

            if (displayScore) {
              displayScore.className = isPassedKKM 
                ? 'px-3 py-1 rounded-lg bg-emerald-500 text-black font-mono text-xs font-extrabold shadow-sm'
                : 'px-3 py-1 rounded-lg bg-amber-500 text-black font-mono text-xs font-extrabold shadow-sm';
              displayScore.textContent = `Nilai: ${score} / 100 ${isPassedKKM ? '(Tuntas)' : '(Belum KKM)'}`;
            }

            if (displayLevel) {
              displayLevel.className = isPassedKKM
                ? 'px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold border border-emerald-500/30'
                : 'px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400 font-mono text-xs font-bold border border-amber-500/30';
              displayLevel.textContent = lkpdSub.teacherLevel || (isPassedKKM ? 'Level 2 (Mencoba ★)' : 'Level 1 (Mulai)');
            }

            if (displayFeedback) displayFeedback.textContent = lkpdSub.teacherFeedback || 'Telah dinilai oleh Guru.';
            
            if (displayGradedDate && lkpdSub.gradedAt) {
              const formattedDate = new Date(lkpdSub.gradedAt).toLocaleDateString('id-ID', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              });
              displayGradedDate.textContent = `🕒 Dinilai pada: ${formattedDate}`;
            }

            const lockNotice = document.getElementById('gen-teacher-lock-notice');
            const remedialNotice = document.getElementById('gen-teacher-remedial-notice');
            const btnGroup = document.getElementById('gen-lkpd-btn-group');
            const lockedBanner = document.getElementById('gen-lkpd-locked-banner');
            const footerNote = document.getElementById('gen-lkpd-footer-note');

            if (isPassedKKM) {
              // CASE 1: TUNTAS (>= 73) -> LOCK FORM
              if (lockNotice) lockNotice.classList.remove('hidden');
              if (remedialNotice) remedialNotice.classList.add('hidden');
              if (btnGroup) btnGroup.classList.add('hidden');
              if (lockedBanner) lockedBanner.classList.remove('hidden');
              if (footerNote) footerNote.classList.add('hidden');

              // Lock all fields
              genForm?.querySelectorAll('input, textarea, select').forEach((input) => {
                (input as HTMLInputElement).disabled = true;
                input.classList.add('opacity-80', 'cursor-not-allowed', 'bg-secondary/40');
              });

              if (genStatusEl) {
                genStatusEl.className = 'text-[11px] font-mono px-2.5 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-bold flex items-center gap-1';
                genStatusEl.textContent = `🔒 Tuntas: ${score}/100`;
              }
            } else {
              // CASE 2: REMEDIAL (< 73) -> TETAP TERBUKA UNTUK EDIT
              if (lockNotice) lockNotice.classList.add('hidden');
              if (remedialNotice) remedialNotice.classList.remove('hidden');
              if (btnGroup) btnGroup.classList.remove('hidden');
              if (lockedBanner) lockedBanner.classList.add('hidden');

              const submitText = document.getElementById('gen-submit-text');
              const submitIcon = document.getElementById('gen-submit-icon');
              const submitBtn = document.getElementById('btn-gen-submit-lkpd');

              if (submitText) submitText.textContent = 'Simpan & Kirim Ulang Perbaikan LKPD';
              if (submitIcon) submitIcon.textContent = '🔄';
              if (submitBtn) {
                submitBtn.className = 'btn text-xs font-bold px-6 py-2.5 rounded-lg w-full sm:w-auto flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-black shadow-lg transition-all';
              }

              if (genStatusEl) {
                genStatusEl.className = 'text-[11px] font-mono px-2.5 py-1 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded border border-amber-500/20 font-bold flex items-center gap-1';
                genStatusEl.textContent = `⚠️ Perlu Revisi (${score}/100)`;
              }
            }
          } else if (genStatusEl) {
            genStatusEl.className = 'text-[11px] font-mono px-2 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-semibold';
            genStatusEl.textContent = '✅ LKPD Terkumpul';
          }
        }
      }
    } catch (e) {
      console.warn('Failed to load existing submission:', e);
    }
  }

  loadExistingGenSubmission();

  async function submitGenLkpd(isDraft = false) {
    const payload = Object.fromEntries(new FormData(genForm).entries()) as Record<string, FormDataEntryValue>;
    const driveUrl = String(payload.driveUrl || '');

    const activeTokenId = localStorage.getItem('ags_active_token_id');
    if (genStatusEl) genStatusEl.textContent = 'Menyimpan...';

    try {
      const res = await fetch('/api/submissions/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lessonSlug: genSlug,
          submissionType: 'lkpd',
          formData: payload,
          driveUrl,
          tokenId: activeTokenId ? Number(activeTokenId) : null,
        }),
      });

      const data = await res.json();
      if (data.success) {
        if (genStatusEl) {
          genStatusEl.className = 'text-[11px] font-mono px-2 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-semibold';
          genStatusEl.textContent = isDraft ? '💾 Draf Tersimpan' : '✅ LKPD Terkumpul (+25 XP)';
        }
        localStorage.setItem(`ags_lkpd_${genSlug}`, 'true');
        window.dispatchEvent(new CustomEvent('lkpd-submitted', { detail: { lessonSlug: genSlug } }));
        window.dispatchEvent(new CustomEvent('refresh-live-score'));
        alert(data.message || 'Jawaban LKPD berhasil disimpan! Tab Jurnal Refleksi kini terbuka.');
      } else {
        alert(data.error || 'Gagal menyimpan LKPD.');
      }
    } catch (e) {
      alert('Terjadi kesalahan jaringan.');
    }
  }

  genSaveDraftBtn?.addEventListener('click', () => submitGenLkpd(true));

  genForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitGenLkpd(false);
  });
</script>
