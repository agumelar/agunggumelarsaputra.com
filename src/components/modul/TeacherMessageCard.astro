---
import type { TeacherMessage } from '../../utils/orientasiInteractiveMaterials.ts';

interface Props {
  teacherMessage: TeacherMessage;
}

const { teacherMessage } = Astro.props;
---

<aside class="teacher-message" data-teacher-message aria-labelledby="teacher-message-title">
  <div class="teacher-message__icon" aria-hidden="true">✦</div>
  <div>
    <p class="teacher-message__eyebrow">Arahan pembelajaran</p>
    <h2 id="teacher-message-title">{teacherMessage.title}</h2>
    <p class="teacher-message__body">{teacherMessage.message}</p>
    <p class="teacher-message__signature">— {teacherMessage.signature}</p>
  </div>
</aside>

<style>
  .teacher-message { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; padding: 1.1rem; color: #f3f4f6; background: #172033; border: 1px solid #475569; border-left: 4px solid #f59e0b; border-radius: 0.75rem; }
  .teacher-message__icon { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; color: #fbbf24; background: #28364d; border: 1px solid #64748b; border-radius: 0.5rem; }
  .teacher-message__eyebrow { margin: 0 0 0.25rem; color: #fbbf24; font: 700 0.72rem/1.3 "JetBrains Mono", monospace; letter-spacing: 0.08em; text-transform: uppercase; }
  .teacher-message h2 { margin: 0; font-size: 1.05rem; }
  .teacher-message__body { margin: 0.55rem 0 0; color: #dbe4f0; line-height: 1.6; }
  .teacher-message__signature { margin: 0.7rem 0 0; color: #93c5fd; font: 600 0.78rem/1.4 "JetBrains Mono", monospace; }
</style>
