---
interface Props {
  lessonSlug: string;
  user: any;
}

const { lessonSlug, user } = Astro.props;
---

<div class="card p-6 md:p-8 rounded-2xl border-border bg-card shadow-sm space-y-6" id="lkpd-p1-form-card" data-slug={lessonSlug}>
  
  <!-- Header LKPD -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-5">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded bg-primary/10 text-primary border border-primary/20 text-[11px] font-mono font-bold uppercase">
          LEMBAR KERJA PESERTA DIDIK (LKPD)
        </span>
        <span class="px-2.5 py-0.5 rounded bg-secondary text-foreground text-[11px] font-mono font-semibold border border-border">
          PERTEMUAN 1 (OR-01)
        </span>
      </div>
      <h2 class="text-xl md:text-2xl font-extrabold text-foreground tracking-tight">
        Formulir Eksplorasi Digital & Setup Skill Passport
      </h2>
      <p class="text-xs text-muted-foreground">
        Isi seluruh aktivitas lembar kerja di bawah ini langsung melalui form web. Jawaban akan tersimpan otomatis ke database portofolio kalian.
      </p>
    </div>

    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
        ✨ Reward: +25 XP
      </span>
      <span id="lkpd-save-status" class="text-[11px] font-mono text-muted-foreground px-2 py-1 bg-secondary rounded border border-border">
        Belum Disimpan
      </span>
    </div>
  </div>

  <!-- Dynamic Teacher Grade & Feedback Card (Appears when Graded by Teacher) -->
  <div id="teacher-grade-card" class="hidden p-5 rounded-2xl border-2 space-y-3 transition-all">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b pb-3" id="teacher-grade-header-border">
      <div class="flex items-center gap-2">
        <span class="text-xl" id="teacher-grade-icon">🏆</span>
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider" id="teacher-grade-tag">Hasil Penilaian Guru</span>
          <h3 class="text-base font-extrabold text-foreground" id="teacher-grade-title">Evaluasi Lembar Kerja LKPD P1</h3>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span id="display-teacher-level" class="px-2.5 py-1 rounded-lg bg-primary text-primary-foreground font-mono text-xs font-bold">
          Level 2 (Mencoba ★)
        </span>
        <span id="display-teacher-score" class="px-3 py-1 rounded-lg font-mono text-xs font-extrabold">
          Nilai: 85 / 100
        </span>
      </div>
    </div>

    <div class="space-y-1.5 text-xs">
      <div class="text-muted-foreground font-semibold flex items-center gap-1.5">
        <span>👨‍🏫 Catatan & Masukan Evaluasi Guru:</span>
      </div>
      <div id="display-teacher-feedback" class="p-3.5 rounded-xl bg-card border border-border text-foreground leading-relaxed italic">
        "Kerja bagus! Seluruh aplikasi telah diidentifikasi perannya dengan tepat."
      </div>
      <div class="text-[11px] text-muted-foreground font-mono flex items-center justify-between pt-1">
        <span id="display-graded-date">🕒 Dinilai pada: -</span>
        <span class="text-primary font-semibold">Pengampu: Agung Gumelar Saputra, S.Tr.T.</span>
      </div>
    </div>

    <!-- Status Alert Notice: Lock vs Remedial -->
    <div id="teacher-lock-notice" class="hidden p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-medium flex items-center gap-2.5">
      <span class="text-lg">🔒</span>
      <div>
        <strong class="font-bold">Lembar Kerja Terkunci:</strong> Nilai Anda telah memenuhi KKM (Minimal 73). Isian lembar kerja ini telah dikunci sebagai bukti portofolio pembelajaran resmi.
      </div>
    </div>

    <div id="teacher-remedial-notice" class="hidden p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-medium space-y-1">
      <div class="font-bold flex items-center gap-1.5 text-amber-600 dark:text-amber-400">
        <span class="text-base">⚠️</span>
        <span>Perlu Perbaikan / Remedial LKPD (Nilai di bawah KKM 73)</span>
      </div>
      <p class="leading-relaxed">
        Pelajari catatan evaluasi guru di atas, perbaiki data atau uraian pada formulir di bawah ini, kemudian klik tombol <strong>"Kirim Ulang Hasil Perbaikan"</strong>.
      </p>
    </div>
  </div>

  <form id="form-lkpd-p1" class="space-y-8">
    
    <!-- Bagian A: Identitas Peserta Didik (Copy-Paste Diizinkan) -->
    <div class="space-y-4 p-5 rounded-xl bg-secondary/30 border border-border" id="identity-section" data-allow-paste-container="true">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-sm font-bold text-foreground font-mono flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">A</span>
          IDENTITAS PESERTA DIDIK
        </h3>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-medium">
          📋 Copy-Paste Diperbolehkan
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Nama Lengkap</label>
          <input 
            type="text" 
            name="studentName" 
            id="studentName"
            value={user?.name || ''} 
            data-allow-paste="true"
            required 
            placeholder="Nama lengkap siswa"
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary allow-paste"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">NIS / NISN</label>
          <input 
            type="text" 
            name="studentNis" 
            id="studentNis"
            data-allow-paste="true"
            required 
            placeholder="Contoh: 242510001"
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono allow-paste"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Kelas</label>
          <select 
            name="studentClass" 
            id="studentClass"
            data-allow-paste="true"
            required 
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
          >
            <option value="10 RPL 1">10 RPL 1</option>
            <option value="10 RPL 2">10 RPL 2</option>
            <option value="10 RPL 3">10 RPL 3</option>
            <option value="10 RPL 4">10 RPL 4</option>
            <option value="11 RPL 1">11 RPL 1</option>
            <option value="11 RPL 2">11 RPL 2</option>
            <option value="11 RPL 3">11 RPL 3</option>
            <option value="11 RPL 4">11 RPL 4</option>
            <option value="12 RPL 1">12 RPL 1</option>
            <option value="12 RPL 2">12 RPL 2</option>
            <option value="12 RPL 3">12 RPL 3</option>
            <option value="12 RPL 4">12 RPL 4</option>
            <option value="Kelas Uji Coba">Kelas Uji Coba (Sandbox)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Tanggal Pengerjaan</label>
          <input 
            type="date" 
            name="submissionDate" 
            id="submissionDate"
            data-allow-paste="true"
            required 
            class="w-full px-3 py-2 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono"
          />
        </div>
      </div>
    </div>

    <!-- Bagian B: Petunjuk Pengerjaan -->
    <div class="p-4 rounded-xl bg-primary/5 border border-primary/20 space-y-1.5 text-xs text-muted-foreground">
      <div class="font-bold text-foreground flex items-center justify-between">
        <span class="flex items-center gap-1.5">📌 Petunjuk Pengisian:</span>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 font-bold">
          ✍️ Wajib Diketik Mandiri (No Copy-Paste)
        </span>
      </div>
      <ol class="list-decimal list-inside space-y-1 leading-relaxed">
        <li>Amati minimal <strong>3 aplikasi digital</strong> yang sering kalian gunakan di HP atau laptop.</li>
        <li>Tuliskan fitur utama dan perkiraan peran profesi pengembang software di balik aplikasi tersebut (wajib diketik sendiri).</li>
        <li>Kalian bisa menambahkan baris baru dengan tombol <em>"+ Tambah Baris Aplikasi"</em>.</li>
        <li>Tekan tombol <strong>"Kirim LKPD P1"</strong> untuk menyimpan jawaban secara permanen ke akun kalian dan mendapatkan reward XP!</li>
      </ol>
    </div>

    <!-- Bagian C: Tabel Audit Profesi & Produk Digital -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <h3 class="text-sm font-bold text-foreground font-mono flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">B</span>
            AUDIT PRODUK DIGITAL & PERAN PROFESI TI
          </h3>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 font-semibold hidden sm:inline-block">
            ✍️ Wajib Diketik Sendiri
          </span>
        </div>

        <button 
          type="button" 
          id="btn-add-audit-row"
          class="btn btn-secondary text-xs font-semibold px-3 py-1.5 rounded-lg border border-border hover:bg-secondary flex items-center gap-1 self-start sm:self-auto"
        >
          <span>➕ Tambah Baris Aplikasi</span>
        </button>
      </div>

      <div class="overflow-x-auto border border-border rounded-xl">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-secondary/60 border-b border-border text-foreground font-mono">
              <th class="py-2.5 px-3 w-10 text-center">No</th>
              <th class="py-2.5 px-3 min-w-[150px]">Nama Produk / Aplikasi</th>
              <th class="py-2.5 px-3 min-w-[200px]">Fitur Utama</th>
              <th class="py-2.5 px-3 min-w-[250px]">Peran Pengembang di Balik Fitur</th>
              <th class="py-2.5 px-2 w-12 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="audit-table-body" class="divide-y divide-border">
            <!-- Row 1 Default -->
            <tr class="audit-row bg-card/40 hover:bg-secondary/20 transition-colors">
              <td class="py-3 px-3 text-center font-mono text-muted-foreground row-index">1</td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_name_1" 
                  placeholder="Misal: WhatsApp"
                  value="WhatsApp"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_feature_1" 
                  placeholder="Misal: Kirim pesan suara & panggilan video"
                  value="Pesan terenkripsi, panggilan video, status"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_roles_1" 
                  placeholder="Misal: Mobile Dev (UI), Backend Dev (Server), Security Engineer (Enkripsi)"
                  value="Mobile Dev (UI Android/iOS), Backend (Server kirim pesan), Security Engineer (E2EE)"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-2 text-center">
                <button type="button" class="btn-delete-row text-muted-foreground hover:text-rose-500 p-1 text-sm transition-colors" title="Hapus baris">
                  🗑️
                </button>
              </td>
            </tr>

            <!-- Row 2 Default -->
            <tr class="audit-row bg-card/40 hover:bg-secondary/20 transition-colors">
              <td class="py-3 px-3 text-center font-mono text-muted-foreground row-index">2</td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_name_2" 
                  placeholder="Misal: Tokopedia / Shopee"
                  value="Tokopedia"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_feature_2" 
                  placeholder="Misal: Keranjang belanja & Pembayaran QRIS"
                  value="Katalog produk, checkout keranjang, integrasi bank/QRIS"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_roles_2" 
                  placeholder="Misal: Frontend Dev, Payment Gateway Engineer, UI/UX"
                  value="Frontend Web Dev, Payment Gateway Backend, QA Tester"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-2 text-center">
                <button type="button" class="btn-delete-row text-muted-foreground hover:text-rose-500 p-1 text-sm transition-colors" title="Hapus baris">
                  🗑️
                </button>
              </td>
            </tr>

            <!-- Row 3 Default -->
            <tr class="audit-row bg-card/40 hover:bg-secondary/20 transition-colors">
              <td class="py-3 px-3 text-center font-mono text-muted-foreground row-index">3</td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_name_3" 
                  placeholder="Misal: Gojek / Grab"
                  value="Gojek"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_feature_3" 
                  placeholder="Misal: Order GoRide & Pelacakan Driver Real-time di Peta"
                  value="Peta GPS rute tercepat & pencocokan driver terdekat"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-3">
                <input 
                  type="text" 
                  name="app_roles_3" 
                  placeholder="Misal: Map Engineer, Dispatching Backend, UI/UX"
                  value="Geospatial/Map Engineer, Dispatch Backend Dev, UI/UX Designer"
                  required
                  class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
                />
              </td>
              <td class="py-2 px-2 text-center">
                <button type="button" class="btn-delete-row text-muted-foreground hover:text-rose-500 p-1 text-sm transition-colors" title="Hapus baris">
                  🗑️
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Bagian D: Bukti Portofolio Google Drive (Opsional / Portofolio Akhir) -->
    <div class="space-y-4 p-5 rounded-xl bg-secondary/30 border border-border">
      <div>
        <h3 class="text-sm font-bold text-foreground font-mono flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs">C</span>
          LINK GOOGLE DRIVE PORTOFOLIO (OPSIONAL - DIKUMPULKAN DI AKHIR)
        </h3>
        <p class="text-xs text-muted-foreground mt-0.5">
          Tautan folder Google Drive portofolio bersifat opsional pada pertemuan awal dan akan diverifikasi secara bertahap saat penilaian akhir semester.
        </p>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">
            URL Link Folder Google Drive (Opsional):
          </label>
          <div class="relative">
            <input 
              type="url" 
              name="driveUrl" 
              id="driveUrl"
              data-allow-paste="true"
              placeholder="https://drive.google.com/drive/folders/..." 
              class="w-full px-3 py-2.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary font-mono allow-paste"
            />
          </div>
          <div class="flex items-center justify-between mt-1 text-[11px] text-muted-foreground">
            <p id="drive-url-feedback"></p>
            <span class="font-mono text-emerald-600 dark:text-emerald-400">📋 Copy-Paste URL Diizinkan</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tombol Aksi Submit / Draft -->
    <div id="lkpd-action-footer" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-border">
      <div class="text-xs text-muted-foreground" id="lkpd-footer-note">
        💡 <em>Draf jawaban dan pengumpulan LKPD tersimpan otomatis ke akun Anda.</em>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto" id="lkpd-btn-group">
        <button 
          type="button" 
          id="btn-save-draft" 
          class="btn btn-secondary text-xs font-semibold px-4 py-2.5 rounded-lg border border-border hover:bg-secondary w-full sm:w-auto"
        >
          💾 Simpan Draf
        </button>

        <button 
          type="submit" 
          id="btn-submit-lkpd" 
          class="btn btn-primary text-xs font-semibold px-6 py-2.5 rounded-lg w-full sm:w-auto flex items-center justify-center gap-2 transition-all shadow-md"
        >
          <span id="submit-btn-icon">🚀</span>
          <span id="submit-btn-text">Kirim LKPD P1 (+25 XP)</span>
        </button>
      </div>

      <!-- Locked Banner when Graded >= 75 -->
      <div id="lkpd-locked-banner" class="hidden w-full p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold text-center flex items-center justify-center gap-2">
        <span>🔒</span>
        <span>Lembar Kerja Ini Telah Dinilai & Tuntas KKM (Formulir Terkunci sebagai Portofolio Resmi)</span>
      </div>
    </div>

  </form>
</div>

<script>
  import { createFormHydrationGuard } from '../../utils/formHydrationGuard';

  const cardEl = document.getElementById('lkpd-p1-form-card');
  const slug = cardEl?.getAttribute('data-slug') || 'orientasi-pplg-01-pengantar-skill-passport';
  const form = document.getElementById('form-lkpd-p1') as HTMLFormElement;
  const statusEl = document.getElementById('lkpd-save-status');
  const btnAddRow = document.getElementById('btn-add-audit-row');
  const tableBody = document.getElementById('audit-table-body');
  const driveUrlInput = document.getElementById('driveUrl') as HTMLInputElement;
  const driveFeedback = document.getElementById('drive-url-feedback');
  const btnSaveDraft = document.getElementById('btn-save-draft');
  const submissionDateInput = document.getElementById('submissionDate') as HTMLInputElement;

  // Teacher grade elements
  const teacherGradeCard = document.getElementById('teacher-grade-card');
  const displayScore = document.getElementById('display-teacher-score');
  const displayLevel = document.getElementById('display-teacher-level');
  const displayFeedback = document.getElementById('display-teacher-feedback');
  const displayGradedDate = document.getElementById('display-graded-date');

  // Set default date today
  if (submissionDateInput && !submissionDateInput.value) {
    submissionDateInput.value = new Date().toISOString().split('T')[0];
  }
  const formHydrationGuard = createFormHydrationGuard(form);

  // Optional Live Drive URL validator
  driveUrlInput?.addEventListener('input', () => {
    const val = driveUrlInput.value.trim();
    if (!val) {
      if (driveFeedback) driveFeedback.textContent = '';
      return;
    }
    if (val.includes('drive.google.com')) {
      driveFeedback!.className = 'text-[11px] text-emerald-600 dark:text-emerald-400 mt-1 flex items-center gap-1 font-mono';
      driveFeedback!.textContent = '✓ Format URL Google Drive valid.';
    } else {
      driveFeedback!.className = 'text-[11px] text-amber-600 dark:text-amber-400 mt-1 flex items-center gap-1 font-mono';
      driveFeedback!.textContent = '⚠️ Pastikan URL berasal dari link Google Drive yang benar.';
    }
  });

  // Re-number rows helper
  function updateRowNumbers() {
    tableBody?.querySelectorAll('.audit-row').forEach((row, idx) => {
      const idxEl = row.querySelector('.row-index');
      if (idxEl) idxEl.textContent = String(idx + 1);
    });
  }

  // Delete row listener
  tableBody?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('btn-delete-row')) {
      const rows = tableBody.querySelectorAll('.audit-row');
      if (rows.length <= 1) {
        alert('Minimal harus ada 1 baris aplikasi.');
        return;
      }
      target.closest('.audit-row')?.remove();
      updateRowNumbers();
    }
  });

  // Add row listener
  btnAddRow?.addEventListener('click', () => {
    const currentRows = tableBody?.querySelectorAll('.audit-row').length || 0;
    const nextIdx = currentRows + 1;

    const tr = document.createElement('tr');
    tr.className = 'audit-row bg-card/40 hover:bg-secondary/20 transition-colors';
    tr.innerHTML = `
      <td class="py-3 px-3 text-center font-mono text-muted-foreground row-index">${nextIdx}</td>
      <td class="py-2 px-3">
        <input 
          type="text" 
          name="app_name_${nextIdx}" 
          placeholder="Nama aplikasi baru..."
          required
          class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
        />
      </td>
      <td class="py-2 px-3">
        <input 
          type="text" 
          name="app_feature_${nextIdx}" 
          placeholder="Fitur utama yang dianalisis..."
          required
          class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
        />
      </td>
      <td class="py-2 px-3">
        <input 
          type="text" 
          name="app_roles_${nextIdx}" 
          placeholder="Peran pengembang IT terkait..."
          required
          class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary"
        />
      </td>
      <td class="py-2 px-2 text-center">
        <button type="button" class="btn-delete-row text-muted-foreground hover:text-rose-500 p-1 text-sm transition-colors" title="Hapus baris">
          🗑️
        </button>
      </td>
    `;
    tableBody?.appendChild(tr);
  });

  // Load existing submission data from DB
  async function loadExistingSubmission() {
    try {
      const res = await fetch(`/api/submissions/get?slug=${encodeURIComponent(slug)}`);
      const data = await res.json();
      
      if (data.success && data.submissions) {
        const lkpdSub = data.submissions.find((s: any) => s.submissionType === 'lkpd');
        if (lkpdSub) {
          const formPayload = lkpdSub.formData;
          if (formHydrationGuard.canApplyServerValues()) {
            if (formPayload.studentName) (document.getElementById('studentName') as HTMLInputElement).value = formPayload.studentName;
            if (formPayload.studentNis) (document.getElementById('studentNis') as HTMLInputElement).value = formPayload.studentNis;
            if (formPayload.studentClass) (document.getElementById('studentClass') as HTMLSelectElement).value = formPayload.studentClass;
            if (formPayload.submissionDate) (document.getElementById('submissionDate') as HTMLInputElement).value = formPayload.submissionDate;
            if (formPayload.driveUrl || lkpdSub.driveUrl) (document.getElementById('driveUrl') as HTMLInputElement).value = formPayload.driveUrl || lkpdSub.driveUrl;
          }

          // Render saved audit apps only before the learner starts editing.
          if (formHydrationGuard.canApplyServerValues() && formPayload.auditApps && Array.isArray(formPayload.auditApps) && formPayload.auditApps.length > 0) {
            tableBody!.innerHTML = '';
            formPayload.auditApps.forEach((app: any, idx: number) => {
              const tr = document.createElement('tr');
              tr.className = 'audit-row bg-card/40 hover:bg-secondary/20 transition-colors';
              tr.innerHTML = `
                <td class="py-3 px-3 text-center font-mono text-muted-foreground row-index">${idx + 1}</td>
                <td class="py-2 px-3">
                  <input type="text" value="${app.name || ''}" required class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary" />
                </td>
                <td class="py-2 px-3">
                  <input type="text" value="${app.feature || ''}" required class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary" />
                </td>
                <td class="py-2 px-3">
                  <input type="text" value="${app.roles || ''}" required class="w-full px-2.5 py-1.5 rounded-lg bg-card border border-border text-xs text-foreground focus:outline-none focus:border-primary" />
                </td>
                <td class="py-2 px-2 text-center">
                  <button type="button" class="btn-delete-row text-muted-foreground hover:text-rose-500 p-1 text-sm transition-colors" title="Hapus baris">🗑️</button>
                </td>
              `;
              tableBody?.appendChild(tr);
            });
          }

          // Check if Graded by Teacher
          if (lkpdSub.teacherScore !== null && lkpdSub.teacherScore !== undefined) {
            const score = Number(lkpdSub.teacherScore);
            const isPassedKKM = score >= 73;

            if (teacherGradeCard) {
              teacherGradeCard.classList.remove('hidden');
              teacherGradeCard.className = isPassedKKM
                ? 'p-5 rounded-2xl border-2 border-emerald-500/40 bg-emerald-500/5 space-y-3 transition-all'
                : 'p-5 rounded-2xl border-2 border-amber-500/40 bg-amber-500/5 space-y-3 transition-all';
            }

            const headerBorder = document.getElementById('teacher-grade-header-border');
            if (headerBorder) {
              headerBorder.className = isPassedKKM ? 'flex flex-wrap items-center justify-between gap-2 border-b border-emerald-500/20 pb-3' : 'flex flex-wrap items-center justify-between gap-2 border-b border-amber-500/20 pb-3';
            }

            const tagEl = document.getElementById('teacher-grade-tag');
            if (tagEl) {
              tagEl.className = isPassedKKM ? 'text-xs font-mono font-bold uppercase tracking-wider text-emerald-500' : 'text-xs font-mono font-bold uppercase tracking-wider text-amber-500';
              tagEl.textContent = isPassedKKM ? '✓ Hasil Penilaian: Tuntas KKM' : '⚠️ Hasil Penilaian: Perlu Remedial';
            }

            const titleEl = document.getElementById('teacher-grade-title');
            if (titleEl) {
              titleEl.textContent = isPassedKKM ? 'Evaluasi LKPD — Kompetensi Tercapai' : 'Evaluasi LKPD — Perlu Perbaikan';
            }

            const iconEl = document.getElementById('teacher-grade-icon');
            if (iconEl) iconEl.textContent = isPassedKKM ? '🏆' : '📝';

            if (displayScore) {
              displayScore.className = isPassedKKM 
                ? 'px-3 py-1 rounded-lg bg-emerald-500 text-black font-mono text-xs font-extrabold shadow-sm'
                : 'px-3 py-1 rounded-lg bg-amber-500 text-black font-mono text-xs font-extrabold shadow-sm';
              displayScore.textContent = `Nilai: ${score} / 100 ${isPassedKKM ? '(Tuntas)' : '(Belum KKM)'}`;
            }

            if (displayLevel) {
              displayLevel.className = isPassedKKM
                ? 'px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold border border-emerald-500/30'
                : 'px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400 font-mono text-xs font-bold border border-amber-500/30';
              displayLevel.textContent = lkpdSub.teacherLevel || (isPassedKKM ? 'Level 2 (Mencoba ★)' : 'Level 1 (Mulai)');
            }

            if (displayFeedback) displayFeedback.textContent = lkpdSub.teacherFeedback || 'Telah diverifikasi oleh Guru.';
            
            if (displayGradedDate && lkpdSub.gradedAt) {
              const formattedDate = new Date(lkpdSub.gradedAt).toLocaleDateString('id-ID', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              });
              displayGradedDate.textContent = `🕒 Dinilai pada: ${formattedDate}`;
            }

            const lockNotice = document.getElementById('teacher-lock-notice');
            const remedialNotice = document.getElementById('teacher-remedial-notice');
            const btnGroup = document.getElementById('lkpd-btn-group');
            const lockedBanner = document.getElementById('lkpd-locked-banner');
            const footerNote = document.getElementById('lkpd-footer-note');

            if (isPassedKKM) {
              // CASE 1: TUNTAS & TERKUNCI (>= 73)
              if (lockNotice) lockNotice.classList.remove('hidden');
              if (remedialNotice) remedialNotice.classList.add('hidden');
              if (btnGroup) btnGroup.classList.add('hidden');
              if (lockedBanner) lockedBanner.classList.remove('hidden');
              if (footerNote) footerNote.classList.add('hidden');

              // Lock all form fields
              form?.querySelectorAll('input, textarea, select').forEach((input) => {
                (input as HTMLInputElement).disabled = true;
                input.classList.add('opacity-80', 'cursor-not-allowed', 'bg-secondary/40');
              });

              // Hide add/delete row buttons
              if (btnAddRow) (btnAddRow as HTMLElement).style.display = 'none';
              document.querySelectorAll('.btn-delete-row').forEach((btn) => {
                (btn as HTMLElement).style.display = 'none';
              });

              if (statusEl) {
                statusEl.className = 'text-[11px] font-mono px-2.5 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-bold flex items-center gap-1';
                statusEl.textContent = `🔒 Tuntas: ${score}/100`;
              }
            } else {
              // CASE 2: REMEDIAL (< 73) - FORM TETAP TERBUKA
              if (lockNotice) lockNotice.classList.add('hidden');
              if (remedialNotice) remedialNotice.classList.remove('hidden');
              if (btnGroup) btnGroup.classList.remove('hidden');
              if (lockedBanner) lockedBanner.classList.add('hidden');

              const submitText = document.getElementById('submit-btn-text');
              const submitIcon = document.getElementById('submit-btn-icon');
              const submitBtn = document.getElementById('btn-submit-lkpd');

              if (submitText) submitText.textContent = 'Simpan & Kirim Ulang Perbaikan LKPD';
              if (submitIcon) submitIcon.textContent = '🔄';
              if (submitBtn) {
                submitBtn.className = 'btn text-xs font-bold px-6 py-2.5 rounded-lg w-full sm:w-auto flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-black shadow-lg transition-all';
              }

              if (statusEl) {
                statusEl.className = 'text-[11px] font-mono px-2.5 py-1 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded border border-amber-500/20 font-bold flex items-center gap-1';
                statusEl.textContent = `⚠️ Perlu Revisi (${score}/100)`;
              }
            }
          } else if (statusEl) {
            statusEl.className = 'text-[11px] font-mono px-2.5 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-semibold';
            statusEl.textContent = '✅ LKPD Terkumpul';
          }
        }
      }
    } catch (e) {
      console.warn('Failed to load existing submission:', e);
    }
  }

  loadExistingSubmission();

  // Extract structured data from form
  function getFormDataPayload() {
    const studentName = (document.getElementById('studentName') as HTMLInputElement).value;
    const studentNis = (document.getElementById('studentNis') as HTMLInputElement).value;
    const studentClass = (document.getElementById('studentClass') as HTMLSelectElement).value;
    const submissionDate = (document.getElementById('submissionDate') as HTMLInputElement).value;
    const driveUrl = (document.getElementById('driveUrl') as HTMLInputElement).value;

    const auditApps: any[] = [];
    tableBody?.querySelectorAll('.audit-row').forEach((row) => {
      const inputs = row.querySelectorAll('input');
      auditApps.push({
        name: inputs[0]?.value || '',
        feature: inputs[1]?.value || '',
        roles: inputs[2]?.value || '',
      });
    });

    return {
      studentName,
      studentNis,
      studentClass,
      submissionDate,
      auditApps,
      driveUrl,
    };
  }

  // Save / Submit handler
  async function submitLkpd(isDraft = false) {
    const payload = getFormDataPayload();
    const activeTokenId = localStorage.getItem('ags_active_token_id');

    if (statusEl) {
      statusEl.textContent = 'Menyimpan...';
    }

    try {
      const res = await fetch('/api/submissions/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lessonSlug: slug,
          submissionType: 'lkpd',
          formData: payload,
          driveUrl: payload.driveUrl,
          tokenId: activeTokenId ? Number(activeTokenId) : null,
        }),
      });

      const data = await res.json();
      if (data.success) {
        if (statusEl) {
          statusEl.className = 'text-[11px] font-mono px-2 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded border border-emerald-500/20 font-semibold';
          statusEl.textContent = isDraft ? '💾 Draf Tersimpan' : '✅ LKPD Terkumpul (+25 XP)';
        }
        localStorage.setItem(`ags_lkpd_${slug}`, 'true');
        window.dispatchEvent(new CustomEvent('lkpd-submitted', { detail: { lessonSlug: slug } }));
        window.dispatchEvent(new CustomEvent('refresh-live-score'));
        alert(data.message || 'Jawaban LKPD berhasil disimpan! Tab Jurnal Refleksi kini terbuka.');
      } else {
        alert(data.error || 'Gagal menyimpan LKPD.');
      }
    } catch (e: any) {
      alert('Terjadi kesalahan jaringan saat menyimpan.');
    }
  }

  btnSaveDraft?.addEventListener('click', () => submitLkpd(true));

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    submitLkpd(false);
  });
</script>
