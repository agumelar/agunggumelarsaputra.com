---
interface Props {
  skillCode?: string;
  targetLevel?: string;
  items?: { no: number; indicator: string; targetMin: string }[];
}

const { 
  skillCode = "OR-01", 
  targetLevel = "Level 2 (Mencoba ★)",
  items = [
    { no: 1, indicator: "Menjelaskan arti dan tujuan mata pelajaran Orientasi PPLG bagi pemula RPL.", targetMin: "Memahami esensi industri & mindset developer" },
    { no: 2, indicator: "Memahami fungsi instrumen Skill Passport dan tangga level kompetensi (0 - 4).", targetMin: "Mengetahui target minimal semester 1 adalah Level 2" },
    { no: 3, indicator: "Menyiapkan struktur folder portofolio Google Drive dengan penamaan baku.", targetMin: "Folder publik (Viewer) & terstruktur rapi" },
    { no: 4, indicator: "Menyelesaikan formulir LKPD audit teknologi 24 jam dan refleksi awal.", targetMin: "Minimal 3 aplikasi dipetakan dengan tepat" },
  ]
} = Astro.props;
---

<div class="card p-6 md:p-8 rounded-2xl border-border bg-card shadow-sm space-y-6">
  
  <div class="space-y-1 border-b border-border pb-5">
    <div class="inline-flex items-center gap-2">
      <span class="px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-[11px] font-mono font-bold uppercase">
        PANDUAN KRITERIA ASESMEN GURU
      </span>
      <span class="px-2.5 py-0.5 rounded bg-secondary text-foreground text-[11px] font-mono font-semibold border border-border">
        KODE SKILL: {skillCode}
      </span>
    </div>
    <h2 class="text-xl md:text-2xl font-extrabold text-foreground tracking-tight">
      Standar Ketercapaian Kompetensi (KKTP) & Rubrik Guru
    </h2>
    <p class="text-xs text-muted-foreground">
      Berikut adalah panduan kriteria yang digunakan oleh Guru untuk memvalidasi evidence portofolio dan pencapaian level kompetensi kalian.
    </p>
  </div>

  <!-- Tangga Level 0 - 4 Infografis -->
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-xs font-mono font-bold text-foreground uppercase tracking-wider">
        Tangga Level Kompetensi Skill Passport
      </h3>
      <span class="text-[11px] font-mono text-primary font-semibold">
        Target Semester 1: {targetLevel}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-5 gap-2.5">
      
      <!-- Level 0 -->
      <div class="p-3 rounded-xl border border-border bg-secondary/30 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold font-mono text-muted-foreground">LV 0</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-secondary text-muted-foreground font-mono">Belum</span>
        </div>
        <h4 class="text-xs font-bold text-foreground">Belum Terlihat</h4>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Belum mengumpulkan file atau link Drive rusak/terkunci.
        </p>
      </div>

      <!-- Level 1 -->
      <div class="p-3 rounded-xl border border-border bg-secondary/30 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold font-mono text-blue-500">LV 1</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-500 font-mono">Dasar</span>
        </div>
        <h4 class="text-xs font-bold text-foreground">Mengenal</h4>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Evidence ada namun meniru contoh tanpa elaborasi mandiri.
        </p>
      </div>

      <!-- Level 2 (Target Minimal) -->
      <div class="p-3 rounded-xl border-2 border-primary bg-primary/5 space-y-1.5 relative shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold font-mono text-primary">LV 2 ★</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-primary text-primary-foreground font-mono font-bold">TARGET</span>
        </div>
        <h4 class="text-xs font-bold text-foreground">Mencoba</h4>
        <p class="text-[11px] text-foreground/80 leading-relaxed font-medium">
          Evidence lengkap, struktur instruksi rapi, link Drive valid.
        </p>
      </div>

      <!-- Level 3 -->
      <div class="p-3 rounded-xl border border-border bg-secondary/30 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold font-mono text-purple-500">LV 3</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-500 font-mono">Mandiri</span>
        </div>
        <h4 class="text-xs font-bold text-foreground">Mandiri</h4>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Karya orisinal, analisis mendalam, presentasi lancar.
        </p>
      </div>

      <!-- Level 4 -->
      <div class="p-3 rounded-xl border border-border bg-secondary/30 space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold font-mono text-amber-500">LV 4 👑</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-500 font-mono">Mahir</span>
        </div>
        <h4 class="text-xs font-bold text-foreground">Portofolio</h4>
        <p class="text-[11px] text-muted-foreground leading-relaxed">
          Karya standar industri, layak dipamerkan sebagai percontohan.
        </p>
      </div>

    </div>
  </div>

  <!-- Tabel Indikator KKTP -->
  <div class="space-y-3 pt-3 border-t border-border">
    <h3 class="text-xs font-mono font-bold text-foreground uppercase tracking-wider">
      Indikator Ketercapaian Tujuan Pembelajaran (KKTP)
    </h3>

    <div class="overflow-x-auto border border-border rounded-xl">
      <table class="w-full text-left text-xs border-collapse">
        <thead>
          <tr class="bg-secondary/60 text-muted-foreground border-b border-border font-mono">
            <th class="p-3 w-12 text-center">No</th>
            <th class="p-3">Indikator Ketercapaian (KKTP)</th>
            <th class="p-3 w-72">Kriteria Minimal Pencapaian (Level 2)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          {items.map((item) => (
            <tr>
              <td class="p-3 text-center font-mono font-bold text-muted-foreground">{item.no}</td>
              <td class="p-3 text-foreground font-medium leading-relaxed">{item.indicator}</td>
              <td class="p-3 text-muted-foreground font-mono leading-relaxed">{item.targetMin}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

</div>
