---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border/40 bg-card/40 backdrop-blur mt-16 py-12">
  <div class="container-main">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Column 1: Brand & Bio -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2 font-bold text-lg">
          <div class="w-7 h-7 rounded-md bg-gradient-to-br from-blue-600 to-cyan-400 flex items-center justify-center text-white text-xs font-bold">
            AGS
          </div>
          <span class="text-foreground">Agung Gumelar Saputra</span>
        </div>
        <p class="text-sm text-muted-foreground max-w-md leading-relaxed">
          Guru Rekayasa Perangkat Lunak (PPLG) di SMKN 1 Rongga & Developer EdTech. Berdedikasi mencetak talenta vokasi IT unggulan melalui media pembelajaran interaktif & teknologi web modern.
        </p>
        <div class="flex items-center gap-3 pt-1 text-xs text-muted-foreground font-mono">
          <span class="inline-flex items-center gap-1 text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            SMKN 1 Rongga
          </span>
          <span>•</span>
          <span>S2 Teknologi Pendidikan</span>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-foreground tracking-wider uppercase">Menu Utama</h4>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="/" class="hover:text-blue-400 transition-colors">Beranda</a></li>
          <li><a href="/pembelajaran" class="hover:text-blue-400 transition-colors">Learning Hub</a></li>
          <li><a href="/pembelajaran/tka-pplg" class="hover:text-cyan-400 transition-colors font-medium">Drilling TKA PPLG</a></li>
          <li><a href="/projects" class="hover:text-blue-400 transition-colors">Portofolio & Projects</a></li>
          <li><a href="/blog" class="hover:text-blue-400 transition-colors">Blog & Artikel</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact & Links -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-foreground tracking-wider uppercase">Tautan & Media</h4>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li><a href="/cv" class="hover:text-blue-400 transition-colors">Curriculum Vitae (CV)</a></li>
          <li><a href="/contact" class="hover:text-blue-400 transition-colors">Kontak & Diskusi</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors">GitHub Profile</a></li>
          <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors">LinkedIn</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-border/40 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-muted-foreground gap-4">
      <p>&copy; {currentYear} Agung Gumelar Saputra, S.Pd. All rights reserved.</p>
      <p class="flex items-center gap-1">
        Dibuat dengan <span class="text-red-500">❤️</span> menggunakan Astro & TailwindCSS di-deploy pada Vercel.
      </p>
    </div>
  </div>
</footer>
