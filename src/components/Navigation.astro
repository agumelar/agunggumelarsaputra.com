---
const currentPath = Astro.url.pathname;
const user = Astro.locals.user;

const navItems = [
  { href: '/', label: 'Beranda' },
  { href: '/pembelajaran', label: 'Pembelajaran' },
  { href: '/pembelajaran/tka-pplg', label: 'Drilling TKA PPLG', highlight: true },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/cv', label: 'CV Guru' },
  { href: '/contact', label: 'Kontak' },
  ...(user 
    ? [{ href: '/dashboard', label: 'Dashboard', highlight: true }]
    : [{ href: '/login', label: 'Login', highlight: true }])
];
---

<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/60">
  <div class="container-main flex h-16 items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight group">
      <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-blue-600 via-cyan-500 to-emerald-400 p-0.5 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
        <div class="w-full h-full bg-background rounded-[7px] flex items-center justify-center">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-cyan-400 font-extrabold text-sm">AGS</span>
        </div>
      </div>
      <div class="flex flex-col">
        <span class="leading-tight text-foreground font-semibold">Agung Gumelar</span>
        <span class="text-[10px] text-muted-foreground font-mono">SMKN 1 Rongga • PPLG</span>
      </div>
    </a>
    
    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a 
            href={item.href}
            class:list={[
              "px-3 py-2 rounded-md text-sm font-medium transition-all relative",
              item.highlight ? "text-cyan-400 hover:text-cyan-300 font-semibold" : "",
              isActive 
                ? "text-blue-500 font-semibold bg-blue-500/10" 
                : "text-muted-foreground hover:text-foreground hover:bg-accent/50"
            ]}
          >
            {item.label}
            {item.highlight && (
              <span class="absolute -top-1 -right-1 flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
              </span>
            )}
          </a>
        );
      })}
    </nav>
    
    <!-- Action Controls: Gamification Badge + Dark/Light Theme Switcher -->
    <div class="flex items-center gap-2">
      {user ? (
        <a href="/dashboard" id="user-xp-badge" class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-amber-500/10 to-emerald-500/10 border border-amber-500/30 text-xs font-medium text-amber-400 hover:scale-105 transition-transform" title="Level & XP Belajar Anda">
          <span>⚡</span>
          <span id="header-xp-val" class="font-bold font-mono">0 XP</span>
          <span class="text-muted-foreground">|</span>
          <span id="header-level-val" class="text-[11px] text-emerald-400">Lvl 1</span>
        </a>
      ) : (
        <a href="/login" class="hidden sm:flex px-3 py-1 rounded-md text-xs font-medium border border-border/40 hover:bg-accent text-foreground transition-colors">
          Login Portal
        </a>
      )}

      <!-- Theme Switcher Button -->
      <button 
        id="theme-toggle" 
        type="button" 
        class="p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
        aria-label="Toggle theme"
      >
        <svg id="sun-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="moon-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button 
        class="lg:hidden p-2 rounded-lg text-muted-foreground hover:bg-accent"
        aria-label="Toggle menu"
        id="mobile-menu-btn"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
  
  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-border bg-background/95 backdrop-blur-md">
    <nav class="container-main py-4 flex flex-col gap-1">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class:list={[
            "px-4 py-2.5 rounded-lg text-sm font-medium transition-colors flex items-center justify-between",
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
              ? "bg-blue-600/10 text-blue-500 font-semibold"
              : "text-muted-foreground hover:bg-accent hover:text-foreground"
          ]}
        >
          <span>{item.label}</span>
          {item.highlight && <span class="text-xs bg-cyan-500/20 text-cyan-400 px-2 py-0.5 rounded-full">New</span>}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import { getGamificationState } from '../utils/gamification';

  // Update Header XP Badge dynamically
  function syncHeaderXp() {
    const xpVal = document.getElementById('header-xp-val');
    const levelVal = document.getElementById('header-level-val');
    if (xpVal && levelVal) {
      const state = getGamificationState();
      xpVal.textContent = `${state.xp} XP`;
      levelVal.textContent = `Lvl ${state.level}`;
    }
  }

  syncHeaderXp();
  window.addEventListener('ags-xp-updated', syncHeaderXp);

  // Theme Toggle Logic
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');

  function initTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      moonIcon?.classList.remove('hidden');
      sunIcon?.classList.add('hidden');
    }
  }

  initTheme();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    initTheme();
  });

  // Mobile Menu Toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
