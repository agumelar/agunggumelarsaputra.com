---
interface Props {
  slug?: string;
}
const { slug = 'tka-01-algoritma-logika' } = Astro.props;

const allQuestionsFiles = import.meta.glob('/src/data/tka-questions/*.json', { eager: true });
const targetFile = `/src/data/tka-questions/${slug}.json`;

let questions = [];
if (allQuestionsFiles[targetFile]) {
  questions = (allQuestionsFiles[targetFile] as any).default || allQuestionsFiles[targetFile];
}
---

<div class="space-y-4">
  <div id="tka-quiz-data" data-questions={JSON.stringify(questions)} data-slug={slug} class="hidden"></div>

  <!-- Active Token Session Indicator Banner -->
  <div id="quiz-token-banner" class="hidden p-4 rounded-m3-xl bg-[var(--md-sys-color-surface-container)] border border-[var(--md-sys-color-outline-variant)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm animate-fadeIn">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-m3-md bg-[var(--md-sys-color-surface-container-high)] border border-[var(--md-sys-color-outline-variant)] flex items-center justify-center text-foreground text-sm flex-shrink-0">
        🎟️
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-foreground">Sesi Ujian Terdaftar:</span>
          <span id="banner-token-code" class="px-2 py-0.5 rounded-m3-xs bg-[var(--md-sys-color-surface-container-highest)] text-foreground font-mono font-bold text-xs tracking-wider border border-[var(--md-sys-color-outline-variant)]">
            TOKEN
          </span>
        </div>
        <p class="text-[11px] text-muted-foreground mt-0.5" id="banner-token-title">
          Hasil ujian ini akan otomatis disinkronkan ke rekapitulasi nilai guru pengampu.
        </p>
      </div>
    </div>

    <button 
      type="button" 
      id="btn-leave-session" 
      class="text-[11px] text-muted-foreground hover:text-foreground font-mono underline whitespace-nowrap self-end sm:self-auto transition-colors"
      title="Ganti atau keluar dari sesi ini"
    >
      Ganti Sesi Token
    </button>
  </div>

  <div class="m3-card-elevated p-5 md:p-7 rounded-m3-2xl relative space-y-4">
    
    <!-- Header Bar Quiz -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[var(--md-sys-color-outline-variant)] pb-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="m3-chip-primary text-[10px] font-mono font-bold uppercase tracking-wider">Simulasi CBT TKA PPLG</span>
          <span id="quiz-progress-text" class="text-xs text-muted-foreground font-mono">Soal 1 dari ...</span>
        </div>
        <h3 id="quiz-category-title" class="text-base font-bold text-foreground font-display mt-1">Memuat Modul...</h3>
      </div>
    </div>

    <div id="quiz-empty-state" class="hidden text-center py-8">
      <p class="text-sm text-muted-foreground">Bank soal untuk pertemuan ini belum tersedia.</p>
    </div>

    <!-- Question Box -->
    <div id="quiz-question-box" class="space-y-4 hidden">
      <div id="quiz-question-text" class="text-sm md:text-base text-foreground font-medium leading-relaxed">
        <!-- Question text rendered by JS -->
      </div>

      <!-- Optional Code Snippet -->
      <div id="quiz-code-container" class="hidden my-3">
        <pre class="p-3.5 rounded-lg bg-secondary/80 border border-border font-mono text-xs text-foreground overflow-x-auto"><code id="quiz-code-text"></code></pre>
      </div>

      <!-- Options List -->
      <div id="quiz-options-container" class="space-y-2.5 pt-1">
        <!-- Options rendered by JS -->
      </div>
    </div>

    <!-- Explanation & Teacher Note Box (Hidden until answered) -->
    <div id="quiz-explanation-box" class="hidden mt-5 p-4 rounded-lg bg-secondary/40 border border-border space-y-2">
      <div class="flex items-center gap-2 text-xs font-bold text-foreground">
        <span>💡 Pembahasan & Kunci Jawaban</span>
      </div>
      <p id="quiz-explanation-text" class="text-xs text-muted-foreground leading-relaxed"></p>
      <div id="quiz-teacher-note" class="text-xs font-medium text-amber-700 dark:text-amber-300 bg-amber-500/10 p-2.5 rounded-md border border-amber-500/20 mt-2"></div>
    </div>

    <!-- Navigation Buttons -->
    <div id="quiz-navigation" class="hidden items-center justify-between mt-6 pt-4 border-t border-border flex">
      <button id="btn-prev-question" class="btn btn-outline btn-sm text-xs font-medium rounded-lg" disabled>
        ← Soal Sebelumnya
      </button>
      
      <div class="flex items-center gap-2">
        <button id="btn-check-answer" class="btn btn-sm px-4 text-xs font-semibold bg-secondary text-foreground hover:bg-accent border border-border rounded-lg">
          Periksa Jawaban
        </button>
        <button id="btn-next-question" class="btn btn-primary btn-sm px-4 text-xs font-semibold rounded-lg">
          Soal Selanjutnya →
        </button>
      </div>
    </div>

    <!-- Final Result Screen (Hidden by default) -->
    <div id="quiz-result-screen" class="hidden text-center py-8 space-y-5">
      <div class="w-16 h-16 rounded-full bg-secondary border border-border text-3xl flex items-center justify-center mx-auto shadow-sm">
        🏆
      </div>
      <div>
        <h3 class="text-xl font-bold text-foreground">Simulasi TKA PPLG Selesai!</h3>
        <p class="text-xs text-muted-foreground mt-0.5">Berikut adalah hasil capaian ujian Anda:</p>
      </div>

      <div class="inline-flex items-center gap-6 px-6 py-4 rounded-xl bg-secondary/30 border border-border">
        <div>
          <div class="text-[10px] text-muted-foreground uppercase font-mono">Skor Akhir</div>
          <div id="result-score-val" class="text-3xl font-extrabold text-foreground font-mono">0</div>
        </div>
        <div class="h-8 w-px bg-border"></div>
        <div>
          <div class="text-[10px] text-muted-foreground uppercase font-mono">Jawaban Benar</div>
          <div id="result-correct-val" class="text-xl font-bold text-emerald-600 dark:text-emerald-400 font-mono">0 / 6</div>
        </div>
        <div class="h-8 w-px bg-border"></div>
        <div>
          <div class="text-[10px] text-muted-foreground uppercase font-mono">Bonus XP</div>
          <div id="result-xp-val" class="text-xl font-bold text-amber-600 dark:text-amber-400 font-mono">+0 XP</div>
        </div>
      </div>

      <div class="flex items-center justify-center gap-3 pt-2">
        <a href="/pembelajaran/tka-pplg" class="btn btn-outline text-xs font-semibold px-4 py-2 rounded-lg">
          ← Kembali ke Hub
        </a>
        <button id="btn-restart-quiz" class="btn btn-primary text-xs font-semibold px-4 py-2 rounded-lg">
          Ulangi Simulasi Ujian 🔄
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { addXp, unlockBadge, getGamificationState } from '../utils/gamification';

  const quizDataEl = document.getElementById('tka-quiz-data');
  let TKA_PPLG_QUESTIONS = quizDataEl && quizDataEl.dataset.questions 
    ? JSON.parse(quizDataEl.dataset.questions) 
    : [];

  // Algoritma Pengacakan (Fisher-Yates) untuk meminimalisir saling contek
  function shuffleArray(array: any[]) {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
  }

  if (TKA_PPLG_QUESTIONS.length > 0) {
    // 1. Acak urutan soal
    shuffleArray(TKA_PPLG_QUESTIONS);
    
    // 2. Acak urutan opsi jawaban per soal
    TKA_PPLG_QUESTIONS.forEach((q: any) => {
      let opts = q.options.map((text: string, i: number) => ({ text, originalIndex: i }));
      shuffleArray(opts);
      q.correctAnswer = opts.findIndex((o: any) => o.originalIndex === q.correctAnswer);
      q.options = opts.map((o: any) => o.text);
    });
  }

  const emptyState = document.getElementById('quiz-empty-state');
  const questionBox = document.getElementById('quiz-question-box');
  const navigation = document.getElementById('quiz-navigation');

  let currentIndex = 0;
  let userAnswers: (number | null)[] = [];
  let isAnswerChecked: boolean[] = [];
  let secondsRemaining = 3600; // 60 minutes
  let timerInterval: any = null;

  if (TKA_PPLG_QUESTIONS.length > 0) {
    userAnswers = new Array(TKA_PPLG_QUESTIONS.length).fill(null);
    isAnswerChecked = new Array(TKA_PPLG_QUESTIONS.length).fill(false);
  } else {
    if (emptyState) emptyState.classList.remove('hidden');
  }

  // Active Token Detection
  const urlParams = new URLSearchParams(window.location.search);
  const paramTokenId = urlParams.get('tokenId');
  const paramTokenCode = urlParams.get('tokenCode');

  if (paramTokenId) {
    localStorage.setItem('ags_active_token_id', paramTokenId);
    if (paramTokenCode) localStorage.setItem('ags_active_token_code', paramTokenCode);
  }

  const activeTokenId = localStorage.getItem('ags_active_token_id');
  const activeTokenCode = localStorage.getItem('ags_active_token_code');
  const activeTokenTitle = localStorage.getItem('ags_active_token_title');

  const tokenBanner = document.getElementById('quiz-token-banner');
  const bannerTokenCode = document.getElementById('banner-token-code');
  const bannerTokenTitle = document.getElementById('banner-token-title');
  const btnLeaveSession = document.getElementById('btn-leave-session');

  if (activeTokenId && activeTokenCode && tokenBanner) {
    tokenBanner.classList.remove('hidden');
    if (bannerTokenCode) bannerTokenCode.textContent = activeTokenCode;
    if (bannerTokenTitle && activeTokenTitle) {
      bannerTokenTitle.textContent = `Sesi: ${activeTokenTitle} — Nilai akan disinkronkan ke rekapitulasi guru.`;
    }
  }

  btnLeaveSession?.addEventListener('click', () => {
    localStorage.removeItem('ags_active_token_id');
    localStorage.removeItem('ags_active_token_code');
    localStorage.removeItem('ags_active_token_title');
    window.location.href = '/pembelajaran';
  });

  const progressText = document.getElementById('quiz-progress-text');
  const categoryTitle = document.getElementById('quiz-category-title');
  const questionText = document.getElementById('quiz-question-text');
  const codeContainer = document.getElementById('quiz-code-container');
  const codeText = document.getElementById('quiz-code-text');
  const optionsContainer = document.getElementById('quiz-options-container');
  const explanationBox = document.getElementById('quiz-explanation-box');
  const explanationText = document.getElementById('quiz-explanation-text');
  const teacherNote = document.getElementById('quiz-teacher-note');
  const timerEl = document.getElementById('quiz-timer');

  const btnPrev = document.getElementById('btn-prev-question') as HTMLButtonElement;
  const btnNext = document.getElementById('btn-next-question') as HTMLButtonElement;
  const btnCheck = document.getElementById('btn-check-answer') as HTMLButtonElement;
  const btnRestart = document.getElementById('btn-restart-quiz');

  const resultScreen = document.getElementById('quiz-result-screen');

  function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      secondsRemaining--;
      if (timerEl) {
        const m = Math.floor(secondsRemaining / 60);
        const s = secondsRemaining % 60;
        timerEl.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
      }
      if (secondsRemaining <= 0) {
        clearInterval(timerInterval);
        finishQuiz();
      }
    }, 1000);
  }

  function renderQuestion() {
    const q = TKA_PPLG_QUESTIONS[currentIndex];
    if (!q) return;

    if (progressText) progressText.textContent = `Soal ${currentIndex + 1} dari ${TKA_PPLG_QUESTIONS.length}`;
    if (categoryTitle) categoryTitle.textContent = q.category;
    if (questionText) questionText.textContent = q.question;

    if (q.codeSnippet && codeContainer && codeText) {
      codeText.textContent = q.codeSnippet;
      codeContainer.classList.remove('hidden');
    } else if (codeContainer) {
      codeContainer.classList.add('hidden');
    }

    // Render Options
    if (optionsContainer) {
      optionsContainer.innerHTML = q.options.map((opt, idx) => {
        const isSelected = userAnswers[currentIndex] === idx;
        const checked = isAnswerChecked[currentIndex];
        const isCorrect = q.correctAnswer === idx;

        let styleClass = "border-border bg-card hover:bg-accent text-foreground";
        if (checked) {
          if (isCorrect) {
            styleClass = "border-emerald-500/60 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold";
          } else if (isSelected && !isCorrect) {
            styleClass = "border-destructive/60 bg-destructive/10 text-destructive font-semibold";
          }
        } else if (isSelected) {
          styleClass = "border-primary bg-primary/10 text-primary font-semibold";
        }

        return `
          <button data-opt-idx="${idx}" class="opt-btn w-full p-3.5 rounded-lg border text-left transition-colors flex items-center justify-between text-xs sm:text-sm ${styleClass}">
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded border border-current flex items-center justify-center font-mono text-xs font-bold flex-shrink-0">
                ${String.fromCharCode(65 + idx)}
              </span>
              <span>${opt}</span>
            </div>
            ${checked && isCorrect ? '<span class="text-xs">✓ Benar</span>' : ''}
            ${checked && isSelected && !isCorrect ? '<span class="text-xs">✕ Salah</span>' : ''}
          </button>
        `;
      }).join('');

      // Add click handlers for option buttons
      const optBtns = optionsContainer.querySelectorAll('.opt-btn');
      optBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          if (isAnswerChecked[currentIndex]) return;
          const selectedIdx = parseInt((btn as HTMLElement).dataset.optIdx || '0');
          userAnswers[currentIndex] = selectedIdx;
          renderQuestion();
        });
      });
    }

    // Show/Hide Explanation & Personal Teacher Feedback
    if (isAnswerChecked[currentIndex] && explanationBox && explanationText && teacherNote) {
      const userChoiceIdx = userAnswers[currentIndex];
      const isCorrect = userChoiceIdx === q.correctAnswer;
      const chosenText = userChoiceIdx !== null ? q.options[userChoiceIdx] : '';
      const correctText = q.options[q.correctAnswer];
      const chosenLetter = userChoiceIdx !== null ? String.fromCharCode(65 + userChoiceIdx) : '';
      const correctLetter = String.fromCharCode(65 + q.correctAnswer);

      if (isCorrect) {
        explanationText.innerHTML = `
          <div class="text-emerald-500 font-bold mb-1">✅ Jawaban kamu Tepat! (${correctLetter}: ${correctText})</div>
          <div>${q.explanation}</div>
        `;
        teacherNote.innerHTML = `
          <span class="font-bold">🗣️ Catatan Pak Agung:</span> 
          <span>${q.teacherNote || "Luar biasa! Pemahaman konsepmu sudah sangat matang. Pertahankan daya analisis ini!"}</span>
        `;
      } else {
        explanationText.innerHTML = `
          <div class="space-y-1.5">
            <div class="text-destructive font-semibold">
              ❌ Kamu memilih: <span class="font-mono font-bold">(${chosenLetter}) ${chosenText}</span>
            </div>
            <div class="text-emerald-600 dark:text-emerald-400 font-bold">
              ✓ Jawaban yang benar adalah: <span class="font-mono">(${correctLetter}) ${correctText}</span>
            </div>
            <div class="pt-2 border-t border-border/40 text-muted-foreground">
              ${q.explanation}
            </div>
          </div>
        `;
        teacherNote.innerHTML = `
          <span class="font-bold">🗣️ Catatan Pak Agung:</span> 
          <span>${q.teacherNote || `Jangan berkecil hati! Pilihan (${chosenLetter}) "${chosenText}" kurang tepat untuk kasus ini. Jawaban yang benar adalah (${correctLetter}) "${correctText}". Perhatikan baik-baik perbedaannya ya!`}</span>
        `;
      }
      
      teacherNote.classList.remove('hidden');
      explanationBox.classList.remove('hidden');
    } else if (explanationBox) {
      explanationBox.classList.add('hidden');
    }

    // Controls status
    if (btnPrev) btnPrev.disabled = currentIndex === 0;
    if (btnNext) {
      btnNext.textContent = currentIndex === TKA_PPLG_QUESTIONS.length - 1 ? 'Selesaikan Ujian 🏁' : 'Soal Selanjutnya →';
    }
  }

  btnCheck?.addEventListener('click', () => {
    if (userAnswers[currentIndex] === null) {
      alert('Silakan pilih salah satu jawaban terlebih dahulu!');
      return;
    }
    isAnswerChecked[currentIndex] = true;
    const q = TKA_PPLG_QUESTIONS[currentIndex];
    if (userAnswers[currentIndex] === q.correctAnswer) {
      addXp(20, 'Jawaban TKA benar');
    }
    renderQuestion();
  });

  btnPrev?.addEventListener('click', () => {
    if (currentIndex > 0) {
      currentIndex--;
      renderQuestion();
    }
  });

  btnNext?.addEventListener('click', () => {
    if (currentIndex < TKA_PPLG_QUESTIONS.length - 1) {
      currentIndex++;
      renderQuestion();
    } else {
      const answeredCount = userAnswers.filter(a => a !== null).length;
      const total = TKA_PPLG_QUESTIONS.length;

      if (answeredCount < total) {
        alert(`⚠️ Masih ada ${total - answeredCount} soal yang belum Anda jawab!\n\nHarap lengkapi jawaban seluruh soal sebelum menyelesaikan ujian.`);
        return;
      }

      const confirmFinish = confirm(`📝 Seluruh ${total} soal telah Anda jawab.\n\nApakah Anda yakin 100% ingin mengumpulkan ujian sekarang dan mengunci skor Anda?`);
      if (!confirmFinish) return;

      finishQuiz();
    }
  });

  async function finishQuiz() {
    let correctCount = 0;
    TKA_PPLG_QUESTIONS.forEach((q, idx) => {
      if (userAnswers[idx] === q.correctAnswer) {
        correctCount++;
      }
    });

    const score = Math.round((correctCount / TKA_PPLG_QUESTIONS.length) * 100);
    const xpEarned = correctCount * 20 + (score >= 80 ? 100 : 0);

    const state = getGamificationState();
    unlockBadge(state, 'tka-warrior');
    if (score >= 80) unlockBadge(state, 'tka-master');
    addXp(score >= 80 ? 100 : 0, 'Bonus kelulusan TKA');

    const currentSavedTokenId = localStorage.getItem('ags_active_token_id');
    const quizSlug = quizDataEl?.dataset.slug || '';

    try {
      await fetch('/api/tka/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          score,
          totalQuestions: TKA_PPLG_QUESTIONS.length,
          correctAnswers: correctCount,
          tokenId: currentSavedTokenId ? Number(currentSavedTokenId) : null,
          lessonSlug: quizSlug,
        })
      });
    } catch (err) {
      console.error('TKA Submit API Error:', err);
    }

    window.dispatchEvent(new CustomEvent('checkpoint-passed'));

    if (questionBox) questionBox.classList.add('hidden');
    if (explanationBox) explanationBox.classList.add('hidden');
    if (btnPrev) btnPrev.classList.add('hidden');
    if (btnNext) btnNext.classList.add('hidden');
    if (btnCheck) btnCheck.classList.add('hidden');

    if (resultScreen) {
      resultScreen.classList.remove('hidden');
      const scoreVal = document.getElementById('result-score-val');
      const correctVal = document.getElementById('result-correct-val');
      const xpVal = document.getElementById('result-xp-val');

      if (scoreVal) scoreVal.textContent = `${score}`;
      if (correctVal) correctVal.textContent = `${correctCount} / ${TKA_PPLG_QUESTIONS.length}`;
      if (xpVal) xpVal.textContent = `+${xpEarned} XP`;
    }
  }

  btnRestart?.addEventListener('click', () => {
    currentIndex = 0;
    userAnswers = new Array(TKA_PPLG_QUESTIONS.length).fill(null);
    isAnswerChecked = new Array(TKA_PPLG_QUESTIONS.length).fill(false);

    if (questionBox) questionBox.classList.remove('hidden');
    if (btnPrev) btnPrev.classList.remove('hidden');
    if (btnNext) btnNext.classList.remove('hidden');
    if (btnCheck) btnCheck.classList.remove('hidden');
    if (resultScreen) resultScreen.classList.add('hidden');

    renderQuestion();
  });

  // Init
  if (TKA_PPLG_QUESTIONS.length > 0) {
    if (questionBox) questionBox.classList.remove('hidden');
    if (navigation) navigation.classList.remove('hidden');
    renderQuestion();
  }
</script>
