---
---

<div class="card p-6 border-blue-500/20 bg-gradient-to-br from-card via-card to-blue-950/20 shadow-xl relative overflow-hidden">
  <!-- Glowing Background Accent -->
  <div class="absolute -top-12 -right-12 w-40 h-40 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border/40 pb-4">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-amber-500 to-emerald-400 p-0.5 shadow-md">
        <div class="w-full h-full bg-background rounded-[10px] flex items-center justify-center text-xl">
          ⚡
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 id="widget-level-title" class="font-bold text-foreground text-lg">Apprentice Coder</h3>
          <span id="widget-level-badge" class="px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-semibold">Lvl 1</span>
        </div>
        <p class="text-xs text-muted-foreground">Progres Belajar & Gamifikasi Siswa</p>
      </div>
    </div>

    <!-- Streak Badge -->
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-medium">
      <span class="text-base">🔥</span>
      <div>
        <span id="widget-streak-val" class="font-bold font-mono text-sm">1</span>
        <span class="text-[11px] text-muted-foreground ml-1">Hari Streak</span>
      </div>
    </div>
  </div>

  <!-- XP Progress Bar -->
  <div class="mt-4 space-y-1.5">
    <div class="flex justify-between text-xs text-muted-foreground font-mono">
      <span>XP Saat Ini: <strong id="widget-xp-val" class="text-emerald-400 font-bold">0</strong> XP</span>
      <span id="widget-next-xp">Menuju Level Berikutnya: 100 XP</span>
    </div>
    <div class="w-full h-3 rounded-full bg-accent/60 overflow-hidden p-0.5 border border-border/40">
      <div id="widget-xp-bar" class="h-full rounded-full bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 transition-all duration-500" style="width: 0%;"></div>
    </div>
  </div>

  <!-- Badges Grid -->
  <div class="mt-5">
    <h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">Lencana Prestasi (Badges)</h4>
    <div id="widget-badges-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
      <!-- Dynamic Badges rendered via JS -->
    </div>
  </div>
</div>

<script>
  import { getGamificationState, calculateLevel, ALL_BADGES } from '../utils/gamification';

  function renderGamificationWidget() {
    const state = getGamificationState();
    const levelInfo = calculateLevel(state.xp);

    const levelTitleEl = document.getElementById('widget-level-title');
    const levelBadgeEl = document.getElementById('widget-level-badge');
    const streakValEl = document.getElementById('widget-streak-val');
    const xpValEl = document.getElementById('widget-xp-val');
    const nextXpEl = document.getElementById('widget-next-xp');
    const xpBarEl = document.getElementById('widget-xp-bar');
    const badgesContainer = document.getElementById('widget-badges-container');

    if (levelTitleEl) levelTitleEl.textContent = levelInfo.title;
    if (levelBadgeEl) levelBadgeEl.textContent = `Lvl ${levelInfo.level}`;
    if (streakValEl) streakValEl.textContent = `${state.streak}`;
    if (xpValEl) xpValEl.textContent = `${state.xp}`;
    if (nextXpEl) nextXpEl.textContent = `Berikutnya: ${levelInfo.nextLevelXp} XP`;

    if (xpBarEl) {
      const range = levelInfo.nextLevelXp - levelInfo.currentLevelMinXp;
      const currentProgress = state.xp - levelInfo.currentLevelMinXp;
      const pct = Math.min(100, Math.max(5, (currentProgress / range) * 100));
      xpBarEl.style.width = `${pct}%`;
    }

    if (badgesContainer) {
      badgesContainer.innerHTML = ALL_BADGES.map(b => {
        const isUnlocked = state.badges.some(unlocked => unlocked.id === b.id);
        return `
          <div class="p-2 rounded-lg border text-center transition-all ${
            isUnlocked 
              ? 'bg-blue-500/10 border-blue-500/40 text-foreground shadow-sm' 
              : 'bg-card/40 border-border/30 opacity-40 grayscale'
          }">
            <div class="text-xl mb-1">${b.icon}</div>
            <div class="text-[11px] font-medium leading-tight truncate" title="${b.title}">${b.title}</div>
          </div>
        `;
      }).join('');
    }
  }

  renderGamificationWidget();
  window.addEventListener('ags-xp-updated', renderGamificationWidget);
</script>
